{"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallService"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"customerInfoStream","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:ScS","text":"AsyncStream","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV","text":"EntitlementSnapshot","kind":"typeIdentifier"},{"text":">","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Yields a new "},{"code":"EntitlementSnapshot","type":"codeVoice"},{"type":"text","text":" every time RevenueCat reports a change to the user’s"},{"type":"text","text":" "},{"type":"text","text":"customer info — purchase, refund, family-share update, sandbox renewal. A failed-verification"},{"type":"text","text":" "},{"type":"text","text":"response is skipped. The stream"},{"type":"text","text":" "},{"type":"text","text":"finishes when the underlying RevenueCat stream finishes; the paywall plugin’s"},{"type":"text","text":" "},{"code":".observeCustomerInfo","type":"codeVoice"},{"type":"text","text":" effect normally keeps it alive for the duration of the session."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A new stream first yields the customer info RevenueCat last delivered in this process, if"},{"type":"text","text":" "},{"type":"text","text":"any. RevenueCat may not have delivered one yet — on a relaunch with a fresh cache it skips"},{"type":"text","text":" "},{"type":"text","text":"the launch fetch — and then the stream stays silent until the next change. Dispatch"},{"type":"text","text":" "},{"code":".refreshCustomerInfo","type":"codeVoice"},{"type":"text","text":" alongside "},{"code":".observeCustomerInfo","type":"codeVoice"},{"type":"text","text":" to seed the state."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If RevenueCat has not been configured, the stream finishes immediately. Configure RevenueCat, then call this method again to start a live stream."}],"type":"paragraph"}]}],"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"abstract":[{"text":"Returns a long-lived stream of entitlement snapshots derived from","type":"text"},{"text":" ","type":"text"},{"code":"Purchases.shared.customerInfoStream","type":"codeVoice"},{"text":".","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxrevenuecatpaywall\/revenuecatpaywallservice\/customerinfostream()"]}],"identifier":{"url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallService\/customerInfoStream()","interfaceLanguage":"swift"},"metadata":{"title":"customerInfoStream()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"customerInfoStream","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:ScS","text":"AsyncStream","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV","text":"EntitlementSnapshot","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","symbolKind":"method","modules":[{"name":"SwiduxRevenueCatPaywall"}],"externalID":"s:23SwiduxRevenueCatPaywall0bcD7ServiceV18customerInfoStreamScSy0aD019EntitlementSnapshotVGyF","roleHeading":"Instance Method"},"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall":{"kind":"symbol","abstract":[{"type":"text","text":"RevenueCat adapter for Swidux’s "},{"code":"PaywallPlugin","type":"codeVoice"},{"type":"text","text":". Implements "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" against "},{"type":"codeVoice","code":"Purchases.shared"},{"type":"text","text":", ships a controllable mock for previews and tests, and pairs with "},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" for drop-in ","type":"text"},{"code":"PaywallView","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"CustomerCenterView","type":"codeVoice"},{"text":" presentation.","type":"text"}],"url":"\/documentation\/swiduxrevenuecatpaywall","role":"collection","type":"topic","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall","title":"SwiduxRevenueCatPaywall"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/RevenueCatPaywallService":{"type":"topic","role":"symbol","url":"\/documentation\/swiduxrevenuecatpaywall\/revenuecatpaywallservice","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RevenueCatPaywallService","kind":"identifier"}],"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallService","kind":"symbol","title":"RevenueCatPaywallService","abstract":[{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" conformer backed by RevenueCat’s "},{"code":"Purchases.shared","type":"codeVoice"},{"type":"text","text":"."}],"navigatorTitle":[{"text":"RevenueCatPaywallService","kind":"identifier"}]},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/RevenueCatPaywallService/customerInfoStream()":{"type":"topic","role":"symbol","url":"\/documentation\/swiduxrevenuecatpaywall\/revenuecatpaywallservice\/customerinfostream()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"customerInfoStream"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:ScS","text":"AsyncStream"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV",