{"kind":"symbol","hierarchy":{"paths":[[]]},"abstract":[{"text":"RevenueCat adapter for Swidux’s ","type":"text"},{"code":"PaywallPlugin","type":"codeVoice"},{"text":". Implements ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" against ","type":"text"},{"code":"Purchases.shared","type":"codeVoice"},{"text":", ships a controllable mock for previews and tests, and pairs with ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" for drop-in ","type":"text"},{"code":"PaywallView","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"CustomerCenterView","type":"codeVoice"},{"text":" presentation.","type":"text"}],"metadata":{"title":"SwiduxRevenueCatPaywall","symbolKind":"module","externalID":"SwiduxRevenueCatPaywall","modules":[{"name":"SwiduxRevenueCatPaywall"}],"roleHeading":"Framework","role":"collection"},"topicSections":[{"anchor":"Quickstart","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/GettingStarted"],"title":"Quickstart"},{"anchor":"How-to-Guides","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest"],"title":"How-to Guides"},{"anchor":"Reference","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/ServiceReference","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/UIComponentsReference"],"title":"Reference"},{"anchor":"Explanation","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping"],"title":"Explanation"},{"anchor":"Service-Layer","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallService","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallError","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallIdentity","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallIdentityResult","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallIdentityError"],"title":"Service Layer"},{"anchor":"Testing","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService"],"title":"Testing"},{"generated":true,"anchor":"Enumerations","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywall"],"title":"Enumerations"}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"text":" is the adapter between RevenueCat’s SDK and Swidux’s purchase-agnostic paywall plugin. The plugin owns paywall state (presentation flags, current entitlement, async progress); this package translates RevenueCat’s ","type":"text"},{"code":"CustomerInfo","type":"codeVoice"},{"text":" into the ","type":"text"},{"code":"EntitlementSnapshot","type":"codeVoice"},{"text":" the plugin expects, and surfaces the live ","type":"text"},{"code":"customerInfoStream","type":"codeVoice"},{"text":" so entitlement changes propagate without polling.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Two products ship together:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":" (the live "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" conformer) and "},{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"type":"text","text":" (a controllable preview \/ test conformer)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"revenueCatPaywall(isPresented:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"revenueCatCustomerCenter(isPresented:)"},{"type":"text","text":" primitives with adaptive presentation and package-owned outcome events, plus a "},{"type":"codeVoice","code":"revenueCatPaywallAndCustomerCenter(state:onAction:)"},{"type":"text","text":" convenience that composes both."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The flow:","type":"text"}],"type":"paragraph"},{"code":["View → store.send(.paywall(.request(reason:)))","  → PaywallPlugin sets isPresented = true","  → revenueCatPaywallAndCustomerCenter observes the change, presents RevenueCatUI.PaywallView","  → user purchases → Purchases.shared.customerInfoStream yields a new CustomerInfo","  → RevenueCatPaywallService maps it to EntitlementSnapshot","  → PaywallPlugin reduces .customerInfoUpdated, sets isPro = true","  → store.paywall.isGateSatisfied flips, gated UI unlocks"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"The plugin and the adapter stay decoupled: the plugin doesn’t know about RevenueCat, and the adapter doesn’t know about your action tree.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxrevenuecatpaywall"]}],"sections":[],"identifier":{"url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/