{"kind":"symbol","variants":[{"paths":["\/documentation\/swiduxrevenuecatpaywall\/revenuecatpaywallservice\/customerinfostream()"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallService"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"customerInfoStream","kind":"identifier"},{"kind":"text","text":"() -> "},{"text":"AsyncStream","kind":"typeIdentifier","preciseIdentifier":"s:ScS"},{"kind":"text","text":"<"},{"text":"EntitlementSnapshot","kind":"typeIdentifier","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV"},{"kind":"text","text":">"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Yields a new "},{"code":"EntitlementSnapshot","type":"codeVoice"},{"type":"text","text":" every time RevenueCat reports a change to the user’s"},{"type":"text","text":" "},{"type":"text","text":"customer info — purchase, refund, family-share update, sandbox renewal. A failed-verification"},{"type":"text","text":" "},{"type":"text","text":"response is skipped. The stream"},{"type":"text","text":" "},{"type":"text","text":"finishes when the underlying RevenueCat stream finishes; the paywall plugin’s"},{"type":"text","text":" "},{"code":".observeCustomerInfo","type":"codeVoice"},{"type":"text","text":" effect normally keeps it alive for the duration of the session."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A new stream first yields the customer info RevenueCat last delivered in this process, if"},{"type":"text","text":" "},{"type":"text","text":"any. RevenueCat may not have delivered one yet — on a relaunch with a fresh cache it skips"},{"type":"text","text":" "},{"type":"text","text":"the launch fetch — and then the stream stays silent until the next change. Dispatch"},{"type":"text","text":" "},{"code":".refreshCustomerInfo","type":"codeVoice"},{"type":"text","text":" alongside "},{"code":".observeCustomerInfo","type":"codeVoice"},{"type":"text","text":" to seed the state."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If RevenueCat has not been configured, the stream finishes immediately. Configure RevenueCat, then call this method again to start a live stream."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallService\/customerInfoStream()","interfaceLanguage":"swift"},"sections":[],"abstract":[{"type":"text","text":"Returns a long-lived stream of entitlement snapshots derived from"},{"text":" ","type":"text"},{"code":"Purchases.shared.customerInfoStream","type":"codeVoice"},{"text":".","type":"text"}],"metadata":{"modules":[{"name":"SwiduxRevenueCatPaywall"}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"customerInfoStream"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"AsyncStream","preciseIdentifier":"s:ScS"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"EntitlementSnapshot","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV"},{"kind":"text","text":">"}],"title":"customerInfoStream()","externalID":"s:23SwiduxRevenueCatPaywall0bcD7ServiceV18customerInfoStreamScSy0aD019EntitlementSnapshotVGyF","symbolKind":"method","roleHeading":"Instance Method"},"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/RevenueCatPaywallService":{"navigatorTitle":[{"kind":"identifier","text":"RevenueCatPaywallService"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"RevenueCatPaywallService"}],"type":"topic","title":"RevenueCatPaywallService","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallService","abstract":[{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" conformer backed by RevenueCat’s "},{"code":"Purchases.shared","type":"codeVoice"},{"type":"text","text":"."}],"url":"\/documentation\/swiduxrevenuecatpaywall\/revenuecatpaywallservice","role":"symbol"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/RevenueCatPaywallService/customerInfoStream()":{"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"customerInfoStream"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:ScS","kind":"typeIdentifier","text":"AsyncStream"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV","text":"EntitlementSnapshot"},{"kind":"text","text":">"}],"type":"topic","title":"customerInfoStream()","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallService\/customerInfoStream()","abstract":[{"text":"Returns a long-lived stream of entitlement snapshots derived from","type":"text"},{"type":"text","text":" "},{"code":"Purchases.shared.customerInfoStream","type":"codeVoice"},{"type":"text","text":"."}],"url":"\/documentation\/swiduxrevenuecatpaywall\/revenuecatpaywallservice\/customerinfostream()","role":"symbol"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall":{"title":"SwiduxRevenueCatPaywall","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall","type":"topic","kind":"symbol","role":"collection","abstract":[{"type":"text","text":"RevenueCat adapter for Swidux’s "},{"code":"PaywallPlugin","type":"codeVoice"},{"type":"text","text":". Implements "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" against "},{"code":"Purchases.shared","type":"codeVoice"},{"type":"text","text":", ships a controllable mock for previews and tests, and pairs with "},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":" for drop-in "},{"code":"PaywallView","type":"codeVoice"},{"type":"text","text":" and "},{"code":"CustomerCenterView","type":"codeVoice"},{"type":"text","text":" presentation."}],"url":"\/documentation\/swiduxrevenuecatpaywall"}}}