{"topicSections":[{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/init(isPro:hasPermanentLicense:)"]},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/customerInfoError","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/restoreError"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/customerInfo()","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/customerInfoStream()","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/finish()","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/restorePurchases()","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)"]}],"kind":"symbol","relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/13SwiduxPaywall0B7ServiceP","doc:\/\/SwiduxRevenueCatPaywall\/s8SendableP","doc:\/\/SwiduxRevenueCatPaywall\/s16SendableMetatypeP"]}],"variants":[{"paths":["\/documentation\/swiduxrevenuecatpaywall\/mockrevenuecatpaywallservice"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MockRevenueCatPaywallService","kind":"identifier"}]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference"]},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"The mock tracks a "},{"type":"emphasis","inlineContent":[{"text":"current","type":"text"}]},{"type":"text","text":" snapshot: "},{"isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)","type":"reference"},{"type":"text","text":" replaces it, "},{"isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/customerInfo()","type":"reference"},{"type":"text","text":" and"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/restorePurchases()","type":"reference"},{"type":"text","text":" return it, and every "},{"isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/customerInfoStream()","type":"reference"},{"type":"text","text":" yields it first. Streams"},{"type":"text","text":" "},{"type":"text","text":"fan out — each call returns an independent stream, and "},{"isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)","type":"reference"},{"type":"text","text":" delivers to every stream"},{"type":"text","text":" "},{"type":"text","text":"that is still open — so two stores sharing one mock, or a "},{"code":"ResilientPaywallService","type":"codeVoice"},{"type":"text","text":" wrapper"},{"type":"text","text":" "},{"type":"text","text":"plus the paywall plugin, all observe the same transitions. "},{"isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/finish()","type":"reference"},{"type":"text","text":" ends the streams that"},{"type":"text","text":" "},{"type":"text","text":"are open at the time. Set "},{"isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/customerInfoError","type":"reference"},{"type":"text","text":" or "},{"isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/restoreError","type":"reference"},{"type":"text","text":" to make the corresponding"},{"type":"text","text":" "},{"type":"text","text":"call throw, e.g. to drive the plugin’s "},{"code":".refreshFailed","type":"codeVoice"},{"type":"text","text":" path or a "},{"code":"ResilientPaywallService","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"fallback."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Deliberate differences from the real "},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":", chosen so tests are"},{"type":"text","text":" "},{"type":"text","text":"deterministic:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"A stream buffers every value it has not delivered yet; the real stream keeps only the","type":"text"},{"text":" ","type":"text"},{"text":"newest. A test that sends several snapshots before its consumer runs sees each one, in order.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A new stream always yields the current snapshot first; the real stream yields a first value","type":"text"},{"text":" ","type":"text"},{"text":"only if RevenueCat has already delivered customer info in this process.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Compared with Swidux’s "},{"code":"SimulatedPaywallService","type":"codeVoice"},{"type":"text","text":" (an actor with a dev-paywall UI and simulated"},{"type":"text","text":" "},{"type":"text","text":"latency, better suited to vendor-free previews and development builds), this mock offers a"},{"type":"text","text":" "},{"type":"text","text":"synchronous "},{"isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)","type":"reference"},{"type":"text","text":", arbitrary injected errors, "},{"isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/finish()","type":"reference"},{"type":"text","text":", and delivery of repeated"},{"type":"text","text":" "},{"type":"text","text":"identical snapshots — "},{"code":"SimulatedPaywallService","type":"codeVoice"},{"type":"text","text":" drops a change that equals the current state."},{"type":"text","text":" "},{"code":"MockPaywallService","type":"codeVoice"},{"type":"text","text":" in SwiduxPaywall differs again: its stream finishes immediately after the"},{"type":"text","text":" "},{"type":"text","text":"initial yield, so it cannot drive entitlement transitions over time."}],"type":"paragraph"},{"name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Thread-safe. State lives behind a ","type":"text"},{"code":"Synchronization.Mutex","type":"codeVoice"},{"text":", so the type is checked","type":"text"},{"text":" ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" and can be shared across actors in tests and previews.","type":"text"}]}],"style":"note"}],"kind":"content"}],"sections":[],"identifier":{"url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService","interfaceLanguage":"swift"},"abstract":[{"code":"PaywallService","type":"codeVoice"},{"type":"text","text"