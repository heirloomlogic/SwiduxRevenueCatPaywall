{"kind":"symbol","sections":[],"hierarchy":{"paths":[[]]},"variants":[{"paths":["\/documentation\/swiduxrevenuecatpaywall"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"},"abstract":[{"text":"RevenueCat adapter for Swidux’s ","type":"text"},{"code":"PaywallPlugin","type":"codeVoice"},{"text":". Implements ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" against ","type":"text"},{"code":"Purchases.shared","type":"codeVoice"},{"text":", ships a controllable mock for previews and tests, and pairs with ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" for drop-in ","type":"text"},{"code":"PaywallView","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"CustomerCenterView","type":"codeVoice"},{"text":" presentation.","type":"text"}],"topicSections":[{"title":"Quickstart","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/GettingStarted"],"anchor":"Quickstart"},{"title":"How-to Guides","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest"],"anchor":"How-to-Guides"},{"title":"Reference","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/ServiceReference","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/UIComponentsReference"],"anchor":"Reference"},{"title":"Explanation","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping"],"anchor":"Explanation"},{"title":"Service Layer","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallService"],"anchor":"Service-Layer"},{"title":"Testing","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService"],"anchor":"Testing"},{"generated":true,"title":"Enumerations","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywall"],"anchor":"Enumerations"}],"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"text":" is the adapter between RevenueCat’s SDK and Swidux’s purchase-agnostic paywall plugin. The plugin owns paywall state (presentation flags, current entitlement, async progress); this package translates RevenueCat’s ","type":"text"},{"code":"CustomerInfo","type":"codeVoice"},{"text":" into the ","type":"text"},{"code":"EntitlementSnapshot","type":"codeVoice"},{"text":" the plugin expects, and surfaces the live ","type":"text"},{"code":"customerInfoStream","type":"codeVoice"},{"text":" so entitlement changes propagate without polling.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Two products ship together:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":" (the live "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" conformer) and "},{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"type":"text","text":" (a controllable preview \/ test conformer)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"revenueCatPaywall(isPresented:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"revenueCatCustomerCenter(isPresented:)"},{"type":"text","text":", drop-in SwiftUI view modifiers that wrap RevenueCatUI with platform-aware presentation, plus a "},{"type":"codeVoice","code":"revenueCatPaywall(state:send:)"},{"type":"text","text":" convenience that composes both."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The flow:","type":"text"}],"type":"paragraph"},{"code":["View → store.send(.paywall(.request(reason:)))","  → PaywallPlugin sets isPresented = true","  → revenueCatPaywall observes the change, presents RevenueCatUI.PaywallView","  → user purchases → Purchases.shared.customerInfoStream yields a new CustomerInfo","  → RevenueCatPaywallService maps it to EntitlementSnapshot","  → PaywallPlugin reduces .customerInfoUpdated, sets isPro = true","  → store.paywall.isGateSatisfied flips, gated UI unlocks"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"The plugin and the adapter stay decoupled: the plugin doesn’t know about RevenueCat, and the adapter doesn’t know about your action tree.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"symbolKind":"module","title":"SwiduxRevenueCatPaywall","role":"collection","externalID":"SwiduxRevenueCatPaywall","roleHeading":"Framework","modules":[{"name":"SwiduxRevenueCatPaywall"}]},"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/EntitlementMapping":{"kind":"article","role":"article","title":"Entitlement Mapping","type":"topic","abstract":[{"text":"How RevenueCat’s ","type":"text"},{"code":"CustomerInfo.entitlements","type":"codeVoice"},{"text":" translates to Swidux’s ","type":"text"},{"code":"EntitlementSnapshot","type