{"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"identifier":{"url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/GettingStarted","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide walks through the four steps to integrate "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"},{"type":"text","text":" into a Swidux app: add the package, configure RevenueCat, register the plugin, and attach the UI. It is the shortest path from a wired Swidux app to a working paywall. For deeper coverage of any step, follow the linked how-tos."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This package assumes you already use Swidux. If you don’t, work through Swidux’s own getting-started guide first."}]},{"type":"heading","text":"Add the Package","anchor":"Add-the-Package","level":2},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Xcode:","type":"text"}]},{"type":"text","text":" File > Add Package Dependencies, paste "},{"type":"codeVoice","code":"https:\/\/github.com\/HeirloomLogic\/SwiduxRevenueCatPaywall"},{"type":"text","text":". Add the products you need:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"text":" — the ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" implementation and mock.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" — adds the ","type":"text"},{"code":"revenueCatPaywall","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"revenueCatCustomerCenter","type":"codeVoice"},{"text":" view modifiers (depends on RevenueCatUI).","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Package.swift:","type":"text"}]}]},{"type":"codeListing","code":[".package(url: \"https:\/\/github.com\/HeirloomLogic\/SwiduxRevenueCatPaywall\", from: \"1.0.0\"),"],"syntax":"swift"},{"type":"codeListing","code":[".product(name: \"SwiduxRevenueCatPaywall\", package: \"SwiduxRevenueCatPaywall\"),",".product(name: \"SwiduxRevenueCatPaywallUI\", package: \"SwiduxRevenueCatPaywall\"),"],"syntax":"swift"},{"type":"heading","text":"Configure the paywall at launch","anchor":"Configure-the-paywall-at-launch","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":" calls into "},{"type":"codeVoice","code":"Purchases.shared"},{"type":"text","text":" under the hood. Configure the paywall before constructing the store:"}]},{"type":"codeListing","code":["\/\/ MyApp.swift","import SwiduxRevenueCatPaywall","import SwiftUI","","@main","struct MyApp: App {","    @State private var store: AppStore","","    init() {","        RevenueCatPaywall.configure(apiKey: \"your_revenuecat_api_key\")","        _store = State(wrappedValue: AppStore.configured())","    }","","    var body: some Scene {","        WindowGroup { ContentView().environment(store) }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Pass ","type":"text"},{"type":"codeVoice","code":"appUserID"},{"text":", ","type":"text"},{"type":"codeVoice","code":"userDefaults"},{"text":" (for app-group sharing with widgets), ","type":"text"},{"type":"codeVoice","code":"logLevel"},{"text":", ","type":"text"},{"type":"codeVoice","code":"entitlementVerification"},{"text":" (signed entitlement verification), or ","type":"text"},{"type":"codeVoice","code":"purchasesAreCompletedBy"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"storeKitVersion"},{"text":" (app-completed purchases) if you need them — see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywall\/configure(apiKey:appUserID:userDefaults:logLevel:entitlementVerification:purchasesAreCompletedBy:storeKitVersion:)"},{"text":".","type":"text"}]},{"type":"heading","text":"Register the paywall plugin","anchor":"Register-the-paywall-plugin","level":2},{"type":"paragraph","inlineContent":[{"text":"Pass ","type":"text"},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"PaywallPlugin","type":"codeVoice"},{"text":" in your ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory:","type":"text"}]},{"type":"codeListing","code":["import Swidux","import SwiduxPaywall","import SwiduxRevenueCatPaywall","","extension Store where State == AppState, Action == AppAction {","    static func configured() -> AppStore {","        let plugins = PluginHost<AppState, AppAction>()","","        plugins.register(","            PaywallPlugin<AppState, AppAction>(","                state: \\.paywall,","                action: AppAction.paywall,","                extractAction: { if case .paywall(let a) = $0 { return a }; return nil },","                service: ResilientPaywallService(","                    base: RevenueCatPaywallService(entitlementID: \"pro\"),","                    store: UserDefaultsKeyValueStore()","                )","            )","        )","","        return Store(","            initialState: AppState(),","            reducer: AppReducer().reduce,","            plugins: plugins","        )","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"ResilientPaywallService","type":"codeVoice"},{"text":" (from SwiduxPaywall) persists the last entitlement snapshot a successful read delivered. Without it, a slow or failing network at cold launch leaves ","type":"text"},{"code":"PaywallState","type":"codeVoice"},{"text":" at its free default and gates paying users out of their features until the first successful read; with it, the last-known-good state holds until live data arrives, and the server stays authoritative — a genuine lapse is honoured on the next successful read. Wrap the RevenueCat service in it for production.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Start the entitlement stream on the root view so the gate reflects RevenueCat’s state from launch:","type":"text"}]},{"type":"codeListing","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .task { store.send(.paywall(.observeCustomerInfo)) }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Gate features by reading ","type":"text"},{"code":"store.paywall.isGateSatisfied","type":"codeVoice"},{"text":". See ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","type":"reference","isActive":true},{"text":" for the full plugin lifecycle.","type":"text"}]},{"type":"heading","text":"Attach the UI","anchor":"Attach-the-UI","level":2},{"type":"paragraph","inlineContent":[{"text":"Attach the ","type":"text"},{"code":"revenueCatPaywall","type":"codeVoice"},{"text":" modifier to a root view, driven by paywall state:","type":"text"}]},{"type":"codeListing","code":["import SwiduxRevenueCatPaywallUI","","struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .revenueCatPaywall(state: store.paywall) { action in","                store.send(.paywall(action))","            }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Trigger the paywall from a gated feature with ","type":"text"},{"code":".paywall(.request(reason:))","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["Button(\"Export PDF\") {","    if store.paywall.isGateSatisfied {","        store.send(.export(.exportPDF))","    } else {","        store.send(.paywall(.request(reason: \"export-pdf\")))","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","type":"reference","isActive":true},{"text":" for manual wiring with the primitive modifiers, customer-center triggering, and dismiss semantics.","type":"text"}]},{"type":"heading","text":"Next Steps","anchor":"Next-Steps","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService"},{"text":" — Detailed walkthrough of the service lifecycle and error handling.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense"},{"text":" — Add a lifetime entitlement alongside the subscription.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest"},{"text":" — Drive entitlement state from previews and tests.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI"},{"text":" — Wire the bundled view modifiers.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior"},{"text":" — Why iOS and macOS behave differently.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[