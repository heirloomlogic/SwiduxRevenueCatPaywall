{"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"modules":[{"name":"SwiduxRevenueCatPaywall"}],"roleHeading":"Article","title":"How to Implement the Service","role":"article"},"kind":"article","identifier":{"url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"abstract":[{"type":"text","text":"Wire "},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":" into the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin so the store sees real-time entitlement updates from RevenueCat."}],"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/ServiceReference","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping"],"title":"Related Documentation"},{"generated":true,"anchor":"How-to-Guides","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest"],"title":"How-to Guides"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"This guide takes you from a wired Swidux app with a paywall slice to a live RevenueCat-backed entitlement pipeline. It covers SDK configuration, plugin registration, observation lifecycle, and refresh\/restore flows."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For the API-level reference of the service, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/ServiceReference"},{"type":"text","text":". For the entitlement mapping rules, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping"},{"type":"text","text":". For the upstream plugin contract — actions, state shape, dispatch semantics — see Swidux’s "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Add a Paywall"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"SwiduxPaywall Reference"}]},{"type":"text","text":"; this guide does not repeat that material."}],"type":"paragraph"},{"text":"Before you start","anchor":"Before-you-start","type":"heading","level":2},{"inlineContent":[{"text":"This guide assumes:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"You have a wired Swidux app — "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":", "},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":", "},{"code":"AppReducer","type":"codeVoice"},{"type":"text","text":", "},{"code":"AppStore","type":"codeVoice"},{"type":"text","text":" exist, and the store is in the SwiftUI environment."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Your "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" already has a "},{"type":"codeVoice","code":"paywall: PaywallState"},{"type":"text","text":" slice and your "},{"type":"codeVoice","code":"AppAction"},{"text":" has a ","type":"text"},{"type":"codeVoice","code":".paywall(PaywallAction)"},{"text":" case. If not, follow Swidux’s ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Add a Paywall","type":"text"}]},{"type":"text","text":" guide first."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You have a RevenueCat project, an API key, and at least one entitlement identifier configured in the RevenueCat dashboard."}]}]}],"type":"unorderedList"},{"level":2,"anchor":"Step-1-Add-the-dependencies","text":"Step 1: Add the dependencies","type":"heading"},{"inlineContent":[{"type":"text","text":"Add both Swift packages to your "},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/HeirloomLogic\/Swidux\", from: \"1.6.0\"),","    .package(url: \"https:\/\/github.com\/HeirloomLogic\/SwiduxRevenueCatPaywall\", from: \"1.0.0\"),","],"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the products you need to your app target:"}]},{"type":"codeListing","syntax":"swift","code":[".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxPaywall\", package: \"Swidux\"),","        .product(name: \"SwiduxRevenueCatPaywall\", package: \"SwiduxRevenueCatPaywall\"),","        .product(name: \"SwiduxRevenueCatPaywallUI\", package: \"SwiduxRevenueCatPaywall\"),","    ]",")"]},{"inlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"text":" is optional — drop it if you don’t need the bundled sheets.","type":"text"}],"type":"paragraph"},{"text":"Step 2: Configure the paywall at launch","anchor":"Step-2-Configure-the-paywall-at-launch","level":2,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":" calls into "},{"type":"codeVoice","code":"Purchases.shared"},{"type":"text","text":" under the hood. Configure the paywall before constructing the store:"}],"type":"paragraph"},{"code":["\/\/ MyApp.swift","import SwiduxRevenueCatPaywall","import SwiftUI","","@main","struct MyApp: App {","    @State private var store: AppStore","","    init() {","        RevenueCatPaywall.configure(apiKey: \"your_revenuecat_api_key\")","        _store = State(wrappedValue: AppStore.configured())","    }","","    var body: some Scene {","        WindowGroup { ContentView().environment(store) }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"If users sign in after launch, switch the purchase provider to them with "},{"type":"codeVoice","code":"RevenueCatPaywall.logIn(appUserID:)"},{"text":" and back with ","type":"text"},{"type":"codeVoice","code":"RevenueCatPaywall.logOut()"},{"text":" — like ","type":"text"},{"type":"codeVoice","code":"configure"},{"type":"text","text":", these wrappers keep the RevenueCat import out of your app target. The entitlement stream delivers the new user’s entitlements automatically. "},{"type":"codeVoice","code":"logOut()"},{"type":"text","text":" returns immediately when the current user is already anonymous; if it throws a network error, the sign-out has still taken effect, so dispatch "},{"type":"codeVoice","code":".refreshCustomerInfo"},{"text":" once connectivity returns.","type":"text"}],"type":"paragraph"},{"name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywall\/configure(apiKey:appUserID:userDefaults:logLevel:entitlementVerification:purchasesAreCompletedBy:storeKitVersion:)"},{"text":" before dispatching paywall work. Constructing ","type":"text"},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"text":" earlier is safe, but reads and restores throw ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallError\/notConfigured"},{"type":"text","text":" and the entitlement stream finishes immediately until configuration runs."}]}],"type":"aside","style":"important"},{"type":"heading","level":3,"text":"App-owned StoreKit 2 purchases","anchor":"App-owned-StoreKit-2-purchases"},{"inlineContent":[{"type":"text","text":"When the app owns purchases, configure with "},{"type":"codeVoice","code":"purchasesAreCompletedBy: .myApp"},{"type":"text","text":" and the StoreKit version the app uses. For StoreKit 2 purchases made outside the bundled paywall, report the original result before finishing a verified transaction:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import StoreKit","import SwiduxRevenueCatPaywall","","let result = try await product.purchase()","try await RevenueCatPaywall.recordPurchase(result)","","if case .success(.verified(let transaction)) = result {","    await transaction.finish()","}"]},{"type":"paragraph","inlineContent":[{"text":"The package exposes only StoreKit types. Apps do not import RevenueCat. The bundled paywall performs this reporting and finishing sequence when you pass ","type":"text"},{"code":"RevenueCatPaywallPurchaseLogic","type":"codeVoice"},{"text":"; see ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"type":"heading","level":2,"text":"Step 3: Construct the service","anchor":"Step-3-Construct-the-service"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create the service with the entitlement identifier you set up in the RevenueCat dashboard:"}]},{"type":"codeListing","code":["import SwiduxPaywall","import SwiduxRevenueCatPaywall","","let service = ResilientPaywallService(","    base: RevenueCatPaywallService(entitlementID: \"pro\"),","    store: UserDefaultsKeyValueStore()",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"ResilientPaywallService","type":"codeVoice"},{"type":"text","text":" (from SwiduxPaywall) persists the last entitlement snapshot a successful read delivered, so a slow or failing network at cold launch never gates a paying user as free — the last-known-good state holds until live data arrives, and a genuine lapse is honoured on the next successful read. The bare "},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":" works too, but for production the resilient wrapper is the right default."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your app sells a separate lifetime SKU alongside a subscription, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense"},{"text":" for the dual-entitlement form.","type":"text"}]},{"text":"Step 4: Register the paywall plugin","anchor":"Step-4-Register-the-paywall-plugin","level":2,"type":"heading"},{"inlineContent":[{"text":"Pass the service to ","type":"text"},{"code":"PaywallPlugin","type":"codeVoice"},{"text":" when wiring the store:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ AppStore.swift","import Swidux","import SwiduxPaywall","import SwiduxRevenueCatPaywall","","extension Store where State == AppState, Action == AppAction {","    static func configured() -> AppStore {","        let plugins = PluginHost<AppState, AppAction>()","","        plugins.register(","            PaywallPlugin<AppState, AppAction>(","                state: \\.paywall,","                action: AppAction.paywall,","                extractAction: { if case .paywall(let a) = $0 { return a }; return nil },","                service: ResilientPaywallService(","                    base: RevenueCatPaywallService(entitlementID: \"pro\"),","                    store: UserDefaultsKeyValueStore()","                )","            )","        )","","        return Store(","            initialState: AppState(),","            reducer: AppReducer().reduce,","            plugins: plugins","        )","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The plugin owns reducing for "},{"type":"codeVoice","code":".paywall"},{"type":"text","text":" actions; your root reducer should fall through with "},{"code":"return nil","type":"codeVoice"},{"type":"text","text":" for that case."}],"type":"paragraph"},{"text":"Step 5: Observe customer info on launch","anchor":"Step-5-Observe-customer-info-on-launch","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Start the entitlement stream once, on the root view:"}]},{"code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .task {","                store.send(.paywall(.observeCustomerInfo))","                store.send(.paywall(.refreshCustomerInfo))","            }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":"observeCustomerInfo","type":"codeVoice"},{"text":" returns a long-lived effect that consumes ","type":"text"},{"code":"RevenueCatPaywallService.customerInfoStream()","type":"codeVoice"},{"text":". Every snapshot the service yields flows through ","type":"text"},{"code":".customerInfoUpdated","type":"codeVoice"},{"text":" and updates ","type":"text"},{"code":"store.paywall.isPro","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"hasPermanentLicense","type":"codeVoice"},{"text":". The effect lives for the duration of the stream, so the store stays in sync with RevenueCat without polling.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The accompanying ","type":"text"},{"code":"refreshCustomerInfo","type":"codeVoice"},{"text":" seeds the state. A new stream yields the customer info RevenueCat last delivered in this process, but RevenueCat may not have delivered one yet — on a relaunch with a fresh cache it skips the launch fetch — and the stream then stays silent until the next change.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If observation starts before configuration, the stream finishes. Swidux 1.9 and later clears its observation guard at that point. After configuring RevenueCat, dispatch both ","type":"text"},{"code":".observeCustomerInfo","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".refreshCustomerInfo","type":"codeVoice"},{"text":" again; the new stream uses ","type":"text"},{"code":"Purchases.shared","type":"codeVoice"},{"text":" and the refresh seeds current state.","type":"text"}],"type":"paragraph"},{"text":"Step 6: Gate features","anchor":"Step-6-Gate-features","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read "},{"code":"store.paywall.isGateSatisfied","type":"codeVoice"},{"text":" before running gated work. If it’s ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", dispatch ","type":"text"},{"code":".request(reason:)","type":"codeVoice"},{"text":" instead:","type":"text"}]},{"syntax":"swift","code":["Button(\"Export PDF\") {","    if store.paywall.isGateSatisfied {","        store.send(.export(.exportPDF))","    } else {","        store.send(.paywall(.request(reason: \"export-pdf\")))","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isGateSatisfied"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"true"},{"type":"text","text":" when the user holds an active pro subscription "},{"type":"strong","inlineContent":[{"text":"or","type":"text"}]},{"type":"text","text":" a permanent license — feature code does not need to know which."}]},{"text":"Step 7: Wire the UI","anchor":"Step-7-Wire-the-UI","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"To present "},{"type":"codeVoice","code":"RevenueCatUI.PaywallView"},{"type":"text","text":" and the customer center, attach the bundled modifier once to one app-wide presentation host. See "},{"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","isActive":true},{"type":"text","text":"."}]},{"text":"Step 8: Restore purchases","anchor":"Step-8-Restore-purchases","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Add a restore button to your paywall UI. Reflect ","type":"text"},{"type":"codeVoice","code":"store.paywall.isLoading"},{"text":" to disable it while the call is in flight:","type":"text"}]},{"syntax":"swift","code":["Button(\"Restore Purchases\") {","    store.send(.paywall(.restorePurchases))","}",".disabled(store.paywall.isLoading)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The plugin calls ","type":"text"},{"code":"RevenueCatPaywallService.restorePurchases()","type":"codeVoice"},{"type":"text","text":", which forwards to RevenueCat’s user-initiated "},{"code":"restorePurchases()","type":"codeVoice"},{"type":"text","text":" flow in both completion modes. That flow refreshes the App Store receipt before posting transactions, so it can recover subscriptions missing from the device receipt. On success the resulting snapshot flows through "},{"code":".customerInfoUpdated","type":"codeVoice"},{"type":"text","text":" and updates the gate. On failure, "},{"code":"store.paywall.error","type":"codeVoice"},{"text":" is set.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"syncPurchases()"},{"text":" remains useful for background migration after login, but it reads only the receipt already on the device and can alias or transfer purchases under the RevenueCat project’s restore behavior. It is not the implementation of the explicit Restore Purchases action.","type":"text"}]},{"anchor":"Step-9-Handle-errors","type":"heading","level":2,"text":"Step 9: Handle errors"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before RevenueCat is configured, reads and restores throw "},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallError\/notConfigured","type":"reference","isActive":true},{"type":"text","text":". Configured calls can throw errors from "},{"type":"codeVoice","code":"Purchases.shared"},{"type":"text","text":", including "},{"type":"codeVoice","code":"ErrorCode.networkError"},{"type":"text","text":" and "},{"code":".offlineConnectionError","type":"codeVoice"},{"text":". The plugin catches either kind and dispatches ","type":"text"},{"code":".refreshFailed(message)","type":"codeVoice"},{"text":". Read ","type":"text"},{"code":"store.paywall.error","type":"codeVoice"},{"text":" from your paywall view to surface a retry affordance:","type":"text"}]},{"syntax":"swift","code":["if let error = store.paywall.error {","    Text(error)","        .foregroundStyle(.red)","    Button(\"Retry\") {","        store.send(.paywall(.refreshCustomerInfo))","    }","}"],"type":"codeListing"}]}],"variants":[{"paths":["\/documentation\/swiduxrevenuecatpaywall\/howtoimplementservice"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/ServiceReference":{"url":"\/documentation\/swiduxrevenuecatpaywall\/servicereference","kind":"article","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/ServiceReference","abstract":[{"text":"API reference for ","type":"text"},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":" — the RevenueCat-backed ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" conformer that the paywall plugin consumes.","type":"text"}],"type":"topic","role":"article","title":"Service Reference"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToPresentTheUI":{"role":"article","url":"\/documentation\/swiduxrevenuecatpaywall\/howtopresenttheui","type":"topic","kind":"article","abstract":[{"type":"text","text":"Attach the "},{"type":"codeVoice","code":"revenueCatPaywall"},{"type":"text","text":" and "},{"type":"codeVoice","code":"revenueCatCustomerCenter"},{"text":" view modifiers from ","type":"text"},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"text":" to a root view, driven by ","type":"text"},{"type":"codeVoice","code":"PaywallState"},{"text":".","type":"text"}],"title":"How to Present the UI","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/RevenueCatPaywall/configure(apiKey:appUserID:userDefaults:logLevel:entitlementVerification:purchasesAreCompletedBy:storeKitVersion:)":{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywall\/configure(apiKey:appUserID:userDefaults:logLevel:entitlementVerification:purchasesAreCompletedBy:storeKitVersion:)","type":"topic","abstract":[{"type":"text","text":"Configures the underlying purchase provider."}],"title":"configure(apiKey:appUserID:userDefaults:logLevel:entitlementVerification:purchasesAreCompletedBy:storeKitVersion:)","kind":"symbol","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"configure","kind":"identifier"},{"text":"(","kind":"text"},{"text":"apiKey","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"appUserID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"userDefaults","kind":"externalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"c:objc(cs)NSUserDefaults","kind":"typeIdentifier","text":"UserDefaults"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"logLevel"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:23SwiduxRevenueCatPaywall0bcD0O","text":"RevenueCatPaywall","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"LogLevel","preciseIdentifier":"s:23SwiduxRevenueCatPaywall0bcD0O8LogLevelO","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"entitlementVerification","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"RevenueCatPaywall","preciseIdentifier":"s:23SwiduxRevenueCatPaywall0bcD0O"},{"text":".","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:23SwiduxRevenueCatPaywall0bcD0O23EntitlementVerificationO","text":"EntitlementVerification"},{"kind":"text","text":", "},{"kind":"externalParam","text":"purchasesAreCompletedBy"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:23SwiduxRevenueCatPaywall0bcD0O","text":"RevenueCatPaywall"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:23SwiduxRevenueCatPaywall0bcD0O20PurchasesCompletedByO","text":"PurchasesCompletedBy"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"storeKitVersion"},{"kind":"text","text":": "},{"preciseIdentifier":"s:23SwiduxRevenueCatPaywall0bcD0O","text":"RevenueCatPaywall","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"StoreKitVersion","preciseIdentifier":"s:23SwiduxRevenueCatPaywall0bcD0O15StoreKitVersionO","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"url":"\/documentation\/swiduxrevenuecatpaywall\/revenuecatpaywall\/configure(apikey:appuserid:userdefaults:loglevel:entitlementverification:purchasesarecompletedby:storekitversion:)"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall":{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall","type":"topic","abstract":[{"text":"RevenueCat adapter for Swidux’s ","type":"text"},{"code":"PaywallPlugin","type":"codeVoice"},{"text":". Implements ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" against ","type":"text"},{"code":"Purchases.shared","type":"codeVoice"},{"type":"text","text":", ships a controllable mock for previews and tests, and pairs with "},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":" for drop-in "},{"code":"PaywallView","type":"codeVoice"},{"type":"text","text":" and "},{"code":"CustomerCenterView","type":"codeVoice"},{"type":"text","text":" presentation."}],"title":"SwiduxRevenueCatPaywall","kind":"symbol","role":"collection","url":"\/documentation\/swiduxrevenuecatpaywall"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToPreviewAndTest":{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest","title":"How to Preview and Test","role":"article","abstract":[{"type":"text","text":"Drive entitlement state from SwiftUI previews and tests with "},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":" — no RevenueCat SDK call required."}],"url":"\/documentation\/swiduxrevenuecatpaywall\/howtopreviewandtest","kind":"article","type":"topic"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/RevenueCatPaywallError/notConfigured":{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallError\/notConfigured","title":"RevenueCatPaywallError.notConfigured","role":"symbol","abstract":[{"type":"text","text":"RevenueCat has not been configured, so the requested operation cannot start."}],"url":"\/documentation\/swiduxrevenuecatpaywall\/revenuecatpaywallerror\/notconfigured","kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"notConfigured"}],"type":"topic"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToAddAPermanentLicense":{"role":"article","kind":"article","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","type":"topic","abstract":[{"text":"Sell a lifetime entitlement alongside a subscription and surface both flags through the paywall plugin.","type":"text"}],"title":"How to Add a Permanent License","url":"\/documentation\/swiduxrevenuecatpaywall\/howtoaddapermanentlicense"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/EntitlementMapping":{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping","type":"topic","abstract":[{"type":"text","text":"How RevenueCat’s "},{"code":"CustomerInfo.entitlements","type":"codeVoice"},{"type":"text","text":" translates to Swidux’s "},{"code":"EntitlementSnapshot","type":"codeVoice"},{"text":".","type":"text"}],"title":"Entitlement Mapping","kind":"article","role":"article","url":"\/documentation\/swiduxrevenuecatpaywall\/entitlementmapping"}}}