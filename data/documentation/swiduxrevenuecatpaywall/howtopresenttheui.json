{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":" ships three view modifiers that wrap RevenueCatUI’s surfaces with platform-aware presentation. Each is bound to "},{"type":"codeVoice","code":"PaywallState"},{"type":"text","text":": presentation flags drive visibility, and the bindings dispatch matching paywall actions back through the store on dismissal. There is no local sheet state."}]},{"type":"paragraph","inlineContent":[{"text":"For platform behavior details (iOS ","type":"text"},{"code":"fullScreenCover","type":"codeVoice"},{"text":" vs macOS sheet sizing, App Store deep link on macOS), see ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","type":"reference","isActive":true},{"text":".","type":"text"}]},{"anchor":"Before-you-start","level":2,"type":"heading","text":"Before you start"},{"type":"paragraph","inlineContent":[{"text":"This guide assumes:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You have completed "},{"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","isActive":true},{"type":"text","text":". The plugin is registered and "},{"type":"codeVoice","code":"observeCustomerInfo"},{"type":"text","text":" runs on launch."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Your app target depends on the "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":" product:"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"codeListing","code":[".product(name: \"SwiduxRevenueCatPaywallUI\", package: \"SwiduxRevenueCatPaywall\"),"],"syntax":"swift"},{"level":2,"anchor":"Step-1-Attach-both-sheets-to-a-root-view","type":"heading","text":"Step 1: Attach both sheets to a root view"},{"inlineContent":[{"type":"text","text":"The simplest wiring uses the "},{"type":"codeVoice","code":"revenueCatPaywall(state:send:)"},{"type":"text","text":" modifier — one call, both sheets, both dismissals:"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiduxRevenueCatPaywallUI","","struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .revenueCatPaywall(state: store.paywall) { action in","                store.send(.paywall(action))","            }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The closure receives a "},{"type":"codeVoice","code":"PaywallAction"},{"type":"text","text":" ("},{"type":"codeVoice","code":".dismiss"},{"type":"text","text":" or "},{"type":"codeVoice","code":".dismissCustomerCenter"},{"type":"text","text":") and lifts it into your root action. Place the modifier on the topmost view that should host both sheets."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Both paywall modifiers also accept "},{"code":"displayCloseButton:","type":"codeVoice"},{"type":"text","text":" (default "},{"code":"true","type":"codeVoice"},{"type":"text","text":"). The default presentation has no other way out — see "},{"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","isActive":true},{"type":"text","text":" before turning it off."}],"type":"paragraph"},{"anchor":"Step-2-Trigger-the-paywall-from-a-feature","text":"Step 2: Trigger the paywall from a feature","type":"heading","level":2},{"inlineContent":[{"text":"Dispatch ","type":"text"},{"code":".request(reason:)","type":"codeVoice"},{"text":" with a short identifier describing why you’re asking. ","type":"text"},{"code":"PaywallState.requestedReason","type":"codeVoice"},{"text":" stores the value for your own code — analytics, or a custom paywall. The bundled RevenueCatUI paywall does not read it:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["Button(\"Export PDF\") {","    store.send(.paywall(.request(reason: \"export-pdf\")))","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The plugin sets "},{"code":"PaywallState.isPresented = true","type":"codeVoice"},{"type":"text","text":". The "},{"code":"revenueCatPaywall","type":"codeVoice"},{"type":"text","text":" modifier observes the change and presents "},{"type":"codeVoice","code":"RevenueCatUI.PaywallView"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Step-3-Trigger-the-customer-center","text":"Step 3: Trigger the customer center"},{"type":"paragraph","inlineContent":[{"text":"Existing subscribers manage their subscription through the customer center. Surface a button that dispatches ","type":"text"},{"code":".presentCustomerCenter","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["if store.paywall.isPro {","    Button(\"Manage Subscription\") {","        store.send(.paywall(.presentCustomerCenter))","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"revenueCatCustomerCenter","type":"codeVoice"},{"text":" modifier presents ","type":"text"},{"code":"RevenueCatUI.CustomerCenterView","type":"codeVoice"},{"text":" on iOS. On macOS it opens the system App Store subscriptions URL and immediately fires ","type":"text"},{"code":"onDismiss","type":"codeVoice"},{"text":" (RevenueCatUI does not ship a customer center on macOS — see ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","type":"reference","isActive":true},{"text":").","type":"text"}]},{"level":2,"type":"heading","anchor":"Step-4-Manual-wiring-optional","text":"Step 4: Manual wiring (optional)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you need only one sheet, or you want to interleave other modifiers between them, attach the primitive modifiers directly. Each takes a real "},{"type":"codeVoice","code":"Binding<Bool>"},{"type":"text","text":"; build it with a "},{"type":"codeVoice","code":"set:"},{"type":"text","text":" that dispatches the matching dismiss action when SwiftUI clears the flag:"}]},{"type":"codeListing","syntax":"swift","code":["ContentView()","    .revenueCatPaywall(","        isPresented: Binding(","            get: { store.paywall.isPresented },","            set: { if !$0 { store.send(.paywall(.dismiss)) } }","        )","    )","    .revenueCatCustomerCenter(","        isPresented: Binding(","            get: { store.paywall.isCustomerCenterPresented },","            set: { if !$0 { store.send(.paywall(.dismissCustomerCenter)) } }","        )","    )"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The convenience modifier "},{"type":"codeVoice","code":"revenueCatPaywall(state:send:)"},{"type":"text","text":" attaches this wiring and adds two rules the manual version lacks: the paywall and customer center never show at once, and the paywall closes itself after a restore that leaves the user entitled (see below)."}]},{"level":2,"type":"heading","anchor":"Step-5-Restore-from-inside-the-paywall","text":"Step 5: Restore from inside the paywall"},{"type":"paragraph","inlineContent":[{"text":"RevenueCatUI’s ","type":"text"},{"code":"PaywallView","type":"codeVoice"},{"text":" provides its own restore button by default. If you need an additional restore affordance elsewhere (a Settings row, for example), dispatch ","type":"text"},{"code":".restorePurchases","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["Button(\"Restore Purchases\") {","    store.send(.paywall(.restorePurchases))","}",".disabled(store.paywall.isLoading)"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"What-happens-on-dismiss","type":"heading","text":"What happens on dismiss"},{"inlineContent":[{"type":"text","text":"When the user dismisses the paywall, the plugin’s "},{"code":".dismiss","type":"codeVoice"},{"type":"text","text":" action clears "},{"code":"PaywallState.isPresented","type":"codeVoice"},{"type":"text","text":" and "},{"code":"requestedReason","type":"codeVoice"},{"type":"text","text":", then dispatches "},{"code":".refreshCustomerInfo","type":"codeVoice"},{"type":"text","text":" so the gate is reconciled — the user may have purchased while the sheet was open."}],"type":"paragraph"},{"inlineContent":[{"text":"RevenueCatUI dismisses the paywall itself after a purchase, but not after a restore. The convenience modifier closes it for you: once RevenueCatUI reports the restore complete (after the user acknowledges its success alert) and ","type":"text"},{"code":"PaywallState.isGateSatisfied","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", it dispatches ","type":"text"},{"code":".dismiss","type":"codeVoice"},{"text":". The entitlement arrives through the live stream, so keep ","type":"text"},{"code":".observeCustomerInfo","type":"codeVoice"},{"text":" running. With the manual wiring, nothing closes the paywall after a restore — a user who restores behind a hard paywall (","type":"text"},{"code":"displayCloseButton: false","type":"codeVoice"},{"text":") has no way out, so use the convenience modifier there.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When the user dismisses the customer center, the plugin’s ","type":"text"},{"type":"codeVoice","code":".dismissCustomerCenter"},{"text":" action clears ","type":"text"},{"type":"codeVoice","code":"isCustomerCenterPresented"},{"text":". No refresh is dispatched, since opening the customer center does not change entitlement state by itself; the live ","type":"text"},{"type":"codeVoice","code":"customerInfoStream"},{"text":" from ","type":"text"},{"type":"codeVoice","code":"Step 5"},{"text":" of ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","isActive":true,"type":"reference"},{"text":" picks up any subscription change RevenueCat reports asynchronously.","type":"text"}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI"},"metadata":{"roleHeading":"Article","role":"article","title":"How to Present the UI","modules":[{"name":"SwiduxRevenueCatPaywall"}]},"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"abstract":[{"type":"text","text":"Attach the "},{"type":"codeVoice","code":"revenueCatPaywall"},{"type":"text","text":" and "},{"type":"codeVoice","code":"revenueCatCustomerCenter"},{"type":"text","text":" view modifiers from "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":" to a root view, driven by "},{"type":"codeVoice","code":"PaywallState"},{"type":"text","text":"."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"article","seeAlsoSections":[{"abstract":[{"type":"text","text":"The matching API reference for the views described here lives in the "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":" documentation."}],"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService"]},{"anchor":"How-to-Guides","title":"How-to Guides","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest"],"generated":true}],"variants":[{"paths":["\/documentation\/swiduxrevenuecatpaywall\/howtopresenttheui"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/PlatformBehavior":{"abstract":[{"type":"text","text":"Why the "},{"type":"codeVoice","code":"revenueCatPaywall"},{"type":"text","text":" and "},{"type":"codeVoice","code":"revenueCatCustomerCenter"},{"type":"text","text":" modifiers present differently on iOS and macOS, and what is hard-coded."}],"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","role":"article","title":"Platform Behavior","url":"\/documentation\/swiduxrevenuecatpaywall\/platformbehavior","kind":"article","type":"topic"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToAddAPermanentLicense":{"abstract":[{"text":"Sell a lifetime entitlement alongside a subscription and surface both flags through the paywall plugin.","type":"text"}],"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","role":"article","title":"How to Add a Permanent License","url":"\/documentation\/swiduxrevenuecatpaywall\/howtoaddapermanentlicense","kind":"article","type":"topic"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToPreviewAndTest":{"abstract":[{"type":"text","text":"Drive entitlement state from SwiftUI previews and tests with "},{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"type":"text","text":" — no RevenueCat SDK call required."}],"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest","role":"article","title":"How to Preview and Test","url":"\/documentation\/swiduxrevenuecatpaywall\/howtopreviewandtest","kind":"article","type":"topic"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall":{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall","abstract":[{"text":"RevenueCat adapter for Swidux’s ","type":"text"},{"code":"PaywallPlugin","type":"codeVoice"},{"text":". Implements ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" against ","type":"text"},{"code":"Purchases.shared","type":"codeVoice"},{"text":", ships a controllable mock for previews and tests, and pairs with ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":" for drop-in "},{"code":"PaywallView","type":"codeVoice"},{"type":"text","text":" and "},{"code":"CustomerCenterView","type":"codeVoice"},{"type":"text","text":" presentation."}],"role":"collection","title":"SwiduxRevenueCatPaywall","url":"\/documentation\/swiduxrevenuecatpaywall","kind":"symbol","type":"topic"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToImplementService":{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","abstract":[{"text":"Wire ","type":"text"},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"text":" into the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" plugin so the store sees real-time entitlement updates from RevenueCat.","type":"text"}],"title":"How to Implement the Service","role":"article","type":"topic","url":"\/documentation\/swiduxrevenuecatpaywall\/howtoimplementservice","kind":"article"}}}