\/EntitlementMapping","type":"topic","kind":"article","role":"article","abstract":[{"type":"text","text":"How RevenueCat’s "},{"code":"CustomerInfo.entitlements","type":"codeVoice"},{"type":"text","text":" translates to Swidux’s "},{"code":"EntitlementSnapshot","type":"codeVoice"},{"type":"text","text":"."}],"url":"\/documentation\/swiduxrevenuecatpaywall\/entitlementmapping"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToPresentTheUI":{"kind":"article","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","abstract":[{"text":"Attach ","type":"text"},{"type":"codeVoice","code":"revenueCatPaywallAndCustomerCenter"},{"text":" from ","type":"text"},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"text":" to a root view to present both surfaces from ","type":"text"},{"type":"codeVoice","code":"PaywallState"},{"text":", or attach either binding-driven primitive by itself.","type":"text"}],"title":"How to Present the UI","role":"article","type":"topic","url":"\/documentation\/swiduxrevenuecatpaywall\/howtopresenttheui"}}}