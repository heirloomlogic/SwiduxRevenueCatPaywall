c, ","kind":"text"},{"text":"purchaseLogic","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywallUI\/documentation\/SwiduxRevenueCatPaywallUI\/RevenueCatPaywallPurchaseLogic","text":"RevenueCatPaywallPurchaseLogic","preciseIdentifier":"s:25SwiduxRevenueCatPaywallUI0bcD13PurchaseLogicV","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"onEvent","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywallUI\/documentation\/SwiduxRevenueCatPaywallUI\/RevenueCatPaywallEventHandler","text":"RevenueCatPaywallEventHandler","preciseIdentifier":"s:25SwiduxRevenueCatPaywallUI0bcD12EventHandlera","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"onAction","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"(","kind":"text"},{"text":"PaywallAction","preciseIdentifier":"s:13SwiduxPaywall0B6ActionO","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier"},{"text":"\n","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"name":"state","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The paywall slice from your store, typically "},{"type":"codeVoice","code":"store.paywall"},{"type":"text","text":"."}]}]},{"name":"offeringIdentifier","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Explicit RevenueCat offering identifier. When omitted, "},{"type":"codeVoice","code":"state.requestedReason"},{"type":"text","text":" is used as a RevenueCat placement. RevenueCat may return the dashboard’s placement fallback offering, which can differ from the current offering; the package uses the current offering when no placement fallback is configured. An unknown explicit identifier asserts in Debug, logs a warning, and falls back."}]}]},{"name":"displayCloseButton","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether "},{"type":"codeVoice","code":"PaywallView"},{"type":"text","text":" shows a close button. Defaults to "},{"type":"codeVoice","code":"true"},{"type":"text","text":"; when "},{"type":"codeVoice","code":"false"},{"type":"text","text":", iOS sheets disable interactive dismissal, and the iOS full-screen cover and macOS sheet provide no other dismissal affordance. Pass "},{"type":"codeVoice","code":"false"},{"type":"text","text":" only for a hard paywall the user must purchase through."}]}]},{"name":"fonts","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"RevenueCatUI font provider used by the paywall."}]}]},{"name":"presentationStyle","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Automatic or explicit iOS presentation style. macOS always uses a sheet."}]}]},{"name":"purchaseLogic","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"App-owned StoreKit 2 purchase and restore operations for "},{"type":"codeVoice","code":".myApp"},{"type":"text","text":" mode. Leave "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when RevenueCat completes purchases."}]}]},{"name":"onEvent","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional callback for package-owned purchase, restore, cancellation, and failure values."}]}]},{"name":"onAction","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A closure that lifts a "},{"type":"codeVoice","code":"PaywallAction"},{"type":"text","text":" into your root action and dispatches it, for example "},{"type":"codeVoice","code":"{ store.send(.paywall($0)) }"},{"type":"text","text":"."}]}]}],"kind":"parameters"},{"kind":"content","content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"inlineContent":[{"type":"text","text":"A view with paywall and customer-center presentation attached."}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Convenience modifier that composes paywall and customer-center presentation in one call. Presentation changes dispatch their matching paywall actions through "},{"type":"codeVoice","code":"onAction"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"On iOS the two presentations are mutually exclusive and the paywall wins. On macOS a customer-center request dispatches "},{"type":"codeVoice","code":".openManageSubscriptions"},{"type":"text","text":" through the paywall plugin, then "},{"type":"codeVoice","code":".dismissCustomerCenter"},{"type":"text","text":"; the external App Store hand-off does not compete with the paywall sheet."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Attach this modifier once, to one app-wide presentation host. Attaching it to every "},{"type":"codeVoice","code":"WindowGroup"},{"type":"text","text":" scene or window causes every attachment to respond to the same "},{"type":"codeVoice","code":"PaywallState"},{"type":"text","text":" request."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"After a restore inside the paywall, the modifier dispatches "},{"type":"codeVoice","code":".dismiss"},{"type":"text","text":" once"},{"type":"text","text":" "},{"type":"codeVoice","code":"PaywallState.isGateSatisfied"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":", since RevenueCatUI does not dismiss after a"},{"type":"text","text":" "},{"type":"text","text":"restore on its own. This relies on the entitlement stream: dispatch"},{"type":"text","text":" "},{"type":"codeVoice","code":".observeCustomerInfo"},{"type":"text","text":" at launch."}],"type":"paragraph"},{"syntax":"sw