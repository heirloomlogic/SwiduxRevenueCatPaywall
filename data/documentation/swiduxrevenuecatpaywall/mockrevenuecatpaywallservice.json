{"topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/init(isPro:hasPermanentLicense:)"],"anchor":"Initializers"},{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/customerInfoError","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/restoreError"],"anchor":"Instance-Properties"},{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/customerInfo()","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/customerInfoStream()","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/finish()","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/restorePurchases()","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)"],"anchor":"Instance-Methods"}],"abstract":[{"type":"codeVoice","code":"PaywallService"},{"text":" conformer for previews and tests with a controllable entitlement stream.","type":"text"}],"identifier":{"url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MockRevenueCatPaywallService"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference"]},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The mock tracks a ","type":"text"},{"inlineContent":[{"text":"current","type":"text"}],"type":"emphasis"},{"text":" snapshot: ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)","isActive":true,"type":"reference"},{"type":"text","text":" replaces it, "},{"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/customerInfo()","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/restorePurchases()","isActive":true},{"type":"text","text":" return it, and every "},{"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/customerInfoStream()","isActive":true},{"type":"text","text":" yields it first. Streams"},{"type":"text","text":" "},{"type":"text","text":"fan out — each call returns an independent stream, and "},{"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)","isActive":true},{"type":"text","text":" delivers to every stream"},{"type":"text","text":" "},{"type":"text","text":"that is still open — so two stores sharing one mock, or a "},{"type":"codeVoice","code":"ResilientPaywallService"},{"type":"text","text":" wrapper"},{"type":"text","text":" "},{"type":"text","text":"plus the paywall plugin, all observe the same transitions. "},{"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/finish()","isActive":true},{"type":"text","text":" ends the streams that"},{"type":"text","text":" "},{"type":"text","text":"are open at the time. Set "},{"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/customerInfoError","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/restoreError","isActive":true},{"type":"text","text":" to make the corresponding"},{"type":"text","text":" "},{"type":"text","text":"call throw, e.g. to drive the plugin’s "},{"type":"codeVoice","code":".refreshFailed"},{"type":"text","text":" path or a "},{"type":"codeVoice","code":"ResilientPaywallService"},{"type":"text","text":" "},{"type":"text","text":"fallback."}]},{"inlineContent":[{"type":"text","text":"Deliberate differences from the real "},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":", chosen so tests are"},{"type":"text","text":" "},{"type":"text","text":"deterministic:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A stream buffers every value it has not delivered yet; the real stream keeps only the"},{"type":"text","text":" "},{"type":"text","text":"newest. A test that sends several snapshots before its consumer runs sees each one, in order."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A new stream always yields the current snapshot first; the real stream yields a first value"},{"type":"text","text":" "},{"type":"text","text":"only if RevenueCat has already delivered customer info in this process."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Compared with Swidux’s "},{"type":"codeVoice","code":"SimulatedPaywallService"},{"type":"text","text":" (an actor with a dev-paywall UI and simulated"},{"type":"text","text":" "},{"type":"text","text":"latency, better suited to vendor-free previews and development builds), this mock offers a"},{"text":" ","type":"text"},{"type":"text","text":"synchronous "},{"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)","isActive":true},{"type":"text","text":", arbitrary injected errors, "},{"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/finish()","isActive":true},{"type":"text","text":", and delivery of repeated"},{"type":"text","text":" "},{"type":"text","text":"identical snapshots — "},{"type":"codeVoice","code":"SimulatedPaywallService"},{"type":"text","text":" drops a change that equals the current state."},{"type":"text","text":" "},{"type":"codeVoice","code":"MockPaywallService"},{"type":"text","text":" in SwiduxPaywall differs again: its stream finishes immediately after the"},{"type":"text","text":" "},{"text":"initial yield, so it cannot drive entitlement transitions over time.","type":"text"}],"type":"paragraph"},{"name":"Note","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Thread-safe. State lives behind a "},{"code":"Synchronization.Mutex","type":"codeVoice"},{"type":"text","text":", so the type is checked"},{"type":"text","text":" "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" and can be shared across actors in tests and previews."}]}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MockRevenueCatPaywallService"}],"modules":[{"name":"SwiduxRevenueCatPaywall"}],"role":"symbol","roleHeading":"Class","externalID":"s:23SwiduxRevenueCatPaywall04MockbcD7ServiceC","navigatorTitle":[{"text":"MockRevenueCatPaywallService","kind":"identifier"}],"title":"MockRevenueCatPaywallService","symbolKind":"class"},"sections":[],"kind":"symbol","