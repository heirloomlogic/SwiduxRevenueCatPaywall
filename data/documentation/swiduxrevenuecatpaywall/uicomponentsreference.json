{"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The UI product layers three view modifiers on top of "},{"code":"RevenueCatUI","type":"codeVoice"},{"type":"text","text":". Two primitives present the paywall and customer center directly from a "},{"code":"Binding<Bool>","type":"codeVoice"},{"type":"text","text":"; one convenience modifier composes both, driven by "},{"code":"PaywallState","type":"codeVoice"},{"type":"text","text":". Each presentation modifier attaches to the modified content view directly — there are no "},{"code":"View","type":"codeVoice"},{"type":"text","text":" wrappers and no "},{"code":".background { … }","type":"codeVoice"},{"type":"text","text":" indirection. This shape is what makes the macOS sheet machinery present reliably."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For step-by-step wiring, see "},{"type":"emphasis","inlineContent":[{"text":"How to Present the UI","type":"text"}]},{"type":"text","text":" in the "},{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"type":"text","text":" documentation. For the rationale behind platform-specific behavior, see "},{"type":"emphasis","inlineContent":[{"text":"Platform Behavior","type":"text"}]},{"type":"text","text":" in the same catalog."}],"type":"paragraph"},{"level":2,"anchor":"Library-target","text":"Library target","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Product: "},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Import: "},{"code":"import SwiduxRevenueCatPaywallUI","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"code":[".product(name: \"SwiduxRevenueCatPaywallUI\", package: \"SwiduxRevenueCatPaywall\"),"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The UI product depends on "},{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"type":"text","text":" and "},{"code":"RevenueCatUI","type":"codeVoice"},{"type":"text","text":", both pulled in transitively. Apps that don’t ship paywall UI in the same target (for example, a tests-only target) can depend on the lower-level "},{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"type":"text","text":" product alone."}],"type":"paragraph"},{"level":2,"anchor":"Modifiers","text":"Modifiers","type":"heading"},{"level":3,"anchor":"revenueCatPaywallisPresentedofferingIdentifierdisplayCloseButtonpurchaseLogiconDismiss","text":"`revenueCatPaywall(isPresented:offeringIdentifier:displayCloseButton:purchaseLogic:onDismiss:)`","type":"heading"},{"code":["extension View {","    public func revenueCatPaywall(","        isPresented: Binding<Bool>,","        offeringIdentifier: String? = nil,","        displayCloseButton: Bool = true,","        purchaseLogic: RevenueCatPaywallPurchaseLogic? = nil,","        onDismiss: (() -> Void)? = nil","    ) -> some View","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Attaches "},{"code":"RevenueCatUI.PaywallView","type":"codeVoice"},{"type":"text","text":" as a platform-appropriate sheet."}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"iOS","type":"text"}],"type":"strong"},{"type":"text","text":" — Presents in a "},{"code":"fullScreenCover","type":"codeVoice"},{"type":"text","text":" so the paywall takes the full screen."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"macOS","type":"text"}],"type":"strong"},{"type":"text","text":" — Presents in a "},{"code":"sheet","type":"codeVoice"},{"type":"text","text":" sized to a 400×600 minimum."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Pass a real two-way binding; SwiftUI sets it to "},{"code":"false","type":"codeVoice"},{"type":"text","text":" on user dismissal. Build it from "},{"code":"PaywallState.isPresented","type":"codeVoice"},{"type":"text","text":" so the "},{"code":"set:","type":"codeVoice"},{"type":"text","text":" closure dispatches "},{"code":".paywall(.dismiss)","type":"codeVoice"},{"type":"text","text":" and the plugin clears its presentation state."}],"type":"paragraph"},{"level":4,"anchor":"Parameters","text":"Parameters","type":"heading"},{"items":[{"content":[{"inlineContent":[{"code":"isPresented","type":"codeVoice"},{"type":"text","text":" — Two-way binding to the paywall’s visibility flag."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"offeringIdentifier","type":"codeVoice"},{"type":"text","text":" — Identifier of the RevenueCat offering to present, for a win-back or regional offer. Defaults to "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", which presents the dashboard’s current offering. An unknown identifier or a failed fetch falls back to the current offering with a logged warning."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"displayCloseButton","type":"codeVoice"},{"type":"text","text":" — Whether "},{"code":"PaywallView","type":"codeVoice"},{"type":"text","text":" shows a close button. Defaults to "},{"code":"true","type":"codeVoice"},{"type":"text","text":". Neither the iOS "},{"code":"fullScreenCover","type":"codeVoice"},{"type":"text","text":" nor the macOS "},{"code":"sheet","type":"codeVoice"},{"type":"text","text":" offers any other dismissal affordance, so pass "},{"code":"false","type":"codeVoice"},{"type":"text","text":" only for a hard paywall the user must purchase through."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"purchaseLogic","type":"codeVoice"},{"type":"text","text":" — App-owned StoreKit 2 purchase and restore operations for "},{"code":"purchasesAreCompletedBy: .myApp","type":"codeVoice"},{"type":"text","text":". Leave "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" when RevenueCat completes purchases."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"onDismiss","type":"codeVoice"},{"type":"text","text":" — Optional callback fired after dismissal."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"anchor":"revenueCatCustomerCenterisPresentedonDismiss","text":"`revenueCatCustomerCenter(isPresented:onDismiss:)`","type":"heading"},{"code":["extension View {","    public func revenueCatCustomerCenter(","        isPresented: Binding<Bool>,","        onDismiss: (() -> Void)? = nil","    ) -> some View","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Attaches the customer center as a platform-appropriate sheet."}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"iOS","type":"text"}],"type":"strong"},{"type":"text","text":" — Presents "},{"code":"RevenueCatUI.CustomerCenterView","type":"codeVoice"},{"type":"text","text":" in a "},{"code":"sheet","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"macOS","type":"text"}],"type":"strong"},{"type":"text","text":" — Opens "},{"code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions","type":"codeVoice"},{"type":"text","text":" through SwiftUI’s "},{"code":"openURL","type":"codeVoice"},{"type":"text","text":" environment action (falling back to the "},{"code":"https:\/\/apps.apple.com\/account\/subscriptions","type":"codeVoice"},{"type":"text","text":" web URL if nothing handles the "},{"code":"itms-apps","type":"codeVoice"},{"type":"text","text":" scheme), immediately clears the binding, and fires "},{"code":"onDismiss","type":"codeVoice"},{"type":"text","text":". RevenueCatUI does not ship a customer center on macOS."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":4,"anchor":"Parameters","text":"Parameters","type":"heading"},{"items":[{"content":[{"inlineContent":[{"code":"isPresented","type":"codeVoice"},{"type":"text","text":" — Two-way binding to the customer center’s visibility flag."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"onDismiss","type":"codeVoice"},{"type":"text","text":" — Optional callback fired after dismissal (or, on macOS, after the App Store URL is opened)."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"anchor":"revenueCatPaywallstateofferingIdentifierdisplayCloseButtonpurchaseLogicsend","text":"`revenueCatPaywall(state:offeringIdentifier:displayCloseButton:purchaseLogic:send:)`","type":"heading"},{"code":["extension View {","    public func revenueCatPaywall(","        state: PaywallState,","        offeringIdentifier: String? = nil,","        displayCloseButton: Bool = true,","        purchaseLogic: RevenueCatPaywallPurchaseLogic? = nil,","        send: @escaping (PaywallAction) -> Void","    ) -> some View","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Convenience modifier that attaches both "},{"code":"revenueCatPaywall(isPresented:offeringIdentifier:displayCloseButton:purchaseLogic:onDismiss:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"revenueCatCustomerCenter(isPresented:onDismiss:)","type":"codeVoice"},{"type":"text","text":" and dispatches the matching actions through "},{"code":"send","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"On iOS the two presentations are mutually exclusive and the paywall wins. On macOS a customer-center request dispatches "},{"code":".openManageSubscriptions","type":"codeVoice"},{"type":"text","text":" through the paywall plugin, then "},{"code":".dismissCustomerCenter","type":"codeVoice"},{"type":"text","text":"; the external App Store hand-off remains available while the paywall sheet is open. After a restore inside the paywall, the modifier also dispatches "},{"code":".dismiss","type":"codeVoice"},{"type":"text","text":" once "},{"code":"state.isGateSatisfied","type":"codeVoice"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":", because RevenueCatUI does not dismiss after a restore. Attach the modifier once to one app-wide presentation host. See "},{"type":"emphasis","inlineContent":[{"text":"Platform Behavior","type":"text"}]},{"type":"text","text":" in the "},{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"type":"text","text":" documentation."}],"type":"paragraph"},{"level":4,"anchor":"Parameters","text":"Parameters","type":"heading"},{"items":[{"content":[{"inlineContent":[{"code":"state","type":"codeVoice"},{"type":"text","text":" — The paywall slice from your store, typically "},{"code":"store.paywall","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"offeringIdentifier","type":"codeVoice"},{"type":"text","text":" — Identifier of the RevenueCat offering to present. Defaults to "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" (the dashboard’s current offering); see the primitive modifier above."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"displayCloseButton","type":"codeVoice"},{"type":"text","text":" — Whether "},{"code":"PaywallView","type":"codeVoice"},{"type":"text","text":" shows a close button. Defaults to "},{"code":"true","type":"codeVoice"},{"type":"text","text":"; see the primitive modifier above."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"purchaseLogic","type":"codeVoice"},{"type":"text","text":" — App-owned StoreKit 2 purchase and restore operations for "},{"code":"purchasesAreCompletedBy: .myApp","type":"codeVoice"},{"type":"text","text":". Leave "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" when RevenueCat completes purchases."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"send","type":"codeVoice"},{"type":"text","text":" — A closure that lifts a "},{"code":"PaywallAction","type":"codeVoice"},{"type":"text","text":" into your root action and dispatches it through the store. Typically "},{"code":"{ store.send(.paywall($0)) }","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":4,"anchor":"Manual-wiring","text":"Manual wiring","type":"heading"},{"code":["ContentView()","    .revenueCatPaywall(","        isPresented: Binding(","            get: { store.paywall.isPresented },","            set: { if !$0 { store.send(.paywall(.dismiss)) } }","        )","    )","    .revenueCatCustomerCenter(","        isPresented: Binding(","            get: { store.paywall.isCustomerCenterPresented },","            set: { if !$0 { store.send(.paywall(.dismissCustomerCenter)) } }","        )","    )"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"This attaches the same presentation surfaces but leaves the iOS exclusivity and close-after-restore rules to the app. Use the convenience modifier when both surfaces are needed; use the primitives when only one is needed or when you want to interleave other modifiers between them."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxrevenuecatpaywall\/uicomponentsreference"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/UIComponentsReference"},"kind":"article","seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior"],"title":"Related Documentation"},{"generated":true,"anchor":"Reference","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/ServiceReference","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference"],"title":"Reference"}],"metadata":{"role":"article","title":"UI Components Reference","roleHeading":"Article","modules":[{"name":"SwiduxRevenueCatPaywall"}]},"abstract":[{"text":"API reference for the ","type":"text"},{"code":"revenueCatPaywall","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"revenueCatCustomerCenter","type":"codeVoice"},{"text":" view modifiers — the SwiftUI surface of ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":".","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"sections":[],"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/MockServiceReference":{"kind":"article","abstract":[{"text":"API reference for ","type":"text"},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"text":" — a controllable ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" conformer for previews and tests that does not touch ","type":"text"},{"code":"Purchases.shared","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/swiduxrevenuecatpaywall\/mockservicereference","role":"article","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference","type":"topic","title":"Mock Service Reference"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/PlatformBehavior":{"title":"Platform Behavior","abstract":[{"text":"Why the ","type":"text"},{"code":"revenueCatPaywall","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"revenueCatCustomerCenter"},{"text":" modifiers present differently on iOS and macOS, and what is hard-coded.","type":"text"}],"role":"article","type":"topic","kind":"article","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","url":"\/documentation\/swiduxrevenuecatpaywall\/platformbehavior"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/ServiceReference":{"type":"topic","role":"article","url":"\/documentation\/swiduxrevenuecatpaywall\/servicereference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/ServiceReference","kind":"article","title":"Service Reference","abstract":[{"text":"API reference for ","type":"text"},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":" — the RevenueCat-backed ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" conformer that the paywall plugin consumes.","type":"text"}]},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToPresentTheUI":{"kind":"article","abstract":[{"text":"Attach the ","type":"text"},{"code":"revenueCatPaywall","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"revenueCatCustomerCenter","type":"codeVoice"},{"text":" view modifiers from ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" to a root view, driven by ","type":"text"},{"code":"PaywallState","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/swiduxrevenuecatpaywall\/howtopresenttheui","role":"article","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","type":"topic","title":"How to Present the UI"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall":{"kind":"symbol","abstract":[{"type":"text","text":"RevenueCat adapter for Swidux’s "},{"code":"PaywallPlugin","type":"codeVoice"},{"type":"text","text":". Implements "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" against "},{"type":"codeVoice","code":"Purchases.shared"},{"type":"text","text":", ships a controllable mock for previews and tests, and pairs with "},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" for drop-in ","type":"text"},{"code":"PaywallView","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"CustomerCenterView","type":"codeVoice"},{"text":" presentation.","type":"text"}],"url":"\/documentation\/swiduxrevenuecatpaywall","role":"collection","type":"topic","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall","title":"SwiduxRevenueCatPaywall"}}}