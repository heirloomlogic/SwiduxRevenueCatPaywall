{"kind":"article","seeAlsoSections":[{"abstract":[{"type":"text","text":"The matching API reference for the views described here lives in the "},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":" documentation."}],"identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService"],"title":"Related Documentation","anchor":"Related-Documentation"},{"anchor":"How-to-Guides","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest"],"title":"How-to Guides","generated":true}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"text":" ships three view modifiers that wrap RevenueCatUI’s surfaces with platform-aware presentation. Each is bound to ","type":"text"},{"code":"PaywallState","type":"codeVoice"},{"type":"text","text":": presentation flags drive visibility, and the bindings dispatch matching paywall actions back through the store on dismissal. There is no local sheet state."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For platform behavior details (adaptive iOS presentation, macOS sheet sizing, and the App Store deep link on macOS), see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"anchor":"Before-you-start","text":"Before you start","type":"heading"},{"inlineContent":[{"text":"This guide assumes:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You have completed "},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","isActive":true,"type":"reference"},{"type":"text","text":". The plugin is registered and "},{"code":"observeCustomerInfo","type":"codeVoice"},{"type":"text","text":" runs on launch."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Your app target depends on the ","type":"text"},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"text":" product:","type":"text"}]}]}],"type":"unorderedList"},{"code":[".product(name: \"SwiduxRevenueCatPaywallUI\", package: \"SwiduxRevenueCatPaywall\"),"],"type":"codeListing","syntax":"swift"},{"anchor":"Step-1-Attach-one-presentation-host","level":2,"type":"heading","text":"Step 1: Attach one presentation host"},{"type":"paragraph","inlineContent":[{"text":"The simplest wiring uses ","type":"text"},{"type":"codeVoice","code":"revenueCatPaywallAndCustomerCenter(state:onAction:)"},{"text":" for both presentation surfaces and their actions:","type":"text"}]},{"code":["import SwiduxRevenueCatPaywallUI","","struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .revenueCatPaywallAndCustomerCenter(","                state: store.paywall,","                onAction: { action in store.send(.paywall(action)) }","            )","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The closure receives each "},{"code":"PaywallAction","type":"codeVoice"},{"text":" emitted by the UI and lifts it into your root action. Attach the modifier once, to one app-wide presentation host. Do not attach it inside content created for every ","type":"text"},{"type":"codeVoice","code":"WindowGroup"},{"type":"text","text":" window or scene: the shared "},{"type":"codeVoice","code":"PaywallState"},{"text":" request would make every copy present. In a multi-window app, choose one scene, such as the primary app or settings window, to own paywall presentation.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Both paywall-presenting modifiers accept "},{"type":"codeVoice","code":"displayCloseButton:"},{"text":" (default ","type":"text"},{"type":"codeVoice","code":"true"},{"type":"text","text":"), "},{"type":"codeVoice","code":"fonts:"},{"type":"text","text":", "},{"type":"codeVoice","code":"presentationStyle:"},{"type":"text","text":", and "},{"type":"codeVoice","code":"onEvent:"},{"type":"text","text":". See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior"},{"type":"text","text":" before turning off the close button."}],"type":"paragraph"},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"onEvent","type":"codeVoice"},{"text":" for analytics or app actions that distinguish purchase completion, cancellation, failure, restore completion, and restore failure. Its values contain only package-owned types and Foundation fields:","type":"text"}],"type":"paragraph"},{"code":["ContentView()","    .revenueCatPaywallAndCustomerCenter(","        state: store.paywall,","        onEvent: { event in analytics.record(event) },","        onAction: { action in store.send(.paywall(action)) }","    )"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","text":"App-owned StoreKit 2 purchases","anchor":"App-owned-StoreKit-2-purchases"},{"inlineContent":[{"type":"text","text":"If RevenueCat is configured with "},{"code":"purchasesAreCompletedBy: .myApp","type":"codeVoice"},{"type":"text","text":" and "},{"code":"storeKitVersion: .storeKit2","type":"codeVoice"},{"type":"text","text":", pass the app’s StoreKit operations as "},{"code":"purchaseLogic","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["import StoreKit","import SwiduxRevenueCatPaywallUI","","let purchaseLogic = RevenueCatPaywallPurchaseLogic(","    purchase: { product in","        try await product.purchase()","    },","    restore: {","        try await AppStore.sync()","    }",")","","ContentView()","    .revenueCatPaywallAndCustomerCenter(","        state: store.paywall,","        purchaseLogic: purchaseLogic,","        onAction: { action in store.send(.paywall(action)) }","    )"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"RevenueCatUI requires both handlers in "},{"type":"codeVoice","code":".myApp"},{"type":"text","text":" mode. The modifier always supplies them, so presenting without "},{"type":"codeVoice","code":"purchaseLogic"},{"type":"text","text":" returns a configuration error when the user tries to purchase or restore instead of triggering RevenueCatUI’s Release-build trap. The purchase closure returns the original "},{"type":"codeVoice","code":"Product.PurchaseResult"},{"text":"; the package reports it to RevenueCat and then finishes a verified transaction. A pending purchase stays open with a pending message. The restore closure refreshes StoreKit first, and the package then synchronizes RevenueCat and reports whether it found an active subscription or non-subscription.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The bundled observer-mode UI accepts StoreKit 2 products. A ","type":"text"},{"code":".myApp","type":"codeVoice"},{"text":" configuration pinned to StoreKit 1 can still use ","type":"text"},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":", but it needs a custom paywall because ","type":"text"},{"code":"RevenueCatPaywallPurchaseLogic","type":"codeVoice"},{"text":" does not expose ","type":"text"},{"code":"SKProduct","type":"codeVoice"},{"type":"text","text":" or "},{"type":"codeVoice","code":"SKPaymentTransaction"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Step 2: Trigger the paywall from a feature","anchor":"Step-2-Trigger-the-paywall-from-a-feature","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dispatch "},{"type":"codeVoice","code":".request(reason:)"},{"type":"text","text":" with a short identifier describing why you’re asking. When "},{"type":"codeVoice","code":"offeringIdentifier:"},{"type":"text","text":" is omitted, the composed modifier passes this value to RevenueCat as a placement identifier. RevenueCat targeting can select an offering for that placement. For an unknown placement, RevenueCat may return the dashboard’s placement fallback offering, which can differ from the current offering; the package uses the current offering when RevenueCat returns no placement fallback:"}]},{"code":["Button(\"Export PDF\") {","    store.send(.paywall(.request(reason: \"export-pdf\")))","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The plugin sets ","type":"text"},{"code":"PaywallState.isPresented = true","type":"codeVoice"},{"text":". The ","type":"text"},{"code":"revenueCatPaywallAndCustomerCenter","type":"codeVoice"},{"text":" modifier observes the change and presents ","type":"text"},{"code":"RevenueCatUI.PaywallView","type":"codeVoice"},{"text":" with the configured RevenueCat-owned or app-owned handlers.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"An explicit ","type":"text"},{"code":"offeringIdentifier:","type":"codeVoice"},{"text":" takes precedence over the placement. A missing explicit identifier asserts in Debug, logs a warning, and falls back to the current offering. Network failures fall back without asserting.","type":"text"}]},{"text":"Step 3: Trigger the customer center","anchor":"Step-3-Trigger-the-customer-center","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Existing subscribers manage their subscription through the customer center. Surface a button that dispatches "},{"type":"codeVoice","code":".presentCustomerCenter"},{"type":"text","text":":"}]},{"code":["if store.paywall.isPro {","    Button(\"Manage Subscription\") {","        store.send(.paywall(.presentCustomerCenter))","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The composed modifier presents "},{"type":"codeVoice","code":"RevenueCatUI.CustomerCenterView"},{"type":"text","text":" on iOS. On macOS it dispatches "},{"type":"codeVoice","code":".openManageSubscriptions"},{"type":"text","text":" so the paywall plugin opens the App Store subscriptions URL through its injectable URL handler, then dispatches "},{"type":"codeVoice","code":".dismissCustomerCenter"},{"type":"text","text":". RevenueCatUI does not ship a customer center on macOS; see "},{"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","isActive":true},{"type":"text","text":"."}]},{"level":2,"anchor":"Step-4-Manual-wiring-optional","type":"heading","text":"Step 4: Manual wiring (optional)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you need only one sheet, or you want to interleave other modifiers between them, attach the primitive modifiers directly. Each takes a real "},{"type":"codeVoice","code":"Binding<Bool>"},{"type":"text","text":"; build it with a "},{"type":"codeVoice","code":"set:"},{"type":"text","text":" that dispatches the matching dismiss action when SwiftUI clears the flag:"}]},{"syntax":"swift","code":["ContentView()","    .revenueCatPaywall(","        isPresented: Binding(","            get: { store.paywall.isPresented },","            set: { if !$0 { store.send(.paywall(.dismiss)) } }","        )","    )","    .revenueCatCustomerCenter(","        isPresented: Binding(","            get: { store.paywall.isCustomerCenterPresented },","            set: { if !$0 { store.send(.paywall(.dismissCustomerCenter)) } }","        )","    )"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The convenience modifier ","type":"text"},{"code":"revenueCatPaywallAndCustomerCenter(state:onAction:)","type":"codeVoice"},{"text":" attaches this wiring and closes the paywall after a restore that leaves the user entitled. On iOS it also keeps the paywall and customer center mutually exclusive. The macOS customer center is an external App Store hand-off, so a request made while the paywall is open is handled immediately instead of being discarded.","type":"text"}]},{"level":2,"anchor":"Step-5-Restore-from-inside-the-paywall","type":"heading","text":"Step 5: Restore from inside the paywall"},{"type":"paragraph","inlineContent":[{"text":"RevenueCatUI’s ","type":"text"},{"code":"PaywallView","type":"codeVoice"},{"text":" provides its own restore button by default. If you need an additional restore affordance elsewhere (a Settings row, for example), dispatch ","type":"text"},{"code":".restorePurchases","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","code":["Button(\"Restore Purchases\") {","    store.send(.paywall(.restorePurchases))","}",".disabled(store.paywall.isLoading)"],"type":"codeListing"},{"level":2,"anchor":"What-happens-on-dismiss","type":"heading","text":"What happens on dismiss"},{"type":"paragraph","inlineContent":[{"text":"When the user dismisses the paywall, the plugin’s ","type":"text"},{"code":".dismiss","type":"codeVoice"},{"text":" action clears ","type":"text"},{"code":"PaywallState.isPresented","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"requestedReason","type":"codeVoice"},{"text":", then dispatches ","type":"text"},{"code":".refreshCustomerInfo","type":"codeVoice"},{"text":" so the gate is reconciled — the user may have purchased while the sheet was open.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"RevenueCatUI dismisses the paywall itself after a purchase, but not after a restore. The convenience modifier closes it for you: once RevenueCatUI reports the restore complete (after the user acknowledges its success alert) and ","type":"text"},{"type":"codeVoice","code":"PaywallState.isGateSatisfied"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":", it dispatches "},{"type":"codeVoice","code":".dismiss"},{"type":"text","text":". The entitlement arrives through the live stream, so keep "},{"type":"codeVoice","code":".observeCustomerInfo"},{"type":"text","text":" running. With the manual wiring, nothing closes the paywall after a restore — a user who restores behind a hard paywall ("},{"type":"codeVoice","code":"displayCloseButton: false"},{"type":"text","text":") has no way out, so use the convenience modifier there."}]},{"inlineContent":[{"type":"text","text":"When the user dismisses the customer center, the plugin’s "},{"type":"codeVoice","code":".dismissCustomerCenter"},{"type":"text","text":" action clears "},{"type":"codeVoice","code":"isCustomerCenterPresented"},{"type":"text","text":". On macOS the convenience modifier sends that action immediately after "},{"type":"codeVoice","code":".openManageSubscriptions"},{"type":"text","text":". No refresh is dispatched, since opening the customer center does not change entitlement state by itself; the live "},{"type":"codeVoice","code":"customerInfoStream"},{"type":"text","text":" from "},{"type":"codeVoice","code":"Step 5"},{"type":"text","text":" of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService"},{"type":"text","text":" picks up any subscription change RevenueCat reports asynchronously."}],"type":"paragraph"},{"text":"Dashboard exit offers","level":2,"anchor":"Dashboard-exit-offers","type":"heading"},{"inlineContent":[{"text":"Dashboard exit offers do not run through the bundled modifiers. RevenueCatUI implements them only in its own presentation modifiers, and those presenters always add a close button. The bundled modifiers keep supporting ","type":"text"},{"code":"displayCloseButton: false","type":"codeVoice"},{"text":" as a hard paywall, so they continue to embed ","type":"text"},{"code":"PaywallView","type":"codeVoice"},{"text":" directly. Use RevenueCatUI’s ","type":"text"},{"code":"presentPaywall","type":"codeVoice"},{"text":" modifier when an exit offer matters more than the hard-paywall option.","type":"text"}],"type":"paragraph"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"abstract":[{"text":"Attach ","type":"text"},{"type":"codeVoice","code":"revenueCatPaywallAndCustomerCenter"},{"text":" from ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" to a root view to present both surfaces from ","type":"text"},{"code":"PaywallState","type":"codeVoice"},{"type":"text","text":", or attach either binding-driven primitive by itself."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI"},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxrevenuecatpaywall\/howtopresenttheui"]}],"metadata":{"roleHeading":"Article","role":"article","title":"How to Present the UI","modules":[{"name":"SwiduxRevenueCatPaywall"}]},"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToPreviewAndTest":{"type":"topic","title":"How to Preview and Test","kind":"article","role":"article","abstract":[{"text":"Drive entitlement state from SwiftUI previews and tests with ","type":"text"},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"text":" — no RevenueCat SDK call required.","type":"text"}],"url":"\/documentation\/swiduxrevenuecatpaywall\/howtopreviewandtest","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToImplementService":{"role":"article","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","kind":"article","title":"How to Implement the Service","abstract":[{"text":"Wire ","type":"text"},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":" into the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" plugin so the store sees real-time entitlement updates from RevenueCat."}],"url":"\/documentation\/swiduxrevenuecatpaywall\/howtoimplementservice","type":"topic"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall":{"abstract":[{"type":"text","text":"RevenueCat adapter for Swidux’s "},{"type":"codeVoice","code":"PaywallPlugin"},{"text":". Implements ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"text":" against ","type":"text"},{"type":"codeVoice","code":"Purchases.shared"},{"text":", ships a controllable mock for previews and tests, and pairs with ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":" for drop-in "},{"code":"PaywallView","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"CustomerCenterView","type":"codeVoice"},{"text":" presentation.","type":"text"}],"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall","url":"\/documentation\/swiduxrevenuecatpaywall","kind":"symbol","role":"collection","title":"SwiduxRevenueCatPaywall","type":"topic"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/PlatformBehavior":{"type":"topic","title":"Platform Behavior","kind":"article","role":"article","abstract":[{"type":"text","text":"How the paywall and customer-center modifiers choose presentation, and which controls remain fixed."}],"url":"\/documentation\/swiduxrevenuecatpaywall\/platformbehavior","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToAddAPermanentLicense":{"role":"article","type":"topic","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","kind":"article","abstract":[{"type":"text","text":"Sell a lifetime entitlement alongside a subscription and surface both flags through the paywall plugin."}],"title":"How to Add a Permanent License","url":"\/documentation\/swiduxrevenuecatpaywall\/howtoaddapermanentlicense"}}}