{"abstract":[{"type":"text","text":"API reference for "},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":" — the RevenueCat-backed "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" conformer that the paywall plugin consumes."}],"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"kind":"article","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/ServiceReference"},"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallService"]},{"generated":true,"anchor":"Reference","title":"Reference","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/UIComponentsReference"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":" adapts ","type":"text"},{"code":"RevenueCat.Purchases","type":"codeVoice"},{"text":" to the ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" protocol that ","type":"text"},{"code":"SwiduxPaywall.PaywallPlugin","type":"codeVoice"},{"text":" requires. It does one job: translate ","type":"text"},{"code":"CustomerInfo","type":"codeVoice"},{"text":" into ","type":"text"},{"code":"EntitlementSnapshot","type":"codeVoice"},{"text":" (defined by ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":") so the plugin can drive its state. Configuration of the RevenueCat SDK itself remains the caller’s responsibility.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For a step-by-step integration walkthrough, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService"},{"text":". For the entitlement-mapping rules, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping"},{"text":".","type":"text"}]},{"type":"heading","anchor":"Library-target","level":2,"text":"Library target"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Product: ","type":"text"},{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Import: ","type":"text"},{"type":"codeVoice","code":"import SwiduxRevenueCatPaywall"}]}]}]},{"type":"paragraph","inlineContent":[{"code":"Package.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":[".product(name: \"SwiduxRevenueCatPaywall\", package: \"SwiduxRevenueCatPaywall\"),"]},{"type":"heading","anchor":"Types","level":2,"text":"Types"},{"type":"heading","anchor":"docSwiduxRevenueCatPaywalldocumentationSwiduxRevenueCatPaywallRevenueCatPaywallService","level":3,"text":"``doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallService``"},{"type":"codeListing","syntax":"swift","code":["public struct RevenueCatPaywallService: PaywallService {","    public init(","        entitlementID: String,","        permanentLicenseEntitlementID: String? = nil","    )","","    public func customerInfo() async throws -> EntitlementSnapshot","    public func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    public func restorePurchases() async throws -> EntitlementSnapshot","}"]},{"type":"paragraph","inlineContent":[{"text":"Value type. Holds two ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" identifiers and forwards every call to ","type":"text"},{"code":"Purchases.shared","type":"codeVoice"},{"text":". Cheap to construct and pass into ","type":"text"},{"code":"PaywallPlugin","type":"codeVoice"},{"text":" — after ","type":"text"},{"code":"RevenueCatPaywall.configure","type":"codeVoice"},{"text":" has run. For production, wrap it in SwiduxPaywall’s ","type":"text"},{"code":"ResilientPaywallService","type":"codeVoice"},{"text":" so a transient read failure at launch never gates a paid user as free.","type":"text"}]},{"type":"heading","anchor":"Initializer","level":4,"text":"Initializer"},{"type":"codeListing","syntax":"swift","code":["public init(","    entitlementID: String,","    permanentLicenseEntitlementID: String? = nil",")"]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"entitlementID"},{"text":" — RevenueCat entitlement identifier that grants pro access. Surfaces as ","type":"text"},{"type":"codeVoice","code":"EntitlementSnapshot.isPro"},{"text":" when active.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"permanentLicenseEntitlementID"},{"text":" — Optional secondary identifier for a lifetime \/ permanent entitlement. Surfaces as ","type":"text"},{"type":"codeVoice","code":"EntitlementSnapshot.hasPermanentLicense"},{"text":" when active. Pass ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" if the app has no separate lifetime SKU.","type":"text"}]}]}]},{"type":"aside","style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywall\/configure(apiKey:appUserID:userDefaults:logLevel:entitlementVerification:purchasesAreCompletedBy:storeKitVersion:)"},{"type":"text","text":" before constructing the service. The initializer preconditions on the SDK being configured — failing fast with a named fix instead of letting "},{"type":"codeVoice","code":"Purchases.shared"},{"type":"text","text":" trap opaquely at first use. Previews and tests should construct "},{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"type":"text","text":" instead."}]}]},{"type":"heading","anchor":"customerInfo-async-throws-%3E-EntitlementSnapshot","level":4,"text":"`customerInfo() async throws -> EntitlementSnapshot`"},{"type":"paragraph","inlineContent":[{"text":"One-shot fetch. Calls ","type":"text"},{"code":"Purchases.shared.customerInfo()","type":"codeVoice"},{"text":" and maps the result.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Throws whatever the RevenueCat SDK throws (","type":"text"},{"code":"ErrorCode.networkError","type":"codeVoice"},{"text":", ","type":"text"},{"code":".offlineConnectionError","type":"codeVoice"},{"text":", etc.). The plugin catches the error and dispatches ","type":"text"},{"code":".refreshFailed(message)","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"heading","anchor":"customerInfoStream-%3E-AsyncStream%3CEntitlementSnapshot%3E","level":4,"text":"`customerInfoStream() -> AsyncStream<EntitlementSnapshot>`"},{"type":"paragraph","inlineContent":[{"text":"Long-lived stream. Wraps ","type":"text"},{"code":"Purchases.shared.customerInfoStream","type":"codeVoice"},{"text":" and yields a new ","type":"text"},{"code":"EntitlementSnapshot","type":"codeVoice"},{"text":" for every change RevenueCat reports — purchase, refund, family-share update, sandbox renewal.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The stream finishes when the underlying RevenueCat stream finishes. The plugin’s ","type":"text"},{"code":".observeCustomerInfo","type":"codeVoice"},{"text":" effect normally keeps it alive for the duration of the session; cancel by cancelling the consuming ","type":"text"},{"code":"Task","type":"codeVoice"},{"text":", which terminates the stream and tears down the bridge.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The stream buffers only the newest snapshot: each yield is a complete entitlement state, so a slow consumer sees the latest value rather than replaying stale intermediate states.","type":"text"}]},{"type":"heading","anchor":"restorePurchases-async-throws-%3E-EntitlementSnapshot","level":4,"text":"`restorePurchases() async throws -> EntitlementSnapshot`"},{"type":"paragraph","inlineContent":[{"text":"Maps the result of a restore. Reads ","type":"text"},{"code":"Purchases.shared.purchasesAreCompletedBy","type":"codeVoice"},{"text":" live and branches: observer mode (","type":"text"},{"code":".myApp","type":"codeVoice"},{"text":") calls ","type":"text"},{"code":"syncPurchases()","type":"codeVoice"},{"text":", the default mode calls ","type":"text"},{"code":"restorePurchases()","type":"codeVoice"},{"text":". In observer mode the SDK’s ","type":"text"},{"code":"restorePurchases()","type":"codeVoice"},{"text":" can alias or transfer purchases between accounts, so the service uses ","type":"text"},{"code":"syncPurchases()","type":"codeVoice"},{"text":" automatically — no special-casing in your app code. Throws whatever the SDK throws on error.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The plugin’s ","type":"text"},{"code":".restorePurchases","type":"codeVoice"},{"text":" action wraps this call and dispatches ","type":"text"},{"code":".customerInfoUpdated","type":"codeVoice"},{"text":" on success or ","type":"text"},{"code":".refreshFailed","type":"codeVoice"},{"text":" on error.","type":"text"}]},{"type":"heading","anchor":"Entitlement-mapping","level":2,"text":"Entitlement mapping"},{"type":"paragraph","inlineContent":[{"text":"For every ","type":"text"},{"code":"CustomerInfo","type":"codeVoice"},{"text":" the service receives:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Configuration"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isPro"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"hasPermanentLicense"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"entitlementID"},{"type":"text","text":" active"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"true"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"(next column)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"entitlementID"},{"type":"text","text":" inactive or missing"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"false"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"(next column)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"permanentLicenseEntitlementID == nil"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"—"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"false"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"permanentLicenseEntitlementID"},{"type":"text","text":" active"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"—"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"true"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"permanentLicenseEntitlementID"},{"type":"text","text":" inactive or missing"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"—"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"false"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"Both flags are checked independently against the same ","type":"text"},{"code":"CustomerInfo","type":"codeVoice"},{"text":". A user with both active subscription and lifetime entitlements gets both flags set. See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping"},{"text":" for the reasoning behind the truth table.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxrevenuecatpaywall\/servicereference"]}],"metadata":{"roleHeading":"Article","modules":[{"name":"SwiduxRevenueCatPaywall"}],"title":"Service Reference","role":"article"},"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall":{"title":"SwiduxRevenueCatPaywall","url":"\/documentation\/swiduxrevenuecatpaywall","kind":"symbol","type":"topic","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall","role":"collection","abstract":[{"text":"RevenueCat adapter for Swidux’s ","type":"text"},{"code":"PaywallPlugin","type":"codeVoice"},{"text":". Implements ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" against "},{"type":"codeVoice","code":"Purchases.shared"},{"type":"text","text":", ships a controllable mock for previews and tests, and pairs with "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"text":" for drop-in ","type":"text"},{"type":"codeVoice","code":"PaywallView"},{"text":" and ","type":"text"},{"code":"CustomerCenterView","type":"codeVoice"},{"type":"text","text":" presentation."}]},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/EntitlementMapping":{"title":"Entitlement Mapping","url":"\/documentation\/swiduxrevenuecatpaywall\/entitlementmapping","kind":"article","type":"topic","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping","role":"article","abstract":[{"type":"text","text":"How RevenueCat’s "},{"type":"codeVoice","code":"CustomerInfo.entitlements"},{"type":"t