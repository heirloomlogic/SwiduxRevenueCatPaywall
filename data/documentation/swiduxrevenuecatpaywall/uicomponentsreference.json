{"identifier":{"url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/UIComponentsReference","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"revenueCatPaywall"},{"type":"text","text":" and "},{"type":"codeVoice","code":"revenueCatCustomerCenter"},{"text":" view modifiers — the SwiftUI surface of ","type":"text"},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":"."}],"kind":"article","primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The UI product layers three view modifiers on top of ","type":"text"},{"code":"RevenueCatUI","type":"codeVoice"},{"text":". Two primitives present the paywall and customer center directly from a ","type":"text"},{"code":"Binding<Bool>","type":"codeVoice"},{"type":"text","text":"; one convenience modifier composes both, driven by "},{"code":"PaywallState","type":"codeVoice"},{"type":"text","text":". Each presentation modifier attaches to the modified content view directly — there are no "},{"code":"View","type":"codeVoice"},{"type":"text","text":" wrappers and no "},{"code":".background { … }","type":"codeVoice"},{"type":"text","text":" indirection. This shape is what makes the macOS sheet machinery present reliably."}]},{"inlineContent":[{"text":"For step-by-step wiring, see ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"How to Present the UI"}]},{"text":" in the ","type":"text"},{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"},{"type":"text","text":" documentation. For the rationale behind platform-specific behavior, see "},{"type":"emphasis","inlineContent":[{"text":"Platform Behavior","type":"text"}]},{"type":"text","text":" in the same catalog."}],"type":"paragraph"},{"type":"heading","anchor":"Library-target","level":2,"text":"Library target"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Product: ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"text":"Import: ","type":"text"},{"code":"import SwiduxRevenueCatPaywallUI","type":"codeVoice"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"codeVoice","code":"Package.swift"},{"text":":","type":"text"}],"type":"paragraph"},{"code":[".product(name: \"SwiduxRevenueCatPaywallUI\", package: \"SwiduxRevenueCatPaywall\"),"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The UI product depends on ","type":"text"},{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"RevenueCatUI"},{"text":", both pulled in transitively. Apps that don’t ship paywall UI in the same target (for example, a tests-only target) can depend on the lower-level ","type":"text"},{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"},{"text":" product alone.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Modifiers","level":2,"text":"Modifiers"},{"type":"heading","anchor":"revenueCatPaywallisPresentedofferingIdentifierdisplayCloseButtonpurchaseLogiconDismiss","level":3,"text":"`revenueCatPaywall(isPresented:offeringIdentifier:displayCloseButton:purchaseLogic:onDismiss:)`"},{"code":["extension View {","    public func revenueCatPaywall(","        isPresented: Binding<Bool>,","        offeringIdentifier: String? = nil,","        displayCloseButton: Bool = true,","        purchaseLogic: RevenueCatPaywallPurchaseLogic? = nil,","        onDismiss: (() -> Void)? = nil","    ) -> some View","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Attaches ","type":"text"},{"code":"RevenueCatUI.PaywallView","type":"codeVoice"},{"text":" as a platform-appropriate sheet.","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"iOS"}]},{"text":" — Presents in a ","type":"text"},{"type":"codeVoice","code":"fullScreenCover"},{"text":" so the paywall takes the full screen.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"macOS","type":"text"}],"type":"strong"},{"text":" — Presents in a ","type":"text"},{"code":"sheet","type":"codeVoice"},{"text":" sized to a 400×600 minimum.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass a real two-way binding; SwiftUI sets it to "},{"type":"codeVoice","code":"false"},{"type":"text","text":" on user dismissal. Build it from "},{"type":"codeVoice","code":"PaywallState.isPresented"},{"type":"text","text":" so the "},{"type":"codeVoice","code":"set:"},{"type":"text","text":" closure dispatches "},{"type":"codeVoice","code":".paywall(.dismiss)"},{"type":"text","text":" and the plugin clears its presentation state."}]},{"type":"heading","anchor":"Parameters","level":4,"text":"Parameters"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"isPresented"},{"text":" — Two-way binding to the paywall’s visibility flag.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"offeringIdentifier","type":"codeVoice"},{"text":" — Identifier of the RevenueCat offering to present, for a win-back or regional offer. Defaults to ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", which presents the dashboard’s current offering. An unknown identifier or a failed fetch falls back to the current offering with a logged warning.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"displayCloseButton","type":"codeVoice"},{"text":" — Whether ","type":"text"},{"code":"PaywallView","type":"codeVoice"},{"text":" shows a close button. Defaults to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":". Neither the iOS ","type":"text"},{"code":"fullScreenCover","type":"codeVoice"},{"text":" nor the macOS ","type":"text"},{"code":"sheet","type":"codeVoice"},{"text":" offers any other dismissal affordance, so pass ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" only for a hard paywall the user must purchase through.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"purchaseLogic"},{"type":"text","text":" — App-owned StoreKit 2 purchase and restore operations for "},{"type":"codeVoice","code":"purchasesAreCompletedBy: .myApp"},{"type":"text","text":". Leave "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when RevenueCat completes purchases."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"onDismiss","type":"codeVoice"},{"text":" — Optional callback fired after dismissal.","type":"text"}]}]}]},{"anchor":"revenueCatCustomerCenterisPresentedonDismiss","type":"heading","text":"`revenueCatCustomerCenter(isPresented:onDismiss:)`","level":3},{"syntax":"swift","type":"codeListing","code":["extension View {","    public func revenueCatCustomerCenter(","        isPresented: Binding<Bool>,","        onDismiss: (() -> Void)? = nil","    ) -> some View","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Attaches the customer center as a platform-appropriate sheet."}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"iOS"}]},{"text":" — Presents ","type":"text"},{"code":"RevenueCatUI.CustomerCenterView","type":"codeVoice"},{"type":"text","text":" in a "},{"type":"codeVoice","code":"sheet"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"macOS"}]},{"type":"text","text":" — Opens "},{"code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions","type":"codeVoice"},{"type":"text","text":" through SwiftUI’s "},{"code":"openURL","type":"codeVoice"},{"type":"text","text":" environment action (falling back to the "},{"code":"https:\/\/apps.apple.com\/account\/subscriptions","type":"codeVoice"},{"type":"text","text":" web URL if nothing handles the "},{"code":"itms-apps","type":"codeVoice"},{"type":"text","text":" scheme), immediately clears the binding, and fires "},{"code":"onDismiss","type":"codeVoice"},{"type":"text","text":". RevenueCatUI does not ship a customer center on macOS."}]}]}]},{"level":4,"anchor":"Parameters","text":"Parameters","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"isPresented","type":"codeVoice"},{"type":"text","text":" — Two-way binding to the customer center’s visibility flag."}]}]},{"content":[{"inlineContent":[{"code":"onDismiss","type":"codeVoice"},{"text":" — Optional callback fired after dismissal (or, on macOS, after the App Store URL is opened).","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"anchor":"revenueCatPaywallstateofferingIdentifierdisplayCloseButtonpurchaseLogicsend","text":"`revenueCatPaywall(state:offeringIdentifier:displayCloseButton:purchaseLogic:send:)`","type":"heading"},{"syntax":"swift","code":["extension View {","    public func revenueCatPaywall(","        state: PaywallState,","        offeringIdentifier: String? = nil,","        displayCloseButton: Bool = true,","        purchaseLogic: RevenueCatPaywallPurchaseLogic? = nil,","        send: @escaping (PaywallAction) -> Void","    ) -> some View","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Convenience modifier that attaches both "},{"type":"codeVoice","code":"revenueCatPaywall(isPresented:offeringIdentifier:displayCloseButton:purchaseLogic:onDismiss:)"},{"type":"text","text":" and "},{"code":"revenueCatCustomerCenter(isPresented:onDismiss:)","type":"codeVoice"},{"type":"text","text":" and dispatches the matching actions through "},{"code":"send","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"On iOS the two presentations are mutually exclusive and the paywall wins. On macOS a customer-center request dispatches ","type":"text"},{"code":".openManageSubscriptions","type":"codeVoice"},{"text":" through the paywall plugin, then ","type":"text"},{"code":".dismissCustomerCenter","type":"codeVoice"},{"text":"; the external App Store hand-off remains available while the paywall sheet is open. After a restore inside the paywall, the modifier also dispatches ","type":"text"},{"code":".dismiss","type":"codeVoice"},{"text":" once ","type":"text"},{"code":"state.isGateSatisfied","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", because RevenueCatUI does not dismiss after a restore. Attach the modifier once to one app-wide presentation host. See ","type":"text"},{"inlineContent":[{"type":"text","text":"Platform Behavior"}],"type":"emphasis"},{"text":" in the ","type":"text"},{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"text":" documentation.","type":"text"}],"type":"paragraph"},{"anchor":"Parameters","level":4,"type":"heading","text":"Parameters"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"state"},{"type":"text","text":" — The paywall slice from your store, typically "},{"type":"codeVoice","code":"store.paywall"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"offeringIdentifier"},{"type":"text","text":" — Identifier of the RevenueCat offering to present. Defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" (the dashboard’s current offering); see the primitive modifier above."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"displayCloseButton","type":"codeVoice"},{"text":" — Whether ","type":"text"},{"code":"PaywallView","type":"codeVoice"},{"type":"text","text":" shows a close button. Defaults to "},{"code":"true","type":"codeVoice"},{"type":"text","text":"; see the primitive modifier above."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"purchaseLogic"},{"type":"text","text":" — App-owned StoreKit 2 purchase and restore operations for "},{"type":"codeVoice","code":"purchasesAreCompletedBy: .myApp"},{"type":"text","text":". Leave "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when RevenueCat completes purchases."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"send"},{"type":"text","text":" — A closure that lifts a "},{"type":"codeVoice","code":"PaywallAction"},{"type":"text","text":" into your root action and dispatches it through the store. Typically "},{"type":"codeVoice","code":"{ store.send(.paywall($0)) }"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"type":"heading","level":4,"text":"Manual wiring","anchor":"Manual-wiring"},{"type":"codeListing","code":["ContentView()","    .revenueCatPaywall(","        isPresented: Binding(","            get: { store.paywall.isPresented },","            set: { if !$0 { store.send(.paywall(.dismiss)) } }","        )","    )","    .revenueCatCustomerCenter(","        isPresented: Binding(","            get: { store.paywall.isCustomerCenterPresented },","            set: { if !$0 { store.send(.paywall(.dismissCustomerCenter)) } }","        )","    )"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This attaches the same presentation surfaces but leaves the iOS exclusivity and close-after-restore rules to the app. Use the convenience modifier when both surfaces are needed; use the primitives when only one is needed or when you want to interleave other modifiers between them.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxrevenuecatpaywall\/uicomponentsreference"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"metadata":{"title":"UI Components Referen