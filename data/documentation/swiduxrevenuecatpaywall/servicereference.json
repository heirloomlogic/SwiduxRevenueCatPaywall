{"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallService","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallError","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallIdentity","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallIdentityResult","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallIdentityError"]},{"anchor":"Reference","title":"Reference","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/UIComponentsReference"],"generated":true}],"sections":[],"identifier":{"url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/ServiceReference","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxrevenuecatpaywall\/servicereference"]}],"metadata":{"role":"article","title":"Service Reference","roleHeading":"Article","modules":[{"name":"SwiduxRevenueCatPaywall"}]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":" adapts "},{"type":"codeVoice","code":"RevenueCat.Purchases"},{"type":"text","text":" to the "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" protocol that "},{"type":"codeVoice","code":"SwiduxPaywall.PaywallPlugin"},{"type":"text","text":" requires. It does one job: translate "},{"type":"codeVoice","code":"CustomerInfo"},{"type":"text","text":" into "},{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":" (defined by "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":") so the plugin can drive its state. Configuration of the RevenueCat SDK itself remains the caller’s responsibility."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For a step-by-step integration walkthrough, see "},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","type":"reference","isActive":true},{"type":"text","text":". For the entitlement-mapping rules, see "},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Library-target","text":"Library target","type":"heading","level":2},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Product: "},{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Import: "},{"code":"import SwiduxRevenueCatPaywall","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}],"type":"paragraph"},{"code":[".product(name: \"SwiduxRevenueCatPaywall\", package: \"SwiduxRevenueCatPaywall\"),"],"type":"codeListing","syntax":"swift"},{"anchor":"Types","text":"Types","type":"heading","level":2},{"anchor":"docSwiduxRevenueCatPaywalldocumentationSwiduxRevenueCatPaywallRevenueCatPaywallService","text":"``doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallService``","type":"heading","level":3},{"code":["public struct RevenueCatPaywallService: PaywallService {","    public init(","        entitlementID: String,","        permanentLicenseEntitlementID: String? = nil","    )","","    public func customerInfo() async throws -> EntitlementSnapshot","    public func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    public func restorePurchases() async throws -> EntitlementSnapshot","    @MainActor public func logIn(appUserID: String) async throws(RevenueCatPaywallIdentityError) -> RevenueCatPaywallIdentityResult","    @MainActor public func logOut() async throws(RevenueCatPaywallIdentityError) -> RevenueCatPaywallIdentityResult","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Value type. Holds two "},{"type":"codeVoice","code":"String"},{"type":"text","text":" identifiers and forwards configured calls to "},{"type":"codeVoice","code":"Purchases.shared"},{"type":"text","text":". It is safe to construct before "},{"type":"codeVoice","code":"RevenueCatPaywall.configure"},{"type":"text","text":" runs. For production, wrap it in SwiduxPaywall’s "},{"type":"codeVoice","code":"ResilientPaywallService"},{"type":"text","text":" so a transient read failure at launch never gates a paid user as free."}],"type":"paragraph"},{"anchor":"Initializer","text":"Initializer","type":"heading","level":4},{"code":["public init(","    entitlementID: String,","    permanentLicenseEntitlementID: String? = nil",")"],"type":"codeListing","syntax":"swift"},{"items":[{"content":[{"inlineContent":[{"code":"entitlementID","type":"codeVoice"},{"type":"text","text":" — RevenueCat entitlement identifier that grants pro access. Surfaces as "},{"code":"EntitlementSnapshot.isPro","type":"codeVoice"},{"type":"text","text":" when active."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"permanentLicenseEntitlementID","type":"codeVoice"},{"type":"text","text":" — Optional secondary identifier for a lifetime \/ permanent entitlement. Surfaces as "},{"code":"EntitlementSnapshot.hasPermanentLicense","type":"codeVoice"},{"type":"text","text":" when active. Pass "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if the app has no separate lifetime SKU."}],"type":"paragraph"}]}],"type":"unorderedList"},{"content":[{"inlineContent":[{"type":"text","text":"Call "},{"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywall\/configure(apiKey:appUserID:userDefaults:logLevel:entitlementVerification:purchasesAreCompletedBy:storeKitVersion:)","isActive":true},{"type":"text","text":" before invoking the service. Construction before configuration is safe, including from a stored-property initializer. Previews and tests that do not configure RevenueCat should still use "},{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"type":"text","text":" when they need entitlement values."}],"type":"paragraph"}],"style":"important","name":"Important","type":"aside"},{"anchor":"customerInfo-async-throws-%3E-EntitlementSnapshot","text":"`customerInfo() async throws -> EntitlementSnapshot`","type":"heading","level":4},{"inlineContent":[{"type":"text","text":"One-shot fetch. Calls "},{"type":"codeVoice","code":"Purchases.shared.customerInfo()"},{"type":"text","text":" and maps the result. A response older than five minutes by "},{"type":"codeVoice","code":"requestDate"},{"type":"text","text":" is labelled "},{"type":"codeVoice","code":".cache"},{"type":"text","text":" (see "},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping#Live-and-cached-customer-info","type":"reference","isActive":true},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Throws "},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallError\/notConfigured","type":"reference","isActive":true},{"type":"text","text":" before configuration, "},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallError\/verificationFailed","type":"reference","isActive":true},{"type":"text","text":" for failed signature verification, or an SDK error. A "},{"type":"codeVoice","code":"ResilientPaywallService"},{"type":"text","text":" can serve a valid same-account cache after a failed read; without a fallback the plugin dispatches "},{"type":"codeVoice","code":".refreshFailed(message)"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"customerInfoStream-%3E-AsyncStream%3CEntitlementSnapshot%3E","text":"`customerInfoStream() -> AsyncStream<EntitlementSnapshot>`","type":"heading","level":4},{"inlineContent":[{"type":"text","text":"Long-lived stream. Wraps "},{"type":"codeVoice","code":"Purchases.shared.customerInfoStream"},{"type":"text","text":" and yields a new "},{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":" for each valid change RevenueCat reports. A failed-verification element is skipped."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The stream finishes when the underlying RevenueCat stream finishes. The plugin’s "},{"type":"codeVoice","code":".observeCustomerInfo"},{"type":"text","text":" effect normally keeps it alive for the duration of the session; cancel by cancelling the consuming "},{"type":"codeVoice","code":"Task"},{"type":"text","text":", which terminates the stream and tears down the bridge."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Before configuration, the stream logs a fault and finishes immediately. Swidux 1.9 and later clears its observation guard when the stream ends, so configure RevenueCat and dispatch "},{"type":"codeVoice","code":".observeCustomerInfo"},{"type":"text","text":" again to retry."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The stream buffers only the newest snapshot: each yield is a complete entitlement state, so a slow consumer sees the latest value rather than replaying stale intermediate states."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A new stream first yields the customer info RevenueCat last delivered in this process, if any. RevenueCat may not have delivered one yet — on a relaunch with a fresh cache it skips the launch fetch — and then the stream stays silent until the next change, so dispatch "},{"type":"codeVoice","code":".refreshCustomerInfo"},{"type":"text","text":" alongside "},{"type":"codeVoice","code":".observeCustomerInfo"},{"type":"text","text":" to seed the state."}],"type":"paragraph"},{"anchor":"restorePurchases-async-throws-%3E-EntitlementSnapshot","text":"`restorePurchases() async throws -> EntitlementSnapshot`","type":"heading","level":4},{"inlineContent":[{"type":"text","text":"Maps the result of RevenueCat’s user-initiated "},{"type":"codeVoice","code":"restorePurchases()"},{"type":"text","text":" flow in every purchase-completion mode. Unlike "},{"type":"codeVoice","code":"syncPurchases()"},{"type":"text","text":", this flow refreshes the App Store receipt and can recover a subscription missing from the device receipt. It may show an App Store sign-in prompt and applies the RevenueCat project’s restore behavior when purchases belong to another app user ID. It throws "},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallError\/notConfigured","type":"reference","isActive":true},{"type":"text","text":" before configuration, "},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallError\/verificationFailed","type":"reference","isActive":true},{"type":"text","text":" for failed signature verification, or an SDK error."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The plugin’s "},{"type":"codeVoice","code":".restorePurchases"},{"type":"text","text":" action wraps this call and dispatches "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" on success or "},{"type":"codeVoice","code":".refreshFailed"},{"type":"text","text":" on error."}],"type":"paragraph"},{"anchor":"Identity-operations","text":"Identity operations","type":"heading","level":4},{"inlineContent":[{"type":"codeVoice","code":"logIn(appUserID:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"logOut()"},{"type":"text","text":" switch the RevenueCat identity and map the returned customer info with the same entitlement identifiers and verification policy as "},{"type":"codeVoice","code":"customerInfo()"},{"type":"text","text":". Their "},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallIdentityResult","type":"reference","isActive":true},{"type":"text","text":" reports the identity observed after the call, whether it differs from the identity observed before the call, and the mapped snapshot. An already-anonymous logout skips the SDK logout operation and may return "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for its snapshot when no cached customer info passes the verification policy."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Failed signature verification is rejected. With "},{"type":"codeVoice","code":"entitlementVerification: .disabled"},{"type":"text","text":", "},{"type":"codeVoice","code":".notRequested"},{"type":"text","text":" responses are accepted without a signature check."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"All package login\/logout calls are serialized through completion, including the deprecated namespace methods. Direct RevenueCat identity calls bypass that serialization. A returned result records the completed operation; later queued operations may change the identity again."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Both methods throw "},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallIdentityError","type":"reference","isActive":true},{"type":"text","text":" instead of exposing RevenueCat errors. The error records the operation, a package-owned reason, and the identity observed before and after the failure. A provider operation can change identity before a later request or verification step fails, so callers must inspect "},{"type":"codeVoice","code":"identityChanged"},{"type":"text","text":" rather than treating every thrown error as an unchanged identity."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Identity results do not reset "},{"type":"codeVoice","code":"PaywallState"},{"type":"text","text":", clear "},{"type":"codeVoice","code":"ResilientPaywallService"},{"type":"text","text":" caches, or reject delayed work from the previous identity. "},{"identifier":"https:\/\/github.com\/HeirloomLogic\/SwiduxRevenueCatPaywall\/issues\/46","type":"reference","isActive":true},{"type":"text","text":" owns that integration contract. The customer-info stream may later repeat a successful operation’s result, but a failed offline transition is not guaranteed to yield a stream value."}],"type":"paragraph"},{"anchor":"Entitlement-mapping","text":"Entitlement mapping","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"For every "},{"type":"codeVoice","code":"CustomerInfo"},{"type":"text","text":" the service receives:"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Configuration"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"isPro"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"hasPermanentLicense"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"entitlementID"},{"type":"text","text":" active"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"true"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"(next column)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"entitlementID"},{"type":"text","text":" inactive or missing"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"false"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"(next column)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"permanentLicenseEntitlementID == nil"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"—"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"false"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"permanentLicenseEntitlementID"},{"type":"text","text":" active"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"—"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"true"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"permanentLicenseEntitlementID"},{"type":"text","text":" inactive or missing"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"—"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"false"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"Both flags are checked independently against the same "},{"type":"codeVoice","code":"CustomerInfo"},{"type":"text","text":". A user with both active subscription and lifetime entitlements gets both flags set. See "},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping","type":"reference","isActive":true},{"type":"text","text":" for the reasoning behind the truth table."}],"type":"paragraph"}]}],"abstract":[{"text":"API reference for ","type":"text"},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":" — the RevenueCat-backed ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" conformer that the paywall plugin consumes.","type":"text"}],"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/UIComponentsReference":{"kind":"article","type":"topic","title":"UI Components Reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/UIComponentsReference","abstract":[{"type":"text","text":"API reference for the paywall, customer-center, and composed view modifiers in "},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":"."}],"url":"\/documentation\/swiduxrevenuecatpaywall\/uicomponentsreference","role":"article"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/MockServiceReference":{"kind":"article","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference","role":"article","url":"\/documentation\/swiduxrevenuecatpaywall\/mockservicereference","title":"Mock Service Reference","type":"topic","abstract":[{"text":"API reference for ","type":"text"},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"text":" — a controllable ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" conformer for previews and tests that does not touch ","type":"text"},{"code":"Purchases.shared","type":"codeVoice"},{"text":".","type":"text"}]},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/RevenueCatPaywallService":{"navigatorTitle":[{"kind":"identifier","text":"RevenueCatPaywallService"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"RevenueCatPaywallService"}],"type":"topic","title":"RevenueCatPaywallService","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallService","abstract":[{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" conformer backed by RevenueCat’s "},{"code":"Purchases.shared","type":"codeVoice"},{"type":"text","text":"."}],"url":"\/documentation\/swiduxrevenuecatpaywall\/revenuecatpaywallservice","role":"symbol"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/EntitlementMapping#Live-and-cached-customer-info":{"abstract":[],"url":"\/documentation\/swiduxrevenuecatpaywall\/entitlementmapping#Live-and-cached-customer-info","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping#Live-and-cached-customer-info","title":"Live and cached customer info","type":"topic","kind":"section"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/RevenueCatPaywallError/notConfigured":{"kind":"symbol","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallError\/notConfigured","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"notConfigured"}],"url":"\/documentation\/swiduxrevenuecatpaywall\/revenuecatpaywallerror\/notconfigured","title":"RevenueCatPaywallError.notConfigured","type":"topic","abstract":[{"text":"RevenueCat has not been configured, so the requested operation cannot start.","type":"text"}]},"https://github.com/HeirloomLogic/SwiduxRevenueCatPaywall/issues/46":{"url":"https:\/\/github.com\/HeirloomLogic\/SwiduxRevenueCatPaywall\/issues\/46","titleInlineContent":[{"text":"Issue #46","type":"text"}],"identifier":"https:\/\/github.com\/HeirloomLogic\/SwiduxRevenueCatPaywall\/issues\/46","title":"Issue #46","type":"link"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall":{"title":"SwiduxRevenueCatPaywall","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall","type":"topic","kind":"symbol","role":"collection","abstract":[{"type":"text","text":"RevenueCat adapter for Swidux’s "},{"code":"PaywallPlugin","type":"codeVoice"},{"type":"text","text":". Implements "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" against "},{"code":"Purchases.shared","type":"codeVoice"},{"type":"text","text":", ships a controllable mock for previews and tests, and pairs with "},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":" for drop-in "},{"code":"PaywallView","type":"codeVoice"},{"type":"text","text":" and "},{"code":"CustomerCenterView","type":"codeVoice"},{"type":"text","text":" presentation."}],"url":"\/documentation\/swiduxrevenuecatpaywall"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/RevenueCatPaywallIdentity":{"navigatorTitle":[{"kind":"identifier","text":"RevenueCatPaywallIdentity"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"RevenueCatPaywallIdentity"}],"type":"topic","title":"RevenueCatPaywallIdentity","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallIdentity","abstract":[{"type":"text","text":"A provider-independent description of the active purchase identity."}],"url":"\/documentation\/swiduxrevenuecatpaywall\/revenuecatpaywallidentity","role":"symbol"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/RevenueCatPaywallIdentityResult":{"navigatorTitle":[{"text":"RevenueCatPaywallIdentityResult","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RevenueCatPaywallIdentityResult","kind":"identifier"}],"type":"topic","title":"RevenueCatPaywallIdentityResult","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallIdentityResult","abstract":[{"type":"text","text":"The completed state of a login or logout operation."}],"url":"\/documentation\/swiduxrevenuecatpaywall\/revenuecatpaywallidentityresult","role":"symbol"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/EntitlementMapping":{"title":"Entitlement Mapping","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping","type":"topic","kind":"article","role":"article","abstract":[{"type":"text","text":"How RevenueCat’s "},{"code":"CustomerInfo.entitlements","type":"codeVoice"},{"type":"text","text":" translates to Swidux’s "},{"code":"EntitlementSnapshot","type":"codeVoice"},{"type":"text","text":"."}],"url":"\/documentation\/swiduxrevenuecatpaywall\/entitlementmapping"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToImplementService":{"kind":"article","type":"topic","title":"How to Implement the Service","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","abstract":[{"type":"text","text":"Wire "},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":" into the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin so the store sees real-time entitlement updates from RevenueCat."}],"url":"\/documentation\/swiduxrevenuecatpaywall\/howtoimplementservice","role":"article"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/RevenueCatPaywall/configure(apiKey:appUserID:userDefaults:logLevel:entitlementVerification:purchasesAreCompletedBy:storeKitVersion:)":{"title":"configure(apiKey:appUserID:userDefaults:logLevel:entitlementVerification:purchasesAreCompletedBy:storeKitVersion:)","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywall\/configure(apiKey:appUserID:userDefaults:logLevel:entitlementVerification:purchasesAreCompletedBy:storeKitVersion:)","type":"topic","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Configures the underlying purchase provider."}],"url":"\/documentation\/swiduxrevenuecatpaywall\/revenuecatpaywall\/configure(apikey:appuserid:userdefaults:loglevel:entitlementverification:purchasesarecompletedby:storekitversion:)","fragments":[{"kind":"keyword","text":"static"},{"text":" ","kind":"text"},{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"con