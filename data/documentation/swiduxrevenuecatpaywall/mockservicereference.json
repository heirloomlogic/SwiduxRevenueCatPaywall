{"kind":"article","primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"text":" tracks a ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"current","type":"text"}]},{"text":" entitlement snapshot, the way the real service reflects RevenueCat’s state: ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)","isActive":true,"type":"reference"},{"text":" updates it and delivers it to every open stream, and ","type":"text"},{"code":"customerInfo()","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"restorePurchases()","type":"codeVoice"},{"text":" return it. Streams fan out: each ","type":"text"},{"code":"customerInfoStream()","type":"codeVoice"},{"text":" call returns an independent stream, so two stores sharing one mock, or a ","type":"text"},{"code":"ResilientPaywallService","type":"codeVoice"},{"text":" wrapper plus the paywall plugin, all see the same transitions. ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/finish()","isActive":true,"type":"reference"},{"text":" ends the streams that are open at the time, and the ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/customerInfoError","isActive":true,"type":"reference"},{"text":" \/ ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/restoreError","isActive":true,"type":"reference"},{"text":" properties inject failures for testing error paths.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The mock departs from the real ","type":"text"},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":" in two deliberate ways, both for deterministic tests:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"A stream buffers every value its consumer has not read yet. The real stream keeps only the newest, so a slow consumer skips intermediate states; with the mock, a test that sends several snapshots before its consumer runs sees each one, in order.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A new stream always yields the current snapshot first. The real stream yields a first value only if RevenueCat has already delivered customer info in this process, and otherwise stays silent until the next change.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"This mock also differs from ","type":"text"},{"code":"MockPaywallService","type":"codeVoice"},{"text":" in SwiduxPaywall: that mock’s stream finishes after the initial yield, which is fine for static previews but cannot model purchase, refund, or family-share updates as a sequence.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For vendor-free previews and development builds, Swidux’s ","type":"text"},{"code":"SimulatedPaywallService","type":"codeVoice"},{"text":" (in ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":") is often the better fit: it is driven from the dev paywall UI in ","type":"text"},{"code":"SwiduxDevPaywallUI","type":"codeVoice"},{"text":", can simulate latency, and needs no RevenueCat dependency. Prefer this mock in tests that need a synchronous ","type":"text"},{"code":"send(_:)","type":"codeVoice"},{"text":", arbitrary injected errors, ","type":"text"},{"code":"finish()","type":"codeVoice"},{"text":", or delivery of repeated identical snapshots (","type":"text"},{"code":"SimulatedPaywallService","type":"codeVoice"},{"text":" drops a change equal to the current state).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For preview and test patterns built on this type, see ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Library-target","level":2,"type":"heading","text":"Library target"},{"items":[{"content":[{"inlineContent":[{"text":"Product: ","type":"text"},{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Import: ","type":"text"},{"code":"import SwiduxRevenueCatPaywall","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Types","level":2,"type":"heading","text":"Types"},{"anchor":"docSwiduxRevenueCatPaywalldocumentationSwiduxRevenueCatPaywallMockRevenueCatPaywallService","level":3,"type":"heading","text":"``doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService``"},{"syntax":"swift","code":["public final class MockRevenueCatPaywallService: PaywallService, Sendable {","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","","    public var customerInfoError: (any Error)?","    public var restoreError: (any Error)?","","    public func customerInfo() async throws -> EntitlementSnapshot","    public func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    public func restorePurchases() async throws -> EntitlementSnapshot","","    public func send(_ snapshot: EntitlementSnapshot)","    public func finish()","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reference type. Internal state lives behind a "},{"code":"Synchronization.Mutex","type":"codeVoice"},{"type":"text","text":", so the type is checked "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" and can be shared across actors and tasks."}]},{"anchor":"Initializer","level":4,"type":"heading","text":"Initializer"},{"syntax":"swift","code":["public init(isPro: Bool = false, hasPermanentLicense: Bool = false)"],"type":"codeListing"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"isPro","type":"codeVoice"},{"text":" — Initial value for ","type":"text"},{"code":"EntitlementSnapshot.isPro","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"hasPermanentLicense","type":"codeVoice"},{"text":" — Initial value for ","type":"text"},{"code":"EntitlementSnapshot.hasPermanentLicense","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The values supplied here become the starting "},{"type":"emphasis","inlineContent":[{"type":"text","text":"current"}]},{"type":"text","text":" snapshot — what "},{"code":"customerInfo()","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"restorePurchases()","type":"codeVoice"},{"type":"text","text":" return and what "},{"code":"customerInfoStream()","type":"codeVoice"},{"type":"text","text":" yields first, until "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)"},{"type":"text","text":" replaces it."}]},{"anchor":"customerInfoError--restoreError","level":4,"type":"heading","text":"`customerInfoError` \/ `restoreError`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional errors thrown by "},{"code":"customerInfo()","type":"codeVoice"},{"type":"text","text":" and "},{"code":"restorePurchases()","type":"codeVoice"},{"type":"text","text":" respectively while set ("},{"code":"nil","type":"codeVoice"},{"type":"text","text":", the default, means success). Set them to drive the plugin’s "},{"code":".refreshFailed","type":"codeVoice"},{"type":"text","text":" path, retry affordances, or "},{"code":"ResilientPaywallService","type":"codeVoice"},{"type":"text","text":"’s last-known-good fallback; clear them to restore success."}]},{"anchor":"customerInfo-async-throws-%3E-EntitlementSnapshot","level":4,"type":"heading","text":"`customerInfo() async throws -> EntitlementSnapshot`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns the current snapshot — the init-time state, or the latest value passed to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)"},{"type":"text","text":". This matches the real service: the plugin’s dismiss-triggered refresh sees the same state the stream delivered, so a simulated purchase does not regress to free on refresh. Throws "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/customerInfoError"},{"type":"text","text":" instead when it is set."}]},{"anchor":"customerInfoStream-%3E-AsyncStream%3CEntitlementSnapshot%3E","level":4,"type":"heading","text":"`customerInfoStream() -> AsyncStream<EntitlementSnapshot>`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns a new stream that yields the current snapshot, then every value passed to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)"},{"type":"text","text":". Each call returns an independent stream, and every open stream receives every "},{"code":"send(_:)","type":"codeVoice"},{"type":"text","text":". A stream stays open until "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/finish()"},{"type":"text","text":" is called while it is open, or until its consumer cancels or drops it; cancelling one stream does not affect the others."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The stream uses unbounded buffering on purpose, so a test observes every transition in order even when it sends faster than its consumer reads. The real service buffers only the newest value."}]},{"anchor":"restorePurchases-async-throws-%3E-EntitlementSnapshot","level":4,"type":"heading","text":"`restorePurchases() async throws -> EntitlementSnapshot`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns the current snapshot, exactly like "},{"code":"customerInfo()","type":"codeVoice"},{"type":"text","text":". Throws "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/restoreError"},{"type":"text","text":" instead when it is set."}]},{"anchor":"docSwiduxRevenueCatPaywalldocumentationSwiduxRevenueCatPaywallMockRevenueCatPaywallServicesend","level":4,"type":"heading","text":"``doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)``"},{"syntax":"swift","code":["public func send(_ snapshot: EntitlementSnapshot)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Makes the snapshot current and delivers it to every open stream. With no open stream, the snapshot is still recorded, and the next stream yields it first. Identical consecutive snapshots are each delivered."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this to simulate purchase, expiration, or family-share updates during a test."}]},{"anchor":"docSwiduxRevenueCatPaywalldocumentationSwiduxRevenueCatPaywallMockRevenueCatPaywallServicefinish","level":4,"type":"heading","text":"``doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/finish()``"},{"syntax":"swift","code":["public func finish()"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Finishes every stream that is open when called. Consumers receive any values still buffered, then their iterators return "},{"code":"nil","type":"codeVoice"},{"type":"text","text":". The mock stays usable: "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)"},{"type":"text","text":" keeps updating the current snapshot, and a stream requested afterwards is a fresh, live stream that yields the current snapshot and later sends."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call this in test teardown or when a preview is done observing entitlement transitions."}]},{"anchor":"Lifecycle-example","level":2,"type":"heading","text":"Lifecycle example"},{"syntax":"swift","code":["let mock = MockRevenueCatPaywallService(isPro: false)","let stream = mock.customerInfoStream()","","var iterator = stream.makeAsyncIterator()","let initial = await iterator.next()  \/\/ EntitlementSnapshot(isPro: false, ...)","","mock.send(EntitlementSnapshot(isPro: true))","let updated = await iterator.next()  \/\/ EntitlementSnapshot(isPro: true, ...)","","mock.finish()","let terminal = await iterator.next()  \/\/ nil — stream finished","","let refreshed = try await mock.customerInfo()  \/\/ EntitlementSnapshot(isPro: true, ...) — send(_:) updated it"],"type":"codeListing"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxrevenuecatpaywall\/mockservicereference"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"abstract":[{"type":"text","text":"API reference for "},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":" — a controllable "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" conformer for previews and tests that does not touch "},{"code":"Purchases.shared","type":"codeVoice"},{"type":"text","text":"."}],"sections":[],"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/ServiceReference","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService"],"title":"Related Documentation"},{"anchor":"Reference","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/ServiceReference","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/UIComponentsReference"],"title":"Reference","generated":true}],"metadata":{"role":"article","title":"Mock Service Reference","roleHeading":"Article","modules":[{"name":"SwiduxRevenueCatPaywall"}]},"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/MockRevenueCatPaywallService/restoreError":{"url":"\/documentation\/swiduxrevenuecatpaywall\/mockrevenuecatpaywallservice\/restoreerror","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"restoreError","kind":"identifier"},{"text":": (any ","kind":"text"},{"text":"Error","kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP"},{"text":")?","kind":"text"}],"role":"symbol","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/restoreError","type":"topic","abstract":[{"type":"text","text":"Error thrown by "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/restorePurchases()"},{"type":"text","text":" while set. "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" (the default) means success."}],"kind":"symbol","title":"restoreError"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToPreviewAndTest":{"type":"topic","abstract":[{"type":"text","text":"Drive entitlement state from SwiftUI previews and tests with "},{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"type":"text","text":" — no RevenueCat SDK call required."}],"kind":"article","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest","url":"\/documentation\/swiduxrevenuecatpaywall\/howtopreviewandtest","role":"article","title":"How to Preview and Test"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/MockRevenueCatPaywallService/customerInfo()":{"role":"symbol","title":"customerInfo()","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/customerInfo()","kind":"symbol","abstract":[{"text":"Returns the current snapshot — the init-time state, or the latest value passed to","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)","type":"reference","isActive":true},{"text":".","type":"text"}],"url":"\/documentation\/swiduxrevenuecatpaywall\/mockrevenuecatpaywallservice\/customerinfo()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"customerInfo","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"EntitlementSnapshot","kind":"typeIdentifier","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV"}],"type":"topic"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall":{"title":"SwiduxRevenueCatPaywall","role":"collection","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall","type":"topic","abstract":[{"type":"text","text":"RevenueCat adapter for Swidux’s "},{"type":"codeVoice","code":"PaywallPlugin"},{"type":"text","text":". Implements "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" against "},{"code":"Purchases.shared","type":"codeVoice"},{"type":"text","text":", ships a controllable mock for previews and tests, and pairs with "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":" for drop-in "},{"code":"PaywallView","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"CustomerCenterView","type":"codeVoice"},{"text":" presentation.","type":"text"}],"kind":"symbol","url":"\/documentation\/swiduxrevenuecatpaywall"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/MockRevenueCatPaywallService/restorePurchases()":{"url":"\/documentation\/swiduxrevenuecatpaywall\/mockrevenuecatpaywallservice\/restorepurchases()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"restorePurchases","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"EntitlementSnapshot","kind":"typeIdentifier","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV"}],"role":"symbol","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/restorePurchases()","type":"topic","abstract":[{"type":"text","text":"Returns the current snapshot — the init-time state, or the latest value passed to"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)"},{"type":"text","text":"."}],"kind":"symbol","title":"restorePurchases()"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/MockRevenueCatPaywallService/customerInfoStream()":{"url":"\/documentation\/swiduxrevenuecatpaywall\/mockrevenuecatpaywallservice\/customerinfostream()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"customerInfoStream","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"AsyncStream","kind":"typeIdentifier","preciseIdentifier":"s:ScS"},{"text":"<","kind":"text"},{"text":"EntitlementSnapshot","kind":"typeIdentifier","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV"},{"text":">","kind":"text"}],"role":"symbol","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/customerInfoStream()","type":"topic","abstract":[{"type":"text","text":"Returns a new stream that yields the current snapshot, then every value passed to"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)"},{"type":"text","text":"."}],"kind":"symbol","title":"customerInfoStream()"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/MockRevenueCatPaywallService/customerInfoError":{"role":"symbol","title":"customerInfoError","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/customerInfoError","kind":"symbol","abstract":[{"text":"Error thrown by ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/customerInfo()","type":"reference","isActive":true},{"text":" while set. ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" (the default) means success.","type":"text"}],"url":"\/documentation\/swiduxrevenuecatpaywall\/mockrevenuecatpaywallservice\/customerinfoerror","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"customerInfoError","kind":"identifier"},{"text":": (any ","kind":"text"},{"text":"Error","kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP"},{"text":")?","kind":"text"}],"type":"topic"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/ServiceReference":{"abstract":[{"type":"text","text":"API reference for "},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":" — the RevenueCat-backed "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" conformer that the paywall plugin consumes."}],"role":"article","url":"\/documentation\/swiduxrevenuecatpaywall\/servicereference","kind":"article","type":"topic","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/ServiceReference","title":"Service Reference"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/MockRevenueCatPaywallService":{"url":"\/documentation\/swiduxrevenuecatpaywall\/mockrevenuecatpaywallservice","navigatorTitle":[{"text":"MockRevenueCatPaywallService","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MockRevenueCatPaywallService","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService","type":"topic","abstract":[{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" conformer for previews and tests with a controllable entitlement stream."}],"kind":"symbol","title":"MockRevenueCatPaywallService"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/MockRevenueCatPaywallService/finish()":{"type":"topic","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"finish","kind":"identifier"},{"text":"()","kind":"text"}],"abstract":[{"text":"Finishes every stream that is open when called.","type":"text"}],"url":"\/documentation\/swiduxrevenuecatpaywall\/mockrevenuecatpaywallservice\/finish()","title":"finish()","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/finish()","role":"symbol"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/MockRevenueCatPaywallService/send(_:)":{"url":"\/documentation\/swiduxrevenuecatpaywall\/mockrevenuecatpaywallservice\/send(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"send"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"EntitlementSnapshot","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV"},{"kind":"text","text":")"}],"role":"symbol","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)","type":"topic","abstract":[{"type":"text","text":"Makes "},{"code":"snapshot","type":"codeVoice"},{"type":"text","text":" current and delivers it to every open "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/customerInfoStream()"},{"text":".","type":"text"}],"kind":"symbol","title":"send(_:)"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/UIComponentsReference":{"type":"topic","kind":"article","abstract":[{"text":"API reference for the paywall, customer-center, and composed view modifiers in ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/swiduxrevenuecatpaywall\/uicomponentsreference","title":"UI Components Reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/UIComponentsReference","role":"article"}}}