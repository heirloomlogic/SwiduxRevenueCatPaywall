{"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"role":"symbol","roleHeading":"Instance Method","modules":[{"name":"SwiduxRevenueCatPaywall"}],"symbolKind":"method","externalID":"s:23SwiduxRevenueCatPaywall0bcD7ServiceV18customerInfoStreamScSy0aD019EntitlementSnapshotVGyF","title":"customerInfoStream()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"customerInfoStream","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:ScS","text":"AsyncStream","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV","text":"EntitlementSnapshot","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"kind":"symbol","identifier":{"url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallService\/customerInfoStream()","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallService"]]},"abstract":[{"text":"Returns a long-lived stream of entitlement snapshots derived from","type":"text"},{"text":" ","type":"text"},{"code":"Purchases.shared.customerInfoStream","type":"codeVoice"},{"text":".","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"customerInfoStream"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:ScS","kind":"typeIdentifier","text":"AsyncStream"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV","kind":"typeIdentifier","text":"EntitlementSnapshot"},{"kind":"text","text":">"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Yields a new "},{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":" every time RevenueCat reports a change to the user’s"},{"type":"text","text":" "},{"type":"text","text":"customer info — purchase, refund, family-share update, sandbox renewal. The stream"},{"type":"text","text":" "},{"type":"text","text":"finishes when the underlying RevenueCat stream finishes; the paywall plugin’s"},{"type":"text","text":" "},{"type":"codeVoice","code":".observeCustomerInfo"},{"type":"text","text":" effect normally keeps it alive for the duration of the session."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A new stream first yields the customer info RevenueCat last delivered in this process, if"},{"type":"text","text":" "},{"type":"text","text":"any. RevenueCat may not have delivered one yet — on a relaunch with a fresh cache it skips"},{"type":"text","text":" "},{"type":"text","text":"the launch fetch — and then the stream stays silent until the next change. Dispatch"},{"type":"text","text":" "},{"type":"codeVoice","code":".refreshCustomerInfo"},{"type":"text","text":" alongside "},{"type":"codeVoice","code":".observeCustomerInfo"},{"type":"text","text":" to seed the state."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If RevenueCat has not been configured, the stream finishes immediately. Configure RevenueCat, then call this method again to start a live stream."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxrevenuecatpaywall\/revenuecatpaywallservice\/customerinfostream()"]}],"sections":[],"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/RevenueCatPaywallService/customerInfoStream()":{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallService\/customerInfoStream()","type":"topic","abstract":[{"type":"text","text":"Returns a long-lived stream of entitlement snapshots derived from"},{"ty