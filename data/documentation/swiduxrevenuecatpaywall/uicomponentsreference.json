{"sections":[],"identifier":{"url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/UIComponentsReference","interfaceLanguage":"swift"},"kind":"article","seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior"]},{"anchor":"Reference","title":"Reference","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/ServiceReference","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference"],"generated":true}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The UI product layers three view modifiers on top of ","type":"text"},{"code":"RevenueCatUI","type":"codeVoice"},{"text":". Two primitives present the paywall and customer center directly from a ","type":"text"},{"code":"Binding<Bool>","type":"codeVoice"},{"text":"; one convenience modifier composes both, driven by ","type":"text"},{"code":"PaywallState","type":"codeVoice"},{"text":". Each presentation modifier attaches to the modified content view directly — there are no ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" wrappers and no ","type":"text"},{"code":".background { … }","type":"codeVoice"},{"text":" indirection. This shape is what makes the macOS sheet machinery present reliably.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For step-by-step wiring, see ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"How to Present the UI","type":"text"}]},{"text":" in the ","type":"text"},{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"text":" documentation. For the rationale behind platform-specific behavior, see ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Platform Behavior","type":"text"}]},{"text":" in the same catalog.","type":"text"}]},{"text":"Library target","type":"heading","level":2,"anchor":"Library-target"},{"items":[{"content":[{"inlineContent":[{"text":"Product: ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Import: ","type":"text"},{"code":"import SwiduxRevenueCatPaywallUI","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"code":"Package.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":[".product(name: \"SwiduxRevenueCatPaywallUI\", package: \"SwiduxRevenueCatPaywall\"),"]},{"type":"paragraph","inlineContent":[{"text":"The UI product depends on ","type":"text"},{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"RevenueCatUI","type":"codeVoice"},{"text":", both pulled in transitively. Apps that don’t ship paywall UI in the same target (for example, a tests-only target) can depend on the lower-level ","type":"text"},{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"text":" product alone.","type":"text"}]},{"text":"Modifiers","type":"heading","level":2,"anchor":"Modifiers"},{"text":"`revenueCatPaywall(isPresented:offeringIdentifier:displayCloseButton:fonts:presentationStyle:purchaseLogic:onEvent:onDismiss:)`","type":"heading","level":3,"anchor":"revenueCatPaywallisPresentedofferingIdentifierdisplayCloseButtonfontspresentationStylepurchaseLogiconEventonDismiss"},{"type":"codeListing","syntax":"swift","code":["extension View {","    public func revenueCatPaywall(","        isPresented: Binding<Bool>,","        offeringIdentifier: String? = nil,","        displayCloseButton: Bool = true,","        fonts: any PaywallFontProvider = DefaultPaywallFontProvider(),","        presentationStyle: RevenueCatPaywallPresentationStyle = .automatic,","        purchaseLogic: RevenueCatPaywallPurchaseLogic? = nil,","        onEvent: RevenueCatPaywallEventHandler? = nil,","        onDismiss: (() -> Void)? = nil","    ) -> some View","}"]},{"type":"paragraph","inlineContent":[{"text":"Attaches ","type":"text"},{"code":"RevenueCatUI.PaywallView","type":"codeVoice"},{"text":" as a platform-appropriate sheet.","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"iOS"}]},{"text":" — The automatic style uses a full-screen cover at compact width and a sheet at regular width.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"macOS"}]},{"text":" — Presents in a ","type":"text"},{"code":"sheet","type":"codeVoice"},{"text":" sized to a 400×600 minimum.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Pass a real two-way binding; SwiftUI sets it to ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" on user dismissal. Build it from ","type":"text"},{"code":"PaywallState.isPresented","type":"codeVoice"},{"text":" so the ","type":"text"},{"code":"set:","type":"codeVoice"},{"text":" closure dispatches ","type":"text"},{"code":".paywall(.dismiss)","type":"codeVoice"},{"text":" and the plugin clears its presentation state.","type":"text"}]},{"text":"Parameters","type":"heading","level":4,"anchor":"Parameters"},{"items":[{"content":[{"inlineContent":[{"code":"isPresented","type":"codeVoice"},{"text":" — Two-way binding to the paywall’s visibility flag.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"offeringIdentifier","type":"codeVoice"},{"text":" — Identifier of the RevenueCat offering to present, for a win-back or regional offer. Defaults to ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", which presents the dashboard’s current offering. An unknown identifier asserts in Debug and falls back to the current offering with a logged warning; a fetch failure also falls back without asserting.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"displayCloseButton","type":"codeVoice"},{"text":" — Whether ","type":"text"},{"code":"PaywallView","type":"codeVoice"},{"text":" shows a close button. Defaults to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":". When ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", iOS sheets disable interactive dismissal. On macOS, Escape dismisses only when this is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"fonts","type":"codeVoice"},{"text":" — RevenueCatUI font provider used by every resolved paywall.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"presentationStyle","type":"codeVoice"},{"text":" — ","type":"text"},{"code":".automatic","type":"codeVoice"},{"text":" adapts to iOS width and uses a sheet on macOS. iOS callers can force ","type":"text"},{"code":".sheet","type":"codeVoice"},{"text":" or ","type":"text"},{"code":".fullScreen","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"purchaseLogic","type":"codeVoice"},{"text":" — App-owned StoreKit 2 purchase and restore operations for ","type":"text"},{"code":"purchasesAreCompletedBy: .myApp","type":"codeVoice"},{"text":". Leave ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when RevenueCat completes purchases.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"onEvent","type":"codeVoice"},{"text":" — Optional callback for package-owned purchase, restore, cancellation, purchase-failure, and restore-failure values. It exposes Foundation identifiers and error fields instead of RevenueCat models.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"onDismiss","type":"codeVoice"},{"text":" — Optional callback fired after dismissal.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Dashboard exit offers do not run through these modifiers. RevenueCatUI implements them in its own ","type":"text"},{"code":"presentPaywall","type":"codeVoice"},{"text":" modifiers, which always add a close button; using that path here would change ","type":"text"},{"code":"displayCloseButton: false","type":"codeVoice"},{"text":" from a hard paywall into a dismissible one. Apps that need exit offers should use RevenueCatUI’s presenter directly.","type":"text"}]},{"text":"`revenueCatCustomerCenter(isPresented:onDismiss:)`","type":"heading","level":3,"anchor":"revenueCatCustomerCenterisPresentedonDismiss"},{"type":"codeListing","syntax":"swift","code":["extension View {","    public func revenueCatCustomerCenter(","        isPresented: Binding<Bool>,","        onDismiss: (() -> Void)? = nil","    ) -> some View","}"]},{"type":"paragraph","inlineContent":[{"text":"Attaches the customer center as a platform-appropriate sheet.","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"iOS"}]},{"text":" — Presents ","type":"text"},{"code":"RevenueCatUI.CustomerCenterView","type":"codeVoice"},{"text":" in a ","type":"text"},{"code":"sheet","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"macOS"}]},{"text":" — Opens ","type":"text"},{"code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions","type":"codeVoice"},{"text":" through SwiftUI’s ","type":"text"},{"code":"openURL","type":"codeVoice"},{"text":" environment action (falling back to the ","type":"text"},{"code":"https:\/\/apps.apple.com\/account\/subscriptions","type":"codeVoice"},{"text":" web URL if nothing handles the ","type":"text"},{"code":"itms-apps","type":"codeVoice"},{"text":" scheme), immediately clears the binding, and fires ","type":"text"},{"code":"onDismiss","type":"codeVoice"},{"text":". RevenueCatUI does not ship a customer center on macOS.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Parameters","type":"heading","level":4,"anchor":"Parameters"},{"items":[{"content":[{"inlineContent":[{"code":"isPresented","type":"codeVoice"},{"text":" — Two-way binding to the customer center’s visibility flag.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"onDismiss","type":"codeVoice"},{"text":" — Optional callback fired after dismissal (or, on macOS, after the App Store URL is opened).","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"`revenueCatPaywallAndCustomerCenter(state:offeringIdentifier:displayCloseButton:fonts:presentationStyle:purchaseLogic:onEvent:onAction:)`","type":"heading","level":3,"anchor":"revenueCatPaywallAndCustomerCenterstateofferingIdentifierdisplayCloseButtonfontspresentationStylepurchaseLogiconEventonAction"},{"type":"codeListing","syntax":"swift","code":["extension View {","    public func revenueCatPaywallAndCustomerCenter(","        state: PaywallState,","        offeringIdentifier: String? = nil,","        displayCloseButton: Bool = true,","        fonts: any PaywallFontProvider = DefaultPaywallFontProvider(),","        presentationStyle: RevenueCatPaywallPresentationStyle = .automatic,","        purchaseLogic: RevenueCatPaywallPurchaseLogic? = nil,","        onEvent: RevenueCatPaywallEventHandler? = nil,","        onAction: @escaping (PaywallAction) -> Void","    ) -> some View","}"]},{"type":"paragraph","inlineContent":[{"text":"Convenience modifier that attaches both primitive presentation surfaces and dispatches the matching actions through ","type":"text"},{"code":"onAction","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"On iOS the two presentations are mutually exclusive and the paywall wins. On macOS a customer-center request dispatches ","type":"text"},{"code":".openManageSubscriptions","type":"codeVoice"},{"text":" through the paywall plugin, then ","type":"text"},{"code":".dismissCustomerCenter","type":"codeVoice"},{"text":"; the external App Store hand-off remains available while the paywall sheet is open. After a restore inside the paywall, the modifier also dispatches ","type":"text"},{"code":".dismiss","type":"codeVoice"},{"text":" once ","type":"text"},{"code":"state.isGateSatisfied","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", because RevenueCatUI does not dismiss after a restore. Attach the modifier once to one app-wide presentation host. See ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Platform Behavior","type":"text"}]},{"text":" in the ","type":"text"},{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"text":" documentation.","type":"text"}]},{"text":"Parameters","type":"heading","level":4,"anchor":"Parameters"},{"items":[{"content":[{"inlineContent":[{"code":"state","type":"codeVoice"},{"text":" — The paywall slice from your store, typically ","type":"text"},{"code":"store.paywall","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"offeringIdentifier","type":"codeVoice"},{"text":" — Identifier of the RevenueCat offering to present. When it is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", ","type":"text"},{"code":"state.requestedReason","type":"codeVoice"},{"text":" is used as a RevenueCat placement identifier. For an unknown placement, RevenueCat may return the dashboard’s placement fallback offering, which can differ from the current offering; the package uses the current offering when RevenueCat returns no placement fallback. An explicit identifier takes precedence.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"displayCloseButton","type":"codeVoice"},{"text":" — Whether ","type":"text"},{"code":"PaywallView","type":"codeVoice"},{"text":" shows a close button. Defaults to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":"; see the primitive modifier above.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"fonts","type":"codeVoice"},{"text":" — RevenueCatUI font provider used by the paywall.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"presentationStyle","type":"codeVoice"},{"text":" — Automatic or explicit iOS presentation style; macOS always uses a sheet.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"purchaseLogic","type":"codeVoice"},{"text":" — App-owned StoreKit 2 purchase and restore operations for ","type":"text"},{"code":"purchasesAreCompletedBy: .myApp","type":"codeVoice"},{"text":". Leave ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when RevenueCat completes purchases.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"onEvent","type":"codeVoice"},{"text":" — Optional package-owned outcome callback; see the primitive modifier above.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"onAction","type":"codeVoice"},{"text":" — A closure that lifts a ","type":"text"},{"code":"PaywallAction","type":"codeVoice"},{"text":" into your root action and dispatches it through the store. Typically ","type":"text"},{"code":"{ store.send(.paywall($0)) }","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Manual wiring","type":"heading","level":4,"anchor":"Manual-wiring"},{"type":"codeListing","syntax":"swift","code":["ContentView()","    .revenueCatPaywall(","        isPresented: Binding(","            get: { store.paywall.isPresented },","            set: { if !$0 { store.send(.paywall(.dismiss)) } }","        )","    )","    .revenueCatCustomerCenter(","        isPresented: Binding(","            get: { store.paywall.isCustomerCenterPresented },","            set: { if !$0 { store.send(.paywall(.dismissCustomerCenter)) } }","        )","    )"]},{"type":"paragraph","inlineContent":[{"text":"This attaches the same presentation surfaces but leaves the iOS exclusivity and close-after-restore rules to the app. Use the convenience modifier when both surfaces are needed; use the primitives when only one is needed or when you want to interleave other modifiers between them.","type":"text"}]}]}],"abstract":[{"text":"API reference for the paywall, customer-center, and composed view modifiers in ","type":"text"},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"text":".","type":"text"}],"metadata":{"title":"UI Components Reference","modules":[{"name":"SwiduxRevenueCatPaywall"}],"roleHeading":"Article","role":"article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxrevenuecatpaywall\/uicomponentsreference"]}],"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/ServiceReference":{"abstract":[{"type":"text","text":"API reference for "},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":" — the RevenueCat-backed "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" conformer that the paywall plugin consumes."}],"role":"article","url":"\/documentation\/swiduxrevenuecatpaywall\/servicereference","kind":"article","type":"topic","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/ServiceReference","title":"Service Reference"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/PlatformBehavior":{"abstract":[{"type":"text","text":"How the paywall and customer-center modifiers choose presentation, and which controls remain fixed."}],"role":"article","url"