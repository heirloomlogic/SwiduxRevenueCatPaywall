{"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxrevenuecatpaywall\/howtopreviewandtest"]}],"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"text":" is a ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"text":" conformer that tracks a ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"current"}]},{"text":" snapshot, the way the real service reflects RevenueCat’s state: ","type":"text"},{"type":"codeVoice","code":"send(_:)"},{"text":" updates it and delivers it to every open stream, ","type":"text"},{"type":"codeVoice","code":"customerInfo()"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"restorePurchases()"},{"text":" return it, and ","type":"text"},{"type":"codeVoice","code":"finish()"},{"text":" ends the open streams. Plug it into the same ","type":"text"},{"type":"codeVoice","code":"PaywallPlugin"},{"text":" you use in production. Drive entitlement transitions from your test or preview body.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For the API reference, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Why a different mock from SwiduxPaywall’s","type":"heading","anchor":"Why-a-different-mock-from-SwiduxPaywalls","level":2},{"inlineContent":[{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" ships its own ","type":"text"},{"type":"codeVoice","code":"MockPaywallService"},{"text":" whose stream finishes after the initial yield. That works for static “Pro” and “Free” previews but cannot model purchase, refund, or family-share transitions as a sequence. ","type":"text"},{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"text":" keeps the stream open until you call ","type":"text"},{"type":"codeVoice","code":"finish()"},{"text":", which lets a single test verify the store reacts correctly to an ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"order"}]},{"text":" of snapshots.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When you only need a static state (one snapshot, one render pass), either mock works. When you need a sequence, use this one.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The mock is built for deterministic tests, so it differs from the real ","type":"text"},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"text":" in two ways: a stream buffers every value its consumer has not read yet (the real stream keeps only the newest), and a new stream always yields the current snapshot first (the real stream does so only if RevenueCat has already delivered customer info in this process). Don’t rely on either behavior to prove production code correct.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Swidux’s ","type":"text"},{"type":"codeVoice","code":"SimulatedPaywallService"},{"text":" (in ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":") is the other option. It is an actor driven from the dev paywall UI in ","type":"text"},{"type":"codeVoice","code":"SwiduxDevPaywallUI"},{"text":", can simulate latency, and needs no RevenueCat dependency, which makes it the better fit for vendor-free previews and development builds. Prefer ","type":"text"},{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"text":" in tests that need a synchronous ","type":"text"},{"type":"codeVoice","code":"send(_:)"},{"text":", arbitrary injected errors, ","type":"text"},{"type":"codeVoice","code":"finish()"},{"text":", or delivery of repeated identical snapshots — ","type":"text"},{"type":"codeVoice","code":"SimulatedPaywallService"},{"text":" drops a change equal to the current state.","type":"text"}],"type":"paragraph"},{"text":"Step 1: Make the service injectable","type":"heading","anchor":"Step-1-Make-the-service-injectable","level":2},{"inlineContent":[{"text":"Plumb the service through your ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":" factory so previews and tests can override it:","type":"text"}],"type":"paragraph"},{"code":["extension Store where State == AppState, Action == AppAction {","    static func configured(","        paywallService: any PaywallService = RevenueCatPaywallService(entitlementID: \"pro\")","    ) -> AppStore {","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(","            PaywallPlugin<AppState, AppAction>(","                state: \\.paywall,","                action: AppAction.paywall,","                extractAction: { if case .paywall(let a) = $0 { return a }; return nil },","                service: paywallService","            )","        )","        return Store(initialState: AppState(), reducer: AppReducer().reduce, plugins: plugins)","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The default keeps the live RevenueCat path for app launch. Previews and tests pass an override."}],"type":"paragraph"},{"text":"Step 2: Static previews — pick a state","type":"heading","anchor":"Step-2-Static-previews-pick-a-state","level":2},{"inlineContent":[{"type":"text","text":"Use the configured-state form when one snapshot is enough:"}],"type":"paragraph"},{"code":["#Preview(\"Free\") {","    let store = AppStore.configured(","        paywallService: MockRevenueCatPaywallService()","    )","    return ContentView().environment(store)","}","","#Preview(\"Pro\") {","    let store = AppStore.configured(","        paywallService: MockRevenueCatPaywallService(isPro: true)","    )","    return ContentView().environment(store)","}","","#Preview(\"Lifetime\") {","    let store = AppStore.configured(","        paywallService: MockRevenueCatPaywallService(hasPermanentLicense: true)","    )","    return ContentView().environment(store)","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Each preview gets its own store. The store starts from "},{"code":"PaywallState","type":"codeVoice"},{"type":"text","text":"‘s free default; when the root view’s "},{"code":".task","type":"codeVoice"},{"type":"text","text":" dispatches "},{"code":".observeCustomerInfo","type":"codeVoice"},{"type":"text","text":" and "},{"code":".refreshCustomerInfo","type":"codeVoice"},{"type":"text","text":" (as in "},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/GettingStarted","type":"reference","isActive":true},{"type":"text","text":"), the mock answers with its initial snapshot and the gate updates. Effects run asynchronously, so that happens just after the first render, not before it — the first frame of the “Pro” and “Lifetime” previews briefly shows the free state."}],"type":"paragraph"},{"text":"Step 3: Driving transitions in a test","type":"heading","anchor":"Step-3-Driving-transitions-in-a-test","level":2},{"inlineContent":[{"type":"text","text":"When the test cares about a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"sequence"}]},{"type":"text","text":" of states — for example, the gate flipping to "},{"code":"true","type":"codeVoice"},{"type":"text","text":" after a purchase and back to "},{"code":"false","type":"codeVoice"},{"type":"text","text":" after a refund — use the streaming form."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Swidux runs effects as unstructured tasks, so a state change driven by an effect lands at some later point: after "},{"code":"store.send(_:)","type":"codeVoice"},{"type":"text","text":" or "},{"code":"mock.send(_:)","type":"codeVoice"},{"type":"text","text":" returns, no fixed number of "},{"code":"await Task.yield()","type":"codeVoice"},{"type":"text","text":" calls guarantees the store has caught up. Poll for the state you expect with a bounded wait instead. Add a helper like this one to your test target:"}],"type":"paragraph"},{"code":["import Testing","","\/\/\/ Polls `condition` on the main actor until it holds; records a failure and throws once","\/\/\/ `timeout` elapses without it holding.","@MainActor","func waitUntil(","    timeout: Duration = .seconds(1),","    sourceLocation: SourceLocation = #_sourceLocation,","    _ condition: () -> Bool",") async throws {","    let deadline = ContinuousClock.now + timeout","    while !condition() {","        guard ContinuousClock.now < deadline else {","            try #require(condition(), \"Timed out after \\(timeout)\", sourceLocation: sourceLocation)","            return","        }","        try await Task.sleep(for: .milliseconds(10))","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Store tests run on the main actor, because "},{"code":"Store","type":"codeVoice"},{"type":"text","text":" and its "},{"code":"send(_:)","type":"codeVoice"},{"type":"text","text":" are "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["@Test(\"Store follows entitlement transitions: purchase, then refund\")","@MainActor","func storeFollowsEntitlementTransitions() async throws {","    let mock = MockRevenueCatPaywallService(isPro: false)","    let store = AppStore.configured(paywallService: mock)","    store.send(.paywall(.observeCustomerInfo))","","    mock.send(EntitlementSnapshot(isPro: true))","    try await waitUntil { store.paywall.isPro }","","    mock.send(EntitlementSnapshot(isPro: false))","    try await waitUntil { !store.paywall.isPro }","","    mock.finish()","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Each "},{"code":"send(_:)","type":"codeVoice"},{"type":"text","text":" makes the snapshot current and delivers it to every open stream — here, the one the plugin’s "},{"code":"observeCustomerInfo","type":"codeVoice"},{"type":"text","text":" effect consumes. The effect dispatches "},{"code":".customerInfoUpdated","type":"codeVoice"},{"type":"text","text":", the plugin updates "},{"code":"store.paywall","type":"codeVoice"},{"type":"text","text":", and the wait sees the new value. The stream delivers values in order and buffers them until the effect reads them, so a "},{"code":"send(_:)","type":"codeVoice"},{"type":"text","text":" that runs before the effect has subscribed is not lost: the new stream yields the current snapshot first. Because "},{"code":"customerInfo()","type":"codeVoice"},{"type":"text","text":" also returns the sent snapshot, the refresh the plugin dispatches when the paywall is dismissed sees the purchased state too — the gate never regresses to the init-time value mid-test."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Streams fan out, so one mock can feed several consumers at once — two stores, or a "},{"code":"ResilientPaywallService","type":"codeVoice"},{"type":"text","text":" wrapper alongside your own reader — and each receives every "},{"code":"send(_:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Step 4: Driving transitions in a preview","type":"heading","anchor":"Step-4-Driving-transitions-in-a-preview","level":2},{"inlineContent":[{"type":"text","text":"Previews can drive transitions too — useful for verifying paywall sheet copy across states without running the app:"}],"type":"paragraph"},{"code":["#Preview(\"Purchase flow\") {","    let mock = MockRevenueCatPaywallService(isPro: false)","    let store = AppStore.configured(paywallService: mock)","","    return ContentView()","        .environment(store)","        .task {","            store.send(.paywall(.observeCustomerInfo))","            try? await Task.sleep(for: .seconds(2))","            mock.send(EntitlementSnapshot(isPro: true))","        }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The preview starts in the free state, runs the gated UI for two seconds, then transitions to pro — letting you eyeball both copy paths in one preview pane."}],"type":"paragraph"},{"text":"Step 5: Simulating failures","type":"heading","anchor":"Step-5-Simulating-failures","level":2},{"inlineContent":[{"type":"text","text":"Set "},{"code":"customerInfoError","type":"codeVoice"},{"type":"text","text":" or "},{"code":"restoreError","type":"codeVoice"},{"type":"text","text":" to make the corresponding call throw — the plugin dispatches "},{"code":".refreshFailed","type":"codeVoice"},{"type":"text","text":", sets "},{"code":"store.paywall.error","type":"codeVoice"},{"type":"text","text":", and your retry UI becomes testable:"}],"type":"paragraph"},{"code":["@Test(\"Refresh failure surfaces an error the UI can retry from\")","@MainActor","func refreshFailureSurfacesError() async throws {","    struct Offline: Error {}","    let mock = MockRevenueCatPaywallService(isPro: false)","    let store = AppStore.configured(paywallService: mock)","","    mock.customerInfoError = Offline()","    store.send(.paywall(.refreshCustomerInfo))","    try await waitUntil { store.paywall.error != nil }","","    mock.customerInfoError = nil","    store.send(.paywall(.refreshCustomerInfo))","    try await waitUntil { store.paywall.error == nil }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The same hooks exercise "},{"code":"ResilientPaywallService","type":"codeVoice"},{"type":"text","text":"’s last-known-good fallback: wrap the mock, make "},{"code":"customerInfo()","type":"codeVoice"},{"type":"text","text":" throw, and assert the cached entitlement holds."}],"type":"paragraph"},{"text":"Step 6: Tear the streams down","type":"heading","anchor":"Step-6-Tear-the-streams-down","level":2},{"inlineContent":[{"type":"text","text":"Call "},{"code":"finish()","type":"codeVoice"},{"type":"text","text":" at the end of a test to end every stream the mock has open:"}],"type":"paragraph"},{"code":["mock.finish()"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Each open stream delivers what it has buffered, then its "},{"code":"for await","type":"codeVoice"},{"type":"text","text":" loop exits, so the plugin’s "},{"code":"observeCustomerInfo","type":"codeVoice"},{"type":"text","text":" effect task completes. Don’t skip this in store-driven tests: Swidux runs effects as unstructured tasks, which Swift Testing does not cancel when the test returns, so without "},{"code":"finish()","type":"codeVoice"},{"type":"text","text":" the effect task stays suspended on the stream, holding the mock, for the rest of the test process. The mock stays usable afterwards — "},{"code":"send(_:)","type":"codeVoice"},{"type":"text","text":" keeps updating the current snapshot, and a stream requested later is live again."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest","interfaceLanguage":"swift"},"abstract":[{"text":"Drive entitlement state from SwiftUI previews and tests with ","type":"text"},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"text":" — no RevenueCat SDK call required.","type":"text"}],"metadata":{"role":"article","title":"How to Preview and Test","modules":[{"name":"SwiduxRevenueCatPaywall"}],"roleHeading":"Article"},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService"],"anchor":"Related-Documentation"},{"generated":true,"title":"How-to Guides","anchor":"How-to-Guides","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI"]}],"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/GettingStarted":{"title":"Getting Started with SwiduxRevenueCatPaywall","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/GettingStarted","abstract":[{"text":"Add the package, configure RevenueCat, register the paywall plugin, and present the bundled sheets.","type":"text"}],"type":"topic","kind":"article","role":"article","url":"\/documentation\/swiduxrevenuecatpaywall\/gettingstarted"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToPresentTheUI":{"kind":"article","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","abstract":[{"text":"Attach ","type":"text"},{"type":"codeVoice","code":"revenueCatPaywallAndCustomerCenter"},{"text":" from ","type":"text"},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"text":" to a root view to present both surfaces from ","type":"text"},{"type":"codeVoice","code":"PaywallState"},{"text":", or attach either binding-driven primitive by itself.","type":"text"}],"title":"How to Present the UI","role":"article","type":"topic","url":"\/documentation\/swiduxrevenuecatpaywall\/howtopresenttheui"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToAddAPermanentLicense":{"kind":"article","type":"topic","title":"How to Add a Permanent License","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","abstract":[{"text":"Sell a lifetime entitlement alongside a subscription and surface both flags through the paywall plugin.","type":"text"}],"url":"\/documentation\/swiduxrevenuecatpaywall\/howtoaddapermanentlicense","role":"article"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall":{"title":"SwiduxRevenueCatPaywall","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall","type":"topic","kind":"symbol","role":"collection","abstract":[{"type":"text","text":"RevenueCat adapter for Swidux’s "},{"code":"PaywallPlugin","type":"codeVoice"},{"type":"text","text":". Implements "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" against "},{"code":"Purchases.shared","type":"codeVoice"},{"type":"text","text":", ships a controllable mock for previews and tests, and pairs with "},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":" for drop-in "},{"code":"PaywallView","type":"codeVoice"},{"type":"text","text":" and "},{"code":"CustomerCenterView","type":"codeVoice"},{"type":"text","text":" presentation."}],"url":"\/documentation\/swiduxrevenuecatpaywall"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/MockServiceReference":{"kind":"article","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference","role":"article","url":"\/documentation\/swiduxrevenuecatpaywall\/mockservicereference","title":"Mock Service Reference","type":"topic","abstract":[{"text":"API reference for ","type":"text"},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"text":" — a controllable ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" conformer for previews and tests that does not touch ","type":"text"},{"code":"Purchases.shared","type":"codeVoice"},{"text":".","type":"text"}]},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/MockRevenueCatPaywallService":{"navigatorTitle":[{"kind":"identifier","text":"MockRevenueCatPaywallService"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"MockRevenueCatPaywallService","kind":"identifier"}],"type":"topic","title":"MockRevenueCatPaywallService","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService","abstract":[{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" conformer for previews and tests with a controllable entitlement stream."}],"url":"\/documentation\/swiduxrevenuecatpaywall\/mockrevenuecatpaywallservice","role":"symbol"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToImplementService":{"kind":"article","type":"topic","title":"How to Implement the Service","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","abstract":[{"type":"text","text":"Wire "},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":" into the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin so the store sees real-time entitlement updates from RevenueCat."}],"url":"\/documentation\/swiduxrevenuecatpaywall\/howtoimplementservice","role":"article"}}}