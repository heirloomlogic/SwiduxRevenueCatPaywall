{"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"title":"UI Components Reference","modules":[{"name":"SwiduxRevenueCatPaywall"}],"roleHeading":"Article","role":"article"},"identifier":{"url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/UIComponentsReference","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"API reference for the paywall, customer-center, and composed view modifiers in "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":"."}],"kind":"article","sections":[],"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/ServiceReference","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference"],"title":"Reference","anchor":"Reference","generated":true}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The UI product layers three view modifiers on top of ","type":"text"},{"code":"RevenueCatUI","type":"codeVoice"},{"text":". Two primitives present the paywall and customer center directly from a ","type":"text"},{"code":"Binding<Bool>","type":"codeVoice"},{"text":"; one convenience modifier composes both, driven by ","type":"text"},{"code":"PaywallState","type":"codeVoice"},{"text":". Each presentation modifier attaches to the modified content view directly — there are no ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" wrappers and no ","type":"text"},{"code":".background { … }","type":"codeVoice"},{"text":" indirection. This shape is what makes the macOS sheet machinery present reliably.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For step-by-step wiring, see ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"How to Present the UI","type":"text"}]},{"text":" in the ","type":"text"},{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"text":" documentation. For the rationale behind platform-specific behavior, see ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"Platform Behavior"}]},{"text":" in the same catalog.","type":"text"}]},{"type":"heading","text":"Library target","level":2,"anchor":"Library-target"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Product: "},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Import: ","type":"text"},{"code":"import SwiduxRevenueCatPaywallUI","type":"codeVoice"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":[".product(name: \"SwiduxRevenueCatPaywallUI\", package: \"SwiduxRevenueCatPaywall\"),"]},{"type":"paragraph","inlineContent":[{"text":"The UI product depends on ","type":"text"},{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"RevenueCatUI"},{"text":", both pulled in transitively. Apps that don’t ship paywall UI in the same target (for example, a tests-only target) can depend on the lower-level ","type":"text"},{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"},{"text":" product alone.","type":"text"}]},{"type":"heading","text":"Modifiers","level":2,"anchor":"Modifiers"},{"type":"heading","text":"`revenueCatPaywall(isPresented:offeringIdentifier:displayCloseButton:fonts:presentationStyle:purchaseLogic:onEvent:onDismiss:)`","level":3,"anchor":"revenueCatPaywallisPresentedofferingIdentifierdisplayCloseButtonfontspresentationStylepurchaseLogiconEventonDismiss"},{"type":"codeListing","syntax":"swift","code":["extension View {","    public func revenueCatPaywall(","        isPresented: Binding<Bool>,","        offeringIdentifier: String? = nil,","        displayCloseButton: Bool = true,","        fonts: any PaywallFontProvider = DefaultPaywallFontProvider(),","        presentationStyle: RevenueCatPaywallPresentationStyle = .automatic,","        purchaseLogic: RevenueCatPaywallPurchaseLogic? = nil,","        onEvent: RevenueCatPaywallEventHandler? = nil,","        onDismiss: (() -> Void)? = nil","    ) -> some View","}"]},{"type":"paragraph","inlineContent":[{"text":"Attaches ","type":"text"},{"code":"RevenueCatUI.PaywallView","type":"codeVoice"},{"text":" as a platform-appropriate sheet.","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"iOS"}]},{"text":" — The automatic style uses a full-screen cover at compact width and a sheet at regular width.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"macOS","type":"text"}]},{"type":"text","text":" — Presents in a "},{"type":"codeVoice","code":"sheet"},{"type":"text","text":" sized to a 400×600 minimum."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass a real two-way binding; SwiftUI sets it to "},{"type":"codeVoice","code":"false"},{"type":"text","text":" on user dismissal. Build it from "},{"type":"codeVoice","code":"PaywallState.isPresented"},{"type":"text","text":" so the "},{"type":"codeVoice","code":"set:"},{"type":"text","text":" closure dispatches "},{"type":"codeVoice","code":".paywall(.dismiss)"},{"type":"text","text":" and the plugin clears its presentation state."}]},{"text":"Parameters","anchor":"Parameters","type":"heading","level":4},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"isPresented"},{"text":" — Two-way binding to the paywall’s visibility flag.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"offeringIdentifier"},{"text":" — Identifier of the RevenueCat offering to present, for a win-back or regional offer. Defaults to ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":", which presents the dashboard’s current offering. An unknown identifier asserts in Debug and falls back to the current offering with a logged warning; a fetch failure also falls back without asserting.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"displayCloseButton"},{"text":" — Whether ","type":"text"},{"type":"codeVoice","code":"PaywallView"},{"text":" shows a close button. Defaults to ","type":"text"},{"type":"codeVoice","code":"true"},{"text":". When ","type":"text"},{"type":"codeVoice","code":"false"},{"text":", iOS sheets disable interactive dismissal. On macOS, Escape dismisses only when this is ","type":"text"},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"fonts","type":"codeVoice"},{"type":"text","text":" — RevenueCatUI font provider used by every resolved paywall."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"presentationStyle"},{"text":" — ","type":"text"},{"type":"codeVoice","code":".automatic"},{"text":" adapts to iOS width and uses a sheet on macOS. iOS callers can force ","type":"text"},{"type":"codeVoice","code":".sheet"},{"text":" or ","type":"text"},{"type":"codeVoice","code":".fullScreen"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"purchaseLogic","type":"codeVoice"},{"text":" — App-owned StoreKit 2 purchase and restore operations for ","type":"text"},{"code":"purchasesAreCompletedBy: .myApp","type":"codeVoice"},{"text":". Leave ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when RevenueCat completes purchases.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"onEvent","type":"codeVoice"},{"type":"text","text":" — Optional callback for package-owned purchase, restore, cancellation, purchase-failure, and restore-failure values. It exposes Foundation identifiers and error fields instead of RevenueCat models."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"onDismiss","type":"codeVoice"},{"type":"text","text":" — Optional callback fired after dismissal."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Dashboard exit offers do not run through these modifiers. RevenueCatUI implements them in its own "},{"type":"codeVoice","code":"presentPaywall"},{"type":"text","text":" modifiers, which always add a close button; using that path here would change "},{"type":"codeVoice","code":"displayCloseButton: false"},{"type":"text","text":" from a hard paywall into a dismissible one. Apps that need exit offers should use RevenueCatUI’s presenter directly."}],"type":"paragraph"},{"type":"heading","text":"`revenueCatCustomerCenter(isPresented:onDismiss:)`","anchor":"revenueCatCustomerCenterisPresentedonDismiss","level":3},{"type":"codeListing","code":["extension View {","    public func revenueCatCustomerCenter(","        isPresented: Binding<Bool>,","        onDismiss: (() -> Void)? = nil","    ) -> some View","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Attaches the customer center as a platform-appropriate sheet.","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"iOS","type":"text"}]},{"type":"text","text":" — Presents "},{"type":"codeVoice","code":"RevenueCatUI.CustomerCenterView"},{"type":"text","text":" in a "},{"type":"codeVoice","code":"sheet"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"macOS"}]},{"type":"text","text":" — Opens "},{"type":"codeVoice","code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions"},{"type":"text","text":" through SwiftUI’s "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" environment action (falling back to the "},{"type":"codeVoice","code":"https:\/\/apps.apple.com\/account\/subscriptions"},{"type":"text","text":" web URL if nothing handles the "},{"type":"codeVoice","code":"itms-apps"},{"type":"text","text":" scheme), immediately clears the binding, and fires "},{"type":"codeVoice","code":"onDismiss"},{"type":"text","text":". RevenueCatUI does not ship a customer center on macOS."}]}]}]},{"type":"heading","level":4,"anchor":"Parameters","text":"Parameters"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isPresented"},{"type":"text","text":" — Two-way binding to the customer center’s visibility flag."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"onDismiss","type":"codeVoice"},{"type":"text","text":" — Optional callback fired after dismissal (or, on macOS, after the App Store URL is opened)."}]}]}]},{"type":"heading","level":3,"anchor":"revenueCatPaywallAndCustomerCenterstateofferingIdentifierdisplayCloseButtonfontspresentationStylepurchaseLogiconEventonAction","text":"`revenueCatPaywallAndCustomerCenter(state:offeringIdentifier:displayCloseButton:fonts:presentationStyle:purchaseLogic:onEvent:onAction:)`"},{"syntax":"swift","type":"codeListing","code":["extension View {","    public func revenueCatPaywallAndCustomerCenter(","        state: PaywallState,","        offeringIdentifier: String? = nil,","        displayCloseButton: Bool = true,","        fonts: any PaywallFontProvider = DefaultPaywallFontProvider(),","        presentationStyle: RevenueCatPaywallPresentationStyle = .automatic,","        purchaseLogic: RevenueCatPaywallPurchaseLogic? = nil,","        onEvent: RevenueCatPaywallEventHandler? = nil,","        onAction: @escaping (PaywallAction) -> Void","    ) -> some View","}"]},{"type":"paragraph","inlineContent":[{"text":"Convenience modifier that attaches both primitive presentation surfaces and dispatches the matching actions through ","type":"text"},{"code":"onAction","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"On iOS the two presentations are mutually exclusive and the paywall wins. On macOS a customer-center request dispatches ","type":"text"},{"type":"codeVoice","code":".openManageSubscriptions"},{"text":" through the paywall plugin, then ","type":"text"},{"type":"codeVoice","code":".dismissCustomerCenter"},{"text":"; the external App Store hand-off remains available while the paywall sheet is open. After a restore inside the paywall, the modifier also dispatches ","type":"text"},{"type":"codeVoice","code":".dismiss"},{"text":" once ","type":"text"},{"type":"codeVoice","code":"state.isGateSatisfied"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":", because RevenueCatUI does not dismiss after a restore. Attach the modifier once to one app-wide presentation host. See ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"Platform Behavior"}]},{"text":" in the ","type":"text"},{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"text":" documentation.","type":"text"}]},{"anchor":"Parameters","type":"heading","text":"Parameters","level":4},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"state"},{"text":" — The paywall slice from your store, typically ","type":"text"},{"type":"codeVoice","code":"store.paywall"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"offeringIdentifier"},{"type":"text","text":" — Identifier of the RevenueCat offering to present. When it is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", "},{"type":"codeVoice","code":"state.requestedReason"},{"type":"text","text":" is used as a RevenueCat placement identifier. For an unknown placement, RevenueCat may return the dashboard’s placement fallback offering, which can differ from the current offering; the package uses the current offering when RevenueCat returns no placement fallback. An explicit identifier takes precedence."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"displayCloseButton","type":"codeVoice"},{"text":" — Whether ","type":"text"},{"code":"PaywallView","type":"codeVoice"},{"text":" shows a close button. Defaults to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":"; see the primitive modifier above.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"fonts"},{"type":"text","text":" — RevenueCatUI font provider used by the paywall."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"presentationStyle","type":"codeVoice"},{"text":" — Automatic or explicit iOS presentation style; macOS always uses a sheet.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"purchaseLogic"},{"type":"text","text":" — App-owned StoreKit 2 purchase and restore operations for "},{"type":"codeVoice","code":"purchasesAreCompletedBy: .myApp"},{"type":"text","text":". Leave "},{"type":"codeVoice","code":"nil"},{"text":" when RevenueCat completes purchases.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"onEvent"},{"type":"text","text":" — Optional package-owned outcome callback; see the primitive modifier above."}]}]},{"content":[{"inlineContent":[{"code":"onAction","type":"codeVoice"},{"text":" — A closure that lifts a ","type":"text"},{"code":"PaywallAction","type":"codeVoice"},{"text":" into your root action and dispatches it through the store. Typically ","type":"text"},{"code":"{ store.send(.paywall($0)) }","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Manual-wiring","text":"Manual wiring","level":4,"type":"heading"},{"syntax":"swift","type":"codeListing","code":["ContentView()","    .revenueCatPaywall(","        isPresented: Binding(","            get: { store.paywall.isPresented },","            set: { if !$0 { store.send(.paywall(.dismiss)) } }","        )","    )","    .revenueCatCustomerCenter(","        isPresented: Binding(","            get: { store.paywall.isCustomerCenterPresented },","            set: { if !$0 { store.send(.paywall(.dismissCustomerCenter)) } }","        )","    )"]},{"inlineContent":[{"type":"text","text":"This attaches the same presentation surfaces but leaves the iOS exclusivity and close-after-restore rules to the app. Use the convenience modifier when both surfaces are needed; use the primitives when only one is needed or when you want to interleave other modifiers between them."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxrevenuecatpaywall\/uicomponentsreference"]}],"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/MockServiceReference":{"type":"topic","title":"Mock Service Reference","kind":"article","role":"article","url":"\/documentation\/swiduxrevenuecatpaywall\/mockservicereference","abstract":[{"text":"API reference for ","type":"text"},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"text":" — a controllable ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" conformer for previews and tests that does not touch "},{"type":"codeVoice","code":"Purchases.shared"},{"type":"text","text":"."}],"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall":{"abstract":[{"type":"text","text":"RevenueCat adapter for Swidux’s "},{"type":"codeVoice","code":"PaywallPlugin"},{"text":". Implements ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"text":" against ","type":"text"},{"type":"codeVoice","code":"Purchases.shared"},{"text":", ships a controllable mock for previews and tests, and pairs with ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":" for drop-in "},{"code":"PaywallView","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"CustomerCenterView","type":"codeVoice"},{"text":" presentation.","type":"text"}],"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall","url":"\/documentation\/swiduxrevenuecatpaywall","kind":"symbol","role":"collection","title":"SwiduxRevenueCatPaywall","type":"topic"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToPresentTheUI":{"role":"article","type":"topic","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","kind":"article","abstract":[{"type":"text","text":"Attach "},{"type":"codeVoice","code":"revenueCatPaywallAndCustomerCenter"},{"type":"text","text":" from "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"text":" to a root view to present both surfaces from ","type":"text"},{"type":"codeVoice","code":"PaywallState"},{"text":", or attach either binding-driven primitive by itself.","type":"text"}],"url":"\/documentation\/swiduxrevenuecatpaywall\/howtopresenttheui","title":"How to Present the UI"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/PlatformBehavior":{"type":"topic","title":"Platform Behavior","kind":"article","role":"article","abstract":[{"type":"text","text":"How the paywall and customer-center modifiers choose presentation, and which controls remain fixed."}],"url":"\/documentation\/swiduxrevenuecatpaywall\/platformbehavior","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/ServiceReference":{"role":"article","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/ServiceReference","title":"Service Reference","kind":"article","abstract":[{"text":"API reference for ","type":"text"},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"text":" — the RevenueCat-backed ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" conformer that the paywall plugin consumes."}],"url":"\/documentation\/swiduxrevenuecatpaywall\/servicereference","type":"topic"}}}