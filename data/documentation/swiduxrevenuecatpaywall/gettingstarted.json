{"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"SwiduxRevenueCatPaywall"}],"title":"Getting Started with SwiduxRevenueCatPaywall"},"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"sections":[],"kind":"article","identifier":{"url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/GettingStarted","interfaceLanguage":"swift"},"abstract":[{"text":"Add the package, configure RevenueCat, register the paywall plugin, and present the bundled sheets.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxrevenuecatpaywall\/gettingstarted"]}],"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"This guide walks through the four steps to integrate ","type":"text"},{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"},{"text":" into a Swidux app: add the package, configure RevenueCat, register the plugin, and attach the UI. It is the shortest path from a wired Swidux app to a working paywall. For deeper coverage of any step, follow the linked how-tos.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This package assumes you already use Swidux. If you don’t, work through Swidux’s own getting-started guide first.","type":"text"}]},{"type":"heading","text":"Add the Package","level":2,"anchor":"Add-the-Package"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Xcode:","type":"text"}],"type":"strong"},{"text":" File > Add Package Dependencies, paste ","type":"text"},{"code":"https:\/\/github.com\/HeirloomLogic\/SwiduxRevenueCatPaywall","type":"codeVoice"},{"text":". Add the products you need:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"},{"type":"text","text":" — the "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" implementation and mock."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":" — adds the "},{"type":"codeVoice","code":"revenueCatPaywall"},{"type":"text","text":" and "},{"type":"codeVoice","code":"revenueCatCustomerCenter"},{"type":"text","text":" view modifiers (depends on RevenueCatUI)."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Package.swift:","type":"text"}]}]},{"syntax":"swift","type":"codeListing","code":[".package(url: \"https:\/\/github.com\/HeirloomLogic\/SwiduxRevenueCatPaywall\", from: \"1.0.0\"),"]},{"syntax":"swift","type":"codeListing","code":[".product(name: \"SwiduxRevenueCatPaywall\", package: \"SwiduxRevenueCatPaywall\"),",".product(name: \"SwiduxRevenueCatPaywallUI\", package: \"SwiduxRevenueCatPaywall\"),"]},{"type":"heading","text":"Configure the paywall at launch","level":2,"anchor":"Configure-the-paywall-at-launch"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":" calls into "},{"code":"Purchases.shared","type":"codeVoice"},{"text":" under the hood. Configure the paywall before constructing the store:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ MyApp.swift","import SwiduxRevenueCatPaywall","import SwiftUI","","@main","struct MyApp: App {","    @State private var store: AppStore","","    init() {","        RevenueCatPaywall.configure(apiKey: \"your_revenuecat_api_key\")","        _store = State(wrappedValue: AppStore.configured())","    }","","    var body: some Scene {","        WindowGroup { ContentView().environment(store) }","    }","}"]},{"inlineContent":[{"text":"The service itself is safe to construct before configuration. If stored-property initialization creates the store first, configure RevenueCat before dispatching paywall actions. An early read or restore throws ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallError\/notConfigured","type":"reference","isActive":true},{"text":"; an early entitlement stream finishes and can be started again after configuration. Swidux 1.9 and later clears the plugin’s observation guard when that stream ends.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass "},{"code":"appUserID","type":"codeVoice"},{"type":"text","text":", "},{"code":"userDefaults","type":"codeVoice"},{"type":"text","text":" (for app-group sharing with widgets), "},{"code":"logLevel","type":"codeVoice"},{"type":"text","text":", "},{"code":"entitlementVerification","type":"codeVoice"},{"text":" (signed entitlement verification), or ","type":"text"},{"type":"codeVoice","code":"purchasesAreCompletedBy"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"storeKitVersion"},{"type":"text","text":" (app-completed purchases) if you need them — see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywall\/configure(apiKey:appUserID:userDefaults:logLevel:entitlementVerification:purchasesAreCompletedBy:storeKitVersion:)"},{"type":"text","text":"."}]},{"level":2,"text":"Register the paywall plugin","anchor":"Register-the-paywall-plugin","type":"heading"},{"inlineContent":[{"type":"text","text":"Pass "},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":" to "},{"type":"codeVoice","code":"PaywallPlugin"},{"type":"text","text":" in your "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory:"}],"type":"paragraph"},{"syntax":"swift","code":["import Swidux","import SwiduxPaywall","import SwiduxRevenueCatPaywall","","extension Store where State == AppState, Action == AppAction {","    static func configured() -> AppStore {","        let plugins = PluginHost<AppState, AppAction>()","","        plugins.register(","            PaywallPlugin<AppState, AppAction>(","                state: \\.paywall,","                action: AppAction.paywall,","                extractAction: { if case .paywall(let a) = $0 { return a }; return nil },","                service: ResilientPaywallService(","                    base: RevenueCatPaywallService(entitlementID: \"pro\"),","                    store: UserDefaultsKeyValueStore()","                )","            )","        )","","        return Store(","            initialState: AppState(),","            reducer: AppReducer().reduce,","            plugins: plugins","        )","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"ResilientPaywallService"},{"type":"text","text":" (from SwiduxPaywall) persists the last entitlement snapshot a successful read delivered. Without it, a slow or failing network at cold launch leaves "},{"type":"codeVoice","code":"PaywallState"},{"type":"text","text":" at its free default and gates paying users out of their features until the first successful read; with it, the last-known-good state holds until live data arrives, and the server stays authoritative — a genuine lapse is honoured on the next successful read. Wrap the RevenueCat service in it for production."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Start the entitlement stream on the root view so the gate reflects RevenueCat’s state from launch:"}],"type":"paragraph"},{"syntax":"swift","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .task {","                store.send(.paywall(.observeCustomerInfo))","                store.send(.paywall(.refreshCustomerInfo))","            }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Gate features by reading ","type":"text"},{"code":"store.paywall.isGateSatisfied","type":"codeVoice"},{"text":". See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","type":"reference"},{"text":" for the full plugin lifecycle.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Attach the UI","anchor":"Attach-the-UI","type":"heading"},{"inlineContent":[{"text":"Attach the ","type":"text"},{"code":"revenueCatPaywall","type":"codeVoice"},{"text":" modifier to a root view, driven by paywall state:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiduxRevenueCatPaywallUI","","struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .revenueCatPaywall(state: store.paywall) { action in","                store.send(.paywall(action))","            }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Trigger the paywall from a gated feature with ","type":"text"},{"code":".paywall(.request(reason:))","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["Button(\"Export PDF\") {","    if store.paywall.isGateSatisfied {","        store.send(.export(.exportPDF))","    } else {","        store.send(.paywall(.request(reason: \"export-pdf\")))","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI"},{"type":"text","text":" for manual wiring with the primitive modifiers, customer-center triggering, and dismiss semantics."}]},{"anchor":"Next-Steps","type":"heading","level":2,"text":"Next Steps"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","type":"reference","isActive":true},{"type":"text","text":" — Detailed walkthrough of the service lifecycle and error handling."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","isActive":true,"type":"reference"},{"text":" — Add a lifetime entitlement alongside the subscription.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest","isActive":true},{"type":"text","text":" — Drive entitlement state from previews and tests."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","type":"reference"},{"text":" — Wire the bundled view modifiers.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","type":"reference"},{"text":" — Why iOS and macOS behave differently.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping"},{"type":"text","text":" — How RevenueCat entitlements map to "},{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToPreviewAndTest":{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest","title":"How to Preview and Test","role":"article","abstract":[{"type":"text","text":"Drive entitlement state from SwiftUI previews and tests with "},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":" — no RevenueCat SDK ca