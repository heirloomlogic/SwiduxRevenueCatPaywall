n\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/customerInfoStream()","isActive":true,"type":"reference"},{"text":" yields it first. Streams","type":"text"},{"text":" ","type":"text"},{"text":"fan out — each call returns an independent stream, and ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)","isActive":true,"type":"reference"},{"type":"text","text":" delivers to every stream"},{"type":"text","text":" "},{"type":"text","text":"that is still open — so two stores sharing one mock, or a "},{"code":"ResilientPaywallService","type":"codeVoice"},{"type":"text","text":" wrapper"},{"type":"text","text":" "},{"type":"text","text":"plus the paywall plugin, all observe the same transitions. "},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/finish()","type":"reference","isActive":true},{"type":"text","text":" ends the streams that"},{"type":"text","text":" "},{"type":"text","text":"are open at the time. Set "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/customerInfoError"},{"text":" or ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/restoreError","isActive":true,"type":"reference"},{"type":"text","text":" to make the corresponding"},{"type":"text","text":" "},{"type":"text","text":"call throw, e.g. to drive the plugin’s "},{"type":"codeVoice","code":".refreshFailed"},{"type":"text","text":" path or a "},{"type":"codeVoice","code":"ResilientPaywallService"},{"type":"text","text":" "},{"type":"text","text":"fallback."}]},{"inlineContent":[{"type":"text","text":"Deliberate differences from the real "},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":", chosen so tests are"},{"type":"text","text":" "},{"type":"text","text":"deterministic:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A stream buffers every value it has not delivered yet; the real stream keeps only the","type":"text"},{"text":" ","type":"text"},{"text":"newest. A test that sends several snapshots before its consumer runs sees each one, in order.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A new stream always yields the current snapshot first; the real stream yields a first value","type":"text"},{"text":" ","type":"text"},{"text":"only if RevenueCat has already delivered customer info in this process.","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"Compared with Swidux’s "},{"type":"codeVoice","code":"SimulatedPaywallService"},{"type":"text","text":" (an actor with a dev-paywall UI and simulated"},{"type":"text","text":" "},{"type":"text","text":"latency, better suited to vendor-free previews and development builds), this mock offers a"},{"type":"text","text":" "},{"type":"text","text":"synchronous "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)"},{"type":"text","text":", arbitrary injected errors, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/finish()"},{"type":"text","text":", and delivery of repeated"},{"type":"text","text":" "},{"type":"text","text":"identical snapshots — "},{"type":"codeVoice","code":"SimulatedPaywallService"},{"type":"text","text":" drops a change that equals the current state."},{"type":"text","text":" "},{"code":"MockPaywallService","type":"codeVoice"},{"text":" in SwiduxPaywall differs again: its stream finishes immediately after the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"initial yield, so it cannot drive entitlement transitions over time."}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"Thread-safe. State lives behind a ","type":"text"},{"type":"codeVoice","code":"Synchronization.Mutex"},{"text":", so the type is checked","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":" and can be shared across actors in tests and previews.","type":"text"}]}],"name":"Note","type":"aside"}],"kind":"content"}],"sections":[],"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/MockRevenueCatPaywallService/restorePurchases()":{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/restorePurchases()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"restorePurchases","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"EntitlementSnapshot","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV","kind":"typeIdentifier"}],"type":"topic","abstract":[{"type":"text","text":"Returns the current snapshot — the init-time state, or the latest value passed to"},{"type":"text","text":" "},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)","isActive":true,"type":"reference"},{"type":"text","text":"."}],"kind":"symbol","title":"restorePurchases()","role":"symbol","url":"\/documentation\/swiduxrevenuecatpaywall\/mockrevenuecatpaywallservice\/restorepurchases()"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/MockRevenueCatPaywallService/send(_:)":{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{