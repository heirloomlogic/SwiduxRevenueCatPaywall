{"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/ServiceReference"},"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"abstract":[{"type":"text","text":"API reference for "},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"text":" — the RevenueCat-backed ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"text":" conformer that the paywall plugin consumes.","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallService","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallError"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/UIComponentsReference"],"anchor":"Reference","generated":true,"title":"Reference"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":" adapts "},{"type":"codeVoice","code":"RevenueCat.Purchases"},{"type":"text","text":" to the "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" protocol that "},{"type":"codeVoice","code":"SwiduxPaywall.PaywallPlugin"},{"type":"text","text":" requires. It does one job: translate "},{"type":"codeVoice","code":"CustomerInfo"},{"type":"text","text":" into "},{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":" (defined by "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":") so the plugin can drive its state. Configuration of the RevenueCat SDK itself remains the caller’s responsibility."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a step-by-step integration walkthrough, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService"},{"type":"text","text":". For the entitlement-mapping rules, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping"},{"type":"text","text":"."}]},{"level":2,"text":"Library target","type":"heading","anchor":"Library-target"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product: "},{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"text":"Import: ","type":"text"},{"code":"import SwiduxRevenueCatPaywall","type":"codeVoice"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"code":"Package.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"code":[".product(name: \"SwiduxRevenueCatPaywall\", package: \"SwiduxRevenueCatPaywall\"),"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Types","type":"heading","anchor":"Types"},{"anchor":"docSwiduxRevenueCatPaywalldocumentationSwiduxRevenueCatPaywallRevenueCatPaywallService","type":"heading","level":3,"text":"``doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallService``"},{"syntax":"swift","type":"codeListing","code":["public struct RevenueCatPaywallService: PaywallService {","    public init(","        entitlementID: String,","        permanentLicenseEntitlementID: String? = nil","    )","","    public func customerInfo() async throws -> EntitlementSnapshot","    public func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    public func restorePurchases() async throws -> EntitlementSnapshot","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Value type. Holds two "},{"type":"codeVoice","code":"String"},{"type":"text","text":" identifiers and forwards configured calls to "},{"type":"codeVoice","code":"Purchases.shared"},{"type":"text","text":". It is safe to construct before "},{"type":"codeVoice","code":"RevenueCatPaywall.configure"},{"type":"text","text":" runs. For production, wrap it in SwiduxPaywall’s "},{"type":"codeVoice","code":"ResilientPaywallService"},{"type":"text","text":" so a transient read failure at launch never gates a paid user as free."}]},{"type":"heading","text":"Initializer","level":4,"anchor":"Initializer"},{"type":"codeListing","syntax":"swift","code":["public init(","    entitlementID: String,","    permanentLicenseEntitlementID: String? = nil",")"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"entitlementID","type":"codeVoice"},{"type":"text","text":" — RevenueCat entitlement identifier that grants pro access. Surfaces as "},{"code":"EntitlementSnapshot.isPro","type":"codeVoice"},{"type":"text","text":" when active."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"permanentLicenseEntitlementID","type":"codeVoice"},{"text":" — Optional secondary identifier for a lifetime \/ permanent entitlement. Surfaces as ","type":"text"},{"code":"EntitlementSnapshot.hasPermanentLicense","type":"codeVoice"},{"text":" when active. Pass ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if the app has no separate lifetime SKU.","type":"text"}]}]}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywall\/configure(apiKey:appUserID:userDefaults:logLevel:entitlementVerification:purchasesAreCompletedBy:storeKitVersion:)","isActive":true},{"text":" before invoking the service. Construction before configuration is safe, including from a stored-property initializer. Previews and tests that do not configure RevenueCat should still use ","type":"text"},{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"text":" when they need entitlement values.","type":"text"}]}],"style":"important","name":"Important"},{"level":4,"type":"heading","text":"`customerInfo() async throws -> EntitlementSnapshot`","anchor":"customerInfo-async-throws-%3E-EntitlementSnapshot"},{"type":"paragraph","inlineContent":[{"text":"One-shot fetch. Calls ","type":"text"},{"code":"Purchases.shared.customerInfo()","type":"codeVoice"},{"text":" and maps the result.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Throws ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallError\/notConfigured","isActive":true,"type":"reference"},{"text":" if configuration has not run, or whatever the RevenueCat SDK throws (","type":"text"},{"code":"ErrorCode.networkError","type":"codeVoice"},{"text":", ","type":"text"},{"code":".offlineConnectionError","type":"codeVoice"},{"text":", etc.). The plugin catches the error and dispatches ","type":"text"},{"type":"codeVoice","code":".refreshFailed(message)"},{"type":"text","text":"."}]},{"text":"`customerInfoStream() -> AsyncStream<EntitlementSnapshot>`","anchor":"customerInfoStream-%3E-AsyncStream%3CEntitlementSnapshot%3E","type":"heading","level":4},{"inlineContent":[{"text":"Long-lived stream. Wraps ","type":"text"},{"type":"codeVoice","code":"Purchases.shared.customerInfoStream"},{"text":" and yields a new ","type":"text"},{"type":"codeVoice","code":"EntitlementSnapshot"},{"text":" for every change RevenueCat reports — purchase, refund, family-share update, sandbox renewal.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The stream finishes when the underlying RevenueCat stream finishes. The plugin’s "},{"code":".observeCustomerInfo","type":"codeVoice"},{"type":"text","text":" effect normally keeps it alive for the duration of the session; cancel by cancelling the consuming "},{"code":"Task","type":"codeVoice"},{"type":"text","text":", which terminates the stream and tears down the bridge."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Before configuration, the stream logs a fault and finishes immediately. Swidux 1.9 and later clears its observation guard when the stream ends, so configure RevenueCat and dispatch "},{"type":"codeVoice","code":".observeCustomerInfo"},{"type":"text","text":" again to retry."}],"type":"paragraph"},{"inlineContent":[{"text":"The stream buffers only the newest snapshot: each yield is a complete entitlement state, so a slow consumer sees the latest value rather than replaying stale intermediate states.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A new stream first yields the customer info RevenueCat last delivered in this process, if any. RevenueCat may not have delivered one yet — on a relaunch with a fresh cache it skips the launch fetch — and then the stream stays silent until the next change, so dispatch "},{"type":"codeVoice","code":".refreshCustomerInfo"},{"type":"text","text":" alongside "},{"type":"codeVoice","code":".observeCustomerInfo"},{"type":"text","text":" to seed the state."}],"type":"paragraph"},{"text":"`restorePurchases() async throws -> EntitlementSnapshot`","anchor":"restorePurchases-async-throws-%3E-EntitlementSnapshot","type":"heading","level":4},{"inlineContent":[{"type":"text","text":"Maps the result of RevenueCat’s user-initiated "},{"type":"codeVoice","code":"restorePurchases()"},{"type":"text","text":" flow in every purchase-completion mode. Unlike "},{"type":"codeVoice","code":"syncPurchases()"},{"type":"text","text":", this flow refreshes the App Store receipt and can recover a subscription missing from the device receipt. It may show an App Store sign-in prompt and applies the RevenueCat project’s restore behavior when purchases belong to another app user ID. It throws "},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallError\/notConfigured","isActive":true,"type":"reference"},{"text":" before configuration, or whatever the SDK throws on error.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The plugin’s "},{"type":"codeVoice","code":".restorePurchases"},{"type":"text","text":" action wraps this call and dispatches "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" on success or "},{"type":"codeVoice","code":".refreshFailed"},{"type":"text","text":" on error."}],"type":"paragraph"},{"text":"Entitlement mapping","anchor":"Entitlement-mapping","type":"heading","level":2},{"inlineContent":[{"text":"For every ","type":"text"},{"type":"codeVoice","code":"CustomerInfo"},{"text":" the service receives:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Configuration","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"isPro","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"hasPermanentLicense"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"entitlementID"},{"type":"text","text":" active"}]}],[{"type":"paragraph","inlineContent":[{"code":"true","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"(next column)"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"entitlementID","type":"codeVoice"},{"type":"text","text":" inactive or missing"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"false"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"(next column)"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"permanentLicenseEntitlementID == nil","type":"codeVoice"}]}],[{"inlineContent":[{"type":"text","text":"—"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"false"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"permanentLicenseEntitlementID","type":"codeVoice"},{"text":" active","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"—","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"true","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"permanentLicenseEntitlementID","type":"codeVoice"},{"type":"text","text":" inactive or missing"}],"type":"paragraph"}],[{"inlineContent":[{"text":"—","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"false"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"Both flags are checked independently against the same "},{"type":"codeVoice","code":"CustomerInfo"},{"type":"text","text":". A user with both active subscription and lifetime entitlements gets both flags set. See "},{"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping","isActive":true},{"type":"text","text":" for the reasoning behind the truth table."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxrevenuecatpaywall\/servicereference"]}],"metadata":{"modules":[{"name":"SwiduxRevenueCatPaywall"}],"role":"article","title":"Service Reference","roleHeading":"Article"},"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/UIComponentsReference":{"role":"article","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/UIComponentsReference","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"revenueCatPaywall"},{"type":"text","text":" and "},{"type":"codeVoice","code":"revenueCatCustomerCenter"},{"type":"text","text":" view modifiers — the SwiftUI surface of "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":"."}],"url":"\/documentation\/swiduxrevenuecatpaywall\/uicomponentsreference","type":"topic","kind":"article","title":"UI Components Reference"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToImplementService":{"url":"\/documentation\/swiduxrevenuecatpaywall\/howtoimplementservice","kind":"article","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","type":"topic","abstract":[{"type":"text","text":"Wire "},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":" into the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin so the store sees real-time entitlement updates from RevenueCat."}],"role":"article","title":"How to Implement the Service"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/RevenueCatPaywallError/notConfigured":{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallError\/notConfigured","title":"RevenueCatPaywallError.notConfigured","role":"symbol","abstract":[{"type":"text","text":"RevenueCat has not been configured, so the requested operation cannot start."}],"url":"\/documentation\/swiduxrevenuecatpaywall\/revenuecatpaywallerror\/notconfigured","kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"notConfigured"}],"type":"topic"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/RevenueCatPaywall/configure(apiKey:appUserID:userDefaults:logLevel:entitlementVerification:purchasesAreCompletedBy:storeKitVersion:)":{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywall\/configure(apiKey:appUserID:userDefaults:logLevel:entitl