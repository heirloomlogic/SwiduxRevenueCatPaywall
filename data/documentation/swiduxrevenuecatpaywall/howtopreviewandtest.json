{"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"modules":[{"name":"SwiduxRevenueCatPaywall"}],"title":"How to Preview and Test","roleHeading":"Article","role":"article"},"identifier":{"url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/swiduxrevenuecatpaywall\/howtopreviewandtest"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"abstract":[{"text":"Drive entitlement state from SwiftUI previews and tests with ","type":"text"},{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"text":" — no RevenueCat SDK call required.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"text":" is a ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" conformer that tracks a ","type":"text"},{"inlineContent":[{"text":"current","type":"text"}],"type":"emphasis"},{"text":" snapshot the way the real service reflects RevenueCat’s state: ","type":"text"},{"code":"send(_:)","type":"codeVoice"},{"text":" updates it and pushes it through the stream, ","type":"text"},{"code":"customerInfo()","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"restorePurchases()","type":"codeVoice"},{"text":" return it, and ","type":"text"},{"code":"finish()","type":"codeVoice"},{"text":" tears the stream down. Plug it into the same ","type":"text"},{"code":"PaywallPlugin","type":"codeVoice"},{"text":" you use in production. Drive entitlement transitions from your test or preview body.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For the API reference, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference"},{"text":".","type":"text"}]},{"text":"Why a different mock from SwiduxPaywall’s","type":"heading","anchor":"Why-a-different-mock-from-SwiduxPaywalls","level":2},{"type":"paragraph","inlineContent":[{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" ships its own ","type":"text"},{"code":"MockPaywallService","type":"codeVoice"},{"text":" whose stream finishes after the initial yield. That works for static “Pro” and “Free” previews but cannot model purchase, refund, or family-share transitions as a sequence. ","type":"text"},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"text":" keeps the stream open until you call ","type":"text"},{"code":"finish()","type":"codeVoice"},{"text":", which lets a single test verify the store reacts correctly to an ","type":"text"},{"inlineContent":[{"text":"order","type":"text"}],"type":"emphasis"},{"text":" of snapshots.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"When you only need a static state (one snapshot, one render pass), either mock works. When you need a sequence, use this one.","type":"text"}]},{"text":"Step 1: Make the service injectable","type":"heading","anchor":"Step-1-Make-the-service-injectable","level":2},{"type":"paragraph","inlineContent":[{"text":"Plumb the service through your ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory so previews and tests can override it:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["extension Store where State == AppState, Action == AppAction {","    static func configured(","        paywallService: any PaywallService = RevenueCatPaywallService(entitlementID: \"pro\")","    ) -> AppStore {","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(","            PaywallPlugin<AppState, AppAction>(","                state: \\.paywall,","                action: AppAction.paywall,","                extractAction: { if case .paywall(let a) = $0 { return a }; return nil },","                service: paywallService","            )","        )","        return Store(initialState: AppState(), reducer: AppReducer().reduce, plugins: plugins)","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The default keeps the live RevenueCat path for app launch. Previews and tests pass an override.","type":"text"}]},{"text":"Step 2: Static previews — pick a state","type":"heading","anchor":"Step-2-Static-previews-pick-a-state","level":2},{"type":"paragraph","inlineContent":[{"text":"Use the configured-state form when one snapshot is enough:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["#Preview(\"Free\") {","    let store = AppStore.configured(","        paywallService: MockRevenueCatPaywallService()","    )","    return ContentView().environment(store)","}","","#Preview(\"Pro\") {","    let store = AppStore.configured(","        paywallService: MockRevenueCatPaywallService(isPro: true)","    )","    return ContentView().environment(store)","}","","#Preview(\"Lifetime\") {","    let store = AppStore.configured(","        paywallService: MockRevenueCatPaywallService(hasPermanentLicense: true)","    )","    return ContentView().environment(store)","}"]},{"type":"paragraph","inlineContent":[{"text":"Each preview gets its own store; the mock’s initial snapshot flows through ","type":"text"},{"code":".observeCustomerInfo","type":"codeVoice"},{"text":" and updates the gate before the first render.","type":"text"}]},{"text":"Step 3: Driving transitions in a test","type":"heading","anchor":"Step-3-Driving-transitions-in-a-test","level":2},{"type":"paragraph","inlineContent":[{"text":"When the test cares about a ","type":"text"},{"inlineContent":[{"text":"sequence","type":"text"}],"type":"emphasis"},{"text":" of states — for example, the gate flipping from ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" after a purchase — use the streaming form:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@Test(\"Store updates when entitlement transitions to pro\")","func storeReactsToProPurchase() async {","    let mock = MockRevenueCatPaywallService(isPro: false)","    let store = AppStore.configured(paywallService: mock)","","    store.send(.paywall(.observeCustomerInfo))","    await Task.yield()","    #expect(store.paywall.isPro == false)","","    mock.send(EntitlementSnapshot(isPro: true))","    await Task.yield()","    #expect(store.paywall.isPro)","","    mock.finish()","}"]},{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"code":"send(_:)","type":"codeVoice"},{"text":" makes the snapshot current and pushes it through the active stream subscriber, which in this case is the plugin’s ","type":"text"},{"code":"observeCustomerInfo","type":"codeVoice"},{"text":" effect. The store’s reducer applies ","type":"text"},{"code":".customerInfoUpdated","type":"codeVoice"},{"text":", the observer tree fires for changed properties, and the assertion sees the new value. Because ","type":"text"},{"code":"customerInfo()","type":"codeVoice"},{"text":" also returns the sent snapshot, the refresh the plugin dispatches when the paywall is dismissed sees the purchased state too — the gate never regresses to the init-time value mid-test.","type":"text"}]},{"name":"Note","type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"customerInfoStream()"},{"text":" replaces its continuation on every call. If your test requests the stream more than once (rare — ","type":"text"},{"type":"codeVoice","code":"observeCustomerInfo"},{"text":" is dispatched once), the previous stream finishes — its ","type":"text"},{"type":"codeVoice","code":"for await"},{"text":" loop terminates instead of hanging — and only the most recent subscriber receives ","type":"text"},{"type":"codeVoice","code":"send(_:)"},{"text":" updates.","type":"text"}],"type":"paragraph"}],"style":"note"},{"text":"Step 4: Driving transitions in a preview","type":"heading","anchor":"Step-4-Driving-transitions-in-a-preview","level":2},{"type":"paragraph","inlineContent":[{"text":"Previews can drive transitions too — useful for verifying paywall sheet copy across states without running the app:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["#Preview(\"Purchase flow\") {","    let mock = MockRevenueCatPaywallService(isPro: false)","    let store = AppStore.configured(paywallService: mock)","","    return ContentView()","        .environment(store)","        .task {","            store.send(.paywall(.observeCustomerInfo))","            try? await Task.sleep(for: .seconds(2))","            mock.send(EntitlementSnapshot(isPro: true))","        }","}"]},{"type":"paragraph","inlineContent":[{"text":"The preview starts in the free state, runs the gated UI for two seconds, then transitions to pro — letting you eyeball both copy paths in one preview pane.","type":"text"}]},{"text":"Step 5: Simulating failures","type":"heading","anchor":"Step-5-Simulating-failures","level":2},{"type":"paragraph","inlineContent":[{"text":"Set ","type":"text"},{"code":"customerInfoError","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"restoreError","type":"codeVoice"},{"text":" to make the corresponding call throw — the plugin dispatches ","type":"text"},{"code":".refreshFailed","type":"codeVoice"},{"text":", sets ","type":"text"},{"code":"store.paywall.error","type":"codeVoice"},{"text":", and your retry UI becomes testable:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@Test(\"Refresh failure surfaces an error the UI can retry from\")","func refreshFailureSurfacesError() async {","    struct Offline: Error {}","    let mock = MockRevenueCatPaywallService(isPro: false)","    let store = AppStore.configured(paywallService: mock)","","    mock.customerInfoError = Offline()","    store.send(.paywall(.refreshCustomerInfo))","    await Task.yield()","    #expect(store.paywall.error != nil)","","    mock.customerInfoError = nil","    store.send(.paywall(.refreshCustomerInfo))","    await Task.yield()","    #expect(store.paywall.error == nil)","}"]},{"type":"paragraph","inlineContent":[{"text":"The same hooks exercise ","type":"text"},{"code":"ResilientPaywallService","type":"codeVoice"},{"text":"’s last-known-good fallback: wrap the mock, make ","type":"text"},{"code":"customerInfo()","type":"codeVoice"},{"text":" throw, and assert the cached entitlement holds.","type":"text"}]},{"text":"Step 6: Tear the stream down","type":"heading","anchor":"Step-6-Tear-the-stream-down","level":2},{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"code":"finish()","type":"codeVoice"},{"text":" at the end of a test to terminate the stream cleanly:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["mock.finish()"]},{"type":"paragraph","inlineContent":[{"text":"This causes any pending ","type":"text"},{"code":"for await … in stream","type":"codeVoice"},{"text":" to exit. Without it, the consuming ","type":"text"},{"code":"Task","type":"codeVoice"},{"text":" may stay alive until the test runner reaps it. Tests that own the mock for their full duration can skip this — Swift Testing tears down the task tree when the test exits — but it’s a clean habit.","type":"text"}]}]}],"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"kind":"article","seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService"],"title":"Related Documentation"},{"anchor":"How-to-Guides","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI"],"title":"How-to Guides","generated":true}],"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/MockServiceReference":{"kind":"article","role":"article","title":"Mock Service Reference","type":"topic","abstract":[{"text":"API reference for ","type":"text"},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"text":" — a controllable ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" conformer for previews and tests that does not touch ","type":"text"},{"code":"Purchases.shared","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference","url":"\/documentation\/swiduxrevenuecatpaywall\/mockservicereference"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToAddAPermanentLicense":{"kind":"article","role":"article","title":"How to Add a Permanent License","type":"topic","abstract":[{"text":"Sell a lifetime entitlement alongside a subscription and surface both flags through the paywall plugin.","type":"text"}],"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","url":"\/documentation\/swiduxrevenuecatpaywall\/howtoaddapermanentlicense"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToPresentTheUI":{"kind":"article","role":"article","title":"How to Present the UI","type":"topic","abstract":[{"text":"Attach the ","type":"text"},{"code":"revenueCatPaywall","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"revenueCatCustomerCenter","type":"codeVoice"},{"text":" view modifiers from ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" to a root view, driven by ","type":"text"},{"code":"PaywallState","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","url":"\/documentation\/swiduxrevenuecatpaywall\/howtopresenttheui"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall":{"abstract":[{"text":"RevenueCat adapter for Swidux’s ","type":"text"},{"code":"PaywallPlugin","type":"codeVoice"},{"text":". Implements ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" against ","type":"text"},{"code":"Purchases.shared","type":"codeVoice"},{"text":", ships a controllable mock for previews and tests, and pairs with ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" for drop-in ","type":"text"},{"code":"PaywallView","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"CustomerCenterView","type":"codeVoice"},{"text":" presentation.","type":"text"}],"type":"topic","url":"\/documentation\/swiduxrevenuecatpaywall","title":"SwiduxRevenueCatPaywall","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall","role":"collection","kind":"symbol"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/MockRevenueCatPaywallService":{"abstract":[{"code":"PaywallService","type":"codeVoice"},{"text":" conformer for previews and tests with a controllable entitlement stream.","type":"text"}],"type":"topic","url":"\/documentation\/swiduxrevenuecatpaywall\/mockrevenuecatpaywallservice","title":"MockRevenueCatPaywallService","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"MockRevenueCatPaywallService","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MockRevenueCatPaywallService","kind":"identifier"}]},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToImplementService":{"kind":"article","role":"article","title":"How to Implement the Service","type":"topic","abstract":[{"text":"Wire ","type":"text"},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":" into the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" plugin so the store sees real-time entitlement updates from RevenueCat.","type":"text"}],"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","url":"\/documentation\/swiduxrevenuecatpaywall\/howtoimplementservice"}}}