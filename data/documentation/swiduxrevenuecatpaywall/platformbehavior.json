{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxrevenuecatpaywall\/platformbehavior"]}],"abstract":[{"type":"text","text":"Why the "},{"code":"revenueCatPaywall","type":"codeVoice"},{"type":"text","text":" and "},{"code":"revenueCatCustomerCenter","type":"codeVoice"},{"text":" modifiers present differently on iOS and macOS, and what is hard-coded.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI"],"title":"Related Documentation","abstract":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"text":" documentation provides the matching API reference for the modifiers described here.","type":"text"}],"anchor":"Related-Documentation"},{"title":"Explanation","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping"],"generated":true,"anchor":"Explanation"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"The bundled UI is intentionally opinionated. Each modifier picks the platform-appropriate presentation so consumers don’t have to repeat the conditional compilation themselves, and so the dispatch flow stays symmetric across platforms — the same "},{"type":"codeVoice","code":".paywall(.dismiss)"},{"type":"text","text":" action fires from a "},{"type":"codeVoice","code":"fullScreenCover"},{"type":"text","text":" on iOS and from a sheet on macOS."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This article explains the reasoning behind those choices and what is fixed versus configurable."}]},{"type":"heading","anchor":"revenueCatPaywall","level":2,"text":"revenueCatPaywall"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Platform"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Presentation","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"Reason"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"iOS"}],"type":"strong"}]}],[{"inlineContent":[{"type":"codeVoice","code":"fullScreenCover"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"A subscription paywall is a primary moment, not an interrupt. ","type":"text"},{"code":"fullScreenCover","type":"codeVoice"},{"text":" keeps the UI immersive and prevents accidental gesture-dismiss.","type":"text"}]}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"macOS","type":"text"}]}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"sheet","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"frame(minWidth: 400, minHeight: 600)","type":"codeVoice"}]}],[{"inlineContent":[{"type":"text","text":"Mac sheets do not expand to fill the parent window. Without an explicit minimum size the paywall would render too small to legibly show plan options. The 400×600 minimum is roughly the size RevenueCatUI’s templates assume."}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"Because neither presentation offers a system dismissal affordance (","type":"text"},{"code":"fullScreenCover","type":"codeVoice"},{"text":" has no swipe-to-dismiss; Mac sheets have no default close control), the modifiers show ","type":"text"},{"code":"PaywallView","type":"codeVoice"},{"text":"’s close button by default. Pass ","type":"text"},{"code":"displayCloseButton: false","type":"codeVoice"},{"text":" only for a hard paywall the user must purchase through — and make sure some other path out of that screen exists.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The minimum frame is hard-coded; it is not exposed as a parameter. If your paywall layout needs more room on macOS, use "},{"code":"RevenueCatUI.PaywallView","type":"codeVoice"},{"type":"text","text":" directly inside a custom "},{"code":"sheet","type":"codeVoice"},{"type":"text","text":" modifier."}]},{"type":"heading","anchor":"revenueCatCustomerCenter","level":2,"text":"revenueCatCustomerCenter"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Platform"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Presentation","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"Reason"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"iOS"}],"type":"strong"}]}],[{"inlineContent":[{"type":"codeVoice","code":"sheet"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RevenueCatUI.CustomerCenterView"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"RevenueCatUI ships a customer center on iOS only. A non-fullscreen ","type":"text"},{"code":"sheet","type":"codeVoice"},{"text":" is appropriate because customer-center actions are administrative, not part of a purchase flow.","type":"text"}]}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"macOS","type":"text"}]}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Opens ","type":"text"},{"code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions","type":"codeVoice"},{"text":", then clears the request","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"RevenueCatUI does not ship a customer center on macOS, and the system has no equivalent in-app surface. The primitive modifier uses SwiftUI’s URL opener and fires "},{"type":"codeVoice","code":"onDismiss"},{"type":"text","text":"; the composed modifier dispatches the plugin’s "},{"type":"codeVoice","code":".openManageSubscriptions"},{"type":"text","text":" and "},{"type":"codeVoice","code":".dismissCustomerCenter"},{"type":"text","text":" actions."}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"With the composed modifier, the macOS branch dispatches ","type":"text"},{"code":".openManageSubscriptions","type":"codeVoice"},{"text":" through ","type":"text"},{"code":"PaywallPlugin","type":"codeVoice"},{"text":", then clears the binding to dispatch ","type":"text"},{"code":".dismissCustomerCenter","type":"codeVoice"},{"text":". The plugin’s URL opener is injectable, so apps and tests can control the external hand-off. The primitive binding-based modifier uses SwiftUI’s ","type":"text"},{"code":"openURL","type":"codeVoice"},{"text":" environment action and falls back to ","type":"text"},{"code":"https:\/\/apps.apple.com\/account\/subscriptions","type":"codeVoice"},{"text":" when nothing handles the ","type":"text"},{"code":"itms-apps","type":"codeVoice"},{"text":" scheme.","type":"text"}]},{"type":"heading","anchor":"Presentation-coordination","level":2,"text":"Presentation coordination"},{"type":"paragraph","inlineContent":[{"type":"text","text":"On iOS, the composed "},{"code":"revenueCatPaywall(state:offeringIdentifier:displayCloseButton:purchaseLogic:send:)","type":"codeVoice"},{"type":"text","text":" modifier never shows the paywall and customer center at once. The paywall wins: while "},{"code":"PaywallState.isPresented","type":"codeVoice"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":", the customer-center binding reads "},{"code":"false","type":"codeVoice"},{"type":"text","text":", and an initial or later state with both flags set dispatches "},{"code":".dismissCustomerCenter","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On macOS, subscription management is an external App Store hand-off rather than a second modal surface. The customer-center binding remains active while the paywall sheet is open, so the composed modifier dispatches "},{"code":".openManageSubscriptions","type":"codeVoice"},{"type":"text","text":" and then "},{"code":".dismissCustomerCenter","type":"codeVoice"},{"type":"text","text":" without losing the request."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apps wiring the primitive modifiers manually own the iOS exclusivity rule."}]},{"type":"heading","anchor":"One-app-wide-attachment","level":2,"text":"One app-wide attachment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Attach the composed modifier once, to one app-wide presentation host. "},{"code":"PaywallState","type":"codeVoice"},{"type":"text","text":" is shared, so attaching the modifier inside every "},{"code":"WindowGroup","type":"codeVoice"},{"type":"text","text":" window or scene makes every copy respond to the same request. A multi-window app should choose one scene, such as its primary app or settings window, to own paywall presentation."}]},{"type":"heading","anchor":"Why-no-platform-override-hooks","level":2,"text":"Why no platform-override hooks"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both modifiers are deliberately parameter-light: an "},{"code":"isPresented: Binding<Bool>","type":"codeVoice"},{"type":"text","text":", an optional "},{"code":"onDismiss: () -> Void","type":"codeVoice"},{"type":"text","text":", and — on the paywall only — "},{"code":"displayCloseButton:","type":"codeVoice"},{"type":"text","text":", "},{"code":"offeringIdentifier:","type":"codeVoice"},{"type":"text","text":", and optional app-owned "},{"code":"purchaseLogic:","type":"codeVoice"},{"type":"text","text":". There is no "},{"code":"paywallStyle:","type":"codeVoice"},{"type":"text","text":" or "},{"code":"presentationKind:","type":"codeVoice"},{"type":"text","text":" parameter."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The reasoning: any consumer that needs to deviate from the chosen presentation already has the underlying RevenueCatUI types ("},{"code":"PaywallView","type":"codeVoice"},{"type":"text","text":", "},{"code":"CustomerCenterView","type":"codeVoice"},{"type":"text","text":") and SwiftUI’s full presentation surface ("},{"code":"sheet","type":"codeVoice"},{"type":"text","text":", "},{"code":"fullScreenCover","type":"codeVoice"},{"type":"text","text":", "},{"code":"popover","type":"codeVoice"},{"type":"text","text":", custom containers). The bundled modifiers exist to handle the 95% case in one line — when the 5% case applies, drop down to RevenueCatUI directly."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This package does not try to be the complete paywall-UI library. It is the "},{"inlineContent":[{"type":"text","text":"integration layer"}],"type":"emphasis"},{"type":"text","text":" that makes the common case trivial."}]},{"type":"heading","anchor":"What-is-configurable","level":2,"text":"What is configurable"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The configurable surface lives in "},{"code":"RevenueCatUI","type":"codeVoice"},{"type":"text","text":" and on the paywall plugin:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Paywall content, copy, and template"}],"type":"strong"},{"text":" — configured in the RevenueCat dashboard. ","type":"text"},{"code":"RevenueCatUI.PaywallView","type":"codeVoice"},{"text":" renders whichever offering and template the dashboard returns.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Customer-center labels, sections, and actions","type":"text"}]},{"type":"text","text":" — configured in the RevenueCat dashboard. "},{"code":"RevenueCatUI.CustomerCenterView","type":"codeVoice"},{"type":"text","text":" renders whichever configuration the dashboard returns."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Close button"}],"type":"strong"},{"text":" — ","type":"text"},{"code":"displayCloseButton:","type":"codeVoice"},{"text":" on the paywall modifiers. Defaults to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":"; pass ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" for a hard paywall.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Presentation triggering","type":"text"}]},{"type":"text","text":" — driven by the plugin via "},{"code":"PaywallState.isPresented","type":"codeVoice"},{"type":"text","text":" and "},{"code":"isCustomerCenterPresented","type":"codeVoice"},{"type":"text","text":". Your code chooses "},{"type":"emphasis","inlineContent":[{"text":"when","type":"text"}]},{"type":"text","text":" to set them via "},{"code":".request(reason:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":".presentCustomerCenter","type":"codeVoice"},{"type":"text","text":" actions."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Dismiss behavior"}],"type":"strong"},{"text":" — dismiss actions are dispatched by the presentation bindings themselves (","type":"text"},{"code":".dismiss","type":"codeVoice"},{"text":" for the paywall, ","type":"text"},{"code":".dismissCustomerCenter","type":"codeVoice"},{"text":" for the customer center). The primitive modifiers’ ","type":"text"},{"code":"onDismiss","type":"codeVoice"},{"text":" callbacks are purely additive — use them for analytics hooks or cleanup, not for dispatch.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Offering selection","type":"text"}]},{"type":"text","text":" — "},{"code":"offeringIdentifier:","type":"codeVoice"},{"type":"text","text":" on the paywall modifiers presents a specific RevenueCat offering (a win-back or regional offer, for example). Omit it for the dashboard’s current offering. An unknown identifier or a failed fetch falls back to the current offering with a logged warning, so a stale identifier degrades gracefully instead of dead-ending the purchase flow."}],"type":"paragraph"}]}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior"},"metadata":{"role":"article","modules":[{"name":"SwiduxRevenueCatPaywall"}],"title":"Platform Behavior","roleHeading":"Article"},"sections":[],"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/EntitlementMapping":{"kind":"article","abstract":[{"type":"text","text":"How RevenueCat’s "},{"type":"codeVoice","code":"CustomerInfo.entitlements"},{"type":"text","text":" translates to Swidux’s "},{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":"."}],"url":"\/documentation\/swiduxrevenuecatpaywall\/entitlementmapping","role":"article","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping","type":"topic","title":"Entitlement Mapping"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall":{"kind":"symbol","abstract":[{"type":"text","text":"RevenueCat adapter for Swidux’s "},{"code":"PaywallPlugin","type":"codeVoice"},{"type":"text","text":". Implements "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" against "},{"type":"codeVoice","code":"Purchases.shared"},{"type":"text","text":", ships a controllable mock for previews and tests, and pairs with "},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" for drop-in ","type":"text"},{"code":"PaywallView","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"CustomerCenterView","type":"codeVoice"},{"text":" presentation.","type":"text"}],"url":"\/documentation\/swiduxrevenuecatpaywall","role":"collection","type":"topic","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall","title":"SwiduxRevenueCatPaywall"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToPresentTheUI":{"kind":"article","abstract":[{"text":"Attach the ","type":"text"},{"code":"revenueCatPaywall","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"revenueCatCustomerCenter","type":"codeVoice"},{"text":" view modifiers from ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" to a root view, driven by ","type":"text"},{"code":"PaywallState","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/swiduxrevenuecatpaywall\/howtopresenttheui","role":"article","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","type":"topic","title":"How to Present the UI"}}}