{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"title":"How to Present the UI","role":"article","modules":[{"name":"SwiduxRevenueCatPaywall"}],"roleHeading":"Article"},"kind":"article","identifier":{"url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"abstract":[{"type":"text","text":"Attach the "},{"code":"revenueCatPaywall","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"revenueCatCustomerCenter","type":"codeVoice"},{"text":" view modifiers from ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" to a root view, driven by ","type":"text"},{"code":"PaywallState","type":"codeVoice"},{"text":".","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService"],"anchor":"Related-Documentation","title":"Related Documentation","abstract":[{"text":"The matching API reference for the views described here lives in the ","type":"text"},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":" documentation."}]},{"identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest"],"generated":true,"title":"How-to Guides","anchor":"How-to-Guides"}],"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":" ships three view modifiers that wrap RevenueCatUI’s surfaces with platform-aware presentation. Each is bound to "},{"type":"codeVoice","code":"PaywallState"},{"type":"text","text":": presentation flags drive visibility, and the bindings dispatch matching paywall actions back through the store on dismissal. There is no local sheet state."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For platform behavior details (iOS "},{"type":"codeVoice","code":"fullScreenCover"},{"type":"text","text":" vs macOS sheet sizing, App Store deep link on macOS), see "},{"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Before-you-start","text":"Before you start","level":2,"type":"heading"},{"inlineContent":[{"text":"This guide assumes:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"You have completed "},{"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","isActive":true},{"type":"text","text":". The plugin is registered and "},{"type":"codeVoice","code":"observeCustomerInfo"},{"type":"text","text":" runs on launch."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Your app target depends on the ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" product:","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"syntax":"swift","code":[".product(name: \"SwiduxRevenueCatPaywallUI\", package: \"SwiduxRevenueCatPaywall\"),"],"type":"codeListing"},{"anchor":"Step-1-Attach-one-presentation-host","text":"Step 1: Attach one presentation host","level":2,"type":"heading"},{"inlineContent":[{"text":"The simplest wiring uses the ","type":"text"},{"code":"revenueCatPaywall(state:send:)","type":"codeVoice"},{"text":" modifier for both presentation surfaces and their actions:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["import SwiduxRevenueCatPaywallUI","","struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .revenueCatPaywall(state: store.paywall) { action in","                store.send(.paywall(action))","            }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The closure receives each "},{"code":"PaywallAction","type":"codeVoice"},{"type":"text","text":" emitted by the UI and lifts it into your root action. Attach the modifier once, to one app-wide presentation host. Do not attach it inside content created for every "},{"code":"WindowGroup","type":"codeVoice"},{"type":"text","text":" window or scene: the shared "},{"code":"PaywallState","type":"codeVoice"},{"type":"text","text":" request would make every copy present. In a multi-window app, choose one scene, such as the primary app or settings window, to own paywall presentation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both paywall modifiers also accept "},{"type":"codeVoice","code":"displayCloseButton:"},{"type":"text","text":" (default "},{"type":"codeVoice","code":"true"},{"type":"text","text":"). The default presentation has no other way out — see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior"},{"type":"text","text":" before turning it off."}]},{"anchor":"App-owned-StoreKit-2-purchases","level":3,"type":"heading","text":"App-owned StoreKit 2 purchases"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If RevenueCat is configured with "},{"code":"purchasesAreCompletedBy: .myApp","type":"codeVoice"},{"type":"text","text":" and "},{"code":"storeKitVersion: .storeKit2","type":"codeVoice"},{"type":"text","text":", pass the app’s StoreKit operations as "},{"code":"purchaseLogic","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","code":["import StoreKit","import SwiduxRevenueCatPaywallUI","","let purchaseLogic = RevenueCatPaywallPurchaseLogic(","    purchase: { product in","        try await product.purchase()","    },","    restore: {","        try await AppStore.sync()","    }",")","","ContentView()","    .revenueCatPaywall(","        state: store.paywall,","        purchaseLogic: purchaseLogic","    ) { action in","        store.send(.paywall(action))","    }"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"RevenueCatUI requires both handlers in "},{"code":".myApp","type":"codeVoice"},{"type":"text","text":" mode. The modifier always supplies them, so presenting without "},{"code":"purchaseLogic","type":"codeVoice"},{"type":"text","text":" returns a configuration error when the user tries to purchase or restore instead of triggering RevenueCatUI’s Release-build trap. The purchase closure returns the original "},{"code":"Product.PurchaseResult","type":"codeVoice"},{"type":"text","text":"; the package reports it to RevenueCat and then finishes a verified transaction. A pending purchase stays open with a pending message. The restore closure refreshes StoreKit first, and the package then synchronizes RevenueCat and reports whether it found an active subscription or non-subscription."}]},{"type":"paragraph","inlineContent":[{"text":"The bundled observer-mode UI accepts StoreKit 2 products. A ","type":"text"},{"code":".myApp","type":"codeVoice"},{"text":" configuration pinned to StoreKit 1 can still use ","type":"text"},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":", but it needs a custom paywall because ","type":"text"},{"code":"RevenueCatPaywallPurchaseLogic","type":"codeVoice"},{"text":" does not expose ","type":"text"},{"code":"SKProduct","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"SKPaymentTransaction","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"heading","level":2,"text":"Step 2: Trigger the paywall from a feature","anchor":"Step-2-Trigger-the-paywall-from-a-feature"},{"type":"paragraph","inlineContent":[{"text":"Dispatch ","type":"text"},{"code":".request(reason:)","type":"codeVoice"},{"text":" with a short identifier describing why you’re asking. ","type":"text"},{"code":"PaywallState.requestedReason","type":"codeVoice"},{"text":" stores the value for your own code — analytics, or a custom paywall. The bundled RevenueCatUI paywall does not read it:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["Button(\"Export PDF\") {","    store.send(.paywall(.request(reason: \"export-pdf\")))","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin sets "},{"type":"codeVoice","code":"PaywallState.isPresented = true"},{"type":"text","text":". The "},{"type":"codeVoice","code":"revenueCatPaywall"},{"type":"text","text":" modifier observes the change and presents "},{"type":"codeVoice","code":"RevenueCatUI.PaywallView"},{"type":"text","text":" with the correct RevenueCat-owned or app-owned handlers."}]},{"type":"heading","level":2,"text":"Step 3: Trigger the customer center","anchor":"Step-3-Trigger-the-customer-center"},{"inlineContent":[{"type":"text","text":"Existing subscribers manage their subscription through the customer center. Surface a button that dispatches "},{"code":".presentCustomerCenter","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["if store.paywall.isPro {","    Button(\"Manage Subscription\") {","        store.send(.paywall(.presentCustomerCenter))","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The "},{"code":"revenueCatCustomerCenter","type":"codeVoice"},{"type":"text","text":" modifier presents "},{"code":"RevenueCatUI.CustomerCenterView","type":"codeVoice"},{"type":"text","text":" on iOS. On macOS, the convenience modifier dispatches "},{"code":".openManageSubscriptions","type":"codeVoice"},{"type":"text","text":" so the paywall plugin opens the App Store subscriptions URL through its injectable URL handler, then dispatches "},{"code":".dismissCustomerCenter","type":"codeVoice"},{"type":"text","text":". RevenueCatUI does not ship a customer center on macOS; see "},{"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Step 4: Manual wiring (optional)","level":2,"type":"heading","anchor":"Step-4-Manual-wiring-optional"},{"inlineContent":[{"type":"text","text":"If you need only one sheet, or you want to interleave other modifiers between them, attach the primitive modifiers directly. Each takes a real "},{"type":"codeVoice","code":"Binding<Bool>"},{"type":"text","text":"; build it with a "},{"type":"codeVoice","code":"set:"},{"type":"text","text":" that dispatches the matching dismiss action when SwiftUI clears the flag:"}],"type":"paragraph"},{"code":["ContentView()","    .revenueCatPaywall(","        isPresented: Binding(","            get: { store.paywall.isPresented },","            set: { if !$0 { store.send(.paywall(.dismiss)) } }","        )","    )","    .revenueCatCustomerCenter(","        isPresented: Binding(","            get: { store.paywall.isCustomerCenterPresented },","            set: { if !$0 { store.send(.paywall(.dismissCustomerCenter)) } }","        )","    )"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The convenience modifier "},{"type":"codeVoice","code":"revenueCatPaywall(state:send:)"},{"type":"text","text":" attaches this wiring and closes the paywall after a restore that leaves the user entitled. On iOS it also keeps the paywall and customer center mutually exclusive. The macOS customer center is an external App Store hand-off, so a request made while the paywall is open is handled immediately instead of being discarded."}],"type":"paragraph"},{"text":"Step 5: Restore from inside the paywall","level":2,"type":"heading","anchor":"Step-5-Restore-from-inside-the-paywall"},{"inlineContent":[{"text":"RevenueCatUI’s ","type":"text"},{"code":"PaywallView","type":"codeVoice"},{"text":" provides its own restore button by default. If you need an additional restore affordance elsewhere (a Settings row, for example), dispatch ","type":"text"},{"code":".restorePurchases","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["Button(\"Restore Purchases\") {","    store.send(.paywall(.restorePurchases))","}",".disabled(store.paywall.isLoading)"],"type":"codeListing","syntax":"swift"},{"text":"What happens on dismiss","level":2,"type":"heading","anchor":"What-happens-on-dismiss"},{"inlineContent":[{"type":"text","text":"When the user dismisses the paywall, the plugin’s "},{"type":"codeVoice","code":".dismiss"},{"type":"text","text":" action clears "},{"type":"codeVoice","code":"PaywallState.isPresented"},{"type":"text","text":" and "},{"type":"codeVoice","code":"requestedReason"},{"type":"text","text":", then dispatches "},{"code":".refreshCustomerInfo","type":"codeVoice"},{"text":" so the gate is reconciled — the user may have purchased while the sheet was open.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"RevenueCatUI dismisses the paywall itself after a purchase, but not after a restore. The convenience modifier closes it for you: once RevenueCatUI reports the restore complete (after the user acknowledges its success alert) and ","type":"text"},{"type":"codeVoice","code":"PaywallState.isGateSatisfied"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":", it dispatches ","type":"text"},{"type":"codeVoice","code":".dismiss"},{"text":". The entitlement arrives through the live stream, so keep ","type":"text"},{"code":".observeCustomerInfo","type":"codeVoice"},{"type":"text","text":" running. With the manual wiring, nothing closes the paywall after a restore — a user who restores behind a hard paywall ("},{"code":"displayCloseButton: false","type":"codeVoice"},{"type":"text","text":") has no way out, so use the convenience modifier there."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the user dismisses the customer center, the plugin’s "},{"type":"codeVoice","code":".dismissCustomerCenter"},{"type":"text","text":" action clears "},{"type":"codeVoice","code":"isCustomerCenterPresented"},{"type":"text","text":". On macOS the convenience modifier sends that action immediately after "},{"type":"codeVoice","code":".openManageSubscriptions"},{"type":"text","text":". No refresh is dispatched, since opening the customer center does not change entitlement state by itself; the live "},{"type":"codeVoice","code":"customerInfoStream"},{"type":"text","text":" from "},{"type":"codeVoice","code":"Step 5"},{"type":"text","text":" of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService"},{"type":"text","text":" picks up any subscription change RevenueCat reports asynchronously."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swiduxrevenuecatpaywall\/howtopresenttheui"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/PlatformBehavior":{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","type":"topic","abstract":[{"type":"text","text":"Why the "},{"type":"codeVoice","code":"revenueCatPaywall"},{"type":"text","text":" and "},{"type":"codeVoice","code":"revenueCatCustomerCenter"},{"type":"text","text":" modifiers present differently on iOS and macOS, and what is hard-coded."}],"kind":"article","title":"Platform Behavior","role":"article","url":"\/documentation\/swiduxrevenuecatpaywall\/platformbehavior"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToImplementService":{"url":"\/documentation\/swiduxrevenuecatpaywall\/howtoimplementservice","kind":"article","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","type":"topic","abstract":[{"type":"text","text":"Wire "},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":" into the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin so the store sees real-time entitlement updates from RevenueCat."}],"role":"article","title":"How to Implement the Service"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToPreviewAndTest":{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest","title":"How to Preview and Test","role":"article","abstract":[{"type":"text","text":"Drive entitlement state from SwiftUI previews and tests with "},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":" — no RevenueCat SDK call required."}],"url":"\/documentation\/swiduxrevenuecatpaywall\/howtopreviewandtest","kind":"article","type":"topic"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToAddAPermanentLicense":{"role":"article","kind":"article","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","type":"topic","abstract":[{"text":"Sell a lifetime entitlement alongside a subscription and surface both flags through the paywall plugin.","type":"text"}],"title":"How to Add a Permanent License","url":"\/documentation\/swiduxrevenuecatpaywall\/howtoaddapermanentlicense"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall":{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall","type":"topic","abstract":[{"text":"RevenueCat adapter for Swidux’s ","type":"text"},{"code":"PaywallPlugin","type":"codeVoice"},{"text":". Implements ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" against ","type":"text"},{"code":"Purchases.shared","type":"codeVoice"},{"type":"text","text":", ships a controllable mock for previews and tests, and pairs with "},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":" for drop-in "},{"code":"PaywallView","type":"codeVoice"},{"type":"text","text":" and "},{"code":"CustomerCenterView","type":"codeVoice"},{"type":"text","text":" presentation."}],"title":"SwiduxRevenueCatPaywall","kind":"symbol","role":"collection","url":"\/documentation\/swiduxrevenuecatpaywall"}}}