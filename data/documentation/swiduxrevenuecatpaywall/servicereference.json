ext","text":" translates to Swidux’s "},{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":"."}],"kind":"article","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping","url":"\/documentation\/swiduxrevenuecatpaywall\/entitlementmapping","role":"article","title":"Entitlement Mapping"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/RevenueCatPaywallError/verificationFailed":{"type":"topic","abstract":[{"type":"text","text":"The response or a configured entitlement failed signature verification, so no snapshot was produced."}],"kind":"symbol","url":"\/documentation\/swiduxrevenuecatpaywall\/revenuecatpaywallerror\/verificationfailed","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallError\/verificationFailed","role":"symbol","title":"RevenueCatPaywallError.verificationFailed","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"verificationFailed","kind":"identifier"}]},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/UIComponentsReference":{"type":"topic","kind":"article","abstract":[{"text":"API reference for the paywall, customer-center, and composed view modifiers in ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/swiduxrevenuecatpaywall\/uicomponentsreference","title":"UI Components Reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/UIComponentsReference","role":"article"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/RevenueCatPaywall/configure(apiKey:appUserID:userDefaults:logLevel:entitlementVerification:purchasesAreCompletedBy:storeKitVersion:)":{"abstract":[{"type":"text","text":"Configures the underlying purchase provider."}],"role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"k