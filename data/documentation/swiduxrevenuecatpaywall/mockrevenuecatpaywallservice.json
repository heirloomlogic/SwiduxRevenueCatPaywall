{"identifier":{"url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService","interfaceLanguage":"swift"},"relationshipsSections":[{"kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/13SwiduxPaywall0B7ServiceP","doc:\/\/SwiduxRevenueCatPaywall\/s8SendableP","doc:\/\/SwiduxRevenueCatPaywall\/s16SendableMetatypeP"],"title":"Conforms To"}],"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"metadata":{"symbolKind":"class","roleHeading":"Class","navigatorTitle":[{"kind":"identifier","text":"MockRevenueCatPaywallService"}],"modules":[{"name":"SwiduxRevenueCatPaywall"}],"externalID":"s:23SwiduxRevenueCatPaywall04MockbcD7ServiceC","title":"MockRevenueCatPaywallService","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MockRevenueCatPaywallService","kind":"identifier"}],"role":"symbol"},"abstract":[{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" conformer for previews and tests with a controllable entitlement stream."}],"kind":"symbol","topicSections":[{"generated":true,"title":"Initializers","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/init(isPro:hasPermanentLicense:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Properties","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/customerInfoError","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/restoreError"],"anchor":"Instance-Properties"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/customerInfo()","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/customer