{"kind":"article","seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/ServiceReference","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping"],"title":"Related Documentation"},{"anchor":"How-to-Guides","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest"],"generated":true,"title":"How-to Guides"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxrevenuecatpaywall\/howtoimplementservice"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Wire "},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":" into the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin so the store sees real-time entitlement updates from RevenueCat."}],"metadata":{"modules":[{"name":"SwiduxRevenueCatPaywall"}],"roleHeading":"Article","title":"How to Implement the Service","role":"article"},"identifier":{"url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"This guide takes you from a wired Swidux app with a paywall slice to a live RevenueCat-backed entitlement pipeline. It covers SDK configuration, plugin registration, observation lifecycle, and refresh\/restore flows."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For the API-level reference of the service, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/ServiceReference"},{"type":"text","text":". For the entitlement mapping rules, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping"},{"type":"text","text":". For the upstream plugin contract — actions, state shape, dispatch semantics — see Swidux’s "},{"type":"emphasis","inlineContent":[{"text":"Add a Paywall","type":"text"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"SwiduxPaywall Reference"}]},{"type":"text","text":"; this guide does not repeat that material."}]},{"level":2,"type":"heading","text":"Before you start","anchor":"Before-you-start"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide assumes:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"You have a wired Swidux app — ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":", ","type":"text"},{"type":"codeVoice","code":"AppAction"},{"text":", ","type":"text"},{"type":"codeVoice","code":"AppReducer"},{"text":", ","type":"text"},{"type":"codeVoice","code":"AppStore"},{"text":" exist, and the store is in the SwiftUI environment.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Your ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":" already has a ","type":"text"},{"type":"codeVoice","code":"paywall: PaywallState"},{"text":" slice and your ","type":"text"},{"type":"codeVoice","code":"AppAction"},{"text":" has a ","type":"text"},{"type":"codeVoice","code":".paywall(PaywallAction)"},{"text":" case. If not, follow Swidux’s ","type":"text"},{"inlineContent":[{"text":"Add a Paywall","type":"text"}],"type":"emphasis"},{"text":" guide first.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"You have a RevenueCat project, an API key, and at least one entitlement identifier configured in the RevenueCat dashboard.","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Step-1-Add-the-dependencies","level":2,"type":"heading","text":"Step 1: Add the dependencies"},{"type":"paragraph","inlineContent":[{"text":"Add both Swift packages to your ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/HeirloomLogic\/Swidux\", from: \"1.6.0\"),","    .package(url: \"https:\/\/github.com\/HeirloomLogic\/SwiduxRevenueCatPaywall\", from: \"1.0.0\"),","],"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the products you need to your app target:"}]},{"syntax":"swift","code":[".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxPaywall\", package: \"Swidux\"),","        .product(name: \"SwiduxRevenueCatPaywall\", package: \"SwiduxRevenueCatPaywall\"),","        .product(name: \"SwiduxRevenueCatPaywallUI\", package: \"SwiduxRevenueCatPaywall\"),","    ]",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":" is optional — drop it if you don’t need the bundled sheets."}]},{"anchor":"Step-2-Configure-the-paywall-at-launch","level":2,"type":"heading","text":"Step 2: Configure the paywall at launch"},{"type":"paragraph","inlineContent":[{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":" calls into ","type":"text"},{"code":"Purchases.shared","type":"codeVoice"},{"text":" under the hood. Configure the paywall before constructing the store:","type":"text"}]},{"syntax":"swift","code":["\/\/ MyApp.swift","import SwiduxRevenueCatPaywall","import SwiftUI","","@main","struct MyApp: App {","    @State private var store: AppStore","","    init() {","        RevenueCatPaywall.configure(apiKey: \"your_revenuecat_api_key\")","        _store = State(wrappedValue: AppStore.configured())","    }","","    var body: some Scene {","        WindowGroup { ContentView().environment(store) }","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If users sign in after launch, switch the purchase provider to them with "},{"code":"RevenueCatPaywall.logIn(appUserID:)","type":"codeVoice"},{"type":"text","text":" and back with "},{"code":"RevenueCatPaywall.logOut()","type":"codeVoice"},{"type":"text","text":" — like "},{"code":"configure","type":"codeVoice"},{"type":"text","text":", these wrappers keep the RevenueCat import out of your app target. The entitlement stream delivers the new user’s entitlements automatically. "},{"code":"logOut()","type":"codeVoice"},{"text":" returns immediately when the current user is already anonymous; if it throws a network error, the sign-out has still taken effect, so dispatch ","type":"text"},{"type":"codeVoice","code":".refreshCustomerInfo"},{"text":" once connectivity returns.","type":"text"}]},{"name":"Important","style":"important","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"Purchases.shared"},{"type":"text","text":" traps if used unconfigured. Call "},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywall\/configure(apiKey:appUserID:userDefaults:logLevel:entitlementVerification:purchasesAreCompletedBy:storeKitVersion:)","type":"reference","isActive":true},{"text":" before anything that constructs ","type":"text"},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":", including SwiftUI previews — guard preview-only code with ","type":"text"},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":" instead."}],"type":"paragraph"}]},{"anchor":"Step-3-Construct-the-service","level":2,"text":"Step 3: Construct the service","type":"heading"},{"inlineContent":[{"type":"text","text":"Create the service with the entitlement identifier you set up in the RevenueCat dashboard:"}],"type":"paragraph"},{"code":["import SwiduxPaywall","import SwiduxRevenueCatPaywall","","let service = ResilientPaywallService(","    base: RevenueCatPaywallService(entitlementID: \"pro\"),","    store: UserDefaultsKeyValueStore()",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":"ResilientPaywallService","type":"codeVoice"},{"text":" (from SwiduxPaywall) persists the last entitlement snapshot a successful read delivered, so a slow or failing network at cold launch never gates a paying user as free — the last-known-good state holds until live data arrives, and a genuine lapse is honoured on the next successful read. The bare ","type":"text"},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":" works too, but for production the resilient wrapper is the right default.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"If your app sells a separate lifetime SKU alongside a subscription, see ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","isActive":true,"type":"reference"},{"text":" for the dual-entitlement form.","type":"text"}]},{"level":2,"type":"heading","text":"Step 4: Register the paywall plugin","anchor":"Step-4-Register-the-paywall-plugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass the service to "},{"code":"PaywallPlugin","type":"codeVoice"},{"type":"text","text":" when wiring the store:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ AppStore.swift","import Swidux","import SwiduxPaywall","import SwiduxRevenueCatPaywall","","extension Store where State == AppState, Action == AppAction {","    static func configured() -> AppStore {","        let plugins = PluginHost<AppState, AppAction>()","","        plugins.register(","            PaywallPlugin<AppState, AppAction>(","                state: \\.paywall,","                action: AppAction.paywall,","                extractAction: { if case .paywall(let a) = $0 { return a }; return nil },","                service: ResilientPaywallService(","                    base: RevenueCatPaywallService(entitlementID: \"pro\"),","                    store: UserDefaultsKeyValueStore()","                )","            )","        )","","        return Store(","            initialState: AppState(),","            reducer: AppReducer().reduce,","            plugins: plugins","        )","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin owns reducing for "},{"type":"codeVoice","code":".paywall"},{"type":"text","text":" actions; your root reducer should fall through with "},{"type":"codeVoice","code":"return nil"},{"type":"text","text":" for that case."}]},{"level":2,"anchor":"Step-5-Observe-customer-info-on-launch","type":"heading","text":"Step 5: Observe customer info on launch"},{"inlineContent":[{"text":"Start the entitlement stream once, on the root view:","type":"text"}],"type":"paragraph"},{"code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .task {","                store.send(.paywall(.observeCustomerInfo))","                store.send(.paywall(.refreshCustomerInfo))","            }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"observeCustomerInfo","type":"codeVoice"},{"text":" returns a long-lived effect that consumes ","type":"text"},{"type":"codeVoice","code":"RevenueCatPaywallService.customerInfoStream()"},{"type":"text","text":". Every snapshot the service yields flows through "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" and updates "},{"code":"store.paywall.isPro","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"hasPermanentLicense","type":"codeVoice"},{"type":"text","text":". The effect lives for the duration of the stream, so the store stays in sync with RevenueCat without polling."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The accompanying "},{"type":"codeVoice","code":"refreshCustomerInfo"},{"type":"text","text":" seeds the state. A new stream yields the customer info RevenueCat last delivered in this process, but RevenueCat may not have delivered one yet — on a relaunch with a fresh cache it skips the launch fetch — and the stream then stays silent until the next change."}]},{"type":"heading","level":2,"text":"Step 6: Gate features","anchor":"Step-6-Gate-features"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read "},{"type":"codeVoice","code":"store.paywall.isGateSatisfied"},{"type":"text","text":" before running gated work. If it’s "},{"type":"codeVoice","code":"false"},{"type":"text","text":", dispatch "},{"type":"codeVoice","code":".request(reason:)"},{"type":"text","text":" instead:"}]},{"type":"codeListing","syntax":"swift","code":["Button(\"Export PDF\") {","    if store.paywall.isGateSatisfied {","        store.send(.export(.exportPDF))","    } else {","        store.send(.paywall(.request(reason: \"export-pdf\")))","    }","}"]},{"type":"paragraph","inlineContent":[{"code":"isGateSatisfied","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" when the user holds an active pro subscription ","type":"text"},{"inlineContent":[{"type":"text","text":"or"}],"type":"strong"},{"text":" a permanent license — feature code does not need to know which.","type":"text"}]},{"anchor":"Step-7-Wire-the-UI","type":"heading","text":"Step 7: Wire the UI","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"To present "},{"type":"codeVoice","code":"RevenueCatUI.PaywallView"},{"type":"text","text":" and the customer center, attach the bundled sheets to a root view. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI"},{"type":"text","text":"."}]},{"anchor":"Step-8-Restore-purchases","type":"heading","text":"Step 8: Restore purchases","level":2},{"type":"paragraph","inlineContent":[{"text":"Add a restore button to your paywall UI. Reflect ","type":"text"},{"code":"store.paywall.isLoading","type":"codeVoice"},{"text":" to disable it while the call is in flight:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["Button(\"Restore Purchases\") {","    store.send(.paywall(.restorePurchases))","}",".disabled(store.paywall.isLoading)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin calls "},{"type":"codeVoice","code":"RevenueCatPaywallService.restorePurchases()"},{"type":"text","text":", which forwards to "},{"type":"codeVoice","code":"Purchases.shared.restorePurchases()"},{"type":"text","text":". On success the resulting snapshot flows through "},{"code":".customerInfoUpdated","type":"codeVoice"},{"text":" and updates the gate. On failure, ","type":"text"},{"code":"store.paywall.error","type":"codeVoice"},{"text":" is set.","type":"text"}]},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If you configured "},{"type":"codeVoice","code":"purchasesAreCompletedBy: .myApp"},{"text":", the service calls ","type":"text"},{"code":"syncPurchases()","type":"codeVoice"},{"text":" instead of ","type":"text"},{"code":"restorePurchases()","type":"codeVoice"},{"text":", since RevenueCat reserves ","type":"text"},{"code":"syncPurchases()","type":"codeVoice"},{"text":" for apps that don’t call its purchase methods. Be aware that the bundled ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" paywall does not support this mode yet — see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywall\/PurchasesCompletedBy\/myApp","type":"reference"},{"text":".","type":"text"}]}]},{"text":"Step 9: Handle errors","level":2,"type":"heading","anchor":"Step-9-Handle-errors"},{"type":"paragraph","inlineContent":[{"text":"The service throws whatever ","type":"text"},{"code":"Purchases.shared","type":"codeVoice"},{"type":"text","text":" throws — "},{"code":"ErrorCode.networkError","type":"codeVoice"},{"type":"text","text":", "},{"code":".offlineConnectionError","type":"codeVoice"},{"type":"text","text":", configuration errors, etc. The plugin catches the error and dispatches "},{"type":"codeVoice","code":".refreshFailed(message)"},{"type":"text","text":". Read "},{"type":"codeVoice","code":"store.paywall.error"},{"type":"text","text":" from your paywall view to surface a retry affordance:"}]},{"type":"codeListing","syntax":"swift","code":["if let error = store.paywall.error {","    Text(error)","        .foregroundStyle(.red)","    Button(\"Retry\") {","        store.send(.paywall(.refreshCustomerInfo))","    }","}"]}]}],"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToAddAPermanentLicense":{"abstract":[{"text":"Sell a lifetime entitlement alongside a subscription and surface both flags through the paywall plugin.","type":"text"}],"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","role":"article","title":"How to Add a Permanent License","url":"\/documentation\/swiduxrevenuecatpaywall\/howtoaddapermanentlicense","kind":"article","type":"topic"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/EntitlementMapping":{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping","abstract":[{"text":"How RevenueCat’s ","type":"text"},{"type":"codeVoice","code":"CustomerInfo.entitlements"},{"type":"text","text":" translates to Swidux’s "},{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":"."}],"role":"article","title":"Entitlement Mapping","url":"\/documentation\/swiduxrevenuecatpaywall\/entitlementmapping","kind":"article","type":"topic"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToPresentTheUI":{"role":"article","url":"\/documentation\/swiduxrevenuecatpaywall\/howtopresenttheui","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","type":"topic","kind":"article","abstract":[{"type":"text","text":"Attach the "},{"type":"codeVoice","code":"revenueCatPaywall"},{"type":"text","text":" and "},{"type":"codeVoice","code":"revenueCatCustomerCenter"},{"type":"text","text":" view modifiers from "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":" to a root view, driven by "},{"type":"codeVoice","code":"PaywallState"},{"type":"text","text":"."}],"title":"How to Present the UI"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/RevenueCatPaywall/configure(apiKey:appUserID:userDefaults:logLevel:entitlementVerification:purchasesAreCompletedBy:storeKitVersion:)":{"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Configures the underlying purchase provider."}],"title":"configure(apiKey:appUserID:userDefaults:logLevel:entitlementVerification:purchasesAreCompletedBy:storeKitVersion:)","type":"topic","url":"\/documentation\/swiduxrevenuecatpaywall\/revenuecatpaywall\/configure(apikey:appuserid:userdefaults:loglevel:entitlementverification:purchasesarecompletedby:storekitversion:)","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywall\/configure(apiKey:appUserID:userDefaults:logLevel:entitlementVerification:purchasesAreCompletedBy:storeKitVersion:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"configure","kind":"identifier"},{"text":"(","kind":"text"},{"text":"apiKey","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"appUserID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"userDefaults","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UserDefaults","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSUserDefaults"},{"text":"?, ","kind":"text"},{"text":"logLevel","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"RevenueCatPaywall","kind":"typeIdentifier","preciseIdentifier":"s:23SwiduxRevenueCatPaywall0bcD0O"},{"text":".","kind":"text"},{"text":"LogLevel","kind":"typeIdentifier","preciseIdentifier":"s:23SwiduxRevenueCatPaywall0bcD0O8LogLevelO"},{"text":"?, ","kind":"text"},{"text":"entitlementVerification","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"RevenueCatPaywall","kind":"typeIdentifier","preciseIdentifier":"s:23SwiduxRevenueCatPaywall0bcD0O"},{"text":".","kind":"text"},{"text":"EntitlementVerification","kind":"typeIdentifier","preciseIdentifier":"s:23SwiduxRevenueCatPaywall0bcD0O23EntitlementVerificationO"},{"text":", ","kind":"text"},{"text":"purchasesAreCompletedBy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"RevenueCatPaywall","kind":"typeIdentifier","preciseIdentifier":"s:23SwiduxRevenueCatPaywall0bcD0O"},{"text":".","kind":"text"},{"text":"PurchasesCompletedBy","kind":"typeIdentifier","preciseIdentifier":"s:23SwiduxRevenueCatPaywall0bcD0O20PurchasesCompletedByO"},{"text":"?, ","kind":"text"},{"text":"storeKitVersion","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"RevenueCatPaywall","kind":"typeIdentifier","preciseIdentifier":"s:23SwiduxRevenueCatPaywall0bcD0O"},{"text":".","kind":"text"},{"text":"StoreKitVersion","kind":"typeIdentifier","preciseIdentifier":"s:23SwiduxRevenueCatPaywall0bcD0O15StoreKitVersionO"},{"text":"?)","kind":"text"}]},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall":{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall","abstract":[{"text":"RevenueCat adapter for Swidux’s ","type":"text"},{"code":"PaywallPlugin","type":"codeVoice"},{"text":". Implements ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" against ","type":"text"},{"code":"Purchases.shared","type":"codeVoice"},{"text":", ships a controllable mock for previews and tests, and pairs with ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":" for drop-in "},{"code":"PaywallView","type":"codeVoice"},{"type":"text","text":" and "},{"code":"CustomerCenterView","type":"codeVoice"},{"type":"text","text":" presentation."}],"role":"collection","title":"SwiduxRevenueCatPaywall","url":"\/documentation\/swiduxrevenuecatpaywall","kind":"symbol","type":"topic"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/RevenueCatPaywall/PurchasesCompletedBy/myApp":{"abstract":[{"type":"text","text":"Your app makes the purchases and finishes the transactions; RevenueCat observes."}],"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywall\/PurchasesCompletedBy\/myApp","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"myApp","kind":"identifier"}],"title":"RevenueCatPaywall.PurchasesCompletedBy.myApp","url":"\/documentation\/swiduxrevenuecatpaywall\/revenuecatpaywall\/purchasescompletedby\/myapp","kind":"symbol","type":"topic"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/ServiceReference":{"role":"article","url":"\/documentation\/swiduxrevenuecatpaywall\/servicereference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/ServiceReference","kind":"article","type":"topic","abstract":[{"text":"API reference for ","type":"text"},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":" — the RevenueCat-backed ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" conformer that the paywall plugin consumes.","type":"text"}],"title":"Service Reference"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToPreviewAndTest":{"abstract":[{"type":"text","text":"Drive entitlement state from SwiftUI previews and tests with "},{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"type":"text","text":" — no RevenueCat SDK call required."}],"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest","role":"article","title":"How to Preview and Test","url":"\/documentation\/swiduxrevenuecatpaywall\/howtopreviewandtest","kind":"article","type":"topic"}}}