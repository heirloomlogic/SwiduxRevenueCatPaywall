ementMapping","title":"Entitlement Mapping","url":"\/documentation\/swiduxrevenuecatpaywall\/entitlementmapping","kind":"article","role":"article","type":"topic"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToImplementService":{"type":"topic","role":"article","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","title":"How to Implement the Service","url":"\/documentation\/swiduxrevenuecatpaywall\/howtoimplementservice","kind":"article","abstract":[{"type":"text","text":"Wire "},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":" into the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" plugin so the store sees real-time entitlement updates from RevenueCat."}]}}}