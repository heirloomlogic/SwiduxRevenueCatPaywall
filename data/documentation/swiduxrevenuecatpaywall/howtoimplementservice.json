{"seeAlsoSections":[{"identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/ServiceReference","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest"],"anchor":"How-to-Guides","generated":true,"title":"How-to Guides"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService"},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"role":"article","modules":[{"name":"SwiduxRevenueCatPaywall"}],"roleHeading":"Article","title":"How to Implement the Service"},"abstract":[{"type":"text","text":"Wire "},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":" into the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin so the store sees real-time entitlement updates from RevenueCat."}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide takes you from a wired Swidux app with a paywall slice to a live RevenueCat-backed entitlement pipeline. It covers SDK configuration, plugin registration, observation lifecycle, and refresh\/restore flows."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For the API-level reference of the service, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/ServiceReference"},{"type":"text","text":". For the entitlement mapping rules, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping"},{"type":"text","text":". For the upstream plugin contract — actions, state shape, dispatch semantics — see Swidux’s "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Add a Paywall"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"SwiduxPaywall Reference"}]},{"type":"text","text":"; this guide does not repeat that material."}]},{"level":2,"type":"heading","text":"Before you start","anchor":"Before-you-start"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide assumes:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"You have a wired Swidux app — ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppReducer","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppStore","type":"codeVoice"},{"text":" exist, and the store is in the SwiftUI environment.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Your ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" already has a ","type":"text"},{"code":"paywall: PaywallState","type":"codeVoice"},{"text":" slice and your ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":" has a ","type":"text"},{"code":".paywall(PaywallAction)","type":"codeVoice"},{"text":" case. If not, follow Swidux’s ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Add a Paywall","type":"text"}]},{"text":" guide first.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"You have a RevenueCat project, an API key, and at least one entitlement identifier configured in the RevenueCat dashboard.","type":"text"}]}]}]},{"level":2,"type":"heading","text":"Step 1: Add the dependencies","anchor":"Step-1-Add-the-dependencies"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add both Swift packages to your "},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/HeirloomLogic\/Swidux\", from: \"1.3.0\"),","    .package(url: \"https:\/\/github.com\/HeirloomLogic\/SwiduxRevenueCatPaywall\", from: \"1.0.0\"),","],"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the products you need to your app target:"}]},{"type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxPaywall\", package: \"Swidux\"),","        .product(name: \"SwiduxRevenueCatPaywall\", package: \"SwiduxRevenueCatPaywall\"),","        .product(name: \"SwiduxRevenueCatPaywallUI\", package: \"SwiduxRevenueCatPaywall\"),","    ]",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":" is optional — drop it if you don’t need the bundled sheets."}]},{"level":2,"type":"heading","text":"Step 2: Configure the paywall at launch","anchor":"Step-2-Configure-the-paywall-at-launch"},{"type":"paragraph","inlineContent":[{"code":"RevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":" calls into "},{"code":"Purchases.shared","type":"codeVoice"},{"type":"text","text":" under the hood. Configure the paywall before constructing the store:"}]},{"type":"codeListing","code":["\/\/ MyApp.swift","import SwiduxRevenueCatPaywall","import SwiftUI","","@main","struct MyApp: App {","    @State private var store: AppStore","","    init() {","        RevenueCatPaywall.configure(apiKey: \"your_revenuecat_api_key\")","        _store = State(wrappedValue: AppStore.configured())","    }","","    var body: some Scene {","        WindowGroup { ContentView().environment(store) }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If users sign in after launch, switch the purchase provider to them with "},{"code":"RevenueCatPaywall.logIn(appUserID:)","type":"codeVoice"},{"type":"text","text":" and back with "},{"code":"RevenueCatPaywall.logOut()","type":"codeVoice"},{"type":"text","text":" — like "},{"code":"configure","type":"codeVoice"},{"type":"text","text":", these wrappers keep the RevenueCat import out of your app target. The entitlement stream delivers the new user’s entitlements automatically."}]},{"name":"Important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"Purchases.shared"},{"type":"text","text":" traps if used unconfigured. Call "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywall\/configure(apiKey:appUserID:userDefaults:logLevel:entitlementVerification:purchasesAreCompletedBy:storeKitVersion:)"},{"type":"text","text":" before anything that constructs "},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":", including SwiftUI previews — guard preview-only code with "},{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"type":"text","text":" instead."}]}],"style":"important"},{"level":2,"type":"heading","text":"Step 3: Construct the service","anchor":"Step-3-Construct-the-service"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create the service with the entitlement identifier you set up in the RevenueCat dashboard:"}]},{"type":"codeListing","code":["import SwiduxPaywall","import SwiduxRevenueCatPaywall","","let service = ResilientPaywallService(","    base: RevenueCatPaywallService(entitlementID: \"pro\"),","    store: UserDefaultsKeyValueStore()",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"ResilientPaywallService","type":"codeVoice"},{"type":"text","text":" (from SwiduxPaywall) persists the last entitlement snapshot a successful read delivered, so a slow or failing network at cold launch never gates a paying user as free — the last-known-good state holds until live data arrives, and a genuine lapse is honoured on the next successful read. The bare "},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":" works too, but for production the resilient wrapper is the right default."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your app sells a separate lifetime SKU alongside a subscription, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense"},{"type":"text","text":" for the dual-entitlement form."}]},{"level":2,"type":"heading","text":"Step 4: Register the paywall plugin","anchor":"Step-4-Register-the-paywall-plugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass the service to "},{"code":"PaywallPlugin","type":"codeVoice"},{"type":"text","text":" when wiring the store:"}]},{"type":"codeListing","code":["\/\/ AppStore.swift","import Swidux","import SwiduxPaywall","import SwiduxRevenueCatPaywall","","extension Store where State == AppState, Action == AppAction {","    static func configured() -> AppStore {","        let plugins = PluginHost<AppState, AppAction>()","","        plugins.register(","            PaywallPlugin<AppState, AppAction>(","                state: \\.paywall,","                action: AppAction.paywall,","                extractAction: { if case .paywall(let a) = $0 { return a }; return nil },","                service: ResilientPaywallService(","                    base: RevenueCatPaywallService(entitlementID: \"pro\"),","                    store: UserDefaultsKeyValueStore()","                )","            )","        )","","        return Store(","            initialState: AppState(),","            reducer: AppReducer().reduce,","            plugins: plugins","        )","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin owns reducing for "},{"code":".paywall","type":"codeVoice"},{"type":"text","text":" actions; your root reducer should fall through with "},{"code":"return nil","type":"codeVoice"},{"type":"text","text":" for that case."}]},{"level":2,"type":"heading","text":"Step 5: Observe customer info on launch","anchor":"Step-5-Observe-customer-info-on-launch"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Start the entitlement stream once, on the root view:"}]},{"type":"codeListing","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .task { store.send(.paywall(.observeCustomerInfo)) }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"observeCustomerInfo","type":"codeVoice"},{"type":"text","text":" returns a long-lived effect that consumes "},{"code":"RevenueCatPaywallService.customerInfoStream()","type":"codeVoice"},{"type":"text","text":". Every snapshot the service yields flows through "},{"code":".customerInfoUpdated","type":"codeVoice"},{"type":"text","text":" and updates "},{"code":"store.paywall.isPro","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"hasPermanentLicense","type":"codeVoice"},{"type":"text","text":". The effect lives for the duration of the stream, so the store stays in sync with RevenueCat without polling."}]},{"level":2,"type":"heading","text":"Step 6: Gate features","anchor":"Step-6-Gate-features"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read "},{"code":"store.paywall.isGateSatisfied","type":"codeVoice"},{"type":"text","text":" before running gated work. If it’s "},{"code":"false","type":"codeVoice"},{"type":"text","text":", dispatch "},{"code":".request(reason:)","type":"codeVoice"},{"type":"text","text":" instead:"}]},{"type":"codeListing","code":["Button(\"Export PDF\") {","    if store.paywall.isGateSatisfied {","        store.send(.export(.exportPDF))","    } else {","        store.send(.paywall(.request(reason: \"export-pdf\")))","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"isGateSatisfied","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"true","type":"codeVoice"},{"type":"text","text":" when the user holds an active pro subscription "},{"type":"strong","inlineContent":[{"type":"text","text":"or"}]},{"type":"text","text":" a permanent license — feature code does not need to know which."}]},{"level":2,"type":"heading","text":"Step 7: Wire the UI","anchor":"Step-7-Wire-the-UI"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To present "},{"code":"RevenueCatUI.PaywallView","type":"codeVoice"},{"type":"text","text":" and the customer center, attach the bundled sheets to a root view. See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI"},{"type":"text","text":"."}]},{"level":2,"type":"heading","text":"Step 8: Restore purchases","anchor":"Step-8-Restore-purchases"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a restore button to your paywall UI. Reflect "},{"code":"store.paywall.isLoading","type":"codeVoice"},{"type":"text","text":" to disable it while the call is in flight:"}]},{"type":"codeListing","code":["Button(\"Restore Purchases\") {","    store.send(.paywall(.restorePurchases))","}",".disabled(store.paywall.isLoading)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin calls "},{"code":"RevenueCatPaywallService.restorePurchases()","type":"codeVoice"},{"type":"text","text":", which forwards to "},{"code":"Purchases.shared.restorePurchases()","type":"codeVoice"},{"type":"text","text":". On success the resulting snapshot flows through "},{"code":".customerInfoUpdated","type":"codeVoice"},{"type":"text","text":" and updates the gate. On failure, "},{"code":"store.paywall.error","type":"codeVoice"},{"type":"text","text":" is set."}]},{"name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If you configured "},{"type":"codeVoice","code":"purchasesAreCompletedBy: .myApp"},{"type":"text","text":", the service handles restore correctly for you: it calls "},{"type":"codeVoice","code":"syncPurchases()"},{"type":"text","text":" instead of "},{"type":"codeVoice","code":"restorePurchases()"},{"type":"text","text":", because in observer mode a restore can alias or transfer purchases between accounts. Dispatching "},{"type":"codeVoice","code":".restorePurchases"},{"type":"text","text":" stays safe in either mode — no special-casing in your app code."}]}],"style":"note"},{"level":2,"type":"heading","text":"Step 9: Handle errors","anchor":"Step-9-Handle-errors"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The service throws whatever "},{"code":"Purchases.shared","type":"codeVoice"},{"type":"text","text":" throws — "},{"code":"ErrorCode.networkError","type":"codeVoice"},{"type":"text","text":", "},{"code":".offlineConnectionError","type":"codeVoice"},{"type":"text","text":", configuration errors, etc. The plugin catches the error and dispatches "},{"code":".refreshFailed(message)","type":"codeVoice"},{"type":"text","text":". Read "},{"code":"store.paywall.error","type":"codeVoice"},{"type":"text","text":" from your paywall view to surface a retry affordance:"}]},{"type":"codeListing","code":["if let error = store.paywall.error {","    Text(error)","        .foregroundStyle(.red)","    Button(\"Retry\") {","        store.send(.paywall(.refreshCustomerInfo))","    }","}"],"syntax":"swift"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxrevenuecatpaywall\/howtoimplementservice"]}],"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"kind":"article","sections":[],"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall":{"abstract":[{"text":"RevenueCat adapter for Swidux’s ","type":"text"},{"code":"PaywallPlugin","type":"codeVoice"},{"text":". Implements ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" against ","type":"text"},{"code":"Purchases.shared","type":"codeVoice"},{"text":", ships a controllable mock for previews and tests, and pairs with ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" for drop-in ","type":"text"},{"code":"PaywallView","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"CustomerCenterView","type":"codeVoice"},{"text":" presentation.","type":"text"}],"type":"topic","url":"\/documentation\/swiduxrevenuecatpaywall","title":"SwiduxRevenueCatPaywall","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall","role":"collection","kind":"symbol"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/RevenueCatPaywall/configure(apiKey:appUserID:userDefaults:logLevel:entitlementVerification:purchasesAreCompletedBy:storeKitVersion:)":{"role":"symbol","type":"topic","title":"configure(apiKey:appUserID:userDefaults:logLevel:entitlementVerification:purchasesAreCompletedBy:storeKitVersion:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"configure","kind":"identifier"},{"text":"(","kind":"text"},{"text":"apiKey","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"appUserID","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifi