{"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"API reference for ","type":"text"},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":" — a controllable "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" conformer for previews and tests that does not touch "},{"type":"codeVoice","code":"Purchases.shared"},{"type":"text","text":"."}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"type":"text","text":" tracks a "},{"type":"emphasis","inlineContent":[{"text":"current","type":"text"}]},{"type":"text","text":" entitlement snapshot the way the real service reflects RevenueCat’s state: "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)"},{"type":"text","text":" updates it and pushes it through the stream, and "},{"type":"codeVoice","code":"customerInfo()"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"restorePurchases()"},{"type":"text","text":" return it. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/finish()"},{"type":"text","text":" tears the stream down, and the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/customerInfoError"},{"type":"text","text":" \/ "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/restoreError"},{"type":"text","text":" properties inject failures for testing error paths."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This mock differs from "},{"type":"codeVoice","code":"MockPaywallService"},{"type":"text","text":" in SwiduxPaywall: that mock’s stream finishes after the initial yield, which is fine for static previews but cannot model purchase, refund, or family-share updates as a sequence. This mock keeps the stream live until you tear it down."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For preview and test patterns built on this type, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest"},{"type":"text","text":"."}]},{"anchor":"Library-target","type":"heading","level":2,"text":"Library target"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Product: ","type":"text"},{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Import: ","type":"text"},{"type":"codeVoice","code":"import SwiduxRevenueCatPaywall"}],"type":"paragraph"}]}]},{"anchor":"Types","type":"heading","level":2,"text":"Types"},{"anchor":"docSwiduxRevenueCatPaywalldocumentationSwiduxRevenueCatPaywallMockRevenueCatPaywallService","type":"heading","level":3,"text":"``doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService``"},{"type":"codeListing","syntax":"swift","code":["public final class MockRevenueCatPaywallService: PaywallService, @unchecked Sendable {","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","","    public var customerInfoError: Error?","    public var restoreError: Error?","","    public func customerInfo() async throws -> EntitlementSnapshot","    public func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    public func restorePurchases() async throws -> EntitlementSnapshot","","    public func send(_ snapshot: EntitlementSnapshot)","    public func finish()","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reference type. Internal state is guarded by an "},{"type":"codeVoice","code":"NSLock"},{"type":"text","text":"; "},{"type":"codeVoice","code":"@unchecked Sendable"},{"type":"text","text":" because the protected mutable state lives behind that lock."}]},{"anchor":"Initializer","type":"heading","level":4,"text":"Initializer"},{"type":"codeListing","syntax":"swift","code":["public init(isPro: Bool = false, hasPermanentLicense: Bool = false)"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"isPro"},{"text":" — Initial value for ","type":"text"},{"type":"codeVoice","code":"EntitlementSnapshot.isPro"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"hasPermanentLicense"},{"text":" — Initial value for ","type":"text"},{"type":"codeVoice","code":"EntitlementSnapshot.hasPermanentLicense"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The values supplied here become the starting "},{"type":"emphasis","inlineContent":[{"text":"current","type":"text"}]},{"type":"text","text":" snapshot — what "},{"type":"codeVoice","code":"customerInfo()"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"restorePurchases()"},{"type":"text","text":" return and what "},{"type":"codeVoice","code":"customerInfoStream()"},{"text":" yields first, until ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)","type":"reference","isActive":true},{"text":" replaces it.","type":"text"}]},{"anchor":"customerInfoError--restoreError","type":"heading","level":4,"text":"`customerInfoError` \/ `restoreError`"},{"type":"paragraph","inlineContent":[{"text":"Optional errors thrown by ","type":"text"},{"type":"codeVoice","code":"customerInfo()"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"restorePurchases()"},{"text":" respectively while set (","type":"text"},{"type":"codeVoice","code":"nil"},{"text":", the default, means success). Set them to drive the plugin’s ","type":"text"},{"type":"codeVoice","code":".refreshFailed"},{"text":" path, retry affordances, or ","type":"text"},{"type":"codeVoice","code":"ResilientPaywallService"},{"text":"’s last-known-good fallback; clear them to restore success.","type":"text"}]},{"anchor":"customerInfo-async-throws-%3E-EntitlementSnapshot","type":"heading","level":4,"text":"`customerInfo() async throws -> EntitlementSnapshot`"},{"type":"paragraph","inlineContent":[{"text":"Returns the current snapshot — the init-time state, or the latest value passed to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)","type":"reference"},{"text":". This matches the real service: the plugin’s dismiss-triggered refresh sees the same state the stream delivered, so a simulated purchase does not regress to free on refresh. Throws ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/customerInfoError"},{"text":" instead when it is set.","type":"text"}]},{"anchor":"customerInfoStream-%3E-AsyncStream%3CEntitlementSnapshot%3E","type":"heading","level":4,"text":"`customerInfoStream() -> AsyncStream<EntitlementSnapshot>`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Yields the current snapshot, then every value passed to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)"},{"type":"text","text":". The stream stays open until "},{"isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/finish()","type":"reference"},{"text":" is called.","type":"text"}]},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"Each call to this method replaces the active continuation and finishes the previous stream, so an earlier subscriber’s ","type":"text"},{"type":"codeVoice","code":"for await"},{"type":"text","text":" loop terminates instead of hanging. Only the most recent subscriber receives subsequent "},{"isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)","type":"reference"},{"text":" updates.","type":"text"}]}],"type":"aside"},{"text":"`restorePurchases() async throws -> EntitlementSnapshot`","type":"heading","level":4,"anchor":"restorePurchases-async-throws-%3E-EntitlementSnapshot"},{"inlineContent":[{"text":"Returns the current snapshot, exactly like ","type":"text"},{"type":"codeVoice","code":"customerInfo()"},{"type":"text","text":". Throws "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/restoreError"},{"type":"text","text":" instead when it is set."}],"type":"paragraph"},{"type":"heading","anchor":"docSwiduxRevenueCatPaywalldocumentationSwiduxRevenueCatPaywallMockRevenueCatPaywallServicesend","level":4,"text":"``doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)``"},{"type":"codeListing","code":["public func send(_ snapshot: EntitlementSnapshot)"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Makes the snapshot current and pushes it to the active stream subscriber. If no stream is active, the snapshot is still recorded — only the stream delivery is skipped."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Use this to simulate purchase, expiration, or family-share updates during a test.","type":"text"}]},{"type":"heading","anchor":"docSwiduxRevenueCatPaywalldocumentationSwiduxRevenueCatPaywallMockRevenueCatPaywallServicefinish","text":"``doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/finish()``","level":4},{"type":"codeListing","code":["public func finish()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Finishes the active entitlement stream. Iterators terminate cleanly. Subsequent calls to ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)","type":"reference","isActive":true},{"text":" still update the current snapshot but are no longer delivered to a stream.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Call this in test teardown or when a preview is done observing entitlement transitions.","type":"text"}]},{"type":"heading","anchor":"Lifecycle-example","text":"Lifecycle example","level":2},{"syntax":"swift","type":"codeListing","code":["let mock = MockRevenueCatPaywallService(isPro: false)","let stream = mock.customerInfoStream()","","var iterator = stream.makeAsyncIterator()","let initial = await iterator.next()  \/\/ EntitlementSnapshot(isPro: false, ...)","","mock.send(EntitlementSnapshot(isPro: true))","let updated = await iterator.next()  \/\/ EntitlementSnapshot(isPro: true, ...)","","mock.finish()","let terminal = await iterator.next()  \/\/ nil — stream finished","","let refreshed = try await mock.customerInfo()  \/\/ EntitlementSnapshot(isPro: true, ...) — send(_:) updated it"]}]}],"variants":[{"paths":["\/documentation\/swiduxrevenuecatpaywall\/mockservicereference"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest","doc:\/\/S