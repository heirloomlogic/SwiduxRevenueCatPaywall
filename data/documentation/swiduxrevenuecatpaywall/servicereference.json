 flags set. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping","type":"reference"},{"text":" for the reasoning behind the truth table.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxrevenuecatpaywall\/servicereference"]}],"identifier":{"url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/ServiceReference","interfaceLanguage":"swift"},"kind":"article","metadata":{"role":"article","title":"Service Reference","roleHeading":"Article","modules":[{"name":"SwiduxRevenueCatPaywall"}]},"abstract":[{"text":"API reference for ","type":"text"},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":" — the RevenueCat-backed "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" conformer that the paywall plugin consumes."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/UIComponentsReference":{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/UIComponentsReference","abstract":[{"text":"API reference for the ","type":"text"},{"code":"revenueCatPaywall","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"revenueCatCustomerCenter","type":"codeVoice"},{"text":" view modifiers — the SwiftUI surface of ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":".","type":"text"}],"title":"UI Components Reference","role":"article","type":"topic","url":"\/documentation\/swiduxrevenuecatpaywall\/uicomponentsreference","kind":"article"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/MockServiceReference":{"title":"Mock Service Reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference","url":"\/documentation\/swiduxrevenuecatpaywall\/mockservi