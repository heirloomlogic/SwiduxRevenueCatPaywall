{"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxrevenuecatpaywall\/gettingstarted"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"This guide walks through the four steps to integrate "},{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"type":"text","text":" into a Swidux app: add the package, configure RevenueCat, register the plugin, and attach the UI. It is the shortest path from a wired Swidux app to a working paywall. For deeper coverage of any step, follow the linked how-tos."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This package assumes you already use Swidux. If you don’t, work through Swidux’s own getting-started guide first."}],"type":"paragraph"},{"anchor":"Add-the-Package","text":"Add the Package","type":"heading","level":2},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Xcode:"}],"type":"strong"},{"type":"text","text":" File > Add Package Dependencies, paste "},{"code":"https:\/\/github.com\/HeirloomLogic\/SwiduxRevenueCatPaywall","type":"codeVoice"},{"type":"text","text":". Add the products you need:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"type":"text","text":" — the "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" implementation and mock."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":" — adds the composed "},{"code":"revenueCatPaywallAndCustomerCenter","type":"codeVoice"},{"type":"text","text":" modifier and the "},{"code":"revenueCatPaywall","type":"codeVoice"},{"type":"text","text":" and "},{"code":"revenueCatCustomerCenter","type":"codeVoice"},{"type":"text","text":" primitives (depends on RevenueCatUI)."}],"type":"paragraph"}]}]},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Package.swift:"}],"type":"strong"}],"type":"paragraph"},{"code":[".package(url: \"https:\/\/github.com\/HeirloomLogic\/SwiduxRevenueCatPaywall\", from: \"1.0.0\"),"],"syntax":"swift","type":"codeListing"},{"code":[".product(name: \"SwiduxRevenueCatPaywall\", package: \"SwiduxRevenueCatPaywall\"),",".product(name: \"SwiduxRevenueCatPaywallUI\", package: \"SwiduxRevenueCatPaywall\"),"],"syntax":"swift","type":"codeListing"},{"anchor":"Configure-the-paywall-at-launch","text":"Configure the paywall at launch","type":"heading","level":2},{"inlineContent":[{"code":"RevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":" calls into "},{"code":"Purchases.shared","type":"codeVoice"},{"type":"text","text":" under the hood. Configure the paywall before constructing the store:"}],"type":"paragraph"},{"code":["\/\/ MyApp.swift","import SwiduxRevenueCatPaywall","import SwiftUI","","@main","struct MyApp: App {","    @State private var store: AppStore","","    init() {","        RevenueCatPaywall.configure(apiKey: \"your_revenuecat_api_key\")","        _store = State(wrappedValue: AppStore.configured())","    }","","    var body: some Scene {","        WindowGroup { ContentView().environment(store) }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The service itself is safe to construct before configuration. If stored-property initialization creates the store first, configure RevenueCat before dispatching paywall actions. An early read or restore throws "},{"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallError\/notConfigured","isActive":true},{"type":"text","text":"; an early entitlement stream finishes and can be started again after configuration. Swidux 1.9 and later clears the plugin’s observation guard when that stream ends."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Pass "},{"code":"appUserID","type":"codeVoice"},{"type":"text","text":", "},{"code":"userDefaults","type":"codeVoice"},{"type":"text","text":" (for app-group sharing with widgets), "},{"code":"logLevel","type":"codeVoice"},{"type":"text","text":", "},{"code":"entitlementVerification","type":"codeVoice"},{"type":"text","text":" (signed entitlement verification), or "},{"code":"purchasesAreCompletedBy","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"storeKitVersion","type":"codeVoice"},{"type":"text","text":" (app-completed purchases) if you need them — see "},{"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywall\/configure(apiKey:appUserID:userDefaults:logLevel:entitlementVerification:purchasesAreCompletedBy:storeKitVersion:)","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Register-the-paywall-plugin","text":"Register the paywall plugin","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Pass "},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":" to "},{"code":"PaywallPlugin","type":"codeVoice"},{"type":"text","text":" in your "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" factory:"}],"type":"paragraph"},{"code":["import Swidux","import SwiduxPaywall","import SwiduxRevenueCatPaywall","","extension Store where State == AppState, Action == AppAction {","    static func configured() -> AppStore {","        let plugins = PluginHost<AppState, AppAction>()","","        plugins.register(","            PaywallPlugin<AppState, AppAction>(","                state: \\.paywall,","                action: AppAction.paywall,","                extractAction: { if case .paywall(let a) = $0 { return a }; return nil },","                service: ResilientPaywallService(","                    base: RevenueCatPaywallService(entitlementID: \"pro\"),","                    store: KeychainKeyValueStore(service: \"com.example.myapp\")","                )","            )","        )","","        return Store(","            initialState: AppState(),","            reducer: AppReducer().reduce,","            plugins: plugins","        )","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":"ResilientPaywallService","type":"codeVoice"},{"type":"text","text":" (from SwiduxPaywall) persists the last entitlement snapshot a successful read delivered. Without it, a slow or failing network at cold launch leaves "},{"code":"PaywallState","type":"codeVoice"},{"type":"text","text":" at its free default and gates paying users out of their features until the first successful read; with it, the last-known-good state holds until live data arrives, and the server stays authoritative — a genuine lapse is honoured on the next successful read. Wrap the RevenueCat service in it for production."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Back the cache with "},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"type":"text","text":", as shown, rather than "},{"code":"UserDefaultsKeyValueStore","type":"codeVoice"},{"type":"text","text":". The cache vouches for a paid entitlement while RevenueCat is unreachable, and a "},{"code":"UserDefaults","type":"codeVoice"},{"text":" plist is user-editable and restorable from a doctored backup; the Keychain uses OS-protected storage instead of a user-editable plist. See Swidux’s ","type":"text"},{"identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/securityposture","isActive":true,"type":"reference"},{"text":" for what the cache does and does not defend against.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Start the entitlement stream on the root view so the gate reflects RevenueCat’s state from launch:"}],"type":"paragraph"},{"code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .task {","                store.send(.paywall(.observeCustomerInfo))","                store.send(.paywall(.refreshCustomerInfo))","            }","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Gate features by reading ","type":"text"},{"code":"store.paywall.isGateSatisfied","type":"codeVoice"},{"text":". See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService"},{"text":" for the full plugin lifecycle.","type":"text"}]},{"level":2,"anchor":"Attach-the-UI","type":"heading","text":"Attach the UI"},{"inlineContent":[{"type":"text","text":"Attach the composed "},{"code":"revenueCatPaywallAndCustomerCenter","type":"codeVoice"},{"type":"text","text":" modifier to a root view, driven by paywall state:"}],"type":"paragraph"},{"code":["import SwiduxRevenueCatPaywallUI","","struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .revenueCatPaywallAndCustomerCenter(","                state: store.paywall,","                onAction: { action in store.send(.paywall(action)) }","            )","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Trigger the paywall from a gated feature with "},{"type":"codeVoice","code":".paywall(.request(reason:))"},{"text":":","type":"text"}]},{"code":["Button(\"Export PDF\") {","    if store.paywall.isGateSatisfied {","        store.send(.export(.exportPDF))","    } else {","        store.send(.paywall(.request(reason: \"export-pdf\")))","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"See "},{"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","isActive":true},{"type":"text","text":" for manual wiring with the primitive modifiers, customer-center triggering, and dismiss semantics."}],"type":"paragraph"},{"anchor":"Next-Steps","text":"Next Steps","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","isActive":true,"type":"reference"},{"type":"text","text":" — Detailed walkthrough of the service lifecycle and error handling."}]}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","isActive":true,"type":"reference"},{"text":" — Add a lifetime entitlement alongside the subscription.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest","isActive":true,"type":"reference"},{"text":" — Drive entitlement state from previews and tests.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","isActive":true,"type":"reference"},{"text":" — Wire the bundled view modifiers.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","isActive":true,"type":"reference"},{"text":" — Why iOS and macOS behave differently.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping","isActive":true,"type":"reference"},{"text":" — How RevenueCat entitlements map to ","type":"text"},{"code":"EntitlementSnapshot","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}]}]}],"sections":[],"identifier":{"url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/GettingStarted","interfaceLanguage":"swift"},"abstract":[{"text":"Add the package, configure RevenueCat, register the paywall plugin, and present the bundled sheets.","type":"text"}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"SwiduxRevenueCatPaywall"}],"title":"Getting Started with SwiduxRevenueCatPaywall"},"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToPreviewAndTest":{"kind":"article","type":"topic","title":"How to Preview and Test","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest","abstract":[{"type":"text","text":"Drive entitlement state from SwiftUI previews and tests with "},{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"type":"text","text":" — no RevenueCat SDK call required."}],"url":"\/documentation\/swiduxrevenuecatpaywall\/howtopreviewandtest","role":"article"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToImplementService":{"kind":"article","type":"topic","title":"How to Implement the Service","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","abstract":[{"type":"text","text":"Wire "},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":" into the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin so the store sees real-time entitlement updates from RevenueCat."}],"url":"\/documentation\/swiduxrevenuecatpaywall\/howtoimplementservice","role":"article"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall":{"title":"SwiduxRevenueCatPaywall","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall","type":"topic","kind":"symbol","role":"collection","abstract":[{"type":"text","text":"RevenueCat adapter for Swidux’s "},{"code":"PaywallPlugin","type":"codeVoice"},{"type":"text","text":". Implements "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" against "},{"code":"Purchases.shared","type":"codeVoice"},{"type":"text","text":", ships a controllable mock for previews and tests, and pairs with "},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":" for drop-in "},{"code":"PaywallView","type":"codeVoice"},{"type":"text","text":" and "},{"code":"CustomerCenterView","type":"codeVoice"},{"type":"text","text":" presentation."}],"url":"\/documentation\/swiduxrevenuecatpaywall"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToAddAPermanentLicense":{"kind":"article","type":"topic","title":"How to Add a Permanent License","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","abstract":[{"text":"Sell a lifetime entitlement alongside a subscription and surface both flags through the paywall plugin.","type":"text"}],"url":"\/documentation\/swiduxrevenuecatpaywall\/howtoaddapermanentlicense","role":"article"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/RevenueCatPaywall/configure(apiKey:appUserID:userDefaults:logLevel:entitlementVerification:purchasesAreCompletedBy:storeKitVersion:)":{"title":"configure(apiKey:appUserID:userDefaults:logLevel:entitlementVerification:purchasesAreCompletedBy:storeKitVersion:)","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywall\/configure(apiKey:appUserID:userDefaults:logLevel:entitlementVerification:purchasesAreCompletedBy:storeKitVersion:)","type":"topic","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Configures the underlying purchase provider."}],"url":"\/documentation\/swiduxrevenuecatpaywall\/revenuecatpaywall\/configure(apikey:appuserid:userdefaults:loglevel:en