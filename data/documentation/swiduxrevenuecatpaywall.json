{"identifier":{"url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall","interfaceLanguage":"swift"},"sections":[],"abstract":[{"type":"text","text":"RevenueCat adapter for Swidux’s "},{"type":"codeVoice","code":"PaywallPlugin"},{"text":". Implements ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" against ","type":"text"},{"type":"codeVoice","code":"Purchases.shared"},{"type":"text","text":", ships a controllable mock for previews and tests, and pairs with "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":" for drop-in "},{"type":"codeVoice","code":"PaywallView"},{"type":"text","text":" and "},{"type":"codeVoice","code":"CustomerCenterView"},{"type":"text","text":" presentation."}],"hierarchy":{"paths":[[]]},"topicSections":[{"identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/GettingStarted"],"anchor":"Quickstart","title":"Quickstart"},{"title":"How-to Guides","anchor":"How-to-Guides","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest"]},{"identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/ServiceReference","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/UIComponentsReference"],"title":"Reference","anchor":"Reference"},{"anchor":"Explanation","title":"Explanation","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping"]},{"title":"Service Layer","anchor":"Service-Layer","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallService"]},{"title":"Testing","anchor":"Testing","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService"]},{"title":"Enumerations","anchor":"Enumerations","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywall"],"generated":true}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"type":"text","text":" is the adapter between RevenueCat’s SDK and Swidux’s purchase-agnostic paywall plugin. The plugin owns paywall state (presentation flags, current entitlement, async progress); this package translates RevenueCat’s "},{"code":"CustomerInfo","type":"codeVoice"},{"text":" into the ","type":"text"},{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":" the plugin expects, and surfaces the live "},{"type":"codeVoice","code":"customerInfoStream"},{"text":" so entitlement changes propagate without polling.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two products ship together:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":" (the live "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" conformer) and "},{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"type":"text","text":" (a controllable preview \/ test conformer)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"}]},{"text":" — ","type":"text"},{"code":"revenueCatPaywall(isPresented:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"revenueCatCustomerCenter(isPresented:)","type":"codeVoice"},{"text":", drop-in SwiftUI view modifiers that wrap RevenueCatUI with platform-aware presentation, plus a ","type":"text"},{"type":"codeVoice","code":"revenueCatPaywall(state:send:)"},{"type":"text","text":" convenience that composes both."}]}]}]},{"inlineContent":[{"text":"The flow:","type":"text"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["View → store.send(.paywall(.request(reason:)))","  → PaywallPlugin sets isPresented = true","  → revenueCatPaywall observes the change, presents RevenueCatUI.PaywallView","  → user purchases → Purchases.shared.customerInfoStream yields a new CustomerInfo","  → RevenueCatPaywallService maps it to EntitlementSnapshot","  → PaywallPlugin reduces .customerInfoUpdated, sets isPro = true","  → store.paywall.isGateSatisfied flips, gated UI unlocks"]},{"inlineContent":[{"type":"text","text":"The plugin and the adapter stay decoupled: the plugin doesn’t know about RevenueCat, and the adapter doesn’t know about your action tree."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/swiduxrevenuecatpaywall"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"SwiduxRevenueCatPaywall","modules":[{"name":"SwiduxRevenueCatPaywall"}],"roleHeading":"Framework","role":"collection","externalID":"SwiduxRevenueCatPaywall","symbolKind":"module"},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/ServiceReference":{"role":"article","url":"\/documentation\/swiduxrevenuecatpaywall\/servicereference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/ServiceReference","kind":"article","type":"topic","abstract":[{"text":"API reference for ","type":"text"},