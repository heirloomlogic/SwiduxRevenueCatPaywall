{"identifier":{"url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/UIComponentsReference","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"API reference for the paywall, customer-center, and composed view modifiers in "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":"."}],"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior"],"anchor":"Related-Documentation"},{"title":"Reference","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/ServiceReference","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference"],"anchor":"Reference","generated":true}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"metadata":{"title":"UI Components Reference","modules":[{"name":"SwiduxRevenueCatPaywall"}],"role":"article","roleHeading":"Article"},"kind":"article","sections":[],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The UI product layers three view modifiers on top of "},{"type":"codeVoice","code":"RevenueCatUI"},{"type":"text","text":". Two primitives present the paywall and customer center directly from a "},{"type":"codeVoice","code":"Binding<Bool>"},{"type":"text","text":"; one convenience modifier composes both, driven by "},{"type":"codeVoice","code":"PaywallState"},{"type":"text","text":". Each presentation modifier attaches to the modified content view directly — there are no "},{"type":"codeVoice","code":"View"},{"type":"text","text":" wrappers and no "},{"type":"codeVoice","code":".background { … }"},{"type":"text","text":" indirection. This shape is what makes the macOS sheet machinery present reliably."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For step-by-step wiring, see "},{"inlineContent":[{"type":"text","text":"How to Present the UI"}],"type":"emphasis"},{"type":"text","text":" in the "},{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"type":"text","text":" documentation. For the rationale behind platform-specific behavior, see "},{"inlineContent":[{"text":"Platform Behavior","type":"text"}],"type":"emphasis"},{"type":"text","text":" in the same catalog."}]},{"anchor":"Library-target","type":"heading","level":2,"text":"Library target"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Product: ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Import: "},{"type":"codeVoice","code":"import SwiduxRevenueCatPaywallUI"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".product(name: \"SwiduxRevenueCatPaywallUI\", package: \"SwiduxRevenueCatPaywall\"),"]},{"inlineContent":[{"type":"text","text":"The UI product depends on "},{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"type":"text","text":" and "},{"code":"RevenueCatUI","type":"codeVoice"},{"type":"text","text":", both pulled in transitively. Apps that don’t ship paywall UI in the same target (for example, a tests-only target) can depend on the lower-level "},{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"type":"text","text":" product alone."}],"type":"paragraph"},{"level":2,"text":"Modifiers","type":"heading","anchor":"Modifiers"},{"level":3,"text":"`revenueCatPaywall(isPresented:offeringIdentifier:displayCloseButton:fonts:presentationStyle:purchaseLogic:onEvent:onDismiss:)`","type":"heading","anchor":"revenueCatPaywallisPresentedofferingIdentifierdisplayCloseButtonfontspresentationStylepurchaseLogiconEventonDismiss"},{"syntax":"swift","type":"codeListing","code":["extension View {","    public func revenueCatPaywall(","        isPresented: Binding<Bool>,","        offeringIdentifier: String? = nil,","        displayCloseButton: Bool = true,","        fonts: any PaywallFontProvider = DefaultPaywallFontProvider(),","        presentationStyle: RevenueCatPaywallPresentationStyle = .automatic,","        purchaseLogic: RevenueCatPaywallPurchaseLogic? = nil,","        onEvent: RevenueCatPaywallEventHandler? = nil,","        onDismiss: (() -> Void)? = nil","    ) -> some View","}"]},{"inlineContent":[{"text":"Attaches ","type":"text"},{"code":"RevenueCatUI.PaywallView","type":"codeVoice"},{"text":" as a platform-appropriate sheet.","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"iOS"}]},{"text":" — The automatic style uses a full-screen cover at compact width and a sheet at regular width.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"macOS","type":"text"}]},{"type":"text","text":" — Presents in a "},{"code":"sheet","type":"codeVoice"},{"text":" sized to a 400×600 minimum.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Pass a real two-way binding; SwiftUI sets it to "},{"type":"codeVoice","code":"false"},{"type":"text","text":" on user dismissal. Build it from "},{"type":"codeVoice","code":"PaywallState.isPresented"},{"type":"text","text":" so the "},{"type":"codeVoice","code":"set:"},{"type":"text","text":" closure dispatches "},{"type":"codeVoice","code":".paywall(.dismiss)"},{"type":"text","text":" and the plugin clears its presentation state."}],"type":"paragraph"},{"level":4,"text":"Parameters","anchor":"Parameters","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"isPresented"},{"text":" — Two-way binding to the paywall’s visibility flag.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"offeringIdentifier"},{"type":"text","text":" — Identifier of the RevenueCat offering to present, for a win-back or regional offer. Defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", which presents the dashboard’s current offering. An unknown identifier asserts in Debug and falls back to the current offering with a logged warning; a fetch failure also falls back without asserting."}]}]},{"content":[{"inlineContent":[{"code":"displayCloseButton","type":"codeVoice"},{"text":" — Whether ","type":"text"},{"code":"PaywallView","type":"codeVoice"},{"text":" shows a close button. Defaults to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":". When ","type":"text"},{"code":"false","type":"codeVoice"},{"type":"text","text":", iOS sheets disable interactive dismissal. On macOS, Escape dismisses only when this is "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"fonts","type":"codeVoice"},{"text":" — RevenueCatUI font provider used by every resolved paywall.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"presentationStyle","type":"codeVoice"},{"type":"text","text":" — "},{"code":".automatic","type":"codeVoice"},{"type":"text","text":" adapts to iOS width and uses a sheet on macOS. iOS callers can force "},{"type":"codeVoice","code":".sheet"},{"type":"text","text":" or "},{"type":"codeVoice","code":".fullScreen"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"purchaseLogic","type":"codeVoice"},{"type":"text","text":" — App-owned StoreKit 2 purchase and restore operations for "},{"code":"purchasesAreCompletedBy: .myApp","type":"codeVoice"},{"type":"text","text":". Leave "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" when RevenueCat completes purchases."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"onEvent","type":"codeVoice"},{"type":"text","text":" — Optional callback for package-owned purchase, restore, cancellation, purchase-failure, and restore-failure values. It exposes Foundation identifiers and error fields instead of RevenueCat models."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"onDismiss"},{"type":"text","text":" — Optional callback fired after dismissal."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dashboard exit offers do not run through these modifiers. RevenueCatUI implements them in its own "},{"type":"codeVoice","code":"presentPaywall"},{"type":"text","text":" modifiers, which always add a close button; using that path here would change "},{"type":"codeVoice","code":"displayCloseButton: false"},{"type":"text","text":" from a hard paywall into a dismissible one. Apps that need exit offers should use RevenueCatUI’s presenter directly."}]},{"level":3,"text":"`revenueCatCustomerCenter(isPresented:onDismiss:)`","type":"heading","anchor":"revenueCatCustomerCenterisPresentedonDismiss"},{"syntax":"swift","code":["extension View {","    public func revenueCatCustomerCenter(","        isPresented: Binding<Bool>,","        onDismiss: (() -> Void)? = nil","    ) -> some View","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Attaches the customer center as a platform-appropriate sheet."}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"iOS"}]},{"text":" — Presents ","type":"text"},{"code":"RevenueCatUI.CustomerCenterView","type":"codeVoice"},{"text":" in a ","type":"text"},{"code":"sheet","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"macOS","type":"text"}],"type":"strong"},{"text":" — Opens ","type":"text"},{"type":"codeVoice","code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions"},{"type":"text","text":" through SwiftUI’s "},{"type":"codeVoice","code":"openURL"},{"text":" environment action (falling back to the ","type":"text"},{"type":"codeVoice","code":"https:\/\/apps.apple.com\/account\/subscriptions"},{"type":"text","text":" web URL if nothing handles the "},{"type":"codeVoice","code":"itms-apps"},{"type":"text","text":" scheme), immediately clears the binding, and fires "},{"type":"codeVoice","code":"onDismiss"},{"type":"text","text":". RevenueCatUI does not ship a customer center on macOS."}]}]}]},{"text":"Parameters","anchor":"Parameters","type":"heading","level":4},{"items":[{"content":[{"inlineContent":[{"code":"isPresented","type":"codeVoice"},{"text":" — Two-way binding to the customer center’s visibility flag.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"onDismiss","type":"codeVoice"},{"text":" — Optional callback fired after dismissal (or, on macOS, after the App Store URL is opened).","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"revenueCatPaywallAndCustomerCenterstateofferingIdentifierdisplayCloseButtonfontspresentationStylepurchaseLogiconEventonAction","text":"`revenueCatPaywallAndCustomerCenter(state:offeringIdentifier:displayCloseButton:fonts:presentationStyle:purchaseLogic:onEvent:onAction:)`","level":3,"type":"heading"},{"code":["extension View {","    public func revenueCatPaywallAndCustomerCenter(","        state: PaywallState,","        offeringIdentifier: String? = nil,","        displayCloseButton: Bool = true,","        fonts: any PaywallFontProvider = DefaultPaywallFontProvider(),","        presentationStyle: RevenueCatPaywallPresentationStyle = .automatic,","        purchaseLogic: RevenueCatPaywallPurchaseLogic? = nil,","        onEvent: RevenueCatPaywallEventHandler? = nil,","        onAction: @escaping (PaywallAction) -> Void","    ) -> some View","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Convenience modifier that attaches both primitive presentation surfaces and dispatches the matching actions through "},{"type":"codeVoice","code":"onAction"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On iOS the two presentations are mutually exclusive and the paywall wins. On macOS a customer-center request dispatches "},{"type":"codeVoice","code":".openManageSubscriptions"},{"type":"text","text":" through the paywall plugin, then "},{"type":"codeVoice","code":".dismissCustomerCenter"},{"type":"text","text":"; the external App Store hand-off remains available while the paywall sheet is open. After a restore inside the paywall, the modifier also dispatches "},{"code":".dismiss","type":"codeVoice"},{"type":"text","text":" once "},{"code":"state.isGateSatisfied","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", because RevenueCatUI does not dismiss after a restore. Attach the modifier once to one app-wide presentation host. See ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Platform Behavior","type":"text"}]},{"text":" in the ","type":"text"},{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"text":" documentation.","type":"text"}]},{"type":"heading","level":4,"anchor":"Parameters","text":"Parameters"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"state","type":"codeVoice"},{"text":" — The paywall slice from your store, typically ","type":"text"},{"code":"store.paywall","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"offeringIdentifier","type":"codeVoice"},{"text":" — Identifier of the RevenueCat offering to present. When it is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", ","type":"text"},{"code":"state.requestedReason","type":"codeVoice"},{"text":" is used as a RevenueCat placement identifier. For an unknown placement, RevenueCat may return the dashboard’s placement fallback offering, which can differ from the current offering; the package uses the current offering when RevenueCat returns no placement fallback. An explicit identifier takes precedence.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"displayCloseButton"},{"type":"text","text":" — Whether "},{"type":"codeVoice","code":"PaywallView"},{"type":"text","text":" shows a close button. Defaults to "},{"type":"codeVoice","code":"true"},{"type":"text","text":"; see the primitive modifier above."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"fonts","type":"codeVoice"},{"type":"text","text":" — RevenueCatUI font provider used by the paywall."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"presentationStyle","type":"codeVoice"},{"text":" — Automatic or explicit iOS presentation style; macOS always uses a sheet.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"purchaseLogic"},{"type":"text","text":" — App-owned StoreKit 2 purchase and restore operations for "},{"type":"codeVoice","code":"purchasesAreCompletedBy: .myApp"},{"type":"text","text":". Leave "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when RevenueCat completes purchases."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"onEvent"},{"type":"text","text":" — Optional package-owned outcome callback; see the primitive modifier above."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"onAction"},{"type":"text","text":" — A closure that lifts a "},{"type":"codeVoice","code":"PaywallAction"},{"type":"text","text":" into your root action and dispatches it through the store. Typically "},{"type":"codeVoice","code":"{ store.send(.paywall($0)) }"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"text":"Manual wiring","anchor":"Manual-wiring","level":4,"type":"heading"},{"code":["ContentView()","    .revenueCatPaywall(","        isPresented: Binding(","            get: { store.paywall.isPresented },","            set: { if !$0 { store.send(.paywall(.dismiss)) } }","        )","    )","    .revenueCatCustomerCenter(","        isPresented: Binding(","            get: { store.paywall.isCustomerCenterPresented },","            set: { if !$0 { store.send(.paywall(.dismissCustomerCenter)) } }","        )","    )"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"This attaches the same presentation surfaces but leaves the iOS exclusivity and close-after-restore rules to the app. Use the convenience modifier when both surfaces are needed; use the primitives when only one is needed or when you want to interleave other modifiers between them."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swiduxrevenuecatpaywall\/uicomponentsreference"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/PlatformBehavior":{"type":"topic","role":"article","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","title":"Platform Behavior","url":"\/documentation\/swiduxrevenuecatpaywall\/platformbehavior","kind":"article","abstract":[{"text":"How the paywall and customer-center modifiers choose presentation, and which controls remain fixed.","type":"text"}]},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/MockServiceReference":{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference","abstract":[{"type":"text","text":"API reference for "},{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"type":"text","text":" — a controllable "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" conformer for previews and tests that does not touch "},{"type":"codeVoice","code":"Purchases.shared"},{"type":"text","text":"."}],"url":"\/documentation\/swiduxrevenuecatpaywall\/mockservicereference","title":"Mock Service Reference","role":"article","type":"topic","kind":"article"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToPresentTheUI":{"type":"topic","role":"article","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","title":"How to Present the UI","url":"\/documentation\/swiduxrevenuecatpaywall\/howtopresenttheui","abstract":[{"text":"Attach ","type":"text"},{"code":"revenueCatPaywallAndCustomerCenter","type":"codeVoice"},{"type":"text","text":" from "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":" to a root view to present both surfaces from "},{"type":"codeVoice","code":"PaywallState"},{"type":"text","text":", or attach either binding-driven primitive by itself."}],"kind":"article"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall":{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall","type":"topic","role":"collection","url":"\/documentation\/swiduxrevenuecatpaywall","kind":"symbol","title":"SwiduxRevenueCatPaywall","abstract":[{"type":"text","text":"RevenueCat adapter for Swidux’s "},{"code":"PaywallPlugin","type":"codeVoice"},{"type":"text","text":". Implements "},{"code":"PaywallService","type":"codeVoice"},{"text":" against ","type":"text"},{"code":"Purchases.shared","type":"codeVoice"},{"text":", ships a controllable mock for previews and tests, and pairs with ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" for drop-in ","type":"text"},{"code":"PaywallView","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"CustomerCenterView","type":"codeVoice"},{"text":" presentation.","type":"text"}]},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/ServiceReference":{"type":"topic","role":"article","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/ServiceReference","title":"Service Reference","url":"\/documentation\/swiduxrevenuecatpaywall\/servicereference","kind":"article","abstract":[{"text":"API reference for ","type":"text"},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":" — the RevenueCat-backed ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" conformer that the paywall plugin consumes.","type":"text"}]}}}