{"abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"revenueCatPaywall"},{"type":"text","text":" and "},{"type":"codeVoice","code":"revenueCatCustomerCenter"},{"type":"text","text":" view modifiers — the SwiftUI surface of "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":"."}],"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"kind":"article","sections":[],"identifier":{"url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/UIComponentsReference","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior"],"anchor":"Related-Documentation"},{"title":"Reference","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/ServiceReference","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference"],"anchor":"Reference","generated":true}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The UI product layers three view modifiers on top of "},{"type":"codeVoice","code":"RevenueCatUI"},{"type":"text","text":". Two primitives present the paywall and customer center directly from a "},{"type":"codeVoice","code":"Binding<Bool>"},{"type":"text","text":"; one convenience modifier composes both, driven by "},{"type":"codeVoice","code":"PaywallState"},{"type":"text","text":". Each presentation modifier attaches to the modified content view directly — there are no "},{"type":"codeVoice","code":"View"},{"type":"text","text":" wrappers and no "},{"type":"codeVoice","code":".background { … }"},{"type":"text","text":" indirection. This shape is what makes the macOS sheet machinery present reliably."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For step-by-step wiring, see "},{"type":"emphasis","inlineContent":[{"text":"How to Present the UI","type":"text"}]},{"type":"text","text":" in the "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"},{"type":"text","text":" documentation. For the rationale behind platform-specific behavior, see "},{"type":"emphasis","inlineContent":[{"text":"Platform Behavior","type":"text"}]},{"type":"text","text":" in the same catalog."}]},{"type":"heading","text":"Library target","anchor":"Library-target","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Product: "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Import: "},{"type":"codeVoice","code":"import SwiduxRevenueCatPaywallUI"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}]},{"type":"codeListing","code":[".product(name: \"SwiduxRevenueCatPaywallUI\", package: \"SwiduxRevenueCatPaywall\"),"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The UI product depends on "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"},{"type":"text","text":" and "},{"type":"codeVoice","code":"RevenueCatUI"},{"type":"text","text":", both pulled in transitively. Apps that don’t ship paywall UI in the same target (for example, a tests-only target) can depend on the lower-level "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"},{"type":"text","text":" product alone."}]},{"type":"heading","text":"Modifiers","anchor":"Modifiers","level":2},{"type":"heading","text":"`revenueCatPaywall(isPresented:offeringIdentifier:displayCloseButton:onDismiss:)`","anchor":"revenueCatPaywallisPresentedofferingIdentifierdisplayCloseButtononDismiss","level":3},{"type":"codeListing","code":["extension View {","    public func revenueCatPaywall(","        isPresented: Binding<Bool>,","        offeringIdentifier: String? = nil,","        displayCloseButton: Bool = true,","        onDismiss: (() -> Void)? = nil","    ) -> some View","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Attaches "},{"type":"codeVoice","code":"RevenueCatUI.PaywallView"},{"type":"text","text":" as a platform-appropriate sheet."}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"iOS","type":"text"}]},{"type":"text","text":" — Presents in a "},{"type":"codeVoice","code":"fullScreenCover"},{"type":"text","text":" so the paywall takes the full screen."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"macOS","type":"text"}]},{"type":"text","text":" — Presents in a "},{"type":"codeVoice","code":"sheet"},{"type":"text","text":" sized to a 400×600 minimum."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass a real two-way binding; SwiftUI sets it to "},{"type":"codeVoice","code":"false"},{"type":"text","text":" on user dismissal. Build it from "},{"type":"codeVoice","code":"PaywallState.isPresented"},{"type":"text","text":" so the "},{"type":"codeVoice","code":"set:"},{"type":"text","text":" closure dispatches "},{"type":"codeVoice","code":".paywall(.dismiss)"},{"type":"text","text":" and the plugin clears its presentation state."}]},{"type":"heading","text":"Parameters","anchor":"Parameters","level":4},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"isPresented"},{"type":"text","text":" — Two-way binding to the paywall’s visibility flag."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"offeringIdentifier"},{"type":"text","text":" — Identifier of the RevenueCat offering to present, for a win-back or regional offer. Defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", which presents the dashboard’s current offering. An unknown identifier or a failed fetch falls back to the current offering with a logged warning."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"displayCloseButton"},{"type":"text","text":" — Whether "},{"type":"codeVoice","code":"PaywallView"},{"type":"text","text":" shows a close button. Defaults to "},{"type":"codeVoice","code":"true"},{"type":"text","text":". Neither the iOS "},{"type":"codeVoice","code":"fullScreenCover"},{"type":"text","text":" nor the macOS "},{"type":"codeVoice","code":"sheet"},{"type":"text","text":" offers any other dismissal affordance, so pass "},{"type":"codeVoice","code":"false"},{"type":"text","text":" only for a hard paywall the user must purchase through."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"onDismiss"},{"type":"text","text":" — Optional callback fired after dismissal."}],"type":"paragraph"}]}]},{"type":"heading","text":"`revenueCatCustomerCenter(isPresented:onDismiss:)`","anchor":"revenueCatCustomerCenterisPresentedonDismiss","level":3},{"type":"codeListing","code":["extension View {","    public func revenueCatCustomerCenter(","        isPresented: Binding<Bool>,","        onDismiss: (() -> Void)? = nil","    ) -> some View","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Attaches the customer center as a platform-appropriate sheet."}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"iOS","type":"text"}]},{"type":"text","text":" — Presents "},{"type":"codeVoice","code":"RevenueCatUI.CustomerCenterView"},{"type":"text","text":" in a "},{"type":"codeVoice","code":"sheet"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"macOS","type":"text"}]},{"type":"text","text":" — Opens "},{"type":"codeVoice","code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions"},{"type":"text","text":" via "},{"type":"codeVoice","code":"NSWorkspace.shared.open"},{"type":"text","text":" (falling back to the "},{"type":"codeVoice","code":"https:\/\/apps.apple.com\/account\/subscriptions"},{"type":"text","text":" web URL if nothing on the system handles the "},{"type":"codeVoice","code":"itms-apps"},{"type":"text","text":" scheme), immediately clears the binding, and fires "},{"type":"codeVoice","code":"onDismiss"},{"type":"text","text":". RevenueCatUI does not ship a customer center on macOS."}],"type":"paragraph"}]}]},{"type":"heading","text":"Parameters","anchor":"Parameters","level":4},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"isPresented"},{"type":"text","text":" — Two-way binding to the customer center’s visibility flag."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"onDismiss"},{"type":"text","text":" — Optional callback fired after dismissal (or, on macOS, after the App Store URL is opened)."}],"type":"paragraph"}]}]},{"type":"heading","text":"`revenueCatPaywall(state:offeringIdentifier:displayCloseButton:send:)`","anchor":"revenueCatPaywallstateofferingIdentifierdisplayCloseButtonsend","level":3},{"type":"codeListing","code":["extension View {","    public func revenueCatPaywall(","        state: PaywallState,","        offeringIdentifier: String? = nil,","        displayCloseButton: Bool = true,","        send: @escaping (PaywallAction) -> Void","    ) -> some View","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Convenience modifier that attaches both "},{"type":"codeVoice","code":"revenueCatPaywall(isPresented:offeringIdentifier:displayCloseButton:onDismiss:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"revenueCatCustomerCenter(isPresented:onDismiss:)"},{"type":"text","text":" and dispatches the matching dismiss action when each sheet closes."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The two presentations are mutually exclusive; the paywall wins. While "},{"type":"codeVoice","code":"state.isPresented"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" the customer-center binding reads "},{"type":"codeVoice","code":"false"},{"type":"text","text":", and a request for either surface while the other is up dispatches "},{"type":"codeVoice","code":".dismissCustomerCenter"},{"type":"text","text":" — the platform refuses simultaneous presentations, and this rule keeps "},{"type":"codeVoice","code":"PaywallState"},{"type":"text","text":" from holding a flag the platform ignored. See "},{"type":"emphasis","inlineContent":[{"text":"Platform Behavior","type":"text"}]},{"type":"text","text":" in the "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"},{"type":"text","text":" documentation."}]},{"type":"heading","text":"Parameters","anchor":"Parameters","level":4},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"state","type":"codeVoice"},{"text":" — The paywall slice from your store, typically ","type":"text"},{"code":"store.paywall","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"offeringIdentifier","type":"codeVoice"},{"text":" — Identifier of the RevenueCat offering to present. Defaults to ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" (the dashboard’s current offering); see the primitive modifier above.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"displayCloseButton","type":"codeVoice"},{"text":" — Whether ","type":"text"},{"code":"PaywallView","type":"codeVoice"},{"text":" shows a close button. Defaults to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":"; see the primitive modifier above.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"send","type":"codeVoice"},{"text":" — A closure that lifts a ","type":"text"},{"code":"PaywallAction","type":"codeVoice"},{"text":" into your root action and dispatches it through the store. Typically ","type":"text"},{"code":"{ store.send(.paywall($0)) }","type":"codeVoice"},{"text":".","type":"text"}]}]}]},{"type":"heading","text":"Equivalent manual wiring","anchor":"Equivalent-manual-wiring","level":4},{"type":"codeListing","code":["ContentView()","    .revenueCatPaywall(","        isPresented: Binding(","            get: { store.paywall.isPresented },","            set: { if !$0 { store.send(.paywall(.dismiss)) } }","        )","    )","    .revenueCatCustomerCenter(","        isPresented: Binding(","            get: { store.paywall.isCustomerCenterPresented },","            set: { if !$0 { store.send(.paywall(.dismissCustomerCenter)) } }","        )","    )"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Use the convenience modifier when both sheets are needed; use the primitives when only one is needed or when you want to interleave other modifiers between them.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxrevenuecatpaywall\/uicomponentsreference"]}],"metadata":{"modules":[{"name":"SwiduxRevenueCatPaywall"}],"role":"article","title":"UI Components Reference","roleHeading":"Article"},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/MockServiceReference":{"title":"Mock Service Reference","url":"\/documentation\/swiduxrevenuecatpaywall\/mockservicereference","kind":"article","type":"topic","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference","role":"article","abstract":[{"text":"API reference for ","type":"text"},{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"type":"text","text":" — a controllable "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" conformer for previews and tests that does not touch "},{"type":"codeVoice","code":"Purchases.shared"},{"type":"text","text":"."}]},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall":{"title":"SwiduxRevenueCatPaywall","url":"\/documentation\/swiduxrevenuecatpaywall","kind":"symbol","type":"topic","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall","role":"collection","abstract":[{"text":"RevenueCat adapter for Swidux’s ","type":"text"},{"code":"PaywallPlugin","type":"codeVoice"},{"text":". Implements ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" against "},{"type":"codeVoice","code":"Purchases.shared"},{"type":"text","text":", ships a controllable mock for previews and tests, and pairs with "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"text":" for drop-in ","type":"text"},{"type":"codeVoice","code":"PaywallView"},{"text":" and ","type":"text"},{"code":"CustomerCenterView","type":"codeVoice"},{"type":"text","text":" presentation."}]},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/PlatformBehavior":{"role":"article","abstract":[{"type":"text","text":"Why the "},{"type":"codeVoice","code":"revenueCatPaywall"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"revenueCatCustomerCenter"},{"text":" modifiers present differently on iOS and macOS, and what is hard-coded.","type":"text"}],"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","url":"\/documentation\/swiduxrevenuecatpaywall\/platformbehavior","title":"Platform Behavior","type":"topic","kind":"article"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/ServiceReference":{"title":"Service Reference","url":"\/documentation\/swiduxrevenuecatpaywall\/servicereference","kind":"article","type":"topic","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRe