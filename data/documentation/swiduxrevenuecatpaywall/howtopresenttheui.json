{"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"metadata":{"role":"article","title":"How to Present the UI","roleHeading":"Article","modules":[{"name":"SwiduxRevenueCatPaywall"}]},"abstract":[{"text":"Attach the ","type":"text"},{"code":"revenueCatPaywall","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"revenueCatCustomerCenter","type":"codeVoice"},{"text":" view modifiers from ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" to a root view, driven by ","type":"text"},{"code":"PaywallState","type":"codeVoice"},{"text":".","type":"text"}],"seeAlsoSections":[{"title":"Related Documentation","abstract":[{"text":"The matching API reference for the views described here lives in the ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" documentation.","type":"text"}],"anchor":"Related-Documentation","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService"]},{"title":"How-to Guides","generated":true,"anchor":"How-to-Guides","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest"]}],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":" ships three view modifiers that wrap RevenueCatUI’s surfaces with platform-aware presentation. Each is bound to "},{"code":"PaywallState","type":"codeVoice"},{"type":"text","text":": presentation flags drive visibility, and the bindings dispatch matching paywall actions back through the store on dismissal. There is no local sheet state."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For platform behavior details (iOS "},{"code":"fullScreenCover","type":"codeVoice"},{"type":"text","text":" vs macOS sheet sizing, App Store deep link on macOS), see "},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"anchor":"Before-you-start","text":"Before you start","type":"heading"},{"inlineContent":[{"type":"text","text":"This guide assumes:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"You have completed "},{"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","isActive":true},{"type":"text","text":". The plugin is registered and "},{"type":"codeVoice","code":"observeCustomerInfo"},{"type":"text","text":" runs on launch."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Your app target depends on the "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":" product:"}],"type":"paragraph"}]}],"type":"unorderedList"},{"code":[".product(name: \"SwiduxRevenueCatPaywallUI\", package: \"SwiduxRevenueCatPaywall\"),"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Step-1-Attach-one-presentation-host","text":"Step 1: Attach one presentation host","type":"heading"},{"inlineContent":[{"type":"text","text":"The simplest wiring uses the "},{"code":"revenueCatPaywall(state:send:)","type":"codeVoice"},{"type":"text","text":" modifier for both presentation surfaces and their actions:"}],"type":"paragraph"},{"code":["import SwiduxRevenueCatPaywallUI","","struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .revenueCatPaywall(state: store.paywall) { action in","                store.send(.paywall(action))","            }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The closure receives each "},{"code":"PaywallAction","type":"codeVoice"},{"type":"text","text":" emitted by the UI and lifts it into your root action. Attach the modifier once, to one app-wide presentation host. Do not attach it inside content created for every "},{"code":"WindowGroup","type":"codeVoice"},{"type":"text","text":" window or scene: the shared "},{"code":"PaywallState","type":"codeVoice"},{"type":"text","text":" request would make every copy present. In a multi-window app, choose one scene, such as the primary app or settings window, to own paywall presentation."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Both paywall modifiers also accept "},{"code":"displayCloseButton:","type":"codeVoice"},{"type":"text","text":" (default "},{"code":"true","type":"codeVoice"},{"type":"text","text":"). The default presentation has no other way out — see "},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","type":"reference","isActive":true},{"type":"text","text":" before turning it off."}],"type":"paragraph"},{"level":3,"anchor":"App-owned-StoreKit-2-purchases","text":"App-owned StoreKit 2 purchases","type":"heading"},{"inlineContent":[{"type":"text","text":"If RevenueCat is configured with "},{"code":"purchasesAreCompletedBy: .myApp","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"storeKitVersion: .storeKit2"},{"type":"text","text":", pass the app’s StoreKit operations as "},{"type":"codeVoice","code":"purchaseLogic"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["import StoreKit","import SwiduxRevenueCatPaywallUI","","let purchaseLogic = RevenueCatPaywallPurchaseLogic(","    purchase: { product in","        try await product.purchase()","    },","    restore: {","        try await AppStore.sync()","    }",")","","ContentView()","    .revenueCatPaywall(","        state: store.paywall,","        purchaseLogic: purchaseLogic","    ) { action in","        store.send(.paywall(action))","    }"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"RevenueCatUI requires both handlers in "},{"type":"codeVoice","code":".myApp"},{"type":"text","text":" mode. The modifier always supplies them, so presenting without "},{"type":"codeVoice","code":"purchaseLogic"},{"type":"text","text":" returns a configuration error when the user tries to purchase or restore instead of triggering RevenueCatUI’s Release-build trap. The purchase closure returns the original "},{"type":"codeVoice","code":"Product.PurchaseResult"},{"type":"text","text":"; the package reports it to RevenueCat and then finishes a verified transaction. A pending purchase stays open with a pending message. The restore closure refreshes StoreKit first, and the package then synchronizes RevenueCat and reports whether it found an active subscription or non-subscription."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The bundled observer-mode UI accepts StoreKit 2 products. A ","type":"text"},{"code":".myApp","type":"codeVoice"},{"text":" configuration pinned to StoreKit 1 can still use ","type":"text"},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":", but it needs a custom paywall because ","type":"text"},{"type":"codeVoice","code":"RevenueCatPaywallPurchaseLogic"},{"type":"text","text":" does not expose "},{"type":"codeVoice","code":"SKProduct"},{"text":" or ","type":"text"},{"code":"SKPaymentTransaction","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"heading","text":"Step 2: Trigger the paywall from a feature","anchor":"Step-2-Trigger-the-paywall-from-a-feature","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dispatch "},{"type":"codeVoice","code":".request(reason:)"},{"type":"text","text":" with a short identifier describing why you’re asking. "},{"type":"codeVoice","code":"PaywallState.requestedReason"},{"type":"text","text":" stores the value for your own code — analytics, or a custom paywall. The bundled RevenueCatUI paywall does not read it:"}]},{"syntax":"swift","code":["Button(\"Export PDF\") {","    store.send(.paywall(.request(reason: \"export-pdf\")))","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin sets "},{"type":"codeVoice","code":"PaywallState.isPresented = true"},{"type":"text","text":". The "},{"type":"codeVoice","code":"revenueCatPaywall"},{"type":"text","text":" modifier observes the change and presents "},{"type":"codeVoice","code":"RevenueCatUI.PaywallView"},{"type":"text","text":" with the correct RevenueCat-owned or app-owned handlers."}]},{"type":"heading","level":2,"anchor":"Step-3-Trigger-the-customer-center","text":"Step 3: Trigger the customer center"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Existing subscribers manage their subscription through the customer center. Surface a button that dispatches "},{"type":"codeVoice","code":".presentCustomerCenter"},{"type":"text","text":":"}]},{"syntax":"swift","code":["if store.paywall.isPro {","    Button(\"Manage Subscription\") {","        store.send(.paywall(.presentCustomerCenter))","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"revenueCatCustomerCenter"},{"type":"text","text":" modifier presents "},{"type":"codeVoice","code":"RevenueCatUI.CustomerCenterView"},{"type":"text","text":" on iOS. On macOS, the convenience modifier dispatches "},{"type":"codeVoice","code":".openManageSubscriptions"},{"type":"text","text":" so the paywall plugin opens the App Store subscriptions URL through its injectable URL handler, then dispatches "},{"type":"codeVoice","code":".dismissCustomerCenter"},{"type":"text","text":". RevenueCatUI does not ship a customer center on macOS; see "},{"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","isActive":true},{"type":"text","text":"."}]},{"type":"heading","level":2,"anchor":"Step-4-Manual-wiring-optional","text":"Step 4: Manual wiring (optional)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you need only one sheet, or you want to interleave other modifiers between them, attach the primitive modifiers directly. Each takes a real "},{"type":"codeVoice","code":"Binding<Bool>"},{"type":"text","text":"; build it with a "},{"type":"codeVoice","code":"set:"},{"type":"text","text":" that dispatches the matching dismiss action when SwiftUI clears the flag:"}]},{"syntax":"swift","code":["ContentView()","    .revenueCatPaywall(","        isPresented: Binding(","            get: { store.paywall.isPresented },","            set: { if !$0 { store.send(.paywall(.dismiss)) } }","        )","    )","    .revenueCatCustomerCenter(","        isPresented: Binding(","            get: { store.paywall.isCustomerCenterPresented },","            set: { if !$0 { store.send(.paywall(.dismissCustomerCenter)) } }","        )","    )"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The convenience modifier "},{"type":"codeVoice","code":"revenueCatPaywall(state:send:)"},{"type":"text","text":" attaches this wiring and closes the paywall after a restore that leaves the user entitled. On iOS it also keeps the paywall and customer center mutually exclusive. The macOS customer center is an external App Store hand-off, so a request made while the paywall is open is handled immediately instead of being discarded."}]},{"type":"heading","text":"Step 5: Restore from inside the paywall","anchor":"Step-5-Restore-from-inside-the-paywall","level":2},{"inlineContent":[{"type":"text","text":"RevenueCatUI’s "},{"code":"PaywallView","type":"codeVoice"},{"type":"text","text":" provides its own restore button by default. If you need an additional restore affordance elsewhere (a Settings row, for example), dispatch "},{"type":"codeVoice","code":".restorePurchases"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","code":["Button(\"Restore Purchases\") {","    store.send(.paywall(.restorePurchases))","}",".disabled(store.paywall.isLoading)"],"syntax":"swift"},{"level":2,"anchor":"What-happens-on-dismiss","text":"What happens on dismiss","type":"heading"},{"inlineContent":[{"type":"text","text":"When the user dismisses the paywall, the plugin’s "},{"type":"codeVoice","code":".dismiss"},{"type":"text","text":" action clears "},{"type":"codeVoice","code":"PaywallState.isPresented"},{"type":"text","text":" and "},{"type":"codeVoice","code":"requestedReason"},{"type":"text","text":", then dispatches "},{"type":"codeVoice","code":".refreshCustomerInfo"},{"type":"text","text":" so the gate is reconciled — the user may have purchased while the sheet was open."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"RevenueCatUI dismisses the paywall itself after a purchase, but not after a restore. The convenience modifier closes it for you: once RevenueCatUI reports the restore complete (after the user acknowledges its success alert) and "},{"type":"codeVoice","code":"PaywallState.isGateSatisfied"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":", it dispatches "},{"type":"codeVoice","code":".dismiss"},{"type":"text","text":". The entitlement arrives through the live stream, so keep "},{"type":"codeVoice","code":".observeCustomerInfo"},{"type":"text","text":" running. With the manual wiring, nothing closes the paywall after a restore — a user who restores behind a hard paywall ("},{"type":"codeVoice","code":"displayCloseButton: false"},{"type":"text","text":") has no way out, so use the convenience modifier there."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When the user dismisses the customer center, the plugin’s "},{"type":"codeVoice","code":".dismissCustomerCenter"},{"type":"text","text":" action clears "},{"type":"codeVoice","code":"isCustomerCenterPresented"},{"type":"text","text":". On macOS the convenience modifier sends that action immediately after "},{"type":"codeVoice","code":".openManageSubscriptions"},{"type":"text","text":". No refresh is dispatched, since opening the customer center does not change entitlement state by itself; the live "},{"type":"codeVoice","code":"customerInfoStream"},{"type":"text","text":" from "},{"type":"codeVoice","code":"Step 5"},{"type":"text","text":" of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService"},{"type":"text","text":" picks up any subscription change RevenueCat reports asynchronously."}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI"},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxrevenuecatpaywall\/howtopresenttheui"]}],"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/PlatformBehavior":{"title":"Platform Behavior","abstract":[{"text":"Why the ","type":"text"},{"code":"revenueCatPaywall","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"revenueCatCustomerCenter"},{"text":" modifiers present differently on iOS and macOS, and what is hard-coded.","type":"text"}],"role":"article","type":"topic","kind":"article","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","url":"\/documentation\/swiduxrevenuecatpaywall\/platformbehavior"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToPreviewAndTest":{"title":"How to Preview and Test","abstract":[{"type":"text","text":"Drive entitlement state from SwiftUI previews and tests with "},{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"type":"text","text":" — no RevenueCat SDK call required."}],"role":"article","type":"topic","kind":"article","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest","url":"\/documentation\/swiduxrevenuecatpaywall\/howtopreviewandtest"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall":{"kind":"symbol","abstract":[{"type":"text","text":"RevenueCat adapter for Swidux’s "},{"code":"PaywallPlugin","type":"codeVoice"},{"type":"text","text":". Implements "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" against "},{"type":"codeVoice","code":"Purchases.shared"},{"type":"text","text":", ships a controllable mock for previews and tests, and pairs with "},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" for drop-in ","type":"text"},{"code":"PaywallView","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"CustomerCenterView","type":"codeVoice"},{"text":" presentation.","type":"text"}],"url":"\/documentation\/swiduxrevenuecatpaywall","role":"collection","type":"topic","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall","title":"SwiduxRevenueCatPaywall"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToAddAPermanentLicense":{"kind":"article","abstract":[{"text":"Sell a lifetime entitlement alongside a subscription and surface both flags through the paywall plugin.","type":"text"}],"url":"\/documentation\/swiduxrevenuecatpaywall\/howtoaddapermanentlicense","role":"article","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","type":"topic","title":"How to Add a Permanent License"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToImplementService":{"abstract":[{"text":"Wire ","type":"text"},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":" into the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" plugin so the store sees real-time entitlement updates from RevenueCat.","type":"text"}],"url":"\/documentation\/swiduxrevenuecatpaywall\/howtoimplementservice","role":"article","type":"topic","kind":"article","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","title":"How to Implement the Service"}}}