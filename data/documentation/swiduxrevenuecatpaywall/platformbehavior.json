{"abstract":[{"type":"text","text":"Why the "},{"type":"codeVoice","code":"revenueCatPaywall"},{"type":"text","text":" and "},{"type":"codeVoice","code":"revenueCatCustomerCenter"},{"type":"text","text":" modifiers present differently on iOS and macOS, and what is hard-coded."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"The bundled UI is intentionally opinionated. Each modifier picks the platform-appropriate presentation so consumers don’t have to repeat the conditional compilation themselves, and so the dispatch flow stays symmetric across platforms — the same ","type":"text"},{"code":".paywall(.dismiss)","type":"codeVoice"},{"text":" action fires from a ","type":"text"},{"code":"fullScreenCover","type":"codeVoice"},{"text":" on iOS and from a sheet on macOS.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This article explains the reasoning behind those choices and what is fixed versus configurable.","type":"text"}],"type":"paragraph"},{"level":2,"text":"revenueCatPaywall","type":"heading","anchor":"revenueCatPaywall"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Platform"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Presentation","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Reason","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"iOS","type":"text"}]}]}],[{"type":"paragraph","inlineContent":[{"code":"fullScreenCover","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A subscription paywall is a primary moment, not an interrupt. "},{"code":"fullScreenCover","type":"codeVoice"},{"type":"text","text":" keeps the UI immersive and prevents accidental gesture-dismiss."}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"macOS"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"code":"sheet","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"frame(minWidth: 400, minHeight: 600)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Mac sheets do not expand to fill the parent window. Without an explicit minimum size the paywall would render too small to legibly show plan options. The 400×600 minimum is roughly the size RevenueCatUI’s templates assume."}]}]]],"type":"table"},{"inlineContent":[{"text":"Because neither presentation offers a system dismissal affordance (","type":"text"},{"code":"fullScreenCover","type":"codeVoice"},{"text":" has no swipe-to-dismiss; Mac sheets have no default close control), the modifiers show ","type":"text"},{"code":"PaywallView","type":"codeVoice"},{"text":"’s close button by default. Pass ","type":"text"},{"code":"displayCloseButton: false","type":"codeVoice"},{"text":" only for a hard paywall the user must purchase through — and make sure some other path out of that screen exists.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The minimum frame is hard-coded; it is not exposed as a parameter. If your paywall layout needs more room on macOS, use ","type":"text"},{"type":"codeVoice","code":"RevenueCatUI.PaywallView"},{"text":" directly inside a custom ","type":"text"},{"type":"codeVoice","code":"sheet"},{"text":" modifier.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"revenueCatCustomerCenter","type":"heading","text":"revenueCatCustomerCenter"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Platform"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Presentation"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Reason"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"iOS","type":"text"}]}]}],[{"type":"paragraph","inlineContent":[{"code":"sheet","type":"codeVoice"},{"type":"text","text":" with "},{"code":"RevenueCatUI.CustomerCenterView","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"RevenueCatUI ships a customer center on iOS only. A non-fullscreen "},{"type":"codeVoice","code":"sheet"},{"type":"text","text":" is appropriate because customer-center actions are administrative, not part of a purchase flow."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"macOS"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Opens "},{"type":"codeVoice","code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions"},{"type":"text","text":" and immediately fires "},{"type":"codeVoice","code":"onDismiss"}]}],[{"type":"paragraph","inlineContent":[{"text":"RevenueCatUI does not ship a customer center on macOS, and the system has no equivalent in-app surface. The App Store subscription management page is what users expect on the Mac, so the sheet hands off to it and clears its own presentation state immediately.","type":"text"}]}]]],"type":"table","header":"row"},{"inlineContent":[{"type":"text","text":"The macOS branch clears the binding and fires "},{"code":"onDismiss","type":"codeVoice"},{"type":"text","text":" synchronously after "},{"code":"NSWorkspace.shared.open","type":"codeVoice"},{"type":"text","text":" so "},{"code":"PaywallState.isCustomerCenterPresented","type":"codeVoice"},{"type":"text","text":" does not get stuck "},{"code":"true","type":"codeVoice"},{"type":"text","text":". The user returns from App Store to find the app’s UI in its idle state. If nothing on the system handles the "},{"code":"itms-apps","type":"codeVoice"},{"type":"text","text":" scheme, the hand-off falls back to the "},{"code":"https:\/\/apps.apple.com\/account\/subscriptions","type":"codeVoice"},{"type":"text","text":" web URL in the default browser."}],"type":"paragraph"},{"anchor":"One-surface-at-a-time","type":"heading","level":2,"text":"One surface at a time"},{"inlineContent":[{"type":"text","text":"The composed "},{"code":"revenueCatPaywall(state:offeringIdentifier:displayCloseButton:send:)","type":"codeVoice"},{"type":"text","text":" modifier never shows the paywall and the customer center at once — two modal surfaces competing for one host leave at most one on screen, and the other’s state flag stuck "},{"code":"true","type":"codeVoice"},{"type":"text","text":" with nothing showing. The paywall wins: while "},{"code":"PaywallState.isPresented","type":"codeVoice"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" the customer-center binding reads "},{"type":"codeVoice","code":"false"},{"type":"text","text":", and a request for either surface while the other is up dispatches "},{"type":"codeVoice","code":".dismissCustomerCenter"},{"type":"text","text":" so state and screen stay in agreement."}],"type":"paragraph"},{"inlineContent":[{"text":"Apps wiring the primitive modifiers manually own this rule themselves; keep the two presentation flags mutually exclusive.","type":"text"}],"type":"paragraph"},{"anchor":"Why-no-platform-override-hooks","type":"heading","text":"Why no platform-override hooks","level":2},{"inlineContent":[{"text":"Both modifiers are deliberately parameter-light: an ","type":"text"},{"code":"isPresented: Binding<Bool>","type":"codeVoice"},{"text":", an optional ","type":"text"},{"code":"onDismiss: () -> Void","type":"codeVoice"},{"text":", and — on the paywall only — ","type":"text"},{"code":"displayCloseButton:","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"offeringIdentifier:","type":"codeVoice"},{"text":". There is no ","type":"text"},{"code":"paywallStyle:","type":"codeVoice"},{"type":"text","text":" or "},{"type":"codeVoice","code":"presentationKind:"},{"type":"text","text":" parameter."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The reasoning: any consumer that needs to deviate from the chosen presentation already has the underlying RevenueCatUI types ("},{"type":"codeVoice","code":"PaywallView"},{"type":"text","text":", "},{"type":"codeVoice","code":"CustomerCenterView"},{"type":"text","text":") and SwiftUI’s full presentation surface ("},{"type":"codeVoice","code":"sheet"},{"type":"text","text":", "},{"type":"codeVoice","code":"fullScreenCover"},{"type":"text","text":", "},{"type":"codeVoice","code":"popover"},{"type":"text","text":", custom containers). The bundled modifiers exist to handle the 95% case in one line — when the 5% case applies, drop down to RevenueCatUI directly."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This package does not try to be the complete paywall-UI library. It is the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"integration layer"}]},{"type":"text","text":" that makes the common case trivial."}],"type":"paragraph"},{"text":"What is configurable","level":2,"anchor":"What-is-configurable","type":"heading"},{"inlineContent":[{"text":"The configurable surface lives in ","type":"text"},{"code":"RevenueCatUI","type":"codeVoice"},{"text":" and on the paywall plugin:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Paywall content, copy, and template","type":"text"}],"type":"strong"},{"text":" — configured in the RevenueCat dashboard. ","type":"text"},{"type":"codeVoice","code":"RevenueCatUI.PaywallView"},{"text":" renders whichever offering and template the dashboard returns.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Customer-center labels, sections, and actions"}]},{"type":"text","text":" — configured in the RevenueCat dashboard. "},{"type":"codeVoice","code":"RevenueCatUI.CustomerCenterView"},{"type":"text","text":" renders whichever configuration the dashboard returns."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Close button","type":"text"}],"type":"strong"},{"text":" — ","type":"text"},{"code":"displayCloseButton:","type":"codeVoice"},{"text":" on the paywall modifiers. Defaults to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":"; pass ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" for a hard paywall.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Presentation triggering"}],"type":"strong"},{"type":"text","text":" — driven by the plugin via "},{"type":"codeVoice","code":"PaywallState.isPresented"},{"type":"text","text":" and "},{"type":"codeVoice","code":"isCustomerCenterPresented"},{"type":"text","text":". Your code chooses "},{"inlineContent":[{"type":"text","text":"when"}],"type":"emphasis"},{"type":"text","text":" to set them via "},{"type":"codeVoice","code":".request(reason:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":".presentCustomerCenter"},{"type":"text","text":" actions."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Dismiss behavior","type":"text"}],"type":"strong"},{"text":" — dismiss actions are dispatched by the presentation bindings themselves (","type":"text"},{"code":".dismiss","type":"codeVoice"},{"text":" for the paywall, ","type":"text"},{"code":".dismissCustomerCenter","type":"codeVoice"},{"text":" for the customer center). The primitive modifiers’ ","type":"text"},{"code":"onDismiss","type":"codeVoice"},{"text":" callbacks are purely additive — use them for analytics hooks or cleanup, not for dispatch.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Offering selection"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"offeringIdentifier:"},{"type":"text","text":" on the paywall modifiers presents a specific RevenueCat offering (a win-back or regional offer, for example). Omit it for the dashboard’s current offering. An unknown identifier or a failed fetch falls back to the current offering with a logged warning, so a stale identifier degrades gracefully instead of dead-ending the purchase flow."}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"sections":[],"metadata":{"modules":[{"name":"SwiduxRevenueCatPaywall"}],"role":"article","title":"Platform Behavior","roleHeading":"Article"},"kind":"article","seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI"],"anchor":"Related-Documentation","abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":" documentation provides the matching API reference for the modifiers described here."}]},{"title":"Explanation","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping"],"generated":true,"anchor":"Explanation"}],"variants":[{"paths":["\/documentation\/swiduxrevenuecatpaywall\/platformbehavior"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToPresentTheUI":{"role":"article","url":"\/documentation\/swiduxrevenuecatpaywall\/howtopresenttheui","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","type":"topic","kind":"article","abstract":[{"type":"text","text":"Attach the "},{"type":"codeVoice","code":"revenueCatPaywall"},{"type":"text","text":" and "},{"type":"codeVoice","code":"revenueCatCustomerCenter"},{"type":"text","text":" view modifiers from "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":" to a root view, driven by "},{"type":"codeVoice","code":"PaywallState"},{"type":"text","text":"."}],"title":"How to Present the UI"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall":{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall","abstract":[{"text":"RevenueCat adapter for Swidux’s ","type":"text"},{"code":"PaywallPlugin","type":"codeVoice"},{"text":". Implements ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" against ","type":"text"},{"code":"Purchases.shared","type":"codeVoice"},{"text":", ships a controllable mock for previews and tests, and pairs with ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":" for drop-in "},{"code":"PaywallView","type":"codeVoice"},{"type":"text","text":" and "},{"code":"CustomerCenterView","type":"codeVoice"},{"type":"text","text":" presentation."}],"role":"collection","title":"SwiduxRevenueCatPaywall","url":"\/documentation\/swiduxrevenuecatpaywall","kind":"symbol","type":"topic"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/EntitlementMapping":{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping","abstract":[{"text":"How RevenueCat’s ","type":"text"},{"type":"codeVoice","code":"CustomerInfo.entitlements"},{"type":"text","text":" translates to Swidux’s "},{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":"."}],"role":"article","title":"Entitlement Mapping","url":"\/documentation\/swiduxrevenuecatpaywall\/entitlementmapping","kind":"article","type":"topic"}}}