{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/ServiceReference"},"kind":"article","seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallService","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallError","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallIdentity","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallIdentityResult","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallIdentityError"]},{"title":"Reference","anchor":"Reference","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/UIComponentsReference"],"generated":true}],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":" adapts ","type":"text"},{"code":"RevenueCat.Purchases","type":"codeVoice"},{"text":" to the ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" protocol that ","type":"text"},{"code":"SwiduxPaywall.PaywallPlugin","type":"codeVoice"},{"text":" requires. It does one job: translate ","type":"text"},{"code":"CustomerInfo","type":"codeVoice"},{"text":" into ","type":"text"},{"code":"EntitlementSnapshot","type":"codeVoice"},{"text":" (defined by ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":") so the plugin can drive its state. Configuration of the RevenueCat SDK itself remains the caller’s responsibility.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For a step-by-step integration walkthrough, see ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","isActive":true,"type":"reference"},{"text":". For the entitlement-mapping rules, see ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Library target","level":2,"type":"heading","anchor":"Library-target"},{"items":[{"content":[{"inlineContent":[{"text":"Product: ","type":"text"},{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Import: ","type":"text"},{"code":"import SwiduxRevenueCatPaywall","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"code":"Package.swift","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":[".product(name: \"SwiduxRevenueCatPaywall\", package: \"SwiduxRevenueCatPaywall\"),"],"syntax":"swift","type":"codeListing"},{"text":"Types","level":2,"type":"heading","anchor":"Types"},{"text":"``doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallService``","level":3,"type":"heading","anchor":"docSwiduxRevenueCatPaywalldocumentationSwiduxRevenueCatPaywallRevenueCatPaywallService"},{"code":["public struct RevenueCatPaywallService: PaywallService {","    public init(","        entitlementID: String,","        permanentLicenseEntitlementID: String? = nil","    )","","    public func customerInfo() async throws -> EntitlementSnapshot","    public func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    public func restorePurchases() async throws -> EntitlementSnapshot","    @MainActor public func logIn(appUserID: String) async throws(RevenueCatPaywallIdentityError) -> RevenueCatPaywallIdentityResult","    @MainActor public func logOut() async throws(RevenueCatPaywallIdentityError) -> RevenueCatPaywallIdentityResult","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Value type. Holds two ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" identifiers and forwards configured calls to ","type":"text"},{"code":"Purchases.shared","type":"codeVoice"},{"text":". It is safe to construct before ","type":"text"},{"code":"RevenueCatPaywall.configure","type":"codeVoice"},{"text":" runs. For production, wrap it in SwiduxPaywall’s ","type":"text"},{"code":"ResilientPaywallService","type":"codeVoice"},{"text":" so a transient read failure at launch never gates a paid user as free.","type":"text"}],"type":"paragraph"},{"text":"Initializer","level":4,"type":"heading","anchor":"Initializer"},{"code":["public init(","    entitlementID: String,","    permanentLicenseEntitlementID: String? = nil",")"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"code":"entitlementID","type":"codeVoice"},{"text":" — RevenueCat entitlement identifier that grants pro access. Surfaces as ","type":"text"},{"code":"EntitlementSnapshot.isPro","type":"codeVoice"},{"text":" when active.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"permanentLicenseEntitlementID","type":"codeVoice"},{"text":" — Optional secondary identifier for a lifetime \/ permanent entitlement. Surfaces as ","type":"text"},{"code":"EntitlementSnapshot.hasPermanentLicense","type":"codeVoice"},{"text":" when active. Pass ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if the app has no separate lifetime SKU.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"style":"important","content":[{"inlineContent":[{"text":"Call ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywall\/configure(apiKey:appUserID:userDefaults:logLevel:entitlementVerification:purchasesAreCompletedBy:storeKitVersion:)","type":"reference","isActive":true},{"text":" before invoking the service. Construction before configuration is safe, including from a stored-property initializer. Previews and tests that do not configure RevenueCat should still use ","type":"text"},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"text":" when they need entitlement values.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Important"},{"text":"`customerInfo() async throws -> EntitlementSnapshot`","level":4,"type":"heading","anchor":"customerInfo-async-throws-%3E-EntitlementSnapshot"},{"inlineContent":[{"text":"One-shot fetch. Calls ","type":"text"},{"code":"Purchases.shared.customerInfo()","type":"codeVoice"},{"text":" and maps the result. A response older than five minutes by ","type":"text"},{"code":"requestDate","type":"codeVoice"},{"text":" is labelled ","type":"text"},{"code":".cache","type":"codeVoice"},{"text":" (see ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping#Live-and-cached-customer-info","isActive":true,"type":"reference"},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A read that starts during a package login or logout waits for it to finish. If an identity operation begins, or the RevenueCat app user ID changes, before the read returns, the result is discarded.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Throws ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallError\/notConfigured","isActive":true,"type":"reference"},{"text":" before configuration, ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallError\/identityChanged","isActive":true,"type":"reference"},{"text":" when the result was discarded, ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallError\/verificationFailed","isActive":true,"type":"reference"},{"text":" for failed signature verification, or an SDK error. A ","type":"text"},{"code":"ResilientPaywallService","type":"codeVoice"},{"text":" retries a failed read and can then serve its cached entitlement; that cache is not tied to an account (see ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService#Account-changes","isActive":true,"type":"reference"},{"text":"). Without a fallback the plugin dispatches ","type":"text"},{"code":".refreshFailed(message)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"`customerInfoStream() -> AsyncStream<EntitlementSnapshot>`","level":4,"type":"heading","anchor":"customerInfoStream-%3E-AsyncStream%3CEntitlementSnapshot%3E"},{"inlineContent":[{"text":"Long-lived stream. Wraps ","type":"text"},{"code":"Purchases.shared.customerInfoStream","type":"codeVoice"},{"text":" and yields a new ","type":"text"},{"code":"EntitlementSnapshot","type":"codeVoice"},{"text":" for each valid change RevenueCat reports. A failed-verification element is skipped.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The stream finishes when the underlying RevenueCat stream finishes. The plugin’s ","type":"text"},{"code":".observeCustomerInfo","type":"codeVoice"},{"text":" effect normally keeps it alive for the duration of the session; cancel by cancelling the consuming ","type":"text"},{"code":"Task","type":"codeVoice"},{"text":", which terminates the stream and tears down the bridge.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Before configuration, the stream logs a fault and finishes immediately. Swidux 1.9 and later clears its observation guard when the stream ends, so configure RevenueCat and dispatch ","type":"text"},{"code":".observeCustomerInfo","type":"codeVoice"},{"text":" again to retry.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The stream stays open across package logins and logouts without forwarding a value that could belong to the previous identity. Each RevenueCat subscription starts while no identity operation is running. The first value that arrives after an identity operation began, or after the app user ID changed, is dropped together with the subscription and anything it still buffered. A new subscription starts once no identity operation is running. RevenueCat begins every subscription by replaying the customer info it last sent, and an identity change does not replace that value: after a logout that failed offline it is still the previous user’s. The stream forwards that first value only when its ","type":"text"},{"code":"originalAppUserId","type":"codeVoice"},{"text":" matches the current app user ID or the ","type":"text"},{"code":"originalAppUserId","type":"codeVoice"},{"text":" of the customer info RevenueCat caches for that ID.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The stream buffers only the newest snapshot: each yield is a complete entitlement state, so a slow consumer sees the latest value rather than replaying stale intermediate states.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A new stream first yields the customer info RevenueCat last delivered in this process, if any, and only when it belongs to the current RevenueCat customer. RevenueCat may not have delivered one yet — on a relaunch with a fresh cache it skips the launch fetch — or may still hold the previous user’s. The stream then stays silent until the next change, so dispatch ","type":"text"},{"code":".refreshCustomerInfo","type":"codeVoice"},{"text":" alongside ","type":"text"},{"code":".observeCustomerInfo","type":"codeVoice"},{"text":" to seed the state.","type":"text"}],"type":"paragraph"},{"text":"`restorePurchases() async throws -> EntitlementSnapshot`","level":4,"type":"heading","anchor":"restorePurchases-async-throws-%3E-EntitlementSnapshot"},{"inlineContent":[{"text":"Maps the result of RevenueCat’s user-initiated ","type":"text"},{"code":"restorePurchases()","type":"codeVoice"},{"text":" flow in every purchase-completion mode. Unlike ","type":"text"},{"code":"syncPurchases()","type":"codeVoice"},{"text":", this flow refreshes the App Store receipt and can recover a subscription missing from the device receipt. It may show an App Store sign-in prompt and applies the RevenueCat project’s restore behavior when purchases belong to another app user ID. It follows the same identity rule as ","type":"text"},{"code":"customerInfo()","type":"codeVoice"},{"text":". It throws ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallError\/notConfigured","isActive":true,"type":"reference"},{"text":" before configuration, ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallError\/identityChanged","isActive":true,"type":"reference"},{"text":" when the identity changed before the restore returned, ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallError\/verificationFailed","isActive":true,"type":"reference"},{"text":" for failed signature verification, or an SDK error.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The plugin’s ","type":"text"},{"code":".restorePurchases","type":"codeVoice"},{"text":" action wraps this call and dispatches ","type":"text"},{"code":".customerInfoUpdated","type":"codeVoice"},{"text":" on success or ","type":"text"},{"code":".refreshFailed","type":"codeVoice"},{"text":" on error.","type":"text"}],"type":"paragraph"},{"text":"Identity operations","level":4,"type":"heading","anchor":"Identity-operations"},{"inlineContent":[{"code":"logIn(appUserID:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"logOut()","type":"codeVoice"},{"text":" switch the RevenueCat identity and map the returned customer info with the same entitlement identifiers and verification policy as ","type":"text"},{"code":"customerInfo()","type":"codeVoice"},{"text":". Their ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallIdentityResult","isActive":true,"type":"reference"},{"text":" reports the identity observed after the call, whether it differs from the identity observed before the call, and the mapped snapshot. An already-anonymous logout skips the SDK logout operation and may return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for its snapshot when no cached customer info passes the verification policy.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Failed signature verification is rejected. With ","type":"text"},{"code":"entitlementVerification: .disabled","type":"codeVoice"},{"text":", ","type":"text"},{"code":".notRequested","type":"codeVoice"},{"text":" responses are accepted without a signature check.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"All package login\/logout calls are serialized through completion, including the deprecated namespace methods. Direct RevenueCat identity calls bypass that serialization. A returned result records the completed operation; later queued operations may change the identity again.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Both methods throw ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallIdentityError","isActive":true,"type":"reference"},{"text":" instead of exposing RevenueCat errors. The error records the operation, a package-owned reason, and the identity observed before and after the failure. A provider operation can change identity before a later request or verification step fails, so callers must inspect ","type":"text"},{"code":"identityChanged","type":"codeVoice"},{"text":" rather than treating every thrown error as an unchanged identity.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Every package identity operation, including one that fails, makes the service discard overlapping reads, restores, and stream values as described above. The operation does not reset ","type":"text"},{"code":"PaywallState","type":"codeVoice"},{"text":" or remove the ","type":"text"},{"code":"ResilientPaywallService","type":"codeVoice"},{"text":" cache, and it cannot recall a stream value delivered before it began. ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService#Account-changes","isActive":true,"type":"reference"},{"text":" lists what the app does after each operation. The customer-info stream may later repeat a successful operation’s result, but a failed offline transition is not guaranteed to yield a stream value.","type":"text"}],"type":"paragraph"},{"text":"Entitlement mapping","level":2,"type":"heading","anchor":"Entitlement-mapping"},{"inlineContent":[{"text":"For every ","type":"text"},{"code":"CustomerInfo","type":"codeVoice"},{"text":" the service receives:","type":"text"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Configuration","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"isPro","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"hasPermanentLicense","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"entitlementID","type":"codeVoice"},{"text":" active","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"true","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"(next column)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"entitlementID","type":"codeVoice"},{"text":" inactive or missing","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"false","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"(next column)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"permanentLicenseEntitlementID == nil","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"—"}],"type":"paragraph"}],[{"inlineContent":[{"code":"false","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"permanentLicenseEntitlementID","type":"codeVoice"},{"type":"text","text":" active"}],"type":"paragraph"}],[{"inlineContent":[{"text":"—","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"true","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"permanentLicenseEntitlementID","type":"codeVoice"},{"text":" inactive or missing","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"—"}],"type":"paragraph"}],[{"inlineContent":[{"code":"false","type":"codeVoice"}],"type":"paragraph"}]]]},{"inlineContent":[{"type":"text","text":"Both flags are checked independently against the same "},{"code":"CustomerInfo","type":"codeVoice"},{"text":". A user with both active subscription and lifetime entitlements gets both flags set. See ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping","type":"reference","isActive":true},{"text":" for the reasoning behind the truth table.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"API reference for ","type":"text"},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":" — the RevenueCat-backed ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" conformer that the paywall plugin consumes.","type":"text"}],"metadata":{"role":"article","title":"Service Reference","modules":[{"name":"SwiduxRevenueCatPaywall"}],"roleHeading":"Article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxrevenuecatpaywall\/servicereference"]}],"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/RevenueCatPaywallError":{"abstract":[{"text":"Errors ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallService","isActive":true,"type":"reference"},{"type":"text","text":" raises itself, as opposed to errors it propagates from the RevenueCat SDK."}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"text":"RevenueCatPaywallError","kind":"identifier"}],"url":"\/documentation\/swiduxrevenuecatpaywall\/revenuecatpaywallerror","type":"topic","kind":"symbol","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallError","title":"RevenueCatPaywallError","navigatorTitle":[{"text":"RevenueCatPaywallError","kind":"identifier"}]},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/RevenueCatPaywallService":{"type":"topic","abstract":[{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" conformer backed by RevenueCat’s "},{"type":"codeVoice","code":"Purchases.shared"},{"type":"text","text":"."}],"kind":"symbol","url":"\/documentation\/swiduxrevenuecatpaywall\/revenuecatpaywallservice","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallService","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"RevenueCatPaywallService"}],"title":"RevenueCatPaywallService","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RevenueCatPaywallService"}]},"doc://SwiduxRev