{"kind":"symbol","relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/13SwiduxPaywall0B7ServiceP","doc:\/\/SwiduxRevenueCatPaywall\/s8SendableP","doc:\/\/SwiduxRevenueCatPaywall\/s16SendableMetatypeP"],"kind":"relationships"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MockRevenueCatPaywallService","kind":"identifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"mentions":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference"],"kind":"mentions"},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"text":"The mock tracks a ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"current"}]},{"text":" snapshot: ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)","type":"reference","isActive":true},{"text":" replaces it, ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/customerInfo()","type":"reference","isActive":true},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/restorePurchases()","type":"reference","isActive":true},{"text":" return it, and every ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/customerInfoStream()","type":"reference","isActive":true},{"text":" yields it first. Streams","type":"text"},{"text":" ","type":"text"},{"text":"fan out — each call returns an independent stream, and ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)","type":"reference","isActive":true},{"text":" delivers to every stream","type":"text"},{"text":" ","type":"text"},{"text":"that is still open — so two stores sharing one mock, or a ","type":"text"},{"code":"ResilientPaywallService","type":"codeVoice"},{"text":" wrapper","type":"text"},{"text":" ","type":"text"},{"text":"plus the paywall plugin, all observe the same transitions. ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/finish()","type":"reference","isActive":true},{"text":" ends the streams that","type":"text"},{"text":" ","type":"text"},{"text":"are open at the time. Set ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/customerInfoError","type":"reference","isActive":true},{"text":" or ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/restoreError","type":"reference","isActive":true},{"text":" to make the corresponding","type":"text"},{"text":" ","type":"text"},{"text":"call throw, e.g. to drive the plugin’s ","type":"text"},{"code":".refreshFailed","type":"codeVoice"},{"text":" path or a ","type":"text"},{"code":"ResilientPaywallService","type":"codeVoice"},{"text":" ","type":"text"},{"text":"fallback.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Deliberate differences from the real ","type":"text"},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":", chosen so tests are","type":"text"},{"text":" ","type":"text"},{"text":"deterministic:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"A stream buffers every value it has not delivered yet; the real stream keeps only the"},{"type":"text","text":" "},{"type":"text","text":"newest. A test