{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"title":"customerInfoStream()","roleHeading":"Instance Method","externalID":"s:23SwiduxRevenueCatPaywall0bcD7ServiceV18customerInfoStreamScSy0aD019EntitlementSnapshotVGyF","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"customerInfoStream"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:ScS","text":"AsyncStream","kind":"typeIdentifier"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV","text":"EntitlementSnapshot","kind":"typeIdentifier"},{"kind":"text","text":">"}],"role":"symbol","modules":[{"name":"SwiduxRevenueCatPaywall"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallService\/customerInfoStream()"},"abstract":[{"type":"text","text":"Returns a long-lived stream of entitlement snapshots derived from"},{"type":"text","text":" "},{"type":"codeVoice","code":"Purchases.shared.customerInfoStream"},{"type":"text","text":"."}],"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallService"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxrevenuecatpaywall\/revenuecatpaywallservice\/customerinfostream()"]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"customerInfoStream","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:ScS","kind":"typeIdentifier","text":"AsyncStream"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"EntitlementSnapshot","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV"},{"kind":"text","text":">"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Yields a new ","type":"text"},{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":" every time RevenueCat reports a change to the user’s"},{"type":"text","text":" "},{"type":"text","text":"customer info — purchase, refund, family-share update, sandbox renewal. A failed-verification"},{"type":"text","text":" "},{"type":"text","text":"response is skipped. The stream"},{"type":"text","text":" "},{"type":"text","text":"finishes when the underlying RevenueCat stream finishes; the paywall plugin’s"},{"type":"text","text":" "},{"code":".observeCustomerInfo","type":"codeVoice"},{"type":"text","text":" effect normally keeps it alive for the duration of the session."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A new stream first yields the customer info RevenueCat last delivered in this process, if"},{"text":" ","type":"text"},{"text":"any, and only when it belongs to the current RevenueCat customer. RevenueCat may not have","type":"text"},{"text":" ","type":"text"},{"text":"delivered one yet — on a relaunch with a fresh cache it skips the launch fetch — or may","type":"text"},{"text":" ","type":"text"},{"text":"still hold the previous user’s, as after a logout that failed offline. The stream then","type":"text"},{"text":" ","type":"text"},{"text":"stays silent until the next change. Dispatch ","type":"text"},{"type":"codeVoice","code":".refreshCustomerInfo"},{"type":"text","text":" alongside"},{"type":"text","text":" "},{"type":"codeVoice","code":".observeCustomerInfo"},{"type":"text","text":" to seed the state."}]},{"inlineContent":[{"text":"If RevenueCat has not been configured, the stream finishes immediately. Configure RevenueCat, then call this method again to start a live stream.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The stream stays open across package logins and logouts but never forwards a value that could belong to the previous identity. When a package identity operation begins, or the RevenueCat app user ID changes, the stream discards its RevenueCat subscription with anything still buffered in it. Once no identity operation is running, it subscribes again. RevenueCat starts every subscription by replaying the customer info it last sent, which an identity change does not replace, so the stream forwards that first value only when its "},{"type":"codeVoice","code":"originalAppUserId"},{"type":"text","text":" matches the current app user ID or the "},{"type":"codeVoice","code":"originalAppUserId"},{"type":"text","text":" of the customer info RevenueCat caches for that ID."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/RevenueCatPaywallService/customerInfoStream()":{"type":"topic","title":"customerInfoStream()","kind":"symbol","role":"symbol","url":"\/documentation\/swiduxrevenuecatpaywall\/revenuecatpaywallservice\/customerinfostream()","abstract":[{"type":"text","text":"Returns a long-lived stream of entitlement snapshots derived from"},{"type":"text","text":" "},{"type":"codeVoice","code":"Purchases.shared.customerInfoStream"},{"type":"text","text":"."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"customerInfoStream","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:ScS","text":"AsyncStream","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"EntitlementSnapshot","kind":"typeIdentifier","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV"},{"text":">","kind":"text"}],"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallService\/customerInfoStream()"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/RevenueCatPaywallService":{"role":"symbol","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallService","kind":"symbol","title":"RevenueCatPaywallService","abstract":[{"type":"codeVoice","code":"PaywallService"},{"text":" conformer backed by RevenueCat’s ","type":"text"},{"type":"codeVoice","code":"Purchases.shared"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RevenueCatPaywallService"}],"navigatorTitle":[{"text":"RevenueCatPaywallService","kind":"identifier"}],"url":"\/documentation\/swiduxrevenuecatpaywall\/revenuecatpaywallservice","type":"topic"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall":{"abstract":[{"type":"text","text":"RevenueCat adapter for Swidux’s "},{"type":"codeVoice","code":"PaywallPlugin"},{"text":". Implements ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"text":" against ","type":"text"},{"type":"codeVoice","code":"Purchases.shared"},{"text":", ships a controllable mock for previews and tests, and pairs with ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":" for drop-in "},{"code":"PaywallView","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"CustomerCenterView","type":"codeVoice"},{"text":" presentation.","type":"text"}],"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall","url":"\/documentation\/swiduxrevenuecatpaywall","kind":"symbol","role":"collection","title":"SwiduxRevenueCatPaywall","type":"topic"}}}