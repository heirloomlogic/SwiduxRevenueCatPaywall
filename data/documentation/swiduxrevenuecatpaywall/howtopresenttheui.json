{"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":" ships three view modifiers that wrap RevenueCatUI’s surfaces with platform-aware presentation. Each is bound to "},{"type":"codeVoice","code":"PaywallState"},{"type":"text","text":": presentation flags drive visibility, and the bindings dispatch matching paywall actions back through the store on dismissal. There is no local sheet state."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For platform behavior details (iOS "},{"type":"codeVoice","code":"fullScreenCover"},{"type":"text","text":" vs macOS sheet sizing, App Store deep link on macOS), see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Before-you-start","text":"Before you start","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide assumes:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You have completed "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService"},{"type":"text","text":". The plugin is registered and "},{"type":"codeVoice","code":"observeCustomerInfo"},{"type":"text","text":" runs on launch."}]}]},{"content":[{"inlineContent":[{"text":"Your app target depends on the ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":" product:"}],"type":"paragraph"}]}]},{"type":"codeListing","syntax":"swift","code":[".product(name: \"SwiduxRevenueCatPaywallUI\", package: \"SwiduxRevenueCatPaywall\"),"]},{"type":"heading","anchor":"Step-1-Attach-both-sheets-to-a-root-view","level":2,"text":"Step 1: Attach both sheets to a root view"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The simplest wiring uses the "},{"type":"codeVoice","code":"revenueCatPaywall(state:send:)"},{"type":"text","text":" modifier — one call, both sheets, both dismissals:"}]},{"type":"codeListing","syntax":"swift","code":["import SwiduxRevenueCatPaywallUI","","struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .revenueCatPaywall(state: store.paywall) { action in","                store.send(.paywall(action))","            }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The closure receives a "},{"type":"codeVoice","code":"PaywallAction"},{"type":"text","text":" ("},{"type":"codeVoice","code":".dismiss"},{"type":"text","text":" or "},{"type":"codeVoice","code":".dismissCustomerCenter"},{"type":"text","text":") and lifts it into your root action. Place the modifier on the topmost view that should host both sheets."}]},{"type":"paragraph","inlineContent":[{"text":"Both paywall modifiers also accept ","type":"text"},{"type":"codeVoice","code":"displayCloseButton:"},{"type":"text","text":" (default "},{"type":"codeVoice","code":"true"},{"type":"text","text":"). The default presentation has no other way out — see "},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","type":"reference","isActive":true},{"type":"text","text":" before turning it off."}]},{"type":"heading","anchor":"Step-2-Trigger-the-paywall-from-a-feature","level":2,"text":"Step 2: Trigger the paywall from a feature"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dispatch "},{"type":"codeVoice","code":".request(reason:)"},{"type":"text","text":" with a short identifier describing why you’re asking. "},{"type":"codeVoice","code":"PaywallState.requestedReason"},{"type":"text","text":" stores the value so the sheet (or analytics) can tailor its copy:"}]},{"type":"codeListing","syntax":"swift","code":["Button(\"Export PDF\") {","    store.send(.paywall(.request(reason: \"export-pdf\")))","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin sets "},{"type":"codeVoice","code":"PaywallState.isPresented = true"},{"type":"text","text":". The "},{"type":"codeVoice","code":"revenueCatPaywall"},{"type":"text","text":" modifier observes the change and presents "},{"type":"codeVoice","code":"RevenueCatUI.PaywallView"},{"type":"text","text":"."}]},{"type":"heading","anchor":"Step-3-Trigger-the-customer-center","level":2,"text":"Step 3: Trigger the customer center"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Existing subscribers manage their subscription through the customer center. Surface a button that dispatches "},{"type":"codeVoice","code":".presentCustomerCenter"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["if store.paywall.isPro {","    Button(\"Manage Subscription\") {","        store.send(.paywall(.presentCustomerCenter))","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"revenueCatCustomerCenter"},{"text":" modifier presents ","type":"text"},{"type":"codeVoice","code":"RevenueCatUI.CustomerCenterView"},{"text":" on iOS. On macOS it opens the system App Store subscriptions URL and immediately fires ","type":"text"},{"type":"codeVoice","code":"onDismiss"},{"text":" (RevenueCatUI does not ship a customer center on macOS — see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior"},{"text":").","type":"text"}]},{"type":"heading","anchor":"Step-4-Manual-wiring-optional","level":2,"text":"Step 4: Manual wiring (optional)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you need only one sheet, or you want to interleave other modifiers between them, attach the primitive modifiers directly. Each takes a real "},{"type":"codeVoice","code":"Binding<Bool>"},{"type":"text","text":"; build it with a "},{"type":"codeVoice","code":"set:"},{"type":"text","text":" that dispatches the matching dismiss action when SwiftUI clears the flag:"}]},{"type":"codeListing","syntax":"swift","code":["ContentView()","    .revenueCatPaywall(","        isPresented: Binding(","            get: { store.paywall.isPresented },","            set: { if !$0 { store.send(.paywall(.dismiss)) } }","        )","    )","    .revenueCatCustomerCenter(","        isPresented: Binding(","            get: { store.paywall.isCustomerCenterPresented },","            set: { if !$0 { store.send(.paywall(.dismissCustomerCenter)) } }","        )","    )"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The convenience modifier "},{"type":"codeVoice","code":"revenueCatPaywall(state:send:)"},{"type":"text","text":" is exactly equivalent to this wiring."}]},{"type":"heading","anchor":"Step-5-Restore-from-inside-the-paywall","level":2,"text":"Step 5: Restore from inside the paywall"},{"type":"paragraph","inlineContent":[{"type":"text","text":"RevenueCatUI’s "},{"type":"codeVoice","code":"PaywallView"},{"type":"text","text":" provides its own restore button by default. If you need an additional restore affordance elsewhere (a Settings row, for example), dispatch "},{"type":"codeVoice","code":".restorePurchases"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["Button(\"Restore Purchases\") {","    store.send(.paywall(.restorePurchases))","}",".disabled(store.paywall.isLoading)"]},{"type":"heading","anchor":"What-happens-on-dismiss","level":2,"text":"What happens on dismiss"},{"type":"paragraph","inlineContent":[{"text":"When the user dismisses the paywall, the plugin’s ","type":"text"},{"type":"codeVoice","code":".dismiss"},{"type":"text","text":" action clears "},{"type":"codeVoice","code":"PaywallState.isPresented"},{"type":"text","text":" and "},{"type":"codeVoice","code":"requestedReason"},{"type":"text","text":", then dispatches "},{"type":"codeVoice","code":".refreshCustomerInfo"},{"type":"text","text":" so the gate is reconciled — the user may have purchased while the sheet was open."}]},{"type":"paragraph","inlineContent":[{"text":"When the user dismisses the customer center, the plugin’s ","type":"text"},{"code":".dismissCustomerCenter","type":"codeVoice"},{"text":" action clears ","type":"text"},{"code":"isCustomerCenterPresented","type":"codeVoice"},{"text":". No refresh is dispatched, since opening the customer center does not change entitlement state by itself; the live ","type":"text"},{"code":"customerInfoStream","type":"codeVoice"},{"text":" from ","type":"text"},{"code":"Step 5","type":"codeVoice"},{"text":" of ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","type":"reference","isActive":true},{"text":" picks up any subscription change RevenueCat reports asynchronously.","type":"text"}]}]}],"abstract":[{"text":"Attach the ","type":"text"},{"code":"revenueCatPaywall","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"revenueCatCustomerCenter","type":"codeVoice"},{"text":" view modifiers from ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" to a root view, driven by ","type":"text"},{"code":"PaywallState","type":"codeVoice"},{"text":".","type":"text"}],"metadata":{"roleHeading":"Article","modules":[{"name":"SwiduxRevenueCatPaywall"}],"title":"How to Present the UI","role":"article"},"schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService"],"abstract":[{"text":"The matching API reference for the views described here lives in the ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" documentation.","type":"text"}]},{"title":"How-to Guides","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest"],"anchor":"How-to-Guides","generated":true}],"sections":[],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxrevenuecatpaywall\/howtopresenttheui"]}],"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall":{"title":"SwiduxRevenueCatPaywall","url":"\/documentation\/swiduxrevenuecatpaywall","kind":"symbol","type":"topic","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall","role":"collection","abstract":[{"text":"RevenueCat adapter for Swidux’s ","type":"text"},{"type":"codeVoice","code":"PaywallPlugin"},{"type":"text","text":". Implements "},{"type":"codeVoice","code":"PaywallService"},{"text":" against ","type":"text"},{"code":"Purchases.shared","type":"codeVoice"},{"type":"text","text":", ships a controllable mock for previews and tests, and pairs with "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":" for drop-in "},{"type":"codeVoice","code":"PaywallView"},{"text":" and ","type":"text"},{"code":"CustomerCenterView","type":"codeVoice"},{"text":" presentation.","type":"text"}]},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToImplementService":{"title":"How to Implement the Service","url":"\/documentation\/swiduxrevenuecatpaywall\/howtoimplementservice","kind":"article","type":"topic","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","role":"article","abstract":[{"type":"text","text":"Wire "},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":" into the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin so the store sees real-time entitlement updates from RevenueCat."}]},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToAddAPermanentLicense":{"title":"How to Add a Permanent License","url":"\/documentation\/swiduxrevenuecatpaywall\/howtoaddapermanentlicense","kind":"article","type":"topic","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","role":"article","abstract":[{"type":"text","text":"Sell a lifetime entitlement alongside a subscription and surface both flags through the paywall plugin."}]},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToPreviewAndTest":{"title":"How to Preview and Test","url":"\/documentation\/swiduxrevenuecatpaywall\/howtopreviewandtest","kind":"article","type":"topic","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest","role":"article","abstract":[{"text":"Drive entitlement state from SwiftUI previews and tests with ","type":"text"},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"text":" — no RevenueCat SDK call required.","type":"text"}]},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/PlatformBehavior":{"role":"article","abstract":[{"type":"text","text":"Why the "},{"type":"codeVoice","code":"revenueCatPaywall"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"revenueCatCustomerCenter"},{"text":" modifiers present differently on iOS and macOS, and what is hard-coded.","type":"text"}],"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","url":"\/documentation\/swiduxrevenuecatpaywall\/platformbehavior","title":"Platform Behavior","type":"topic","kind":"article"}}}