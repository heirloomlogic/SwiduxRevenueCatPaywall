:"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/customerInfoStream()","type":"reference"},{"text":" yields it first. Streams","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"fan out — each call returns an independent stream, and "},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)","isActive":true,"type":"reference"},{"type":"text","text":" delivers to every stream"},{"type":"text","text":" "},{"type":"text","text":"that is still open — so two stores sharing one mock, or a "},{"type":"codeVoice","code":"ResilientPaywallService"},{"type":"text","text":" wrapper"},{"type":"text","text":" "},{"type":"text","text":"plus the paywall plugin, all observe the same transitions. "},{"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/finish()","isActive":true},{"type":"text","text":" ends the streams that"},{"type":"text","text":" "},{"type":"text","text":"are open at the time. Set "},{"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/customerInfoError","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/restoreError","isActive":true},{"type":"text","text":" to make the corresponding"},{"type":"text","text":" "},{"type":"text","text":"call throw, e.g. to drive the plugin’s "},{"type":"codeVoice","code":".refreshFailed"},{"type":"text","text":" path or a "},{"type":"codeVoice","code":"ResilientPaywallService"},{"type":"text","text":" "},{"type":"text","text":"fallback."}]},{"inlineContent":[{"text":"Deliberate differences from the real ","type":"text"},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":", chosen so tests are","type":"text"},{"text":" ","type":"text"},{"text":"deterministic:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A stream buffers every value it has not delivered yet; the real stream keeps only the","type":"text"},{"text":" ","type":"text"},{"text":"newest. A test that sends several snapshots before its consumer runs sees each one, in order.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A new stream always yields the current snapshot first; the real stream yields a first value"},{"type":"text","text":" "},{"type":"text","text":"only if RevenueCat has already delivered customer info in this process."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Compared with Swidux’s ","type":"text"},{"code":"SimulatedPaywallService","type":"codeVoice"},{"text":" (an actor with a dev-paywall UI and simulated","type":"text"},{"text":" ","type":"text"},{"text":"latency, better suited to vendor-free previews and development builds), this mock offers a","type":"text"},{"text":" ","type":"text"},{"text":"synchronous ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/send(_:)","type":"reference"},{"text":", arbitrary injected errors, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService\/finish()","type":"reference"},{"text":", and delivery of repeated","type":"text"},{"text":" ","type":"text"},{"text":"identical snapshots — ","type":"text"},{"code":"SimulatedPaywallService","type":"codeVoice"},{"text":" drops a change that equals the current state.","type":"text"},{"text":" ","type":"text"},{"code":"MockPaywallService","type":"codeVoice"},{"text":" in SwiduxPaywall differs again: its stream finishes immediately after the","type":"text"},{"text":" ","type":"text"},{"text":"ini