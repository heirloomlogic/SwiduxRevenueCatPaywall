{"identifier":{"url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","interfaceLanguage":"swift"},"metadata":{"title":"How to Present the UI","roleHeading":"Article","modules":[{"name":"SwiduxRevenueCatPaywall"}],"role":"article"},"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"sections":[],"abstract":[{"text":"Attach the ","type":"text"},{"code":"revenueCatPaywall","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"revenueCatCustomerCenter","type":"codeVoice"},{"text":" view modifiers from ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" to a root view, driven by ","type":"text"},{"code":"PaywallState","type":"codeVoice"},{"text":".","type":"text"}],"variants":[{"paths":["\/documentation\/swiduxrevenuecatpaywall\/howtopresenttheui"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"text":" ships three view modifiers that wrap RevenueCatUI’s surfaces with platform-aware presentation. Each is bound to ","type":"text"},{"type":"codeVoice","code":"PaywallState"},{"text":": presentation flags drive visibility, and the bindings dispatch matching paywall actions back through the store on dismissal. There is no local sheet state.","type":"text"}]},{"inlineContent":[{"type":"text","text":"For platform behavior details (iOS "},{"code":"fullScreenCover","type":"codeVoice"},{"type":"text","text":" vs macOS sheet sizing, App Store deep link on macOS), see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Before you start","level":2,"type":"heading","anchor":"Before-you-start"},{"inlineContent":[{"type":"text","text":"This guide assumes:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You have completed "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService"},{"type":"text","text":". The plugin is registered and "},{"type":"codeVoice","code":"observeCustomerInfo"},{"type":"text","text":" runs on launch."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your app target depends on the "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":" product:"}]}]}]},{"syntax":"swift","type":"codeListing","code":[".product(name: \"SwiduxRevenueCatPaywallUI\", package: \"SwiduxRevenueCatPaywall\"),"]},{"text":"Step 1: Attach both sheets to a root view","level":2,"type":"heading","anchor":"Step-1-Attach-both-sheets-to-a-root-view"},{"inlineContent":[{"type":"text","text":"The simplest wiring uses the "},{"code":"revenueCatPaywall(state:send:)","type":"codeVoice"},{"type":"text","text":" modifier — one call, both sheets, both dismissals:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiduxRevenueCatPaywallUI","","struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .revenueCatPaywall(state: store.paywall) { action in","                store.send(.paywall(action))","            }","    }","}"]},{"inlineContent":[{"type":"text","text":"The closure receives a "},{"code":"PaywallAction","type":"codeVoice"},{"type":"text","text":" ("},{"code":".dismiss","type":"codeVoice"},{"type":"text","text":" or "},{"code":".dismissCustomerCenter","type":"codeVoice"},{"type":"text","text":") and lifts it into your root action. Place the modifier on the topmost view that should host both sheets."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Both paywall modifiers also accept "},{"code":"displayCloseButton:","type":"codeVoice"},{"type":"text","text":" (default "},{"code":"true","type":"codeVoice"},{"type":"text","text":"). The default presentation has no other way out — see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior"},{"type":"text","text":" before turning it off."}],"type":"paragraph"},{"text":"Step 2: Trigger the paywall from a feature","level":2,"type":"heading","anchor":"Step-2-Trigger-the-paywall-from-a-feature"},{"inlineContent":[{"type":"text","text":"Dispatch "},{"code":".request(reason:)","type":"codeVoice"},{"type":"text","text":" with a short identifier describing why you’re asking. "},{"code":"PaywallState.requestedReason","type":"codeVoice"},{"type":"text","text":" stores the value so the sheet (or analytics) can tailor its copy:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["Button(\"Export PDF\") {","    store.send(.paywall(.request(reason: \"export-pdf\")))","}"]},{"inlineContent":[{"type":"text","text":"The plugin sets "},{"code":"PaywallState.isPresented = true","type":"codeVoice"},{"type":"text","text":". The "},{"code":"revenueCatPaywall","type":"codeVoice"},{"type":"text","text":" modifier observes the change and presents "},{"code":"RevenueCatUI.PaywallView","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Step 3: Trigger the customer center","level":2,"type":"heading","anchor":"Step-3-Trigger-the-customer-center"},{"inlineContent":[{"type":"text","text":"Existing subscribers manage their subscription through the customer center. Surface a button that dispatches "},{"code":".presentCustomerCenter","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["if store.paywall.isPro {","    Button(\"Manage Subscription\") {","        store.send(.paywall(.presentCustomerCenter))","    }","}"]},{"inlineContent":[{"type":"text","text":"The "},{"code":"revenueCatCustomerCenter","type":"codeVoice"},{"type":"text","text":" modifier presents "},{"code":"RevenueCatUI.CustomerCenterView","type":"codeVoice"},{"type":"text","text":" on iOS. On macOS it opens the system App Store subscriptions URL and immediately fires "},{"code":"onDismiss","type":"codeVoice"},{"type":"text","text":" (RevenueCatUI does not ship a customer center on macOS — see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior"},{"type":"text","text":")."}],"type":"paragraph"},{"text":"Step 4: Manual wiring (optional)","level":2,"type":"heading","anchor":"Step-4-Manual-wiring-optional"},{"inlineContent":[{"type":"text","text":"If you need only one sheet, or you want to interleave other modifiers between them, attach the primitive modifiers directly. Each takes a real "},{"code":"Binding<Bool>","type":"codeVoice"},{"type":"text","text":"; build it with a "},{"code":"set:","type":"codeVoice"},{"type":"text","text":" that dispatches the matching dismiss action when SwiftUI clears the flag:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["ContentView()","    .revenueCatPaywall(","        isPresented: Binding(","            get: { store.paywall.isPresented },","            set: { if !$0 { store.send(.paywall(.dismiss)) } }","        )","    )","    .revenueCatCustomerCenter(","        isPresented: Binding(","            get: { store.paywall.isCustomerCenterPresented },","            set: { if !$0 { store.send(.paywall(.dismissCustomerCenter)) } }","        )","    )"]},{"inlineContent":[{"type":"text","text":"The convenience modifier "},{"code":"revenueCatPaywall(state:send:)","type":"codeVoice"},{"type":"text","text":" is exactly equivalent to this wiring."}],"type":"paragraph"},{"text":"Step 5: Restore from inside the paywall","level":2,"type":"heading","anchor":"Step-5-Restore-from-inside-the-paywall"},{"inlineContent":[{"type":"text","text":"RevenueCatUI’s "},{"code":"PaywallView","type":"codeVoice"},{"type":"text","text":" provides its own restore button by default. If you need an additional restore affordance elsewhere (a Settings row, for example), dispatch "},{"code":".restorePurchases","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["Button(\"Restore Purchases\") {","    store.send(.paywall(.restorePurchases))","}",".disabled(store.paywall.isLoading)"]},{"text":"What happens on dismiss","level":2,"type":"heading","anchor":"What-happens-on-dismiss"},{"inlineContent":[{"type":"text","text":"When the user dismisses the paywall, the plugin’s "},{"code":".dismiss","type":"codeVoice"},{"type":"text","text":" action clears "},{"code":"PaywallState.isPresented","type":"codeVoice"},{"type":"text","text":" and "},{"code":"requestedReason","type":"codeVoice"},{"type":"text","text":", then dispatches "},{"code":".refreshCustomerInfo","type":"codeVoice"},{"type":"text","text":" so the gate is reconciled — the user may have purchased while the sheet was open."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When the user dismisses the customer center, the plugin’s "},{"code":".dismissCustomerCenter","type":"codeVoice"},{"type":"text","text":" action clears "},{"code":"isCustomerCenterPresented","type":"codeVoice"},{"type":"text","text":". No refresh is dispatched, since opening the customer center does not change entitlement state by itself; the live "},{"code":"customerInfoStream","type":"codeVoice"},{"type":"text","text":" from "},{"type":"codeVoice","code":"Step 5"},{"type":"text","text":" of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService"},{"type":"text","text":" picks up any subscription change RevenueCat reports asynchronously."}],"type":"paragraph"}]}],"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService"],"title":"Related Documentation","abstract":[{"text":"The matching API reference for the views described here lives in the ","type":"text"},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"text":" documentation.","type":"text"}]},{"anchor":"How-to-Guides","identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest"],"title":"How-to Guides","generated":true}],"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/PlatformBehavior":{"kind":"article","role":"article","title":"Platform Behavior","type":"topic","abstract":[{"text":"Why the ","type":"text"},{"code":"revenueCatPaywall","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"revenueCatCustomerCenter","type":"codeVoice"},{"text":" modifiers present differently on iOS and macOS, and what is hard-coded.","type":"text"}],"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","url":"\/documentation\/swiduxrevenuecatpaywall\/platformbehavior"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToImplementService":{"kind":"article","role":"article","title":"How to Implement the Service","type":"topic","abstract":[{"text":"Wire ","type":"text"},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":" into the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" plugin so the store sees real-time entitlement updates from RevenueCat.","type":"text"}],"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","url":"\/documentation\/swiduxrevenuecatpaywall\/howtoimplementservice"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall":{"abstract":[{"text":"RevenueCat adapter for Swidux’s ","type":"text"},{"code":"PaywallPlugin","type":"codeVoice"},{"text":". Implements ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" against ","type":"text"},{"code":"Purchases.shared","type":"codeVoice"},{"text":", ships a controllable mock for previews and tests, and pairs with ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" for drop-in ","type":"text"},{"code":"PaywallView","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"CustomerCenterView","type":"codeVoice"},{"text":" presentation.","type":"text"}],"type":"topic","url":"\/documentation\/swiduxrevenuecatpaywall","title":"SwiduxRevenueCatPaywall","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall","role":"collection","kind":"symbol"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToAddAPermanentLicense":{"kind":"article","role":"article","title":"How to Add a Permanent License","type":"topic","abstract":[{"text":"Sell a lifetime entitlement alongside a subscription and surface both flags through the paywall plugin.","type":"text"}],"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","url":"\/documentation\/swiduxrevenuecatpaywall\/howtoaddapermanentlicense"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToPreviewAndTest":{"kind":"article","role":"article","title":"How to Preview and Test","type":"topic","abstract":[{"text":"Drive entitlement state from SwiftUI previews and tests with ","type":"text"},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"text":" — no RevenueCat SDK call required.","type":"text"}],"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest","url":"\/documentation\/swiduxrevenuecatpaywall\/howtopreviewandtest"}}}