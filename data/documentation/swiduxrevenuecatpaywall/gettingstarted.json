{"metadata":{"role":"article","roleHeading":"Article","title":"Getting Started with SwiduxRevenueCatPaywall","modules":[{"name":"SwiduxRevenueCatPaywall"}]},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/GettingStarted"},"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"abstract":[{"type":"text","text":"Add the package, configure RevenueCat, register the paywall plugin, and present the bundled sheets."}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxrevenuecatpaywall\/gettingstarted"]}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"This guide walks through the four steps to integrate ","type":"text"},{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"text":" into a Swidux app: add the package, configure RevenueCat, register the plugin, and attach the UI. It is the shortest path from a wired Swidux app to a working paywall. For deeper coverage of any step, follow the linked how-tos.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This package assumes you already use Swidux. If you don’t, work through Swidux’s own getting-started guide first.","type":"text"}]},{"type":"heading","level":2,"text":"Add the Package","anchor":"Add-the-Package"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Xcode:"}],"type":"strong"},{"text":" File > Add Package Dependencies, paste ","type":"text"},{"code":"https:\/\/github.com\/HeirloomLogic\/SwiduxRevenueCatPaywall","type":"codeVoice"},{"text":". Add the products you need:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"text":" — the ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" implementation and mock.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" — adds the composed ","type":"text"},{"code":"revenueCatPaywallAndCustomerCenter","type":"codeVoice"},{"text":" modifier and the ","type":"text"},{"code":"revenueCatPaywall","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"revenueCatCustomerCenter","type":"codeVoice"},{"text":" primitives (depends on RevenueCatUI).","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Package.swift:"}],"type":"strong"}]},{"type":"codeListing","code":[".package(url: \"https:\/\/github.com\/HeirloomLogic\/SwiduxRevenueCatPaywall\", from: \"1.0.0\"),"],"syntax":"swift"},{"type":"codeListing","code":[".product(name: \"SwiduxRevenueCatPaywall\", package: \"SwiduxRevenueCatPaywall\"),",".product(name: \"SwiduxRevenueCatPaywallUI\", package: \"SwiduxRevenueCatPaywall\"),"],"syntax":"swift"},{"type":"heading","level":2,"text":"Configure the paywall at launch","anchor":"Configure-the-paywall-at-launch"},{"type":"paragraph","inlineContent":[{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":" calls into ","type":"text"},{"code":"Purchases.shared","type":"codeVoice"},{"text":" under the hood. Configure the paywall before constructing the store:","type":"text"}]},{"type":"codeListing","code":["\/\/ MyApp.swift","import SwiduxRevenueCatPaywall","import SwiftUI","","@main","struct MyApp: App {","    @State private var store: AppStore","","    init() {","        RevenueCatPaywall.configure(apiKey: \"your_revenuecat_api_key\")","        _store = State(wrappedValue: AppStore.configured())","    }","","    var body: some Scene {","        WindowGroup { ContentView().environment(store) }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The service itself is safe to construct before configuration. If stored-property initialization creates the store first, configure RevenueCat before dispatching paywall actions. An early read or restore throws ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallError\/notConfigured","type":"reference","isActive":true},{"text":"; an early entitlement stream finishes and can be started again after configuration. Swidux 1.9 and later clears the plugin’s observation guard when that stream ends.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Pass ","type":"text"},{"code":"appUserID","type":"codeVoice"},{"text":", ","type":"text"},{"code":"userDefaults","type":"codeVoice"},{"text":" (for app-group sharing with widgets), ","type":"text"},{"code":"logLevel","type":"codeVoice"},{"text":", ","type":"text"},{"code":"entitlementVerification","type":"codeVoice"},{"text":" (signed entitlement verification), or ","type":"text"},{"code":"purchasesAreCompletedBy","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"storeKitVersion","type":"codeVoice"},{"text":" (app-completed purchases) if you need them — see ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywall\/configure(apiKey:appUserID:userDefaults:logLevel:entitlementVerification:purchasesAreCompletedBy:storeKitVersion:)","type":"reference","isActive":true},{"text":".","type":"text"}]},{"type":"heading","level":2,"text":"Register the paywall plugin","anchor":"Register-the-paywall-plugin"},{"type":"paragraph","inlineContent":[{"text":"Pass ","type":"text"},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"PaywallPlugin","type":"codeVoice"},{"text":" in your ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory:","type":"text"}]},{"type":"codeListing","code":["import Swidux","import SwiduxPaywall","import SwiduxRevenueCatPaywall","","extension Store where State == AppState, Action == AppAction {","    static func configured() -> AppStore {","        let plugins = PluginHost<AppState, AppAction>()","","        plugins.register(","            PaywallPlugin<AppState, AppAction>(","                state: \\.paywall,","                action: AppAction.paywall,","                extractAction: { if case .paywall(let a) = $0 { return a }; return nil },","                service: ResilientPaywallService(","                    base: RevenueCatPaywallService(entitlementID: \"pro\"),","                    store: KeychainKeyValueStore(service: \"com.example.myapp\")","                )","            )","        )","","        return Store(","            initialState: AppState(),","            reducer: AppReducer().reduce,","            plugins: plugins","        )","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"ResilientPaywallService","type":"codeVoice"},{"text":" (from SwiduxPaywall) persists the last entitlement snapshot a successful read delivered. Without it, a slow or failing network at cold launch leaves ","type":"text"},{"code":"PaywallState","type":"codeVoice"},{"text":" at its free default and gates paying users out of their features until the first successful read; with it, the last-known-good state holds until live data arrives, and the server stays authoritative — a genuine lapse is honoured on the next successful read. Wrap the RevenueCat service in it for production.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Back the cache with ","type":"text"},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"text":", as shown, rather than ","type":"text"},{"code":"UserDefaultsKeyValueStore","type":"codeVoice"},{"text":". The cache vouches for a paid entitlement while RevenueCat is unreachable, and a ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" plist is user-editable and restorable from a doctored backup; the Keychain uses OS-protected storage instead of a user-editable plist. See Swidux’s ","type":"text"},{"identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/securityposture","type":"reference","isActive":true},{"text":" for what the cache does and does not defend against.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Start the entitlement stream on the root view so the gate reflects RevenueCat’s state from launch:","type":"text"}]},{"type":"codeListing","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .task {","                store.send(.paywall(.observeCustomerInfo))","                store.send(.paywall(.refreshCustomerInfo))","            }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Gate features by reading ","type":"text"},{"code":"store.paywall.isGateSatisfied","type":"codeVoice"},{"text":". See ","type":"text"},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","type":"reference","isActive":true},{"text":" for the full plugin lifecycle.","type":"text"}]},{"type":"heading","level":2,"text":"Attach the UI","anchor":"Attach-the-UI"},{"type":"paragraph","inlineContent":[{"text":"Attach the composed ","type":"text"},{"code":"revenueCatPaywallAndCustomerCenter","type":"codeVoice"},{"text":" modifier to a root view, driven by paywall state:","type":"text"}]},{"code":["import SwiduxRevenueCatPaywallUI","","struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .revenueCatPaywallAndCustomerCenter(","                state: store.paywall,","                onAction: { action in store.send(.paywall(action)) }","            )","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Trigger the paywall from a gated feature with ","type":"text"},{"code":".paywall(.request(reason:))","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["Button(\"Export PDF\") {","    if store.paywall.isGateSatisfied {","        store.send(.export(.exportPDF))","    } else {","        store.send(.paywall(.request(reason: \"export-pdf\")))","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","type":"reference"},{"text":" for manual wiring with the primitive modifiers, customer-center triggering, and dismiss semantics.","type":"text"}],"type":"paragraph"},{"text":"Next Steps","anchor":"Next-Steps","level":2,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","type":"reference","isActive":true},{"type":"text","text":" — Detailed walkthrough of the service lifecycle and error handling."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","type":"reference","isActive":true},{"type":"text","text":" — Add a lifetime entitlement alongside the subscription."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest","type":"reference","isActive":true},{"type":"text","text":" — Drive entitlement state from previews and tests."}]}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","type":"reference","isActive":true},{"type":"text","text":" — Wire the bundled view modifiers."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","type":"reference","isActive":true},{"type":"text","text":" — Why iOS and macOS behave differently."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping"},{"text":" — How RevenueCat entitlements map to ","type":"text"},{"code":"EntitlementSnapshot","type":"codeVoice"},{"text":".","type":"text"}]}]}],"type":"unorderedList"}]}],"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToPresentTheUI":{"kind":"article","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","url":"\/documentation\/swiduxrevenuecatpaywall\/howtopresenttheui","type":"topic","title":"How to Present the UI","abstract":[{"text":"Attach ","type":"text"},{"code":"revenueCatPaywallAndCustomerCenter","type":"codeVoice"},{"text":" from ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" to a root view to present both surfaces from ","type":"text"},{"code":"PaywallState","type":"codeVoice"},{"text":", or attach either binding-driven primitive by itself.","type":"text"}],"role":"article"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToImplementService":{"title":"How to Implement the Service","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","role":"article","kind":"article","abstract":[{"type":"text","text":"Wire "},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":" into the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin so the store sees real-time entitlement updates from RevenueCat."}],"type":"topic","url":"\/documentation\/swiduxrevenuecatpaywall\/howtoimplementservice"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/HowToPrev