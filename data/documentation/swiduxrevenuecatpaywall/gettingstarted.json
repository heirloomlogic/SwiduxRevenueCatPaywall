{"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"modules":[{"name":"SwiduxRevenueCatPaywall"}],"roleHeading":"Article","role":"article","title":"Getting Started with SwiduxRevenueCatPaywall"},"identifier":{"url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/GettingStarted","interfaceLanguage":"swift"},"abstract":[{"text":"Add the package, configure RevenueCat, register the paywall plugin, and present the bundled sheets.","type":"text"}],"kind":"article","sections":[],"hierarchy":{"paths":[["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"]]},"variants":[{"paths":["\/documentation\/swiduxrevenuecatpaywall\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"This guide walks through the four steps to integrate "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"},{"type":"text","text":" into a Swidux app: add the package, configure RevenueCat, register the plugin, and attach the UI. It is the shortest path from a wired Swidux app to a working paywall. For deeper coverage of any step, follow the linked how-tos."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This package assumes you already use Swidux. If you don’t, work through Swidux’s own getting-started guide first."}],"type":"paragraph"},{"level":2,"text":"Add the Package","anchor":"Add-the-Package","type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Xcode:"}]},{"type":"text","text":" File > Add Package Dependencies, paste "},{"type":"codeVoice","code":"https:\/\/github.com\/HeirloomLogic\/SwiduxRevenueCatPaywall"},{"type":"text","text":". Add the products you need:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"text":" — the ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" implementation and mock.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":" — adds the composed "},{"type":"codeVoice","code":"revenueCatPaywallAndCustomerCenter"},{"text":" modifier and the ","type":"text"},{"type":"codeVoice","code":"revenueCatPaywall"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"revenueCatCustomerCenter"},{"text":" primitives (depends on RevenueCatUI).","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Package.swift:","type":"text"}]}]},{"type":"codeListing","code":[".package(url: \"https:\/\/github.com\/HeirloomLogic\/SwiduxRevenueCatPaywall\", from: \"1.0.0\"),"],"syntax":"swift"},{"type":"codeListing","code":[".product(name: \"SwiduxRevenueCatPaywall\", package: \"SwiduxRevenueCatPaywall\"),",".product(name: \"SwiduxRevenueCatPaywallUI\", package: \"SwiduxRevenueCatPaywall\"),"],"syntax":"swift"},{"type":"heading","text":"Configure the paywall at launch","anchor":"Configure-the-paywall-at-launch","level":2},{"type":"paragraph","inlineContent":[{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":" calls into ","type":"text"},{"code":"Purchases.shared","type":"codeVoice"},{"text":" under the hood. Configure the paywall before constructing the store:","type":"text"}]},{"code":["\/\/ MyApp.swift","import SwiduxRevenueCatPaywall","import SwiftUI","","@main","struct MyApp: App {","    @State private var store: AppStore","","    init() {","        RevenueCatPaywall.configure(apiKey: \"your_revenuecat_api_key\")","        _store = State(wrappedValue: AppStore.configured())","    }","","    var body: some Scene {","        WindowGroup { ContentView().environment(store) }","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The service itself is safe to construct before configuration. If stored-property initialization creates the store first, configure RevenueCat before dispatching paywall actions. An early read or restore throws "},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallError\/notConfigured","type":"reference","isActive":true},{"type":"text","text":"; an early entitlement stream finishes and can be started again after configuration. Swidux 1.9 and later clears the plugin’s observation guard when that stream ends."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass "},{"type":"codeVoice","code":"appUserID"},{"text":", ","type":"text"},{"type":"codeVoice","code":"userDefaults"},{"type":"text","text":" (for app-group sharing with widgets), "},{"type":"codeVoice","code":"logLevel"},{"type":"text","text":", "},{"code":"entitlementVerification","type":"codeVoice"},{"text":" (signed entitlement verification), or ","type":"text"},{"code":"purchasesAreCompletedBy","type":"codeVoice"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"storeKitVersion"},{"type":"text","text":" (app-completed purchases) if you need them — see "},{"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywall\/configure(apiKey:appUserID:userDefaults:logLevel:entitlementVerification:purchasesAreCompletedBy:storeKitVersion:)","isActive":true},{"text":".","type":"text"}]},{"level":2,"text":"Register the paywall plugin","type":"heading","anchor":"Register-the-paywall-plugin"},{"type":"paragraph","inlineContent":[{"text":"Pass ","type":"text"},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":" to "},{"type":"codeVoice","code":"PaywallPlugin"},{"type":"text","text":" in your "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory:"}]},{"type":"codeListing","code":["import Swidux","import SwiduxPaywall","import SwiduxRevenueCatPaywall","","extension Store where State == AppState, Action == AppAction {","    static func configured() -> AppStore {","        let plugins = PluginHost<AppState, AppAction>()","","        plugins.register(","            PaywallPlugin<AppState, AppAction>(","                state: \\.paywall,","                action: AppAction.paywall,","                extractAction: { if case .paywall(let a) = $0 { return a }; return nil },","                service: ResilientPaywallService(","                    base: RevenueCatPaywallService(entitlementID: \"pro\"),","                    store: KeychainKeyValueStore(service: \"com.example.myapp\")","                )","            )","        )","","        return Store(","            initialState: AppState(),","            reducer: AppReducer().reduce,","            plugins: plugins","        )","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ResilientPaywallService"},{"type":"text","text":" (from SwiduxPaywall) persists the last entitlement snapshot a successful read delivered. Without it, a slow or failing network at cold launch leaves "},{"type":"codeVoice","code":"PaywallState"},{"type":"text","text":" at its free default and gates paying users out of their features until the first successful read; with it, the last-known-good state holds until live data arrives, and the server stays authoritative — a genuine lapse is honoured on the next successful read. Wrap the RevenueCat service in it for production."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Back the cache with "},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"type":"text","text":", as shown, rather than "},{"code":"UserDefaultsKeyValueStore","type":"codeVoice"},{"text":". The cache vouches for a paid entitlement while RevenueCat is unreachable, and a ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" plist is user-editable and restorable from a doctored backup; the Keychain uses OS-protected storage instead of a user-editable plist. See Swidux’s ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/securityposture"},{"text":" for what the cache does and does not defend against.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Start the entitlement stream on the root view so the gate reflects RevenueCat’s state from launch:"}]},{"syntax":"swift","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .task {","                store.send(.paywall(.observeCustomerInfo))","                store.send(.paywall(.refreshCustomerInfo))","            }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Gate features by reading "},{"type":"codeVoice","code":"store.paywall.isGateSatisfied"},{"type":"text","text":". See "},{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","isActive":true,"type":"reference"},{"type":"text","text":" for the full plugin lifecycle."}],"type":"paragraph"},{"level":2,"text":"Attach the UI","anchor":"Attach-the-UI","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Attach the composed ","type":"text"},{"code":"revenueCatPaywallAndCustomerCenter","type":"codeVoice"},{"text":" modifier to a root view, driven by paywall state:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import SwiduxRevenueCatPaywallUI","","struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .revenueCatPaywallAndCustomerCenter(","                state: store.paywall,","                onAction: { action in store.send(.paywall(action)) }","            )","    }","}"]},{"inlineContent":[{"type":"text","text":"Trigger the paywall from a gated feature with "},{"type":"codeVoice","code":".paywall(.request(reason:))"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","code":["Button(\"Export PDF\") {","    if store.paywall.isGateSatisfied {","        store.send(.export(.exportPDF))","    } else {","        store.send(.paywall(.request(reason: \"export-pdf\")))","    }","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI"},{"type":"text","text":" for manual wiring with the primitive modifiers, customer-center triggering, and dismiss semantics."}],"type":"paragraph"},{"text":"Next Steps","level":2,"anchor":"Next-Steps","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","isActive":true,"type":"reference"},{"text":" — Detailed walkthrough of the service lifecycle and error handling.","type":"text"}]}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","type":"reference"},{"text":" — Add a lifetime entitlement alongside the subscription.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest","isActive":true},{"type":"text","text":" — Drive entitlement state from previews and tests."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","isActive":true,"type":"reference"},{"type":"text","text":" — Wire the bundled view modifiers."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior"},{"type":"text","text":" — Why iOS and macOS behave differently."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping"},{"text":" — How RevenueCat entitlements map to ","type":"text"},{"code":"EntitlementSnapshot","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"references":{"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall/RevenueCatPaywallError/notConfigured":{"role":"symbol","identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallError\/notConfigured","title":"RevenueCatPaywallError.notConfigured","kind":"symbol","abstract":[{"text":"RevenueCat has not been configured, so the requested operation cannot start.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"text":"notConfigured","kind":"identifier"}],"url":"\/documentation\/swiduxrevenuecatpaywall\/revenuecatpaywallerror\/notconfigured","type":"topic"},"doc://SwiduxRevenueCatPaywall/documentation/SwiduxRevenueCatPaywall":{"abstract":[{"type":"text","text":"RevenueCat adapter for Swidux’s "},{"type":"codeVoice","code":"PaywallPlugin"},{"text":". Implements ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"text":" against ","type":"text"},{"type":"codeVoice","code":"Purchases.shared"},{"text":", ships a controllable mock for previews and tests, and pairs with ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":" for drop-in "},{"code":"PaywallView","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"CustomerCenterView","type":"codeVoice"},{"text":" presentation.","type":"text"}],"identifier":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall","url":"\/documenta