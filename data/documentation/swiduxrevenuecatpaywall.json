{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxrevenuecatpaywall"]}],"topicSections":[{"identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/GettingStarted"],"anchor":"Quickstart","title":"Quickstart"},{"identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToImplementService","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToAddAPermanentLicense","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPresentTheUI","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/HowToPreviewAndTest"],"anchor":"How-to-Guides","title":"How-to Guides"},{"identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/ServiceReference","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockServiceReference","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/UIComponentsReference"],"anchor":"Reference","title":"Reference"},{"identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/PlatformBehavior","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/EntitlementMapping"],"anchor":"Explanation","title":"Explanation"},{"identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallService","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallError","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallIdentity","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallIdentityResult","doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywallIdentityError"],"anchor":"Service-Layer","title":"Service Layer"},{"identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/MockRevenueCatPaywallService"],"anchor":"Testing","title":"Testing"},{"identifiers":["doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall\/RevenueCatPaywall"],"anchor":"Enumerations","title":"Enumerations","generated":true}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"},{"type":"text","text":" is the adapter between RevenueCat’s SDK and Swidux’s purchase-agnostic paywall plugin. The plugin owns paywall state (presentation flags, current entitlement, async progress); this package translates RevenueCat’s "},{"type":"codeVoice","code":"CustomerInfo"},{"type":"text","text":" into the "},{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":" the plugin expects, and surfaces the live "},{"type":"codeVoice","code":"customerInfoStream"},{"type":"text","text":" so entitlement changes propagate without polling."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two products ship together:"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"}],"type":"strong"},{"text":" — ","type":"text"},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":" (the live ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" conformer) and ","type":"text"},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"text":" (a controllable preview \/ test conformer).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"}],"type":"strong"},{"text":" — ","type":"text"},{"code":"revenueCatPaywall(isPresented:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"revenueCatCustomerCenter(isPresented:)","type":"codeVoice"},{"text":" primitives with adaptive presentation and package-owned outcome events, plus a ","type":"text"},{"code":"revenueCatPaywallAndCustomerCenter(state:onAction:)","type":"codeVoice"},{"text":" convenience that composes both.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The flow:"}]},{"type":"codeListing","syntax":null,"code":["View → store.send(.paywall(.request(reason:)))","  → PaywallPlugin sets isPresented = true","  → revenueCatPaywallAndCustomerCenter observes the change, presents RevenueCatUI.PaywallView","  → user purchases → Purchases.shared.customerInfoStream yields a new CustomerInfo","  → RevenueCatPaywallService maps it to EntitlementSnapshot","  → PaywallPlugin reduces .customerInfoUpdated, sets isPro = true","  → store.paywall.isGateSatisfied flips, gated UI unlocks"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin and the adapter stay decoupled: the plugin doesn’t know about RevenueCat, and the adapter doesn’t know about your action tree."}]}],"kind":"content"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxRevenueCatPaywall\/documentation\/SwiduxRevenueCatPaywall"},"abstract":[{"type":"text","text":"RevenueCat adapter for Swidux’s "},{"type":"codeVoice","code":"PaywallPlugin"},{"type":"text","text":". Implements "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" against "},{"type":"codeVoice","code":"Purchases.shared"},{"type":"text","text":", ships a controllable mock for previews and tests, and pairs with "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":" for drop-in "},{"type":"codeVoice","code":"PaywallView"},{"type":"text","text":" and "},{"type":"codeVoice","code":"CustomerCenterView"},{"type":"text","text":" presentation."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","metadata":{"title":"SwiduxRevenueCatPaywall","roleHeading":"Framework","externalID":"SwiduxRevenueCatPaywall","symbolKind":"module","modules":[{"name":"SwiduxRevenueCatPaywa