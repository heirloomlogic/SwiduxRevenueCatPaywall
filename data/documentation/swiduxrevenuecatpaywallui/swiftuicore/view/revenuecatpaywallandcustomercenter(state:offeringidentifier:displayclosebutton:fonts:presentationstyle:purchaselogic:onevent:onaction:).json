 uses the current offering when no placement fallback is configured. An unknown explicit identifier asserts in Debug, logs a warning, and falls back.","type":"text"}]}],"name":"offeringIdentifier"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Whether ","type":"text"},{"code":"PaywallView","type":"codeVoice"},{"text":" shows a close button. Defaults to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":"; when ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", iOS sheets disable interactive dismissal, and the iOS full-screen cover and macOS sheet provide no other dismissal affordance. Pass ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" only for a hard paywall the user must purchase through.","type":"text"}]}],"name":"displayCloseButton"},{"content":[{"type":"paragraph","inlineContent":[{"text":"RevenueCatUI font provider used by the paywall.","type":"text"}]}],"name":"fonts"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Automatic or explicit iOS presentation style. macOS always uses a sheet.","type":"text"}]}],"name":"presentationStyle"},{"content":[{"type":"paragraph","inlineContent":[{"text":"App-owned StoreKit 2 purchase and restore operations for ","type":"text"},{"code":".myApp","type":"codeVoice"},{"text":" mode. Leave ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when RevenueCat completes purchases.","type":"text"}]}],"name":"purchaseLogic"},{"content":[{"inlineContent":[{"type":"text","text":"Optional callback for package-owned purchase, restore, cancellation, and failure values."}],"type":"paragraph"}],"name":"onEvent"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A closure that lifts a ","type":"text"},{"code":"PaywallAction","type":"codeVoice"},{"type":"text","text":" into your root action and dispatches it, for example "},{"code":"{ store.send(.paywall($0)) }","type":"codeVoice"},{"type":"text","text":"."}]}],"name":"onAction"}]},{"kind":"content","content":[{"anchor":"return-value","type":"heading","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A view with paywall and customer-center presentation attached."}]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Convenience modifier that composes paywall and customer-center presentation in one call. Presentation changes dispatch their matching paywall actions through ","type":"text"},{"code":"onAction","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"On iOS the two presentations are mutually exclusive and the paywall wins. On macOS a customer-center request dispatches ","type":"text"},{"code":".openManageSubscriptions","type":"codeVoice"},{"text":" through the paywall plugin, then ","type":"text"},{"code":".dismissCustomerCenter","type":"codeVoice"},{"type":"text","text":"; the external App Store hand-off does not compete with the paywall sheet."}]},{"inlineContent":[{"type":"text","text":"Attach this modifier once, to one app-wide presentation host. Attaching it to every "},{"type":"codeVoice","code":"WindowGroup"},{"type":"text","text":" scene or window causes every attachment to respond to the same "},{"type":"codeVoice","code":"PaywallState"},{"type":"text","text":" request."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"After a restore inside the paywall, the modifier dispatches "},{"type":"codeVoice","code":".dismiss"},{"type":"text","text":" once"},{"type":"text","text":" "},{"type":"codeVoice","code":"PaywallState.isGateSatisfied"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":", since RevenueCatUI does not dismiss after a"},{"type":"text","text":" "},{"type":"text","text":"restore on its own. This relies on the entitlement stream: dispatch"},{"type":"text","text":" "},{"type":"codeVoice","code":".observeCustomerInfo"},{"type":"text","text":" at launch."}],"type":"paragraph"},{"syntax":"swift","code":["ContentView()","    .revenueCatPaywallAndCustomerCenter(","        state: store.paywall,","        onAction: { store.send(.paywall($0)) }","    )"],"type":"codeListing"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxrevenuecatpaywallui\/swiftuicore\/view\/revenuecatpaywallandcustomercenter(state:offeringidentifier:displayclosebutton:fonts:presentationstyle:purchaselogic:onevent:onaction:)"]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxRevenueCatPaywallUI\/documentation\/SwiduxRevenueCatPaywallUI\/SwiftUICore\/View\/revenueCatPaywallAndCustomerCenter(state:offeringIdentifier:displayCloseButton:fonts:presentationStyle:purchaseLogic:onEvent:onAction:)"},"metadata":{"externalID":"s:7SwiftUI4ViewP023SwiduxRevenueCatPaywallB0E07revenuefG17AndCustomerCenter5state18offeringIdentifier18displayCloseButton5fonts17presentationStyle13purchaseLogic7onEvent0W6ActionQr0dG00G5StateV_SSSgSb0efB00G12FontProvider_pAD0efg12PresentationT0OAD0efg8PurchaseV0VSgyAD0efgX0OcSgyAN0gY0OctF","roleHeading":"Instance Method","role":"symbol","title":"revenueCatPaywallAndCustomerCenter(state:offeringIdentifier:displayCloseButton:fonts:presentationStyle:purchaseLogic:onEvent:onAction:)","extendedModule":"SwiftUICore","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"revenueCatPaywallAndCustomerCenter","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"state"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:13SwiduxPaywall0B5StateV","text":"PaywallState","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"offeringIdentifier","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"displayCloseButton"},{"kind":"text","text":": "},{