 the iOS full-screen cover and macOS sheet provide no other dismissal affordance. Pass ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" only for a hard paywall the user must purchase through.","type":"text"}],"type":"paragraph"}],"name":"displayCloseButton"},{"content":[{"inlineContent":[{"text":"RevenueCatUI font provider used by the paywall.","type":"text"}],"type":"paragraph"}],"name":"fonts"},{"content":[{"inlineContent":[{"text":"Automatic or explicit iOS presentation style. macOS always uses a sheet.","type":"text"}],"type":"paragraph"}],"name":"presentationStyle"},{"content":[{"inlineContent":[{"text":"App-owned StoreKit 2 purchase and restore operations for ","type":"text"},{"code":".myApp","type":"codeVoice"},{"text":" mode. Leave ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when RevenueCat completes purchases.","type":"text"}],"type":"paragraph"}],"name":"purchaseLogic"},{"content":[{"inlineContent":[{"text":"Optional callback for package-owned purchase, restore, cancellation, and failure values.","type":"text"}],"type":"paragraph"}],"name":"onEvent"},{"content":[{"inlineContent":[{"text":"A closure that lifts a ","type":"text"},{"code":"PaywallAction","type":"codeVoice"},{"text":" into your root action and dispatches it, for example ","type":"text"},{"code":"{ store.send(.paywall($0)) }","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"onAction"}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Return Value","anchor":"return-value"},{"inlineContent":[{"type":"text","text":"A view with paywall and customer-center presentation attached."}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Convenience modifier that composes paywall and customer-center presentation in one call. Presentation changes dispatch their matching paywall actions through "},{"code":"onAction","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"On iOS the two presentations are mutually exclusive and the paywall wins. On macOS a customer-center request dispatches "},{"code":".openManageSubscriptions","type":"codeVoice"},{"type":"text","text":" through the paywall plugin, then "},{"code":".dismissCustomerCenter","type":"codeVoice"},{"type":"text","text":"; the external App Store hand-off does not compete with the paywall sheet."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Attach this modifier once, to one app-wide presentation host. Attaching it to every "},{"code":"WindowGroup","type":"codeVoice"},{"type":"text","text":" scene or window causes every attachment to respond to the same "},{"code":"PaywallState","type":"codeVoice"},{"type":"text","text":" request."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"After a restore inside the paywall, the modifier dispatches "},{"code":".dismiss","type":"codeVoice"},{"type":"text","text":" once"},{"type":"text","text":" "},{"code":"PaywallState.isGateSatisfied","type":"codeVoice"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":", since RevenueCatUI does not dismiss after a"},{"type":"text","text":" "},{"type":"text","text":"restore on its own. This relies on the entitlement stream: dispatch"},{"text":" ","type":"text"},{"code":".observeCustomerInfo","type":"codeVoice"},{"text":" at launch.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["ContentView()","    .revenueCatPaywallAndCustomerCenter(","        state: store.paywall,","        onAction: { store.send(.paywall($0)) }","    )"],"type":"codeListing"}]}],"identifier":{"url":"doc:\/\/SwiduxRevenueCatPaywallUI\/documentation\/SwiduxRevenueCatPaywallUI\/SwiftUICore\/View\/revenueCatPaywallAndCustomerCenter(state:offeringIdentifier:displayCloseButton:fonts:presentationStyle:purchaseLogic:onEvent:onAction:)","interfaceLanguage":